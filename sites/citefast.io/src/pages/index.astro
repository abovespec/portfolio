---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout
  title="Citation Generator — APA, MLA, Chicago Format Online Free"
  description="Free online citation generator. Create formatted citations in APA, MLA, and Chicago style for books, websites, journal articles, YouTube, podcasts, government documents, and dissertations."
>

  <!-- Header -->
  <header class="text-center mb-8">
    <h1 class="text-4xl font-bold text-stone-800 mb-2">Citation Generator</h1>
    <p class="text-stone-600 text-lg">Generate APA, MLA, and Chicago citations instantly — books, websites, journal articles, and more.</p>
  </header>

  <!-- Source type tabs -->
  <div class="flex flex-wrap gap-2 mb-3">
    <button id="tab-book"
      class="px-4 py-2 rounded-lg text-sm font-medium transition bg-stone-700 text-white"
      onclick="switchTab('book')">
      Book
    </button>
    <button id="tab-website"
      class="px-4 py-2 rounded-lg text-sm font-medium transition bg-stone-100 text-stone-700 hover:bg-stone-200"
      onclick="switchTab('website')">
      Website
    </button>
    <button id="tab-journal"
      class="px-4 py-2 rounded-lg text-sm font-medium transition bg-stone-100 text-stone-700 hover:bg-stone-200"
      onclick="switchTab('journal')">
      Journal Article
    </button>
    <button id="tab-video"
      class="px-4 py-2 rounded-lg text-sm font-medium transition bg-stone-100 text-stone-700 hover:bg-stone-200"
      onclick="switchTab('video')">
      YouTube / Video
    </button>
    <button id="tab-podcast"
      class="px-4 py-2 rounded-lg text-sm font-medium transition bg-stone-100 text-stone-700 hover:bg-stone-200"
      onclick="switchTab('podcast')">
      Podcast
    </button>
    <button id="tab-govdoc"
      class="px-4 py-2 rounded-lg text-sm font-medium transition bg-stone-100 text-stone-700 hover:bg-stone-200"
      onclick="switchTab('govdoc')">
      Government Doc
    </button>
    <button id="tab-dissertation"
      class="px-4 py-2 rounded-lg text-sm font-medium transition bg-stone-100 text-stone-700 hover:bg-stone-200"
      onclick="switchTab('dissertation')">
      Dissertation / Thesis
    </button>
  </div>

  <!-- Dual-pane -->
  <div class="grid gap-4 md:grid-cols-2 min-h-96">

    <!-- LEFT: form -->
    <div class="bg-stone-50 border border-stone-200 rounded-xl p-5 flex flex-col gap-3">

      <!-- Book form -->
      <div id="form-book">
        <p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-2">Book Details</p>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="book-author-last">Author Last Name</label>
            <input id="book-author-last" type="text" placeholder="Smith"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="book-author-first">Author First Name</label>
            <input id="book-author-first" type="text" placeholder="Jane"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="book-year">Year</label>
          <input id="book-year" type="text" placeholder="2024"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="book-title">Book Title</label>
          <input id="book-title" type="text" placeholder="The Great Book"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="book-publisher">Publisher</label>
          <input id="book-publisher" type="text" placeholder="Oxford University Press"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="grid grid-cols-2 gap-2 mt-2">
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="book-city">City <span class="text-stone-400">(Chicago)</span></label>
            <input id="book-city" type="text" placeholder="New York"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="book-edition">Edition <span class="text-stone-400">(optional)</span></label>
            <input id="book-edition" type="text" placeholder="2nd"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
        </div>
      </div>

      <!-- Website form -->
      <div id="form-website" class="hidden">
        <p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-2">Website Details</p>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="web-author-last">Author Last <span class="text-stone-400">(optional)</span></label>
            <input id="web-author-last" type="text" placeholder="Smith"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="web-author-first">Author First <span class="text-stone-400">(optional)</span></label>
            <input id="web-author-first" type="text" placeholder="Jane"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
        </div>
        <div class="grid grid-cols-3 gap-2 mt-2">
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="web-year">Year <span class="text-stone-400">(opt.)</span></label>
            <input id="web-year" type="text" placeholder="2024"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="web-month">Month <span class="text-stone-400">(opt.)</span></label>
            <input id="web-month" type="text" placeholder="March"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="web-day">Day <span class="text-stone-400">(opt.)</span></label>
            <input id="web-day" type="text" placeholder="15"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="web-page-title">Page Title</label>
          <input id="web-page-title" type="text" placeholder="How to Do Something"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="web-site-name">Website / Organization Name</label>
          <input id="web-site-name" type="text" placeholder="Wikipedia"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="web-url">URL</label>
          <input id="web-url" type="text" placeholder="https://example.com/page"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="web-accessed">Accessed Date</label>
          <input id="web-accessed" type="text" placeholder="April 25, 2026"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
      </div>

      <!-- Journal form -->
      <div id="form-journal" class="hidden">
        <p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-2">Journal Article Details</p>
        <div class="mb-4 p-3 rounded-lg bg-slate-50 border border-slate-200">
          <label class="block text-xs font-medium text-slate-600 mb-1">Auto-fill from DOI</label>
          <div class="flex gap-2">
            <input type="text" id="doi-input" placeholder="e.g. 10.1000/xyz123"
              class="flex-1 rounded-lg border border-slate-300 px-3 py-1.5 text-sm focus:border-brand focus:outline-none">
            <button id="doi-lookup-btn" onclick="lookupDOI(document.getElementById('doi-input').value)"
              class="px-3 py-1.5 rounded-lg bg-stone-700 text-white text-sm font-medium hover:bg-stone-600">
              Look Up DOI
            </button>
          </div>
          <p id="doi-status" class="text-xs text-slate-400 mt-1">Enter a DOI to auto-fill the form</p>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="journal-author-last">Author Last Name</label>
            <input id="journal-author-last" type="text" placeholder="Smith"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="journal-author-first">Author First Name</label>
            <input id="journal-author-first" type="text" placeholder="Jane"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="journal-year">Year</label>
          <input id="journal-year" type="text" placeholder="2024"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="journal-article-title">Article Title</label>
          <input id="journal-article-title" type="text" placeholder="The effects of something on something"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="journal-name">Journal Name</label>
          <input id="journal-name" type="text" placeholder="Nature"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="grid grid-cols-3 gap-2 mt-2">
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="journal-volume">Volume</label>
            <input id="journal-volume" type="text" placeholder="12"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="journal-issue">Issue <span class="text-stone-400">(opt.)</span></label>
            <input id="journal-issue" type="text" placeholder="3"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="journal-pages">Pages</label>
            <input id="journal-pages" type="text" placeholder="123-145"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="journal-doi">DOI <span class="text-stone-400">(optional)</span></label>
          <input id="journal-doi" type="text" placeholder="10.1000/xyz123"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
      </div>

      <!-- YouTube / Video form -->
      <div id="form-video" class="hidden">
        <p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-2">YouTube / Video Details</p>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="video-creator">Creator / Channel Name</label>
          <input id="video-creator" type="text" placeholder="Kurzgesagt – In a Nutshell"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="video-title">Video Title</label>
          <input id="video-title" type="text" placeholder="Why Black Holes Are Awesome"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="grid grid-cols-3 gap-2 mt-2">
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="video-year">Year</label>
            <input id="video-year" type="text" placeholder="2024"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="video-month">Month <span class="text-stone-400">(opt.)</span></label>
            <input id="video-month" type="text" placeholder="March"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="video-day">Day <span class="text-stone-400">(opt.)</span></label>
            <input id="video-day" type="text" placeholder="15"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="video-platform">Platform</label>
          <select id="video-platform" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400">
            <option value="YouTube">YouTube</option>
            <option value="Vimeo">Vimeo</option>
            <option value="TED">TED</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="video-url">URL</label>
          <input id="video-url" type="text" placeholder="https://www.youtube.com/watch?v=..."
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
      </div>

      <!-- Podcast form -->
      <div id="form-podcast" class="hidden">
        <p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-2">Podcast Details</p>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="pod-host-last">Host Last Name</label>
            <input id="pod-host-last" type="text" placeholder="Rogen"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="pod-host-first">Host First Name</label>
            <input id="pod-host-first" type="text" placeholder="Joe"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="pod-episode-title">Episode Title</label>
          <input id="pod-episode-title" type="text" placeholder="Episode with Elon Musk"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="pod-podcast-name">Podcast Name</label>
          <input id="pod-podcast-name" type="text" placeholder="The Joe Rogan Experience"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="grid grid-cols-3 gap-2 mt-2">
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="pod-year">Year</label>
            <input id="pod-year" type="text" placeholder="2024"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="pod-month">Month <span class="text-stone-400">(opt.)</span></label>
            <input id="pod-month" type="text" placeholder="January"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="pod-episode-num">Episode # <span class="text-stone-400">(opt.)</span></label>
            <input id="pod-episode-num" type="text" placeholder="2054"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="pod-url">URL <span class="text-stone-400">(optional)</span></label>
          <input id="pod-url" type="text" placeholder="https://open.spotify.com/..."
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
      </div>

      <!-- Government Document form -->
      <div id="form-govdoc" class="hidden">
        <p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-2">Government Document Details</p>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="gov-agency">Agency / Department</label>
          <input id="gov-agency" type="text" placeholder="U.S. Department of Health and Human Services"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="gov-title">Document Title</label>
          <input id="gov-title" type="text" placeholder="Annual Report on Health Disparities"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="gov-year">Year</label>
          <input id="gov-year" type="text" placeholder="2024"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="gov-pub-num">Publication Number <span class="text-stone-400">(optional)</span></label>
          <input id="gov-pub-num" type="text" placeholder="HHS-2024-001"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="gov-url">URL <span class="text-stone-400">(optional)</span></label>
          <input id="gov-url" type="text" placeholder="https://www.hhs.gov/..."
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
      </div>

      <!-- Dissertation / Thesis form -->
      <div id="form-dissertation" class="hidden">
        <p class="text-xs font-semibold text-stone-500 uppercase tracking-wide mb-2">Dissertation / Thesis Details</p>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="diss-author-last">Author Last Name</label>
            <input id="diss-author-last" type="text" placeholder="Smith"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
          <div>
            <label class="block text-xs text-stone-600 mb-1" for="diss-author-first">Author First Name</label>
            <input id="diss-author-first" type="text" placeholder="Jane"
              class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
          </div>
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="diss-title">Title</label>
          <input id="diss-title" type="text" placeholder="Neural correlates of decision-making"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="diss-year">Year</label>
          <input id="diss-year" type="text" placeholder="2024"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="diss-institution">Institution</label>
          <input id="diss-institution" type="text" placeholder="Harvard University"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="diss-type">Type</label>
          <select id="diss-type" class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400">
            <option value="Doctoral dissertation">Doctoral dissertation</option>
            <option value="Master's thesis">Master's thesis</option>
          </select>
        </div>
        <div class="mt-2">
          <label class="block text-xs text-stone-600 mb-1" for="diss-url">Database / URL <span class="text-stone-400">(optional)</span></label>
          <input id="diss-url" type="text" placeholder="ProQuest Dissertations &amp; Theses"
            class="w-full border border-stone-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-stone-400" />
        </div>
      </div>

      <!-- Action buttons -->
      <div class="flex gap-2 mt-1">
        <button id="btn-generate"
          class="flex-1 px-4 py-2 bg-stone-700 hover:bg-stone-600 text-white rounded-lg text-sm font-medium transition"
          onclick="generateAll()">
          Generate Citation
        </button>
        <button id="btn-clear"
          class="px-4 py-2 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-lg text-sm font-medium transition"
          onclick="clearAll()">
          Clear
        </button>
      </div>

    </div>

    <!-- RIGHT: citation output -->
    <div class="flex flex-col gap-3">

      <!-- APA -->
      <div class="bg-white border border-stone-200 rounded-xl p-4">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-stone-500 uppercase tracking-wide">APA</span>
          <button onclick="copyCitation('apa')"
            class="text-xs px-3 py-1 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-md transition font-medium">
            Copy
          </button>
        </div>
        <div id="output-apa" class="text-sm leading-relaxed min-h-10 text-stone-400 italic">
          Fill in the form and click Generate.
        </div>
      </div>

      <!-- MLA -->
      <div class="bg-white border border-stone-200 rounded-xl p-4">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-stone-500 uppercase tracking-wide">MLA</span>
          <button onclick="copyCitation('mla')"
            class="text-xs px-3 py-1 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-md transition font-medium">
            Copy
          </button>
        </div>
        <div id="output-mla" class="text-sm leading-relaxed min-h-10 text-stone-400 italic">
          Fill in the form and click Generate.
        </div>
      </div>

      <!-- Chicago -->
      <div class="bg-white border border-stone-200 rounded-xl p-4">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-stone-500 uppercase tracking-wide">Chicago</span>
          <button onclick="copyCitation('chicago')"
            class="text-xs px-3 py-1 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-md transition font-medium">
            Copy
          </button>
        </div>
        <div id="output-chicago" class="text-sm leading-relaxed min-h-10 text-stone-400 italic">
          Fill in the form and click Generate.
        </div>
      </div>

      <!-- Status bar -->
      <div id="status-bar" class="text-xs text-stone-500 text-center hidden">
        <span id="status-msg"></span>
      </div>

      <!-- Add to Bibliography button -->
      <div class="mt-2">
        <button id="btn-add-bib"
          class="w-full px-4 py-2 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-lg text-sm font-medium transition"
          onclick="addCurrentToBib()">
          + Add to Bibliography
        </button>
      </div>

    </div>
  </div>

  <!-- Bibliography Section -->
  <section id="bib-section" class="hidden mt-6 rounded-xl border border-slate-200 bg-white p-4">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-semibold text-slate-700">Bibliography</h2>
      <button id="copy-bib-btn" onclick="copyBib()"
        class="text-xs px-3 py-1.5 rounded-lg bg-stone-700 text-white hover:bg-stone-600 font-medium">
        Copy Bibliography
      </button>
    </div>
    <div id="bib-list"></div>
  </section>

  <!-- SEO content block -->
  <section class="mt-12 max-w-3xl mx-auto">
    <h2 class="text-2xl font-bold text-stone-800 mb-4">APA, MLA, and Chicago Citation Styles</h2>
    <p class="mb-4 text-stone-600">
      Academic citations provide readers with the information needed to locate and verify sources.
      Three citation styles dominate academic writing: APA, MLA, and Chicago. Each has distinct
      formatting rules suited to different disciplines.
    </p>

    <h3 class="text-lg font-semibold text-stone-800 mt-6 mb-2">APA (American Psychological Association)</h3>
    <p class="mb-4 text-stone-600">
      APA style is standard in the social sciences, psychology, education, and nursing. It emphasizes
      the publication date prominently — the year appears right after the author, reflecting the
      importance of recency in scientific fields. The format for a book follows the pattern:
      Last, F. (Year). <em>Title.</em> Publisher.
    </p>

    <h3 class="text-lg font-semibold text-stone-800 mt-6 mb-2">MLA (Modern Language Association)</h3>
    <p class="mb-4 text-stone-600">
      MLA style is used in the humanities — literature, language, film, and cultural studies.
      It focuses on authorship and uses a Works Cited page. The format de-emphasizes the publication
      year, placing it near the end: Last, First. <em>Title.</em> Publisher, Year.
    </p>

    <h3 class="text-lg font-semibold text-stone-800 mt-6 mb-2">Chicago (Turabian)</h3>
    <p class="mb-4 text-stone-600">
      Chicago style is widely used in history, the arts, and some social sciences. It has two
      systems: Notes-Bibliography (used here) and Author-Date. The bibliography entry for a book is:
      Last, First. <em>Title.</em> City: Publisher, Year. Chicago style is particularly detailed
      about place of publication.
    </p>

    <h3 class="text-lg font-semibold text-stone-800 mt-6 mb-2">When to Use Each Style</h3>
    <ul class="list-disc pl-5 space-y-1 text-stone-600 mb-4">
      <li><strong>APA</strong> — psychology, education, social sciences, nursing, business</li>
      <li><strong>MLA</strong> — literature, language, film studies, cultural studies, humanities</li>
      <li><strong>Chicago</strong> — history, fine arts, some social sciences; also used in publishing</li>
    </ul>

    <p class="text-stone-600">
      When in doubt, check your institution's or journal's style guide. Many instructors specify
      which format to use; if not stated, APA is a safe default for science-adjacent fields
      and MLA for humanities.
    </p>
  </section>

  <script is:inline>
    var ALL_TABS = ['book', 'website', 'journal', 'video', 'podcast', 'govdoc', 'dissertation'];
    var currentTab = 'book';
    var citationPlainText = { apa: '', mla: '', chicago: '' };

    function switchTab(tab) {
      currentTab = tab;
      ALL_TABS.forEach(function(t) {
        var form = document.getElementById('form-' + t);
        var btn = document.getElementById('tab-' + t);
        if (t === tab) {
          form.classList.remove('hidden');
          btn.className = 'px-4 py-2 rounded-lg text-sm font-medium transition bg-stone-700 text-white';
        } else {
          form.classList.add('hidden');
          btn.className = 'px-4 py-2 rounded-lg text-sm font-medium transition bg-stone-100 text-stone-700 hover:bg-stone-200';
        }
      });
      generateAll();
    }

    function val(id) {
      var el = document.getElementById(id);
      return el ? el.value.trim() : '';
    }

    function initial(firstName) {
      if (!firstName) return '';
      return firstName.charAt(0).toUpperCase() + '.';
    }

    function ordinalEdition(ed) {
      if (!ed) return '';
      var num = parseInt(ed, 10);
      if (isNaN(num)) return ed + ' ed.';
      var suffix = 'th';
      if (num % 100 < 11 || num % 100 > 13) {
        if (num % 10 === 1) suffix = 'st';
        else if (num % 10 === 2) suffix = 'nd';
        else if (num % 10 === 3) suffix = 'rd';
      }
      return num + suffix + ' ed.';
    }

    function sentenceCase(str) {
      if (!str) return '';
      return str.charAt(0).toUpperCase() + str.slice(1).toLowerCase();
    }

    var MONTH_ABBREV = {
      'january':'Jan.','february':'Feb.','march':'Mar.','april':'Apr.',
      'may':'May','june':'June','july':'July','august':'Aug.',
      'september':'Sept.','october':'Oct.','november':'Nov.','december':'Dec.'
    };

    function monthAbbr(month) {
      return month ? (MONTH_ABBREV[month.toLowerCase()] || month) : '';
    }

    function generateBook() {
      var last = val('book-author-last');
      var first = val('book-author-first');
      var year = val('book-year');
      var title = val('book-title');
      var publisher = val('book-publisher');
      var city = val('book-city');
      var edition = val('book-edition');

      if (!last && !title) { setPlaceholders(); return; }

      var authorFull = last && first ? last + ', ' + first : (last || first || 'Author');
      var authorAPA  = last && first ? last + ', ' + initial(first) : (last || first || 'Author');
      var edStr = edition ? ordinalEdition(edition) : '';

      // APA
      var apaHtml = authorAPA;
      if (year) apaHtml += ' (' + year + ').';
      apaHtml += ' <em>' + (title || 'Title') + '</em>';
      if (edStr) apaHtml += ' (' + edStr + ')';
      apaHtml += '.';
      if (publisher) apaHtml += ' ' + publisher + '.';

      var apaPlain = authorAPA;
      if (year) apaPlain += ' (' + year + ').';
      apaPlain += ' ' + (title || 'Title');
      if (edStr) apaPlain += ' (' + edStr + ')';
      apaPlain += '.';
      if (publisher) apaPlain += ' ' + publisher + '.';

      // MLA
      var mlaHtml = authorFull + '. <em>' + (title || 'Title') + '</em>.';
      if (publisher) mlaHtml += ' ' + publisher + ',';
      if (year) mlaHtml += ' ' + year + '.';

      var mlaPlain = authorFull + '. ' + (title || 'Title') + '.';
      if (publisher) mlaPlain += ' ' + publisher + ',';
      if (year) mlaPlain += ' ' + year + '.';

      // Chicago
      var chicagoHtml = authorFull + '. <em>' + (title || 'Title') + '</em>.';
      if (city && publisher) chicagoHtml += ' ' + city + ': ' + publisher + ',';
      else if (publisher) chicagoHtml += ' ' + publisher + ',';
      else if (city) chicagoHtml += ' ' + city + ':';
      if (year) chicagoHtml += ' ' + year + '.';

      var chicagoPlain = authorFull + '. ' + (title || 'Title') + '.';
      if (city && publisher) chicagoPlain += ' ' + city + ': ' + publisher + ',';
      else if (publisher) chicagoPlain += ' ' + publisher + ',';
      else if (city) chicagoPlain += ' ' + city + ':';
      if (year) chicagoPlain += ' ' + year + '.';

      setOutputs(apaHtml, apaPlain, mlaHtml, mlaPlain, chicagoHtml, chicagoPlain);
    }

    function generateWebsite() {
      var last      = val('web-author-last');
      var first     = val('web-author-first');
      var year      = val('web-year');
      var month     = val('web-month');
      var day       = val('web-day');
      var pageTitle = val('web-page-title');
      var siteName  = val('web-site-name');
      var url       = val('web-url');
      var accessed  = val('web-accessed');

      if (!pageTitle && !siteName) { setPlaceholders(); return; }

      var hasAuthor  = last || first;
      var authorFull = last && first ? last + ', ' + first : (last || first || '');
      var authorAPA  = last && first ? last + ', ' + initial(first) : (last || first || '');

      var dateAPA = '';
      if (year && month && day) dateAPA = year + ', ' + month + ' ' + day;
      else if (year && month)   dateAPA = year + ', ' + month;
      else if (year)            dateAPA = year;
      else                      dateAPA = 'n.d.';

      var mabbr = monthAbbr(month);
      var dateMLA = '';
      if (day && mabbr && year)  dateMLA = day + ' ' + mabbr + ' ' + year;
      else if (mabbr && year)    dateMLA = mabbr + ' ' + year;
      else if (year)             dateMLA = year;

      // APA
      var apaHtml = '';
      var apaPlain = '';
      if (hasAuthor) { apaHtml += authorAPA + ' '; apaPlain += authorAPA + ' '; }
      apaHtml  += '(' + dateAPA + ').';
      apaPlain += '(' + dateAPA + ').';
      if (pageTitle) { apaHtml += ' <em>' + pageTitle + '</em>.'; apaPlain += ' ' + pageTitle + '.'; }
      if (siteName)  { apaHtml += ' ' + siteName + '.';           apaPlain += ' ' + siteName + '.'; }
      if (url)       { apaHtml += ' ' + url;                      apaPlain += ' ' + url; }

      // MLA
      var mlaHtml = '';
      var mlaPlain = '';
      if (hasAuthor) { mlaHtml += authorFull + '. '; mlaPlain += authorFull + '. '; }
      if (pageTitle) { mlaHtml += '&quot;' + pageTitle + '.&quot;'; mlaPlain += '"' + pageTitle + '."'; }
      if (siteName)  { mlaHtml += ' <em>' + siteName + '</em>,'; mlaPlain += ' ' + siteName + ','; }
      if (dateMLA)   { mlaHtml += ' ' + dateMLA + ','; mlaPlain += ' ' + dateMLA + ','; }
      if (url)       { mlaHtml += ' ' + url + '.'; mlaPlain += ' ' + url + '.'; }

      // Chicago
      var chicagoHtml = '';
      var chicagoPlain = '';
      if (hasAuthor) { chicagoHtml += authorFull + '. '; chicagoPlain += authorFull + '. '; }
      if (pageTitle) { chicagoHtml += '&quot;' + pageTitle + '.&quot;'; chicagoPlain += '"' + pageTitle + '."'; }
      if (siteName)  { chicagoHtml += ' <em>' + siteName + '</em>.'; chicagoPlain += ' ' + siteName + '.'; }
      if (accessed)  { chicagoHtml += ' Accessed ' + accessed + '.'; chicagoPlain += ' Accessed ' + accessed + '.'; }
      if (url)       { chicagoHtml += ' ' + url + '.'; chicagoPlain += ' ' + url + '.'; }

      setOutputs(apaHtml, apaPlain, mlaHtml, mlaPlain, chicagoHtml, chicagoPlain);
    }

    function generateJournal() {
      var last         = val('journal-author-last');
      var first        = val('journal-author-first');
      var year         = val('journal-year');
      var articleTitle = val('journal-article-title');
      var journalName  = val('journal-name');
      var volume       = val('journal-volume');
      var issue        = val('journal-issue');
      var pages        = val('journal-pages');
      var doi          = val('journal-doi');

      if (!last && !articleTitle) { setPlaceholders(); return; }

      var authorFull = last && first ? last + ', ' + first : (last || first || 'Author');
      var authorAPA  = last && first ? last + ', ' + initial(first) : (last || first || 'Author');

      // APA
      var apaHtml = authorAPA;
      if (year) apaHtml += ' (' + year + ').';
      if (articleTitle) apaHtml += ' ' + sentenceCase(articleTitle) + '.';
      if (journalName) {
        apaHtml += ' <em>' + journalName + '</em>';
        if (volume) {
          apaHtml += ', <em>' + volume + '</em>';
          if (issue) apaHtml += '(' + issue + ')';
        }
        if (pages) apaHtml += ', ' + pages;
        apaHtml += '.';
      }
      if (doi) apaHtml += ' https://doi.org/' + doi;

      var apaPlain = authorAPA;
      if (year) apaPlain += ' (' + year + ').';
      if (articleTitle) apaPlain += ' ' + sentenceCase(articleTitle) + '.';
      if (journalName) {
        apaPlain += ' ' + journalName;
        if (volume) {
          apaPlain += ', ' + volume;
          if (issue) apaPlain += '(' + issue + ')';
        }
        if (pages) apaPlain += ', ' + pages;
        apaPlain += '.';
      }
      if (doi) apaPlain += ' https://doi.org/' + doi;

      // MLA
      var mlaHtml = authorFull + '.';
      if (articleTitle) mlaHtml += ' &quot;' + articleTitle + '.&quot;';
      if (journalName) mlaHtml += ' <em>' + journalName + '</em>,';
      if (volume) mlaHtml += ' vol. ' + volume + ',';
      if (issue)  mlaHtml += ' no. '  + issue  + ',';
      if (year)   mlaHtml += ' ' + year + ',';
      if (pages)  mlaHtml += ' pp. ' + pages + '.';

      var mlaPlain = authorFull + '.';
      if (articleTitle) mlaPlain += ' "' + articleTitle + '."';
      if (journalName) mlaPlain += ' ' + journalName + ',';
      if (volume) mlaPlain += ' vol. ' + volume + ',';
      if (issue)  mlaPlain += ' no. '  + issue  + ',';
      if (year)   mlaPlain += ' ' + year + ',';
      if (pages)  mlaPlain += ' pp. ' + pages + '.';

      // Chicago
      var chicagoHtml = authorFull + '.';
      if (articleTitle) chicagoHtml += ' &quot;' + articleTitle + '.&quot;';
      if (journalName) chicagoHtml += ' <em>' + journalName + '</em>';
      if (volume) chicagoHtml += ' ' + volume + ',';
      if (issue)  chicagoHtml += ' no. ' + issue;
      if (year)   chicagoHtml += ' (' + year + '):';
      if (pages)  chicagoHtml += ' ' + pages + '.';
      if (doi)    chicagoHtml += ' ' + doi + '.';

      var chicagoPlain = authorFull + '.';
      if (articleTitle) chicagoPlain += ' "' + articleTitle + '."';
      if (journalName) chicagoPlain += ' ' + journalName;
      if (volume) chicagoPlain += ' ' + volume + ',';
      if (issue)  chicagoPlain += ' no. ' + issue;
      if (year)   chicagoPlain += ' (' + year + '):';
      if (pages)  chicagoPlain += ' ' + pages + '.';
      if (doi)    chicagoPlain += ' ' + doi + '.';

      setOutputs(apaHtml, apaPlain, mlaHtml, mlaPlain, chicagoHtml, chicagoPlain);
    }

    function generateVideo() {
      var creator  = val('video-creator');
      var title    = val('video-title');
      var year     = val('video-year');
      var month    = val('video-month');
      var day      = val('video-day');
      var platform = val('video-platform') || 'YouTube';
      var url      = val('video-url');

      if (!creator && !title) { setPlaceholders(); return; }

      var creatorLabel = creator || 'Creator';

      // APA: Creator [Channel]. (Year, Month Day). Title [Video]. Platform. URL
      var dateAPA = '';
      if (year && month && day) dateAPA = year + ', ' + month + ' ' + day;
      else if (year && month)   dateAPA = year + ', ' + month;
      else if (year)            dateAPA = year;
      else                      dateAPA = 'n.d.';

      var apaHtml = creatorLabel + ' [Channel]. (' + dateAPA + '). <em>' + (title || 'Title') + '</em> [Video]. ' + platform + '.';
      if (url) apaHtml += ' ' + url;
      var apaPlain = creatorLabel + ' [Channel]. (' + dateAPA + '). ' + (title || 'Title') + ' [Video]. ' + platform + '.';
      if (url) apaPlain += ' ' + url;

      // MLA: Creator. "Title." Platform, Day Month Year, URL.
      var mabbr = monthAbbr(month);
      var dateMLA = '';
      if (day && mabbr && year) dateMLA = day + ' ' + mabbr + ' ' + year;
      else if (mabbr && year)   dateMLA = mabbr + ' ' + year;
      else if (year)            dateMLA = year;

      var mlaHtml = creatorLabel + '. &quot;' + (title || 'Title') + '.&quot; <em>' + platform + '</em>';
      if (dateMLA) mlaHtml += ', ' + dateMLA;
      if (url) mlaHtml += ', ' + url;
      mlaHtml += '.';

      var mlaPlain = creatorLabel + '. "' + (title || 'Title') + '." ' + platform;
      if (dateMLA) mlaPlain += ', ' + dateMLA;
      if (url) mlaPlain += ', ' + url;
      mlaPlain += '.';

      // Chicago: Creator. "Title." Platform video, Month Day, Year. URL.
      var dateChicago = '';
      if (month && day && year) dateChicago = month + ' ' + day + ', ' + year;
      else if (month && year)   dateChicago = month + ' ' + year;
      else if (year)            dateChicago = year;

      var chicagoHtml = creatorLabel + '. &quot;' + (title || 'Title') + '.&quot; <em>' + platform + '</em> video';
      if (dateChicago) chicagoHtml += ', ' + dateChicago;
      if (url) chicagoHtml += '. ' + url;
      chicagoHtml += '.';

      var chicagoPlain = creatorLabel + '. "' + (title || 'Title') + '." ' + platform + ' video';
      if (dateChicago) chicagoPlain += ', ' + dateChicago;
      if (url) chicagoPlain += '. ' + url;
      chicagoPlain += '.';

      setOutputs(apaHtml, apaPlain, mlaHtml, mlaPlain, chicagoHtml, chicagoPlain);
    }

    function generatePodcast() {
      var hostLast    = val('pod-host-last');
      var hostFirst   = val('pod-host-first');
      var epTitle     = val('pod-episode-title');
      var podName     = val('pod-podcast-name');
      var year        = val('pod-year');
      var month       = val('pod-month');
      var epNum       = val('pod-episode-num');
      var url         = val('pod-url');

      if (!hostLast && !epTitle && !podName) { setPlaceholders(); return; }

      var hostFull = hostLast && hostFirst ? hostLast + ', ' + hostFirst : (hostLast || hostFirst || 'Host');
      var hostAPA  = hostLast && hostFirst ? hostLast + ', ' + initial(hostFirst) : (hostLast || hostFirst || 'Host');

      var mabbr = monthAbbr(month);

      // APA: Host, A. A. (Year, Month). Episode title [Audio podcast episode]. In Podcast Name. URL
      var dateAPA = year && month ? year + ', ' + month : (year || 'n.d.');
      var apaHtml = hostAPA + ' (Host). (' + dateAPA + '). ';
      if (epTitle) apaHtml += epTitle + ' [Audio podcast episode]. ';
      if (podName) apaHtml += 'In <em>' + podName + '</em>.';
      if (url) apaHtml += ' ' + url;

      var apaPlain = hostAPA + ' (Host). (' + dateAPA + '). ';
      if (epTitle) apaPlain += epTitle + ' [Audio podcast episode]. ';
      if (podName) apaPlain += 'In ' + podName + '.';
      if (url) apaPlain += ' ' + url;

      // MLA: Host, First. "Episode Title." Podcast Name, no. EpNum, Month Year. URL.
      var mlaHtml = hostFull + ' (Host). &quot;' + (epTitle || 'Episode Title') + '.&quot;';
      if (podName) mlaHtml += ' <em>' + podName + '</em>';
      if (epNum) mlaHtml += ', no. ' + epNum;
      if (mabbr && year) mlaHtml += ', ' + mabbr + ' ' + year;
      else if (year) mlaHtml += ', ' + year;
      if (url) mlaHtml += '. ' + url;
      mlaHtml += '.';

      var mlaPlain = hostFull + ' (Host). "' + (epTitle || 'Episode Title') + '."';
      if (podName) mlaPlain += ' ' + podName;
      if (epNum) mlaPlain += ', no. ' + epNum;
      if (mabbr && year) mlaPlain += ', ' + mabbr + ' ' + year;
      else if (year) mlaPlain += ', ' + year;
      if (url) mlaPlain += '. ' + url;
      mlaPlain += '.';

      // Chicago: Host, First. "Episode Title." Podcast Name. Podcast audio, Month Year. URL.
      var dateChicago = mabbr && year ? mabbr + ' ' + year : (year || '');
      var chicagoHtml = hostFull + ' (Host). &quot;' + (epTitle || 'Episode Title') + '.&quot;';
      if (podName) chicagoHtml += ' <em>' + podName + '</em>.';
      chicagoHtml += ' Podcast audio';
      if (dateChicago) chicagoHtml += ', ' + dateChicago;
      if (url) chicagoHtml += '. ' + url;
      chicagoHtml += '.';

      var chicagoPlain = hostFull + ' (Host). "' + (epTitle || 'Episode Title') + '."';
      if (podName) chicagoPlain += ' ' + podName + '.';
      chicagoPlain += ' Podcast audio';
      if (dateChicago) chicagoPlain += ', ' + dateChicago;
      if (url) chicagoPlain += '. ' + url;
      chicagoPlain += '.';

      setOutputs(apaHtml, apaPlain, mlaHtml, mlaPlain, chicagoHtml, chicagoPlain);
    }

    function generateGovDoc() {
      var agency  = val('gov-agency');
      var title   = val('gov-title');
      var year    = val('gov-year');
      var pubNum  = val('gov-pub-num');
      var url     = val('gov-url');

      if (!agency && !title) { setPlaceholders(); return; }

      var agencyLabel = agency || 'Agency';

      // APA: Agency. (Year). Title. Publisher. URL
      var apaHtml = agencyLabel + '. (' + (year || 'n.d.') + '). <em>' + (title || 'Title') + '</em>.';
      if (pubNum) apaHtml += ' ' + pubNum + '.';
      if (url) apaHtml += ' ' + url;
      var apaPlain = agencyLabel + '. (' + (year || 'n.d.') + '). ' + (title || 'Title') + '.';
      if (pubNum) apaPlain += ' ' + pubNum + '.';
      if (url) apaPlain += ' ' + url;

      // MLA: Agency. Title. Publication Number, Year. URL.
      var mlaHtml = agencyLabel + '. <em>' + (title || 'Title') + '</em>.';
      if (pubNum) mlaHtml += ' ' + pubNum + ',';
      if (year) mlaHtml += ' ' + year + '.';
      if (url) mlaHtml += ' ' + url + '.';

      var mlaPlain = agencyLabel + '. ' + (title || 'Title') + '.';
      if (pubNum) mlaPlain += ' ' + pubNum + ',';
      if (year) mlaPlain += ' ' + year + '.';
      if (url) mlaPlain += ' ' + url + '.';

      // Chicago: Agency. "Title." Publication Number. Year. URL.
      var chicagoHtml = agencyLabel + '. &quot;' + (title || 'Title') + '.&quot;';
      if (pubNum) chicagoHtml += ' ' + pubNum + '.';
      if (year) chicagoHtml += ' ' + year + '.';
      if (url) chicagoHtml += ' ' + url + '.';

      var chicagoPlain = agencyLabel + '. "' + (title || 'Title') + '."';
      if (pubNum) chicagoPlain += ' ' + pubNum + '.';
      if (year) chicagoPlain += ' ' + year + '.';
      if (url) chicagoPlain += ' ' + url + '.';

      setOutputs(apaHtml, apaPlain, mlaHtml, mlaPlain, chicagoHtml, chicagoPlain);
    }

    function generateDissertation() {
      var last        = val('diss-author-last');
      var first       = val('diss-author-first');
      var title       = val('diss-title');
      var year        = val('diss-year');
      var institution = val('diss-institution');
      var dissType    = val('diss-type') || 'Doctoral dissertation';
      var url         = val('diss-url');

      if (!last && !title) { setPlaceholders(); return; }

      var authorFull = last && first ? last + ', ' + first : (last || first || 'Author');
      var authorAPA  = last && first ? last + ', ' + initial(first) : (last || first || 'Author');

      // APA: Author, A. A. (Year). Title [Doctoral dissertation, Institution]. Database/URL
      var apaHtml = authorAPA + ' (' + (year || 'n.d.') + '). <em>' + (title || 'Title') + '</em>';
      apaHtml += ' [' + dissType;
      if (institution) apaHtml += ', ' + institution;
      apaHtml += '].';
      if (url) apaHtml += ' ' + url;
      var apaPlain = authorAPA + ' (' + (year || 'n.d.') + '). ' + (title || 'Title');
      apaPlain += ' [' + dissType;
      if (institution) apaPlain += ', ' + institution;
      apaPlain += '].';
      if (url) apaPlain += ' ' + url;

      // MLA: Author. Title. Diss. Type, Institution, Year. Database.
      var mlaHtml = authorFull + '. <em>' + (title || 'Title') + '</em>.';
      mlaHtml += ' ' + dissType + ',';
      if (institution) mlaHtml += ' ' + institution + ',';
      if (year) mlaHtml += ' ' + year + '.';
      if (url) mlaHtml += ' ' + url + '.';

      var mlaPlain = authorFull + '. ' + (title || 'Title') + '.';
      mlaPlain += ' ' + dissType + ',';
      if (institution) mlaPlain += ' ' + institution + ',';
      if (year) mlaPlain += ' ' + year + '.';
      if (url) mlaPlain += ' ' + url + '.';

      // Chicago: Author. "Title." Disstype, Institution, Year. URL.
      var chicagoHtml = authorFull + '. &quot;' + (title || 'Title') + '.&quot; ' + dissType;
      if (institution) chicagoHtml += ', ' + institution;
      if (year) chicagoHtml += ', ' + year;
      chicagoHtml += '.';
      if (url) chicagoHtml += ' ' + url + '.';

      var chicagoPlain = authorFull + '. "' + (title || 'Title') + '." ' + dissType;
      if (institution) chicagoPlain += ', ' + institution;
      if (year) chicagoPlain += ', ' + year;
      chicagoPlain += '.';
      if (url) chicagoPlain += ' ' + url + '.';

      setOutputs(apaHtml, apaPlain, mlaHtml, mlaPlain, chicagoHtml, chicagoPlain);
    }

    function setOutputs(apaHtml, apaPlain, mlaHtml, mlaPlain, chicagoHtml, chicagoPlain) {
      document.getElementById('output-apa').innerHTML     = apaHtml;
      document.getElementById('output-mla').innerHTML     = mlaHtml;
      document.getElementById('output-chicago').innerHTML = chicagoHtml;

      document.getElementById('output-apa').className     = 'text-sm text-stone-800 leading-relaxed min-h-10';
      document.getElementById('output-mla').className     = 'text-sm text-stone-800 leading-relaxed min-h-10';
      document.getElementById('output-chicago').className = 'text-sm text-stone-800 leading-relaxed min-h-10';

      citationPlainText.apa     = apaPlain;
      citationPlainText.mla     = mlaPlain;
      citationPlainText.chicago = chicagoPlain;
    }

    function setPlaceholders() {
      var ph = '<span class="text-stone-400 italic">Fill in the form and click Generate.</span>';
      document.getElementById('output-apa').innerHTML     = ph;
      document.getElementById('output-mla').innerHTML     = ph;
      document.getElementById('output-chicago').innerHTML = ph;
      document.getElementById('output-apa').className     = 'text-sm leading-relaxed min-h-10';
      document.getElementById('output-mla').className     = 'text-sm leading-relaxed min-h-10';
      document.getElementById('output-chicago').className = 'text-sm leading-relaxed min-h-10';
      citationPlainText = { apa: '', mla: '', chicago: '' };
    }

    function generateAll() {
      if (currentTab === 'book')           generateBook();
      else if (currentTab === 'website')   generateWebsite();
      else if (currentTab === 'journal')   generateJournal();
      else if (currentTab === 'video')     generateVideo();
      else if (currentTab === 'podcast')   generatePodcast();
      else if (currentTab === 'govdoc')    generateGovDoc();
      else if (currentTab === 'dissertation') generateDissertation();
    }

    function clearAll() {
      ALL_TABS.forEach(function(f) {
        var container = document.getElementById('form-' + f);
        if (container) {
          container.querySelectorAll('input').forEach(function(input) { input.value = ''; });
        }
      });
      setPlaceholders();
    }

    function copyCitation(style) {
      var text = citationPlainText[style];
      if (!text) { showStatus('Nothing to copy — generate a citation first.'); return; }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function() {
          showStatus(style.toUpperCase() + ' citation copied!');
        }).catch(function() { fallbackCopy(text, style); });
      } else {
        fallbackCopy(text, style);
      }
    }

    function fallbackCopy(text, style) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.top = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); showStatus(style.toUpperCase() + ' citation copied!'); }
      catch(e) { showStatus('Copy failed — please select and copy manually.'); }
      document.body.removeChild(ta);
    }

    function showStatus(msg) {
      var bar  = document.getElementById('status-bar');
      var span = document.getElementById('status-msg');
      span.textContent = msg;
      bar.classList.remove('hidden');
      clearTimeout(window._statusTimer);
      window._statusTimer = setTimeout(function() { bar.classList.add('hidden'); }, 2500);
    }

    // Auto-generate on any input change
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('input, select').forEach(function(input) {
        input.addEventListener('input', generateAll);
        input.addEventListener('change', generateAll);
      });
    });

    // ── Bibliography Builder ──
    var bibItems = [];

    function addCurrentToBib() {
      var citation = citationPlainText.apa || citationPlainText.mla || citationPlainText.chicago;
      addToBib(citation);
    }

    function addToBib(citation) {
      if (!citation || !citation.trim()) { showStatus('Generate a citation first, then add it.'); return; }
      bibItems.push(citation.trim());
      renderBib();
      document.getElementById('bib-section').classList.remove('hidden');
    }

    function removeBibItem(index) {
      bibItems.splice(index, 1);
      renderBib();
      if (!bibItems.length) document.getElementById('bib-section').classList.add('hidden');
    }

    function renderBib() {
      var el = document.getElementById('bib-list');
      if (!el) return;
      el.innerHTML = bibItems.map(function(item, i) {
        return '<div class="flex gap-2 items-start text-sm py-2 border-b border-slate-100 last:border-0">' +
          '<span class="text-slate-400 min-w-[1.5rem] text-right shrink-0">' + (i+1) + '.</span>' +
          '<span class="flex-1 text-slate-700">' + item.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</span>' +
          '<button onclick="removeBibItem(' + i + ')" class="shrink-0 text-slate-400 hover:text-red-500 text-xs px-1">✕</button>' +
          '</div>';
      }).join('');
    }

    function copyBib() {
      if (!bibItems.length) return;
      navigator.clipboard.writeText(bibItems.join('\n\n'));
      var btn = document.getElementById('copy-bib-btn');
      if (btn) { btn.textContent = 'Copied!'; setTimeout(function() { btn.textContent = 'Copy Bibliography'; }, 2000); }
    }

    window.removeBibItem = removeBibItem;
    window.copyBib = copyBib;
    window.addCurrentToBib = addCurrentToBib;

    // ── DOI Lookup ──
    async function lookupDOI(doi) {
      if (!doi || !doi.trim()) return;
      var doiLookupBtn = document.getElementById('doi-lookup-btn');
      if (doiLookupBtn) { doiLookupBtn.disabled = true; doiLookupBtn.textContent = 'Looking up...'; }
      try {
        var res = await fetch('https://api.crossref.org/works/' + encodeURIComponent(doi.trim()), {
          headers: { 'User-Agent': 'citefast.io/1.0 (mailto:info@citefast.io)' }
        });
        if (!res.ok) throw new Error('Not found');
        var data = await res.json();
        var msg = data.message;
        var title = (msg.title || [''])[0] || '';
        var authors = (msg.author || []).map(function(a) { return (a.family || '') + ', ' + ((a.given||'').charAt(0)||'') + '.'; }).join(', ');
        var year = (msg.published && msg.published['date-parts'] && msg.published['date-parts'][0] && msg.published['date-parts'][0][0]) ? String(msg.published['date-parts'][0][0]) : '';
        var journal = (msg['container-title'] && msg['container-title'][0]) || '';
        var volume = msg.volume || '';
        var issue = msg.issue || '';
        var pages = msg.page || '';
        // Fill journal form fields
        var fieldMap = { 'journal-author-last': authors.split(',')[0] || '', 'journal-author-first': '', 'journal-year': year, 'journal-article-title': title, 'journal-name': journal, 'journal-volume': volume, 'journal-issue': issue, 'journal-pages': pages };
        Object.keys(fieldMap).forEach(function(id) {
          var el = document.getElementById(id);
          if (el && fieldMap[id]) el.value = fieldMap[id];
        });
        generateAll();
        showDOISuccess('Found: "' + title.slice(0,60) + (title.length>60?'…':'') + '"');
      } catch(e) {
        showDOIError('DOI not found or CrossRef unavailable');
      } finally {
        if (doiLookupBtn) { doiLookupBtn.disabled = false; doiLookupBtn.textContent = 'Look Up DOI'; }
      }
    }

    function showDOISuccess(msg) {
      var el = document.getElementById('doi-status');
      if (el) { el.textContent = msg; el.className = 'text-xs text-green-600 mt-1'; }
    }
    function showDOIError(msg) {
      var el = document.getElementById('doi-status');
      if (el) { el.textContent = msg; el.className = 'text-xs text-red-500 mt-1'; }
    }
    window.lookupDOI = lookupDOI;
  </script>

</BaseLayout>
