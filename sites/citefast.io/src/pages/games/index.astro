---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '~/config/site.config';

if (!siteConfig.features.hasGame) return Astro.redirect('/');
const games = (await getCollection('games', ({ data }) => !data.draft));
---
<BaseLayout title="Games" description={`Games from ${siteConfig.identity.name}`}>
  <h1 class="text-4xl font-bold">Games</h1>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {games.map((g) => (
      <li class="rounded-lg border border-slate-200 bg-white p-4 hover:border-slate-400">
        <a href={`/games/${g.data.urlSlug}/`}>
          <h2 class="text-lg font-medium text-slate-900">{g.data.title}</h2>
          <p class="mt-1 text-sm text-slate-600">{g.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
