---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout
  title="Encode &amp; Decode Online — Base64, URL, HTML, SHA-256, SHA-512"
  description="Free online encoder and decoder. Base64 encode/decode, URL encode/decode, HTML entity encode, SHA-256, SHA-512 hash, ROT13, Caesar cipher, HMAC-SHA256, Hex, Binary. Runs entirely in your browser."
>

  <!-- Compact header -->
  <header class="pb-4 pt-2">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">
      Encode &amp; Decode
    </h1>
    <p class="mt-1.5 text-sm text-slate-500">
      Base64, URL, HTML entities, SHA-256, SHA-512, ROT13/Caesar, HMAC-SHA256, Hex/Binary — all client-side, nothing sent to a server.
    </p>
  </header>

  <!-- Mode tabs / toolbar -->
  <div class="flex flex-wrap gap-2 mb-3">
    <button data-mode="base64-enc" class="mode-btn rounded-md bg-slate-700 px-3.5 py-1.5 text-sm font-medium text-white transition-colors">Base64 Encode</button>
    <button data-mode="base64-dec" class="mode-btn rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Base64 Decode</button>
    <button data-mode="url-enc"    class="mode-btn rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">URL Encode</button>
    <button data-mode="url-dec"    class="mode-btn rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">URL Decode</button>
    <button data-mode="html-enc"   class="mode-btn rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">HTML Entities</button>
    <button data-mode="sha256"     class="mode-btn rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">SHA-256</button>
    <button data-mode="sha512"     class="mode-btn rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">SHA-512</button>
    <button data-mode="rot13"      class="mode-btn rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">ROT13 / Caesar</button>
    <button data-mode="hmac"       class="mode-btn rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">HMAC-SHA256</button>
    <button data-mode="hexbin"     class="mode-btn rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Hex / Binary</button>
    <div class="flex-1"></div>
    <button id="btn-process" class="rounded-md bg-slate-700 px-3.5 py-1.5 text-sm font-medium text-white hover:bg-slate-800 transition-colors">Process</button>
    <button id="btn-swap"    class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Swap &#8645;</button>
    <button id="btn-clear"   class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Clear</button>
    <button id="btn-copy"    class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Copy output</button>
  </div>

  <!-- ROT13/Caesar extra controls -->
  <div id="rot13-controls" class="hidden mb-3 flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3">
    <label class="text-xs font-semibold text-slate-600 uppercase tracking-wide">Shift:</label>
    <input type="range" id="caesar-shift" min="0" max="25" value="13" class="w-40 accent-slate-700" />
    <span id="caesar-shift-val" class="font-mono text-sm text-slate-700 w-6">13</span>
    <span id="caesar-mode-label" class="text-xs text-slate-500">(ROT13)</span>
  </div>

  <!-- HMAC extra controls -->
  <div id="hmac-controls" class="hidden mb-3 flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3">
    <label for="hmac-key" class="text-xs font-semibold text-slate-600 uppercase tracking-wide">Key:</label>
    <input type="text" id="hmac-key" class="flex-1 min-w-48 rounded-md border border-slate-300 bg-white px-3 py-1.5 font-mono text-sm focus:border-slate-500 focus:ring-1 focus:ring-slate-500" placeholder="Enter HMAC secret key" autocomplete="off" spellcheck="false" />
    <button id="btn-hmac-generate" class="rounded-md bg-slate-700 px-3.5 py-1.5 text-sm font-medium text-white hover:bg-slate-800 transition-colors">Generate</button>
  </div>

  <!-- Hex/Binary extra controls -->
  <div id="hexbin-controls" class="hidden mb-3 flex flex-wrap items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3">
    <span class="text-xs font-semibold text-slate-600 uppercase tracking-wide mr-2">Mode:</span>
    <button data-hbmode="to-hex"    class="hb-btn rounded-md bg-slate-700 px-3 py-1 text-sm font-medium text-white transition-colors">Text → Hex</button>
    <button data-hbmode="from-hex"  class="hb-btn rounded-md border border-slate-300 px-3 py-1 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Hex → Text</button>
    <button data-hbmode="to-bin"    class="hb-btn rounded-md border border-slate-300 px-3 py-1 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Text → Binary</button>
    <button data-hbmode="from-bin"  class="hb-btn rounded-md border border-slate-300 px-3 py-1 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Binary → Text</button>
  </div>

  <!-- Dual-pane editor -->
  <div class="grid gap-3 md:grid-cols-2 min-h-96">
    <div class="flex flex-col gap-1 min-h-0">
      <label for="enc-input" id="input-label" class="text-xs font-semibold uppercase tracking-wide text-slate-500">Input</label>
      <textarea
        id="enc-input"
        class="flex-1 w-full rounded-lg border border-slate-300 bg-slate-950 text-slate-100 p-4 font-mono text-sm resize-none focus:border-slate-500 focus:ring-1 focus:ring-slate-500 placeholder:text-slate-600"
        placeholder="Paste your text here"
        spellcheck="false"
        autocomplete="off"
        rows="16"
      ></textarea>
    </div>
    <div class="flex flex-col gap-1 min-h-0">
      <label for="enc-output" id="output-label" class="text-xs font-semibold uppercase tracking-wide text-slate-500">Output</label>
      <textarea
        id="enc-output"
        class="flex-1 w-full rounded-lg border border-slate-200 bg-slate-950 text-slate-100 p-4 font-mono text-sm resize-none"
        readonly
        placeholder="Result appears here"
        spellcheck="false"
        rows="16"
      ></textarea>
    </div>
  </div>

  <!-- Status bar -->
  <div id="status" class="mt-2 rounded-md px-3 py-1.5 text-sm font-medium hidden"></div>

  <!-- Keyboard hint -->
  <p class="mt-2 text-xs text-slate-400">
    <kbd class="rounded border border-slate-300 bg-slate-100 px-1 py-0.5 font-mono text-slate-600">Ctrl</kbd>
    +
    <kbd class="rounded border border-slate-300 bg-slate-100 px-1 py-0.5 font-mono text-slate-600">Enter</kbd>
    to process
  </p>

  <!-- ── Below-fold: SEO content ── -->
  <div class="mt-16 max-w-3xl space-y-10">

    <section aria-labelledby="base64-heading">
      <h2 id="base64-heading" class="text-2xl font-bold text-slate-900">Base64 encoding explained</h2>
      <div class="prose mt-4 max-w-none">
        <p>
          Base64 encodes binary data (or text) into a set of 64 ASCII characters
          (<code>A–Z</code>, <code>a–z</code>, <code>0–9</code>, <code>+</code>, <code>/</code>)
          that are safe to transmit in systems that only handle text. Each 3 bytes of input
          become 4 Base64 characters, increasing size by roughly 33%.
        </p>
        <p>Common uses:</p>
        <ul>
          <li>Embedding binary assets (images, fonts) directly in HTML, CSS, or JSON via data URLs.</li>
          <li>Encoding binary attachments in email (MIME).</li>
          <li>Transmitting binary data in JSON API responses without requiring multipart encoding.</li>
          <li>JWT headers and payloads use Base64Url (a URL-safe variant that replaces <code>+</code> with <code>-</code> and <code>/</code> with <code>_</code>).</li>
        </ul>
      </div>
    </section>

    <section aria-labelledby="url-encode-heading">
      <h2 id="url-encode-heading" class="text-2xl font-bold text-slate-900">URL encoding</h2>
      <div class="prose mt-4 max-w-none">
        <p>
          URL encoding (percent-encoding) converts characters that are not allowed in a URL into
          a <code>%XX</code> hex representation. For example, a space becomes <code>%20</code>, and
          <code>&amp;</code> becomes <code>%26</code>.
        </p>
        <p>
          Use <strong>URL Encode</strong> when you need to embed a value in a query string or path
          segment. Use <strong>URL Decode</strong> when you receive a percent-encoded value and need
          to read the original text — for example, when debugging API request logs.
        </p>
      </div>
    </section>

    <section aria-labelledby="hash-heading">
      <h2 id="hash-heading" class="text-2xl font-bold text-slate-900">SHA-256 &amp; SHA-512 hashing</h2>
      <div class="prose mt-4 max-w-none">
        <p>
          Hash functions produce a fixed-length digest from any input. The same input always produces
          the same hash, but the process is one-way — you can't reverse a hash to get the original input.
        </p>
        <ul>
          <li><strong>SHA-256</strong> — 256-bit output, part of the SHA-2 family. Used in TLS certificates, code signing, Bitcoin, and most modern cryptographic protocols.</li>
          <li><strong>SHA-512</strong> — 512-bit output. Stronger than SHA-256 but produces a longer digest. Used when hash length matters for collision resistance.</li>
        </ul>
        <p>
          Hashes are computed in your browser using the Web Crypto API — no data is transmitted.
        </p>
        <p>
          <strong>Note on MD5:</strong> MD5 is not available here. Modern browser security APIs (Web Crypto) do not support MD5 because it is cryptographically broken — collision attacks are practical and it should not be used for security purposes. Use SHA-256 or SHA-512 instead.
        </p>
      </div>
    </section>

  </div>

  <script is:inline>
    var currentMode = 'base64-enc';
    var currentHBMode = 'to-hex';
    var statusEl = document.getElementById('status');

    function showStatus(msg, type) {
      var clsMap = { error: 'bg-red-50 text-red-700 border border-red-200', success: 'bg-emerald-50 text-emerald-700 border border-emerald-200', info: 'bg-blue-50 text-blue-700 border border-blue-200' };
      statusEl.className = 'mt-2 rounded-md px-3 py-1.5 text-sm font-medium ' + (clsMap[type] || 'bg-slate-100 text-slate-700');
      statusEl.textContent = msg;
      statusEl.classList.remove('hidden');
    }

    var MODE_LABELS = {
      'base64-enc': 'Base64 Encode', 'base64-dec': 'Base64 Decode',
      'url-enc': 'URL Encode', 'url-dec': 'URL Decode',
      'html-enc': 'HTML Entities',
      'sha256': 'SHA-256 Hash', 'sha512': 'SHA-512 Hash',
      'rot13': 'ROT13 / Caesar',
      'hmac': 'HMAC-SHA256',
      'hexbin': 'Hex / Binary'
    };

    function setMode(m) {
      currentMode = m;
      document.querySelectorAll('.mode-btn').forEach(function(b) {
        if (b.dataset.mode === m) {
          b.className = 'mode-btn rounded-md bg-slate-700 px-3.5 py-1.5 text-sm font-medium text-white transition-colors';
        } else {
          b.className = 'mode-btn rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors';
        }
      });
      document.getElementById('input-label').textContent = 'Input (' + (MODE_LABELS[m] || m) + ')';
      // Show/hide extra controls
      document.getElementById('rot13-controls').classList.toggle('hidden', m !== 'rot13');
      document.getElementById('hmac-controls').classList.toggle('hidden', m !== 'hmac');
      document.getElementById('hexbin-controls').classList.toggle('hidden', m !== 'hexbin');
    }

    document.querySelectorAll('.mode-btn').forEach(function(b) {
      b.addEventListener('click', function() { setMode(b.dataset.mode); });
    });

    // ROT13/Caesar
    function rot13(str) {
      return str.replace(/[a-zA-Z]/g, function(c) {
        var b = c < 'a' ? 65 : 97;
        return String.fromCharCode(((c.charCodeAt(0) - b + 13) % 26) + b);
      });
    }
    function caesarCipher(str, shift) {
      var s = ((shift % 26) + 26) % 26;
      return str.replace(/[a-zA-Z]/g, function(c) {
        var b = c < 'a' ? 65 : 97;
        return String.fromCharCode(((c.charCodeAt(0) - b + s) % 26) + b);
      });
    }

    var shiftSlider = document.getElementById('caesar-shift');
    var shiftVal    = document.getElementById('caesar-shift-val');
    var shiftLabel  = document.getElementById('caesar-mode-label');
    shiftSlider.addEventListener('input', function() {
      shiftVal.textContent = shiftSlider.value;
      shiftLabel.textContent = shiftSlider.value === '13' ? '(ROT13)' : '(Caesar shift ' + shiftSlider.value + ')';
    });

    // HMAC
    async function generateHMAC(message, key) {
      var keyMat = await crypto.subtle.importKey('raw', new TextEncoder().encode(key),
        { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
      var sig = await crypto.subtle.sign('HMAC', keyMat, new TextEncoder().encode(message));
      return Array.from(new Uint8Array(sig)).map(function(b) { return b.toString(16).padStart(2,'0'); }).join('');
    }

    document.getElementById('btn-hmac-generate').addEventListener('click', function() {
      var val = document.getElementById('enc-input').value;
      var key = document.getElementById('hmac-key').value;
      if (!val) { showStatus('Enter a message first', 'info'); return; }
      if (!key) { showStatus('Enter an HMAC key', 'info'); return; }
      generateHMAC(val, key).then(function(hex) {
        document.getElementById('enc-output').value = hex;
        showStatus('HMAC-SHA256 generated', 'success');
      }).catch(function(e) { showStatus('HMAC error: ' + e.message, 'error'); });
    });

    // Hex/Binary
    function toHex(str) {
      return Array.from(new TextEncoder().encode(str)).map(function(b) { return b.toString(16).padStart(2,'0'); }).join(' ');
    }
    function fromHex(hex) {
      try {
        return new TextDecoder().decode(new Uint8Array(hex.replace(/\s+/g,'').match(/../g).map(function(h) { return parseInt(h,16); })));
      } catch(e) { return 'Invalid hex input'; }
    }
    function toBinary(str) {
      return Array.from(new TextEncoder().encode(str)).map(function(b) { return b.toString(2).padStart(8,'0'); }).join(' ');
    }
    function fromBinary(bin) {
      try {
        return new TextDecoder().decode(new Uint8Array(bin.split(/\s+/).filter(Boolean).map(function(b) { return parseInt(b,2); })));
      } catch(e) { return 'Invalid binary input'; }
    }

    function setHBMode(m) {
      currentHBMode = m;
      document.querySelectorAll('.hb-btn').forEach(function(b) {
        if (b.dataset.hbmode === m) {
          b.className = 'hb-btn rounded-md bg-slate-700 px-3 py-1 text-sm font-medium text-white transition-colors';
        } else {
          b.className = 'hb-btn rounded-md border border-slate-300 px-3 py-1 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors';
        }
      });
    }
    document.querySelectorAll('.hb-btn').forEach(function(b) {
      b.addEventListener('click', function() { setHBMode(b.dataset.hbmode); });
    });

    async function hashString(algo, str) {
      var buf = new TextEncoder().encode(str);
      var hashBuf = await crypto.subtle.digest(algo, buf);
      return Array.from(new Uint8Array(hashBuf)).map(function(b) { return b.toString(16).padStart(2, '0'); }).join('');
    }

    async function process() {
      var input = document.getElementById('enc-input');
      var output = document.getElementById('enc-output');
      var val = input.value;
      if (!val) { showStatus('Paste some text first', 'info'); return; }
      try {
        var result;
        if (currentMode === 'base64-enc') { result = btoa(unescape(encodeURIComponent(val))); }
        else if (currentMode === 'base64-dec') { result = decodeURIComponent(escape(atob(val))); }
        else if (currentMode === 'url-enc') { result = encodeURIComponent(val); }
        else if (currentMode === 'url-dec') { result = decodeURIComponent(val); }
        else if (currentMode === 'html-enc') { result = val.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
        else if (currentMode === 'sha256') { result = await hashString('SHA-256', val); }
        else if (currentMode === 'sha512') { result = await hashString('SHA-512', val); }
        else if (currentMode === 'rot13') {
          var shift = parseInt(document.getElementById('caesar-shift').value);
          result = shift === 13 ? rot13(val) : caesarCipher(val, shift);
        }
        else if (currentMode === 'hmac') {
          var key = document.getElementById('hmac-key').value;
          if (!key) { showStatus('Enter an HMAC key', 'info'); return; }
          result = await generateHMAC(val, key);
        }
        else if (currentMode === 'hexbin') {
          if (currentHBMode === 'to-hex')   result = toHex(val);
          else if (currentHBMode === 'from-hex') result = fromHex(val);
          else if (currentHBMode === 'to-bin')   result = toBinary(val);
          else if (currentHBMode === 'from-bin') result = fromBinary(val);
        }
        output.value = result;
        showStatus(MODE_LABELS[currentMode] + ' — done', 'success');
      } catch (e) {
        showStatus('Error: ' + e.message, 'error');
      }
    }

    document.getElementById('btn-process').addEventListener('click', process);

    document.getElementById('btn-swap').addEventListener('click', function() {
      var input = document.getElementById('enc-input');
      var output = document.getElementById('enc-output');
      input.value = output.value;
      output.value = '';
      statusEl.classList.add('hidden');
    });

    document.getElementById('btn-clear').addEventListener('click', function() {
      document.getElementById('enc-input').value = '';
      document.getElementById('enc-output').value = '';
      statusEl.classList.add('hidden');
    });

    document.getElementById('btn-copy').addEventListener('click', function() {
      var val = document.getElementById('enc-output').value;
      if (!val) { showStatus('Nothing to copy yet', 'info'); return; }
      navigator.clipboard.writeText(val).then(function() {
        showStatus('Copied to clipboard', 'success');
      }, function() {
        document.getElementById('enc-output').select();
        document.execCommand('copy');
        showStatus('Copied', 'success');
      });
    });

    document.getElementById('enc-input').addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); process(); }
    });

    setMode('base64-enc');
  </script>

</BaseLayout>
