---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '~/config/site.config';

const recentPosts = siteConfig.features.hasBlog
  ? (await getCollection('blog', ({ data }) => !data.draft))
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
      .slice(0, 6)
  : [];
---
<BaseLayout
  title="CSS Flexbox & Grid Playground — Interactive Visual Editor"
  description="Learn and build CSS Flexbox and Grid layouts with a live visual playground. Adjust properties, see results instantly, and copy the generated CSS."
>

  <!-- Hero: playground as focal point, teal/emerald gradient -->
  <section class="relative -mx-4 overflow-hidden px-4 py-14 sm:py-20">
    <div class="absolute inset-0 bg-gradient-to-br from-teal-50 via-emerald-50 to-cyan-50" aria-hidden="true" />
    <div class="absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-teal-300/20 blur-3xl" aria-hidden="true" />
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-emerald-300/15 blur-3xl" aria-hidden="true" />

    <div class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          CSS Flexbox &amp; Grid Playground
        </h1>
        <p class="mt-3 text-lg text-slate-600">
          Adjust properties, watch the layout update live, and copy the generated CSS.
          The fastest way to get Flex and Grid into muscle memory.
        </p>
      </div>

      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {[
          'Live preview as you type',
          'Generated CSS always visible',
          'Flexbox + Grid in one tool',
          'Copy-ready output',
        ].map((badge) => (
          <li class="flex items-center gap-1.5">
            <svg class="h-4 w-4 shrink-0 text-teal-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
            </svg>
            {badge}
          </li>
        ))}
      </ul>

      <!-- Playground card -->
      <div class="mx-auto mt-8 w-full max-w-3xl">
        <div class="rounded-2xl border border-teal-200/80 bg-white shadow-sm overflow-hidden">

          <!-- Tab bar -->
          <div class="flex border-b border-slate-200 bg-slate-50 px-4 pt-3 gap-1">
            <button
              id="tab-flex"
              onclick="showTab('flex')"
              class="rounded-t-lg px-5 py-2.5 text-sm font-semibold text-white bg-teal-600 border border-b-0 border-teal-200 -mb-px"
            >Flexbox</button>
            <button
              id="tab-grid"
              onclick="showTab('grid')"
              class="rounded-t-lg px-5 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 border border-b-0 border-transparent hover:border-slate-200 -mb-px transition"
            >Grid</button>
          </div>

          <div class="p-5">
            <!-- Flexbox Panel -->
            <div id="panel-flex" class="space-y-4">
              <div class="grid gap-4 md:grid-cols-3">
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 space-y-3">
                  <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide">Container</h3>
                  <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">flex-direction</label>
                    <select id="f-dir" class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400/30">
                      <option>row</option><option>row-reverse</option><option>column</option><option>column-reverse</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">justify-content</label>
                    <select id="f-justify" class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400/30">
                      <option>flex-start</option><option>center</option><option>flex-end</option><option>space-between</option><option>space-around</option><option>space-evenly</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">align-items</label>
                    <select id="f-align" class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400/30">
                      <option>stretch</option><option>flex-start</option><option>center</option><option>flex-end</option><option>baseline</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">flex-wrap</label>
                    <select id="f-wrap" class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400/30">
                      <option>nowrap</option><option>wrap</option><option>wrap-reverse</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">gap: <span id="f-gap-val">8px</span></label>
                    <input type="range" id="f-gap" min="0" max="32" value="8" class="w-full accent-teal-600" />
                  </div>

                  <!-- Item count controls -->
                  <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">Items: <span id="f-item-count">4</span></label>
                    <div class="flex gap-1">
                      <button id="f-item-minus" class="flex-1 rounded-lg border border-slate-300 bg-white py-1 text-sm font-bold text-slate-600 hover:bg-slate-100 transition">&#8722;</button>
                      <button id="f-item-plus"  class="flex-1 rounded-lg border border-slate-300 bg-white py-1 text-sm font-bold text-slate-600 hover:bg-slate-100 transition">&#43;</button>
                    </div>
                  </div>
                </div>

                <div class="md:col-span-2 rounded-xl border border-slate-200 bg-white p-4">
                  <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-2">Preview <span class="text-xs font-normal text-slate-400 normal-case">(click an item to edit it)</span></h3>
                  <div id="flex-preview" class="h-56 rounded-lg border-2 border-dashed border-teal-200 bg-teal-50/50 p-2" style="display:flex;flex-direction:row;justify-content:flex-start;align-items:stretch;flex-wrap:nowrap;gap:8px;">
                  </div>

                  <!-- Per-item control panel (hidden until item clicked) -->
                  <div id="item-panel" class="hidden mt-3 rounded-lg border border-teal-200 bg-teal-50/40 p-3">
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-xs font-bold text-teal-700 uppercase tracking-wide">Item <span id="item-panel-label">1</span> Properties</span>
                      <button id="btn-item-reset" class="text-xs text-red-500 hover:text-red-700 font-medium">Reset item</button>
                    </div>
                    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                      <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">flex-grow</label>
                        <select id="item-grow" class="w-full rounded border border-slate-300 bg-white px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-teal-400">
                          <option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option>
                        </select>
                      </div>
                      <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">flex-shrink</label>
                        <select id="item-shrink" class="w-full rounded border border-slate-300 bg-white px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-teal-400">
                          <option value="1">1</option><option value="0">0</option><option value="2">2</option>
                        </select>
                      </div>
                      <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">flex-basis</label>
                        <select id="item-basis" class="w-full rounded border border-slate-300 bg-white px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-teal-400">
                          <option value="auto">auto</option><option value="0">0</option><option value="25%">25%</option><option value="50%">50%</option><option value="100%">100%</option><option value="custom">custom…</option>
                        </select>
                      </div>
                      <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">align-self</label>
                        <select id="item-align-self" class="w-full rounded border border-slate-300 bg-white px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-teal-400">
                          <option value="auto">auto</option><option value="flex-start">flex-start</option><option value="center">center</option><option value="flex-end">flex-end</option><option value="stretch">stretch</option>
                        </select>
                      </div>
                      <div>
                        <label class="block text-xs font-medium text-slate-600 mb-1">order</label>
                        <select id="item-order" class="w-full rounded border border-slate-300 bg-white px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-teal-400">
                          <option value="-2">-2</option><option value="-1">-1</option><option value="0">0</option><option value="1">1</option><option value="2">2</option>
                        </select>
                      </div>
                      <div id="item-basis-custom-wrap" class="hidden">
                        <label class="block text-xs font-medium text-slate-600 mb-1">custom basis</label>
                        <input id="item-basis-custom" type="text" placeholder="e.g. 200px" class="w-full rounded border border-slate-300 bg-white px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-teal-400" />
                      </div>
                    </div>
                    <div class="mt-2">
                      <span class="text-xs font-medium text-slate-500">Computed CSS:</span>
                      <code id="item-css-display" class="ml-2 text-xs font-mono text-teal-700"></code>
                    </div>
                  </div>
                </div>
              </div>
              <div class="rounded-xl border border-slate-200 bg-white p-4">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide">Generated CSS</h3>
                  <div class="flex gap-2">
                    <button id="btn-copy-flex" class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-200 transition">Copy CSS</button>
                    <button id="share-btn" class="rounded-lg bg-teal-600 text-white px-3 py-1.5 text-xs font-medium hover:bg-teal-700 transition">Share URL</button>
                  </div>
                </div>
                <pre id="flex-css" class="overflow-x-auto rounded-lg bg-slate-900 p-3 text-sm text-emerald-300 font-mono"></pre>
              </div>

              <!-- Paste CSS to controls -->
              <div class="rounded-xl border border-slate-200 bg-white p-4">
                <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-2">Paste CSS to Load</h3>
                <textarea
                  id="paste-css-input"
                  class="w-full rounded-lg border border-slate-300 bg-slate-950 text-slate-100 p-3 font-mono text-xs resize-none focus:border-teal-500 focus:ring-1 focus:ring-teal-500 placeholder:text-slate-600"
                  rows="4"
                  placeholder="Paste flexbox CSS here to populate controls automatically..."
                  spellcheck="false"
                ></textarea>
              </div>
            </div>

            <!-- Grid Panel -->
            <div id="panel-grid" class="space-y-4 hidden">
              <div class="grid gap-4 md:grid-cols-3">
                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 space-y-3">
                  <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide">Container</h3>
                  <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">grid-template-columns</label>
                    <input type="text" id="g-cols" class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-teal-400/30" value="repeat(3, 1fr)" />
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">grid-template-rows</label>
                    <input type="text" id="g-rows" class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-teal-400/30" value="auto" />
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">gap: <span id="g-gap-val">8px</span></label>
                    <input type="range" id="g-gap" min="0" max="32" value="8" class="w-full accent-teal-600" />
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">justify-items</label>
                    <select id="g-justify" class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400/30">
                      <option>stretch</option><option>start</option><option>center</option><option>end</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-slate-600 mb-1">align-items</label>
                    <select id="g-align" class="w-full rounded-lg border border-slate-300 bg-white px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400/30">
                      <option>stretch</option><option>start</option><option>center</option><option>end</option>
                    </select>
                  </div>
                </div>
                <div class="md:col-span-2 rounded-xl border border-slate-200 bg-white p-4">
                  <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-2">Preview</h3>
                  <div id="grid-preview" class="h-56 rounded-lg border-2 border-dashed border-teal-200 bg-teal-50/50 p-2" style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
                    <div class="rounded-lg bg-teal-500 text-white font-bold text-sm flex items-center justify-center" style="min-height:36px;">1</div>
                    <div class="rounded-lg bg-emerald-500 text-white font-bold text-sm flex items-center justify-center" style="min-height:36px;">2</div>
                    <div class="rounded-lg bg-cyan-500 text-white font-bold text-sm flex items-center justify-center" style="min-height:36px;">3</div>
                    <div class="rounded-lg bg-violet-500 text-white font-bold text-sm flex items-center justify-center" style="min-height:36px;">4</div>
                    <div class="rounded-lg bg-amber-500 text-white font-bold text-sm flex items-center justify-center" style="min-height:36px;">5</div>
                    <div class="rounded-lg bg-rose-500 text-white font-bold text-sm flex items-center justify-center" style="min-height:36px;">6</div>
                  </div>
                </div>
              </div>
              <div class="rounded-xl border border-slate-200 bg-white p-4">
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wide">Generated CSS</h3>
                  <button id="btn-copy-grid" class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-200 transition">Copy</button>
                </div>
                <pre id="grid-css" class="overflow-x-auto rounded-lg bg-slate-900 p-3 text-sm text-emerald-300 font-mono"></pre>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational content -->
  <section class="mt-16" aria-labelledby="flex-vs-grid-heading">
    <h2 id="flex-vs-grid-heading" class="text-2xl font-bold text-slate-900">Flexbox vs Grid — When to Use Which</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <h3 class="text-lg font-semibold text-teal-700">Use Flexbox when…</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li class="flex gap-2"><span class="text-teal-500 mt-0.5">&#8594;</span>Layout flows in <strong>one dimension</strong> (row or column)</li>
          <li class="flex gap-2"><span class="text-teal-500 mt-0.5">&#8594;</span>You need items to <strong>shrink or grow</strong> based on available space</li>
          <li class="flex gap-2"><span class="text-teal-500 mt-0.5">&#8594;</span>Aligning items in a <strong>nav bar or toolbar</strong></li>
          <li class="flex gap-2"><span class="text-teal-500 mt-0.5">&#8594;</span><strong>Centering</strong> a single element inside a container</li>
          <li class="flex gap-2"><span class="text-teal-500 mt-0.5">&#8594;</span>Cards in a <strong>wrapping row</strong> where items can be different widths</li>
        </ul>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <h3 class="text-lg font-semibold text-emerald-700">Use Grid when…</h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li class="flex gap-2"><span class="text-emerald-500 mt-0.5">&#8594;</span>Layout spans <strong>two dimensions</strong> (rows AND columns)</li>
          <li class="flex gap-2"><span class="text-emerald-500 mt-0.5">&#8594;</span>You want items to align to a <strong>fixed column track</strong></li>
          <li class="flex gap-2"><span class="text-emerald-500 mt-0.5">&#8594;</span>Building a <strong>page-level layout</strong> with header, sidebar, main, footer</li>
          <li class="flex gap-2"><span class="text-emerald-500 mt-0.5">&#8594;</span>Items need to <strong>span multiple rows or columns</strong></li>
          <li class="flex gap-2"><span class="text-emerald-500 mt-0.5">&#8594;</span>A <strong>photo gallery</strong> or card grid where all cells must align</li>
        </ul>
      </div>
    </div>
    <p class="mt-4 text-sm text-slate-600 bg-slate-50 rounded-xl border border-slate-200 px-5 py-4">
      <strong>The real answer:</strong> use both. A Grid for the outer page structure, Flexbox inside each grid cell for content alignment. They complement, not compete with, each other.
    </p>
  </section>

  <section class="mt-12" aria-labelledby="flex-cheatsheet-heading">
    <h2 id="flex-cheatsheet-heading" class="text-2xl font-bold text-slate-900">Flexbox Cheat Sheet</h2>
    <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-slate-50 text-left">
            <th class="px-4 py-3 font-semibold text-slate-700">Property</th>
            <th class="px-4 py-3 font-semibold text-slate-700">Values</th>
            <th class="hidden px-4 py-3 font-semibold text-slate-700 sm:table-cell">Effect</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {([
            { prop: 'display: flex', values: '—', effect: 'Turns the element into a flex container.' },
            { prop: 'flex-direction', values: 'row | column | row-reverse | column-reverse', effect: 'Direction of the main axis.' },
            { prop: 'justify-content', values: 'flex-start | center | flex-end | space-between | space-around | space-evenly', effect: 'Alignment along the main axis.' },
            { prop: 'align-items', values: 'stretch | flex-start | center | flex-end | baseline', effect: 'Alignment along the cross axis.' },
            { prop: 'flex-wrap', values: 'nowrap | wrap | wrap-reverse', effect: 'Whether items wrap to the next line.' },
            { prop: 'gap', values: '<length>', effect: 'Space between flex items (row-gap and column-gap).' },
            { prop: 'flex: 1', values: '1 1 0%', effect: 'Item grows to fill space and shrinks as needed.' },
          ] as const).map((row) => (
            <tr class="bg-white hover:bg-slate-50">
              <td class="px-4 py-3 font-mono text-xs text-slate-900">{row.prop}</td>
              <td class="px-4 py-3 font-mono text-xs text-slate-600">{row.values}</td>
              <td class="hidden px-4 py-3 text-slate-500 sm:table-cell">{row.effect}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {recentPosts.length > 0 && (
    <section class="mt-16" aria-labelledby="articles-heading">
      <h2 id="articles-heading" class="text-2xl font-bold text-slate-900">Latest Articles</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {recentPosts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}/`}
              class="group block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-teal-400/40 hover:shadow-sm"
            >
              <time
                datetime={post.data.publishDate.toISOString()}
                class="text-xs font-medium uppercase tracking-wide text-slate-400"
              >
                {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <h3 class="mt-1 text-base font-semibold text-slate-900 group-hover:text-teal-700">{post.data.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm text-slate-600">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <footer class="mt-16 border-t border-slate-200 pt-8 text-sm text-slate-500">
    <span>Content last reviewed: <time datetime="2026-04-25">April 25, 2026</time>.</span>
  </footer>

</BaseLayout>

<script is:inline>
  // ── Item colors ──
  var ITEM_COLORS = ['bg-teal-500','bg-emerald-500','bg-cyan-500','bg-violet-500','bg-amber-500','bg-rose-500','bg-blue-500','bg-pink-500','bg-orange-500','bg-lime-500','bg-indigo-500','bg-fuchsia-500'];
  var COLOR_STYLES = ['background:#14b8a6','background:#10b981','background:#06b6d4','background:#8b5cf6','background:#f59e0b','background:#f43f5e','background:#3b82f6','background:#ec4899','background:#f97316','background:#84cc16','background:#6366f1','background:#a855f7'];

  // ── Flex items state ──
  var flexItemCount = 4;
  var flexItemStyles = {}; // keyed by 1-based index

  var selectedItem = null; // 1-based index

  function getItemStyle(i) {
    return flexItemStyles[i] || { grow: '0', shrink: '1', basis: 'auto', alignSelf: 'auto', order: '0' };
  }

  function buildFlexItem(i) {
    var el = document.createElement('div');
    var colorStyle = COLOR_STYLES[(i - 1) % COLOR_STYLES.length];
    el.style.cssText = colorStyle + ';border-radius:0.5rem;color:white;font-weight:700;font-size:0.875rem;display:flex;align-items:center;justify-content:center;min-width:48px;min-height:48px;cursor:pointer;transition:outline 0.1s;user-select:none;';
    el.dataset.itemIndex = i;
    el.textContent = i;
    applyItemStyleToEl(el, i);
    el.addEventListener('click', function() { selectItem(i, el); });
    return el;
  }

  function applyItemStyleToEl(el, i) {
    var s = getItemStyle(i);
    el.style.flexGrow    = s.grow;
    el.style.flexShrink  = s.shrink;
    el.style.flexBasis   = s.basis;
    el.style.alignSelf   = s.alignSelf;
    el.style.order       = s.order;
  }

  function renderFlexItems() {
    var preview = document.getElementById('flex-preview');
    preview.innerHTML = '';
    for (var i = 1; i <= flexItemCount; i++) {
      preview.appendChild(buildFlexItem(i));
    }
    // Deselect if selected item no longer exists
    if (selectedItem && selectedItem > flexItemCount) {
      selectedItem = null;
      document.getElementById('item-panel').classList.add('hidden');
    }
    document.getElementById('f-item-count').textContent = flexItemCount;
    updateFlexCSS();
  }

  function selectItem(i, el) {
    // Deselect previous
    document.querySelectorAll('#flex-preview > div').forEach(function(d) {
      d.style.outline = '';
    });
    if (selectedItem === i) {
      // Toggle off
      selectedItem = null;
      document.getElementById('item-panel').classList.add('hidden');
      return;
    }
    selectedItem = i;
    el.style.outline = '3px solid #0d9488';
    document.getElementById('item-panel').classList.remove('hidden');
    document.getElementById('item-panel-label').textContent = i;

    var s = getItemStyle(i);
    document.getElementById('item-grow').value = s.grow;
    document.getElementById('item-shrink').value = s.shrink;

    var basisSel = document.getElementById('item-basis');
    var knownVals = ['auto','0','25%','50%','100%'];
    if (knownVals.indexOf(s.basis) !== -1) {
      basisSel.value = s.basis;
      document.getElementById('item-basis-custom-wrap').classList.add('hidden');
    } else {
      basisSel.value = 'custom';
      document.getElementById('item-basis-custom').value = s.basis;
      document.getElementById('item-basis-custom-wrap').classList.remove('hidden');
    }
    document.getElementById('item-align-self').value = s.alignSelf;
    document.getElementById('item-order').value = s.order;
    updateItemCSSDisplay();
  }

  function updateItemCSSDisplay() {
    if (!selectedItem) return;
    var s = getItemStyle(selectedItem);
    var parts = [];
    if (s.grow !== '0')      parts.push('flex-grow: ' + s.grow);
    if (s.shrink !== '1')    parts.push('flex-shrink: ' + s.shrink);
    if (s.basis !== 'auto')  parts.push('flex-basis: ' + s.basis);
    if (s.alignSelf !== 'auto') parts.push('align-self: ' + s.alignSelf);
    if (s.order !== '0')     parts.push('order: ' + s.order);
    document.getElementById('item-css-display').textContent = parts.length ? parts.join('; ') + ';' : '(defaults)';
  }

  function applyItemPanelToSelected() {
    if (!selectedItem) return;
    var basisSel = document.getElementById('item-basis');
    var basis = basisSel.value;
    if (basis === 'custom') {
      basis = document.getElementById('item-basis-custom').value.trim() || 'auto';
    }
    flexItemStyles[selectedItem] = {
      grow: document.getElementById('item-grow').value,
      shrink: document.getElementById('item-shrink').value,
      basis: basis,
      alignSelf: document.getElementById('item-align-self').value,
      order: document.getElementById('item-order').value,
    };
    // Apply to DOM element
    var el = document.querySelector('#flex-preview > div[data-item-index="' + selectedItem + '"]');
    if (el) applyItemStyleToEl(el, selectedItem);
    updateItemCSSDisplay();
    updateFlexCSS();
  }

  document.getElementById('item-basis').addEventListener('change', function() {
    var isCustom = this.value === 'custom';
    document.getElementById('item-basis-custom-wrap').classList.toggle('hidden', !isCustom);
    applyItemPanelToSelected();
  });
  document.getElementById('item-basis-custom').addEventListener('input', applyItemPanelToSelected);
  ['item-grow','item-shrink','item-align-self','item-order'].forEach(function(id) {
    document.getElementById(id).addEventListener('change', applyItemPanelToSelected);
  });

  document.getElementById('btn-item-reset').addEventListener('click', function() {
    if (!selectedItem) return;
    delete flexItemStyles[selectedItem];
    var el = document.querySelector('#flex-preview > div[data-item-index="' + selectedItem + '"]');
    if (el) applyItemStyleToEl(el, selectedItem);
    // Re-select to refresh panel
    selectItem(selectedItem, el);
    updateFlexCSS();
  });

  // ── Item count buttons ──
  document.getElementById('f-item-minus').addEventListener('click', function() {
    if (flexItemCount > 1) { flexItemCount--; renderFlexItems(); }
  });
  document.getElementById('f-item-plus').addEventListener('click', function() {
    if (flexItemCount < 12) { flexItemCount++; renderFlexItems(); }
  });

  // ── Tab switching ──
  function showTab(t) {
    var isFlex = t === 'flex';
    document.getElementById('panel-flex').classList.toggle('hidden', !isFlex);
    document.getElementById('panel-grid').classList.toggle('hidden', isFlex);
    var ft = document.getElementById('tab-flex');
    var gt = document.getElementById('tab-grid');
    if (isFlex) {
      ft.className = 'rounded-t-lg px-5 py-2.5 text-sm font-semibold text-white bg-teal-600 border border-b-0 border-teal-200 -mb-px';
      gt.className = 'rounded-t-lg px-5 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 border border-b-0 border-transparent hover:border-slate-200 -mb-px transition';
    } else {
      gt.className = 'rounded-t-lg px-5 py-2.5 text-sm font-semibold text-white bg-teal-600 border border-b-0 border-teal-200 -mb-px';
      ft.className = 'rounded-t-lg px-5 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 border border-b-0 border-transparent hover:border-slate-200 -mb-px transition';
    }
  }

  function updateFlexCSS() {
    var dir     = document.getElementById('f-dir').value;
    var justify = document.getElementById('f-justify').value;
    var align   = document.getElementById('f-align').value;
    var wrap    = document.getElementById('f-wrap').value;
    var gap     = document.getElementById('f-gap').value;

    var lines = [
      '.container {',
      '  display: flex;',
      '  flex-direction: ' + dir + ';',
      '  justify-content: ' + justify + ';',
      '  align-items: ' + align + ';',
      '  flex-wrap: ' + wrap + ';',
      '  gap: ' + gap + 'px;',
      '}'
    ];

    // Append per-item CSS for any customized items
    for (var i = 1; i <= flexItemCount; i++) {
      if (flexItemStyles[i]) {
        var s = flexItemStyles[i];
        var itemLines = ['.item-' + i + ' {'];
        if (s.grow !== '0')      itemLines.push('  flex-grow: ' + s.grow + ';');
        if (s.shrink !== '1')    itemLines.push('  flex-shrink: ' + s.shrink + ';');
        if (s.basis !== 'auto')  itemLines.push('  flex-basis: ' + s.basis + ';');
        if (s.alignSelf !== 'auto') itemLines.push('  align-self: ' + s.alignSelf + ';');
        if (s.order !== '0')     itemLines.push('  order: ' + s.order + ';');
        itemLines.push('}');
        if (itemLines.length > 2) lines = lines.concat(['', '/* Item ' + i + ' */'], itemLines);
      }
    }

    document.getElementById('flex-css').textContent = lines.join('\n');
  }

  function updateFlex() {
    var p = document.getElementById('flex-preview');
    var dir = document.getElementById('f-dir').value;
    var justify = document.getElementById('f-justify').value;
    var align = document.getElementById('f-align').value;
    var wrap = document.getElementById('f-wrap').value;
    var gap = document.getElementById('f-gap').value;
    document.getElementById('f-gap-val').textContent = gap + 'px';
    p.style.flexDirection = dir;
    p.style.justifyContent = justify;
    p.style.alignItems = align;
    p.style.flexWrap = wrap;
    p.style.gap = gap + 'px';
    updateFlexCSS();
  }

  ['f-dir','f-justify','f-align','f-wrap','f-gap'].forEach(function(id) {
    document.getElementById(id).addEventListener('input', updateFlex);
  });
  function updateGrid() {
    var p = document.getElementById('grid-preview');
    var cols = document.getElementById('g-cols').value;
    var rows = document.getElementById('g-rows').value;
    var gap = document.getElementById('g-gap').value;
    var justify = document.getElementById('g-justify').value;
    var align = document.getElementById('g-align').value;
    document.getElementById('g-gap-val').textContent = gap + 'px';
    p.style.gridTemplateColumns = cols;
    p.style.gridTemplateRows = rows;
    p.style.gap = gap + 'px';
    p.style.justifyItems = justify;
    p.style.alignItems = align;
    document.getElementById('grid-css').textContent = [
      '.container {',
      '  display: grid;',
      '  grid-template-columns: ' + cols + ';',
      '  grid-template-rows: ' + rows + ';',
      '  gap: ' + gap + 'px;',
      '  justify-items: ' + justify + ';',
      '  align-items: ' + align + ';',
      '}'
    ].join('\n');
  }
  ['g-cols','g-rows','g-gap','g-justify','g-align'].forEach(function(id) {
    document.getElementById(id).addEventListener('input', updateGrid);
  });
  document.getElementById('btn-copy-grid').addEventListener('click', function() {
    navigator.clipboard.writeText(document.getElementById('grid-css').textContent);
  });

  document.getElementById('tab-flex').addEventListener('click', function() { showTab('flex'); });
  document.getElementById('tab-grid').addEventListener('click', function() { showTab('grid'); });

  // Initial render
  renderFlexItems();
  updateFlex();
  updateGrid();

  // ── Share URL / Load from URL ──
  function encodeFlexState() {
    var state = {};
    var controls = [
      ['f-dir',     'flexDirection'],
      ['f-wrap',    'flexWrap'],
      ['f-justify', 'justifyContent'],
      ['f-align',   'alignItems'],
      ['f-gap',     'gap'],
    ];
    controls.forEach(function(pair) {
      var el = document.getElementById(pair[0]);
      if (el) state[pair[1]] = el.value;
    });
    state.n = String(flexItemCount);
    return new URLSearchParams(state).toString();
  }

  function loadFlexFromURL() {
    var params = new URLSearchParams(location.search);
    var map = {
      flexDirection:  'f-dir',
      flexWrap:       'f-wrap',
      justifyContent: 'f-justify',
      alignItems:     'f-align',
      gap:            'f-gap',
    };
    params.forEach(function(value, key) {
      if (key === 'n') {
        var n = parseInt(value);
        if (n >= 1 && n <= 12) { flexItemCount = n; }
      } else if (map[key]) {
        var el = document.getElementById(map[key]);
        if (el) el.value = value;
      }
    });
    if (params.toString()) {
      updateFlex();
      renderFlexItems();
    }
  }

  loadFlexFromURL();

  document.getElementById('share-btn').addEventListener('click', function() {
    var url = location.origin + location.pathname + '?' + encodeFlexState();
    var btn = document.getElementById('share-btn');
    navigator.clipboard.writeText(url).then(function() {
      btn.textContent = 'Copied!';
      setTimeout(function() { btn.textContent = 'Share URL'; }, 2000);
    }, function() {
      btn.textContent = 'Copy failed';
      setTimeout(function() { btn.textContent = 'Share URL'; }, 2000);
    });
  });

  // ── Copy CSS button update ──
  document.getElementById('btn-copy-flex').addEventListener('click', function() {
    var text = document.getElementById('flex-css').textContent;
    navigator.clipboard.writeText(text).then(function() {
      var btn = document.getElementById('btn-copy-flex');
      btn.textContent = 'Copied!';
      setTimeout(function() { btn.textContent = 'Copy CSS'; }, 2000);
    });
  });

  // ── Paste CSS to controls ──
  function parseCSSIntoControls(css) {
    function get(prop) {
      var m = css.match(new RegExp(prop + '\\s*:\\s*([^;\\n]+)'));
      return m ? m[1].trim() : null;
    }
    var map = [
      ['flex-direction',  'f-dir'],
      ['flex-wrap',       'f-wrap'],
      ['justify-content', 'f-justify'],
      ['align-items',     'f-align'],
    ];
    map.forEach(function(pair) {
      var val = get(pair[0]);
      if (val) {
        var el = document.getElementById(pair[1]);
        if (el) { el.value = val; el.dispatchEvent(new Event('input')); }
      }
    });
    var gapVal = get('gap');
    if (gapVal) {
      var gapNum = parseInt(gapVal);
      if (!isNaN(gapNum)) {
        var gapEl = document.getElementById('f-gap');
        if (gapEl) { gapEl.value = String(Math.min(32, Math.max(0, gapNum))); gapEl.dispatchEvent(new Event('input')); }
      }
    }
  }

  document.getElementById('paste-css-input').addEventListener('input', function() {
    if (this.value.trim()) {
      parseCSSIntoControls(this.value);
    }
  });
</script>
