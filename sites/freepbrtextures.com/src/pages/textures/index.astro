---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
import { getCollection } from 'astro:content';

const allTextures = (await getCollection('textures', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const categories = [...new Set(allTextures.map(t => t.data.category))].sort();

const categoryLabels: Record<string, string> = {
  wood: 'Wood', stone: 'Stone', metal: 'Metal', concrete: 'Concrete',
  fabric: 'Fabric', brick: 'Brick', marble: 'Marble', leather: 'Leather',
  grass: 'Grass', dirt: 'Dirt', sand: 'Sand', asphalt: 'Asphalt',
  tile: 'Tile', carpet: 'Carpet',
};

function getTextureColorTag(name: string, tags: string[]): string {
  const text = (name + ' ' + tags.join(' ')).toLowerCase();
  if (/wood|sand|stone|brick|rust|copper|terra|clay|warm/.test(text)) return 'warm';
  if (/concrete|metal|steel|ice|water|slate|blue|gray|silver|cold/.test(text)) return 'cool';
  if (/carbon|coal|dark|black|night|obsidian/.test(text)) return 'dark';
  if (/marble|snow|white|light|cream|alabaster/.test(text)) return 'light';
  if (/gravel|asphalt|plaster|beige|neutral|ground/.test(text)) return 'neutral';
  return 'neutral';
}

// Serialize texture data for client-side filtering
const texturesData = allTextures.map(t => ({
  category: t.data.category,
  urlSlug: t.data.urlSlug,
  title: t.data.title,
  resolution: t.data.resolution,
  preview: t.data.preview,
  colorTag: getTextureColorTag(t.data.title, t.data.tags || []),
}));
---
<BaseLayout title="Browse Textures" description="Browse all free PBR textures by category, resolution, and more.">
  <div class="flex flex-col lg:flex-row gap-8">
    <!-- Sidebar Filters -->
    <aside class="lg:w-64 flex-shrink-0">
      <div class="rounded-lg border border-slate-700 bg-slate-800 p-6 sticky top-20">
        <h2 class="text-white font-semibold mb-4">Filters</h2>
        <h3 class="text-slate-400 text-sm font-medium mb-2 uppercase tracking-wide">Category</h3>
        <ul id="category-filters" class="space-y-1 mb-6">
          <li>
            <a href="/textures/" data-cat="" class="text-sm hover:text-amber-400 text-amber-400 font-medium">
              All ({allTextures.length})
            </a>
          </li>
          {categories.map(cat => (
            <li>
              <a href={`/textures/?category=${cat}`} data-cat={cat} class="text-sm hover:text-amber-400 text-slate-300">
                {categoryLabels[cat] || cat} ({allTextures.filter(t => t.data.category === cat).length})
              </a>
            </li>
          ))}
        </ul>
        <h3 class="text-slate-400 text-sm font-medium mb-2 mt-6 uppercase tracking-wide">Color Palette</h3>
        <div id="color-filter-btns" class="flex flex-wrap gap-1.5 mb-4">
          <button data-color="" class="color-filter-btn text-xs px-2 py-1 rounded-full border border-amber-400 bg-amber-400/20 text-amber-300 font-medium">All</button>
          <button data-color="warm" class="color-filter-btn text-xs px-2 py-1 rounded-full border border-slate-600 text-slate-400 hover:border-amber-400 hover:text-amber-300">Warm</button>
          <button data-color="cool" class="color-filter-btn text-xs px-2 py-1 rounded-full border border-slate-600 text-slate-400 hover:border-amber-400 hover:text-amber-300">Cool</button>
          <button data-color="neutral" class="color-filter-btn text-xs px-2 py-1 rounded-full border border-slate-600 text-slate-400 hover:border-amber-400 hover:text-amber-300">Neutral</button>
          <button data-color="dark" class="color-filter-btn text-xs px-2 py-1 rounded-full border border-slate-600 text-slate-400 hover:border-amber-400 hover:text-amber-300">Dark</button>
          <button data-color="light" class="color-filter-btn text-xs px-2 py-1 rounded-full border border-slate-600 text-slate-400 hover:border-amber-400 hover:text-amber-300">Light</button>
        </div>
        <h3 class="text-slate-400 text-sm font-medium mb-2 uppercase tracking-wide">Resolution</h3>
        <ul class="space-y-1">
          <li><span class="text-sm text-slate-300">4K (4096 x 4096)</span></li>
        </ul>
        <h3 class="text-slate-400 text-sm font-medium mb-2 mt-6 uppercase tracking-wide">License</h3>
        <ul class="space-y-1">
          <li><span class="text-sm text-slate-300">CC0 (Public Domain)</span></li>
        </ul>
      </div>
    </aside>

    <!-- Texture Grid -->
    <div class="flex-1">
      <div class="flex items-center justify-between mb-6">
        <h1 id="grid-title" class="text-2xl font-bold text-white">All Textures</h1>
        <span id="grid-count" class="text-slate-400 text-sm">{allTextures.length} textures</span>
      </div>
      <div id="texture-grid" class="texture-grid">
        {texturesData.map(t => (
          <div class="texture-item" data-category={t.category} data-color={t.colorTag}>
            <a href={`/textures/${t.category}/${t.urlSlug}/`} class="group relative rounded-lg border border-slate-700 bg-slate-800 hover:border-amber-400 transition-colors overflow-hidden block texture-card-link">
              <div class="aspect-square overflow-hidden bg-slate-900">
                <img src={t.preview} alt={t.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200 texture-thumb" loading="lazy" />
              </div>
              <div class="p-4">
                <h3 class="text-white font-medium text-sm truncate">{t.title}</h3>
                <div class="flex items-center justify-between mt-2">
                  <span class="text-slate-400 text-xs capitalize">{t.category}</span>
                  <span class="text-slate-500 text-xs">{t.resolution}</span>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
      <div id="no-results" class="text-center text-slate-400 py-12 hidden">
        No textures found in this category yet. Check back soon!
      </div>
      <div id="batch-download-note" class="hidden mt-6 rounded-lg border border-slate-700 bg-slate-800/50 p-4 text-sm text-slate-400">
        <strong class="text-slate-300">Batch Download:</strong> To download all textures in this category, right-click each image and choose &ldquo;Save image as&rdquo;, or use a browser download extension such as DownThemAll. Individual download links are available on each texture page.
      </div>
    </div>
  </div>

  <script>
    // Client-side category + color filtering
    const urlParams = new URLSearchParams(window.location.search);
    let filterCat: string | null = urlParams.get('category');
    let filterColor: string = '';

    function applyFilter() {
      const cat = filterCat;
      const color = filterColor;
      const items = document.querySelectorAll<HTMLElement>('.texture-item');
      let visible = 0;
      items.forEach(item => {
        const showCat = !cat || item.dataset.category === cat;
        const showColor = !color || item.dataset.color === color;
        const show = showCat && showColor;
        item.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      const title = document.getElementById('grid-title');
      const count = document.getElementById('grid-count');
      const noResults = document.getElementById('no-results');

      if (title) {
        if (cat) {
          const labels: Record<string, string> = {wood:'Wood',stone:'Stone',metal:'Metal',concrete:'Concrete',fabric:'Fabric',brick:'Brick',marble:'Marble',leather:'Leather'};
          title.textContent = (labels[cat] || cat) + ' Textures';
        } else {
          title.textContent = 'All Textures';
        }
      }
      if (count) count.textContent = visible + ' textures';
      if (noResults) noResults.classList.toggle('hidden', visible > 0);
      const batchNote = document.getElementById('batch-download-note');
      if (batchNote) batchNote.classList.toggle('hidden', !cat);

      // Update category link styles
      const links = document.querySelectorAll<HTMLAnchorElement>('#category-filters a[data-cat]');
      links.forEach(link => {
        const isActive = link.dataset.cat === (cat || '');
        link.classList.toggle('text-amber-400', isActive);
        link.classList.toggle('font-medium', isActive);
        link.classList.toggle('text-slate-300', !isActive);
      });

      // Update color button styles
      document.querySelectorAll<HTMLButtonElement>('.color-filter-btn').forEach(btn => {
        const isActive = btn.dataset.color === color;
        btn.classList.toggle('border-amber-400', isActive);
        btn.classList.toggle('bg-amber-400/20', isActive);
        btn.classList.toggle('text-amber-300', isActive);
        btn.classList.toggle('border-slate-600', !isActive);
        btn.classList.toggle('text-slate-400', !isActive);
      });
    }

    applyFilter();

    // Category links push state
    document.querySelectorAll<HTMLAnchorElement>('#category-filters a[data-cat]').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        filterCat = link.dataset.cat || null;
        history.pushState({}, '', filterCat ? `?category=${filterCat}` : '/textures/');
        applyFilter();
      });
    });

    // Color filter buttons
    document.querySelectorAll<HTMLButtonElement>('.color-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        filterColor = btn.dataset.color || '';
        applyFilter();
      });
    });

    // Sphere preview on hover
    function getTextureUrl(card: HTMLElement): string {
      const img = card.querySelector<HTMLImageElement>('.texture-thumb');
      return img ? img.src : '';
    }

    document.querySelectorAll<HTMLElement>('.texture-card-link').forEach(card => {
      let sphereEl: HTMLDivElement | null = null;
      card.addEventListener('mouseenter', () => {
        const url = getTextureUrl(card);
        if (!url) return;
        sphereEl = document.createElement('div');
        sphereEl.style.cssText = `
          position:absolute; top:4px; right:4px; width:60px; height:60px;
          border-radius:50%; z-index:10; pointer-events:none;
          background-image:url(${url}); background-size:200%;
          box-shadow: inset -12px -12px 24px rgba(0,0,0,0.6), inset 6px 6px 12px rgba(255,255,255,0.25);
        `;
        const parent = card.parentElement;
        if (parent) {
          parent.style.position = 'relative';
          parent.appendChild(sphereEl);
        }
      });
      card.addEventListener('mouseleave', () => {
        if (sphereEl) { sphereEl.remove(); sphereEl = null; }
      });
    });
  </script>
</BaseLayout>
