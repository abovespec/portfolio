---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const allTextures = await getCollection('textures', ({ data }) => !data.draft);
---
<BaseLayout title="Free Unreal Textures" description="Download free CC0 PBR textures for Unreal. Seamless 4K textures, ready to use.">
  <h1 class="text-3xl font-bold text-white mb-4">Free Unreal Textures</h1>
  <p class="text-slate-300 text-lg mb-8 max-w-2xl">All textures on FreePBRTextures are CC0 licensed and compatible with Unreal. Import the albedo, normal, and roughness maps directly into your Unreal project.</p>
  <div class="rounded-lg border border-slate-700 bg-slate-800 p-6 mb-8">
    <h2 class="text-xl font-semibold text-white mb-3">How to Use in Unreal</h2>
    <ol class="text-slate-400 space-y-2 list-decimal list-inside">
      <li>Download the texture maps (albedo, normal, roughness).</li>
      <li>Create a new Material in Unreal.</li>
      <li>Assign the albedo map to the <strong>Base Color</strong> input.</li>
      <li>Assign the normal map to the <strong>Normal</strong> input.</li>
      <li>Assign the roughness map to the <strong>Roughness</strong> input.</li>
    </ol>
  </div>
  <a href="/textures/" class="px-6 py-3 bg-amber-500 hover:bg-amber-400 text-slate-900 font-semibold rounded-lg transition-colors inline-block">Browse All Textures</a>
</BaseLayout>
