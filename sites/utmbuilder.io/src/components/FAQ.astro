---
import SchemaFAQ, { type FAQItem } from './SchemaFAQ.astro';

interface Props {
  items: FAQItem[];
  heading?: string;
  headingLevel?: 2 | 3;
}
const { items, heading = 'Frequently asked questions', headingLevel = 2 } = Astro.props;
const Tag = `h${headingLevel}` as 'h2' | 'h3';
---
<section class="my-12">
  <Tag class="text-2xl font-semibold mb-4">{heading}</Tag>
  <div class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
    {items.map((item) => (
      <details class="group p-4">
        <summary class="flex cursor-pointer items-center justify-between gap-4 text-base font-medium text-slate-900 list-none">
          <span>{item.question}</span>
          <span aria-hidden="true" class="transition-transform group-open:rotate-45 text-xl leading-none">+</span>
        </summary>
        <div class="mt-3 text-slate-700 leading-relaxed">{item.answer}</div>
      </details>
    ))}
  </div>
</section>
<SchemaFAQ items={items} />
