---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout
  title="UTM Builder — Free UTM Link Generator for Campaign Tracking"
  description="Free UTM link builder. Generate campaign-tracked URLs with utm_source, utm_medium, utm_campaign, utm_term, and utm_content parameters. Runs in your browser."
>

  <!-- Compact header -->
  <header class="pb-4 pt-2">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">
      UTM Link Builder
    </h1>
    <p class="mt-1.5 text-sm text-slate-500">
      Build campaign-tracked URLs with UTM parameters. History saved in your browser — nothing sent to any server.
    </p>
  </header>

  <!-- Toolbar -->
  <div class="flex flex-wrap gap-2 mb-3">
    <button id="btn-sample" class="rounded-md bg-orange-600 px-3.5 py-1.5 text-sm font-medium text-white hover:bg-orange-700 transition-colors">Load example</button>
    <div class="flex-1"></div>
    <button id="btn-clear-history" class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Clear history</button>
  </div>

  <!-- Campaign Presets -->
  <div class="mb-4 rounded-lg border border-slate-200 bg-slate-50 p-4">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2.5">Campaign Presets</p>
    <div class="flex flex-wrap gap-2" id="preset-buttons">
      <!-- Rendered by JS -->
    </div>
  </div>

  <!-- Dual-pane: form left | output right -->
  <div class="grid gap-3 md:grid-cols-2 min-h-96">

    <!-- Input pane -->
    <div class="flex flex-col gap-3 rounded-lg border border-slate-200 bg-white p-5">
      <div class="text-xs font-semibold uppercase tracking-wide text-slate-500">Parameters</div>

      <div class="space-y-3">
        <div>
          <label for="utm-url" class="block text-sm font-medium text-slate-700 mb-1">
            Base URL <span class="text-red-500">*</span>
          </label>
          <input type="url" id="utm-url"
            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
            placeholder="https://example.com/landing-page" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="utm-source" class="block text-sm font-medium text-slate-700 mb-1">
              Source <span class="text-red-500">*</span>
            </label>
            <input type="text" id="utm-source"
              class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
              placeholder="google, newsletter" />
          </div>
          <div>
            <label for="utm-medium" class="block text-sm font-medium text-slate-700 mb-1">
              Medium <span class="text-red-500">*</span>
            </label>
            <input type="text" id="utm-medium"
              class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
              placeholder="cpc, email, social" />
          </div>
          <div>
            <label for="utm-campaign" class="block text-sm font-medium text-slate-700 mb-1">Campaign</label>
            <input type="text" id="utm-campaign"
              class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
              placeholder="summer_sale" />
          </div>
          <div>
            <label for="utm-term" class="block text-sm font-medium text-slate-700 mb-1">Term</label>
            <input type="text" id="utm-term"
              class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
              placeholder="keyword" />
          </div>
          <div class="col-span-2">
            <label for="utm-content" class="block text-sm font-medium text-slate-700 mb-1">Content</label>
            <input type="text" id="utm-content"
              class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
              placeholder="ad_variant_a" />
          </div>
        </div>
      </div>

      <button id="btn-build"
        class="mt-auto rounded-lg bg-orange-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-orange-700 transition-colors w-full">
        Build URL
      </button>
    </div>

    <!-- Output pane -->
    <div class="flex flex-col gap-3">
      <div class="text-xs font-semibold uppercase tracking-wide text-slate-500">Output</div>

      <!-- Generated URL -->
      <div id="utm-output-wrap" class="rounded-lg border border-slate-200 bg-white p-4 hidden">
        <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">Generated URL</label>
        <div class="flex gap-2">
          <input id="utm-output" type="text"
            class="flex-1 min-w-0 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 font-mono text-xs focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
            readonly />
          <button id="btn-copy"
            class="shrink-0 rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
            Copy
          </button>
        </div>
        <a id="utm-preview-link" target="_blank" rel="noopener noreferrer" class="hidden text-xs text-brand underline break-all mt-1 block">Test link &rarr;</a>
        <p class="text-xs text-slate-500 mt-2">
          UTM URLs can be long &mdash; consider shortening with
          <a href="https://bitly.com" target="_blank" rel="noopener noreferrer" class="text-brand underline hover:no-underline">Bitly</a>
          or <a href="https://tinyurl.com" target="_blank" rel="noopener noreferrer" class="text-brand underline hover:no-underline">TinyURL</a>
          before sharing.
        </p>
        <div class="mt-3 flex items-center gap-3">
          <button id="btn-show-qr"
            class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50 transition-colors">
            Show QR Code
          </button>
        </div>
        <img id="utm-qr" class="hidden mt-3 rounded-lg border border-slate-200" alt="QR code for UTM URL" width="150" height="150">
      </div>

      <!-- History -->
      <div class="flex-1 rounded-lg border border-slate-200 bg-white p-4 overflow-auto">
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-3">History</div>
        <div id="utm-history">
          <p class="text-sm text-slate-400">Generated links will appear here.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Status bar -->
  <div id="status" class="mt-2 rounded-md px-3 py-1.5 text-sm font-medium hidden"></div>

  <!-- ── Below-fold: SEO content ── -->
  <div class="mt-16 max-w-3xl space-y-10">

    <section aria-labelledby="what-are-utm-heading">
      <h2 id="what-are-utm-heading" class="text-2xl font-bold text-slate-900">What are UTM parameters?</h2>
      <div class="prose mt-4 max-w-none">
        <p>
          UTM parameters (Urchin Tracking Module) are tags appended to a URL's query string that analytics
          platforms — Google Analytics, Plausible, Fathom — use to attribute website traffic to its source.
          When a visitor clicks a UTM-tagged link, the parameters are captured in your analytics dashboard
          without any additional server-side configuration.
        </p>
        <ul>
          <li><strong>utm_source</strong> — identifies the platform that sent the traffic (e.g., <code>google</code>, <code>twitter</code>, <code>newsletter</code>).</li>
          <li><strong>utm_medium</strong> — the marketing channel (e.g., <code>cpc</code>, <code>email</code>, <code>organic</code>).</li>
          <li><strong>utm_campaign</strong> — the specific campaign (e.g., <code>spring_launch</code>).</li>
          <li><strong>utm_term</strong> — paid search keyword (Google Ads).</li>
          <li><strong>utm_content</strong> — differentiates creatives in A/B tests (e.g., <code>hero_button</code> vs <code>sidebar_link</code>).</li>
        </ul>
      </div>
    </section>

    <section aria-labelledby="utm-best-practices-heading">
      <h2 id="utm-best-practices-heading" class="text-2xl font-bold text-slate-900">UTM parameter best practices</h2>
      <div class="prose mt-4 max-w-none">
        <p>
          Inconsistent UTM parameters fragment your analytics data. A few conventions that prevent this:
        </p>
        <ul>
          <li><strong>Always lowercase.</strong> UTM values are case-sensitive — <code>Email</code> and <code>email</code> appear as separate sources.</li>
          <li><strong>Use underscores, not spaces or hyphens.</strong> Spaces become <code>%20</code> in URLs and are hard to read. Underscores are the de-facto convention.</li>
          <li><strong>Be consistent across your team.</strong> Document your naming conventions in a shared spreadsheet or wiki so every campaign uses the same source/medium vocabulary.</li>
          <li><strong>Don't tag internal links.</strong> UTM parameters reset the session in analytics — tagging internal navigation will incorrectly attribute conversions to the clicked internal link.</li>
          <li><strong>utm_source and utm_medium are required</strong> for most analytics platforms to recognize the traffic correctly.</li>
        </ul>
      </div>
    </section>

    <section aria-labelledby="utm-examples-heading">
      <h2 id="utm-examples-heading" class="text-2xl font-bold text-slate-900">UTM parameter examples</h2>
      <div class="prose mt-4 max-w-none">
        <p>Common patterns for different marketing channels:</p>
        <ul>
          <li><strong>Google Ads:</strong> <code>?utm_source=google&amp;utm_medium=cpc&amp;utm_campaign=brand&amp;utm_term=your+keyword</code></li>
          <li><strong>Email campaign:</strong> <code>?utm_source=mailchimp&amp;utm_medium=email&amp;utm_campaign=spring_sale</code></li>
          <li><strong>Twitter/X organic:</strong> <code>?utm_source=twitter&amp;utm_medium=social&amp;utm_campaign=launch</code></li>
          <li><strong>Newsletter sponsor:</strong> <code>?utm_source=tldr&amp;utm_medium=newsletter&amp;utm_campaign=q2_sponsor&amp;utm_content=top_banner</code></li>
          <li><strong>QR code:</strong> <code>?utm_source=qr_code&amp;utm_medium=offline&amp;utm_campaign=store_poster</code></li>
        </ul>
      </div>
    </section>

  </div>

  <script is:inline>
    var utmHistory = JSON.parse(localStorage.getItem('utm_history') || '[]');
    var statusEl = document.getElementById('status');

    // Campaign presets
    var PRESETS = [
      { label: 'Email Newsletter', source: 'newsletter', medium: 'email' },
      { label: 'Google Ads',       source: 'google',     medium: 'cpc' },
      { label: 'Facebook Post',    source: 'facebook',   medium: 'social' },
      { label: 'Instagram',        source: 'instagram',  medium: 'social' },
      { label: 'LinkedIn',         source: 'linkedin',   medium: 'social' },
      { label: 'Twitter/X',        source: 'twitter',    medium: 'social' },
      { label: 'YouTube',          source: 'youtube',    medium: 'video' },
      { label: 'Press Release',    source: 'press',      medium: 'referral' },
      { label: 'QR Code',          source: 'qr-code',    medium: 'print' },
    ];

    var activePreset = null;

    function applyPreset(idx) {
      var p = PRESETS[idx];
      document.getElementById('utm-source').value = p.source;
      document.getElementById('utm-medium').value = p.medium;
      activePreset = idx;
      renderPresets();
      // Focus campaign field so user fills it next
      document.getElementById('utm-campaign').focus();
    }

    function renderPresets() {
      var container = document.getElementById('preset-buttons');
      container.innerHTML = '';
      PRESETS.forEach(function(p, i) {
        var btn = document.createElement('button');
        var isActive = activePreset === i;
        btn.type = 'button';
        btn.textContent = p.label;
        btn.className = 'rounded-full border px-3 py-1 text-xs font-medium transition ' +
          (isActive
            ? 'border-orange-500 bg-orange-500 text-white'
            : 'border-slate-300 bg-white text-slate-600 hover:border-orange-400 hover:text-orange-600');
        btn.addEventListener('click', function() { applyPreset(i); });
        container.appendChild(btn);
      });
    }

    renderPresets();

    function showStatus(msg, type) {
      var clsMap = { error: 'bg-red-50 text-red-700 border border-red-200', success: 'bg-emerald-50 text-emerald-700 border border-emerald-200', info: 'bg-blue-50 text-blue-700 border border-blue-200' };
      statusEl.className = 'mt-2 rounded-md px-3 py-1.5 text-sm font-medium ' + (clsMap[type] || 'bg-slate-100 text-slate-700');
      statusEl.textContent = msg;
      statusEl.classList.remove('hidden');
    }

    function renderHistory() {
      var el = document.getElementById('utm-history');
      if (!utmHistory.length) {
        el.innerHTML = '<p class="text-sm text-slate-400">Generated links will appear here.</p>';
        return;
      }
      el.innerHTML = utmHistory.map(function(h) {
        var esc = h.url.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        return '<div class="mb-2 rounded-lg border border-slate-200 px-3 py-2">' +
          '<div class="text-xs text-slate-400 mb-1">' + h.ts + '</div>' +
          '<a href="' + h.url + '" target="_blank" rel="noopener" class="block truncate font-mono text-xs text-orange-600 hover:underline">' + esc + '</a>' +
          '</div>';
      }).join('');
    }

    renderHistory();

    document.getElementById('btn-sample').addEventListener('click', function() {
      document.getElementById('utm-url').value = 'https://example.com/landing';
      document.getElementById('utm-source').value = 'google';
      document.getElementById('utm-medium').value = 'cpc';
      document.getElementById('utm-campaign').value = 'summer_sale';
      document.getElementById('utm-term').value = 'utm+builder';
      document.getElementById('utm-content').value = 'hero_cta';
      statusEl.classList.add('hidden');
      activePreset = null;
      renderPresets();
    });

    document.getElementById('btn-build').addEventListener('click', function() {
      var url = document.getElementById('utm-url').value.trim();
      if (!url) { showStatus('Please enter a base URL', 'error'); return; }
      var source = document.getElementById('utm-source').value.trim();
      var medium = document.getElementById('utm-medium').value.trim();
      if (!source || !medium) { showStatus('utm_source and utm_medium are required', 'error'); return; }

      var params = new URLSearchParams();
      params.set('utm_source', source);
      params.set('utm_medium', medium);
      ['campaign', 'term', 'content'].forEach(function(k) {
        var v = document.getElementById('utm-' + k).value.trim();
        if (v) params.set('utm_' + k, v);
      });
      var sep = url.includes('?') ? '&' : '?';
      var final = url + sep + params.toString();

      document.getElementById('utm-output').value = final;
      document.getElementById('utm-output-wrap').classList.remove('hidden');
      showStatus('URL built successfully', 'success');

      // P3: Preview link
      var previewLink = document.getElementById('utm-preview-link');
      if (previewLink) {
        previewLink.href = final;
        previewLink.textContent = (final.length > 80 ? final.slice(0, 77) + '...' : final) + ' →';
        previewLink.classList.remove('hidden');
      }

      // P3: Hide QR if URL changes
      var qrImg = document.getElementById('utm-qr');
      if (qrImg) qrImg.classList.add('hidden');

      utmHistory.unshift({ url: final, ts: new Date().toLocaleString() });
      localStorage.setItem('utm_history', JSON.stringify(utmHistory.slice(0, 20)));
      renderHistory();
    });

    document.getElementById('btn-copy').addEventListener('click', function() {
      var val = document.getElementById('utm-output').value;
      if (!val) { showStatus('Nothing to copy yet', 'info'); return; }
      navigator.clipboard.writeText(val).then(function() {
        showStatus('Copied to clipboard', 'success');
      }, function() {
        document.getElementById('utm-output').select();
        document.execCommand('copy');
        showStatus('Copied', 'success');
      });
    });

    document.getElementById('btn-clear-history').addEventListener('click', function() {
      utmHistory = [];
      localStorage.removeItem('utm_history');
      renderHistory();
      document.getElementById('utm-output-wrap').classList.add('hidden');
      statusEl.classList.add('hidden');
    });

    // P3: QR code
    function showUTMQR(url) {
      var qrImg = document.getElementById('utm-qr');
      if (!qrImg) return;
      var encoded = encodeURIComponent(url);
      qrImg.src = 'https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' + encoded;
      qrImg.classList.remove('hidden');
    }

    document.getElementById('btn-show-qr').addEventListener('click', function() {
      var val = document.getElementById('utm-output').value;
      if (!val) { showStatus('Build a URL first', 'info'); return; }
      showUTMQR(val);
    });
  </script>

</BaseLayout>
