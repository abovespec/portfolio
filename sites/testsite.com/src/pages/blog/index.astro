---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '~/config/site.config';

if (!siteConfig.features.hasBlog) return Astro.redirect('/');

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---
<BaseLayout title="Blog" description={`Articles from ${siteConfig.identity.name}`}>
  <h1 class="text-4xl font-bold">Blog</h1>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {posts.map((post) => (
      <li class="rounded-lg border border-slate-200 bg-white p-4 hover:border-slate-400">
        <a href={`/blog/${post.slug}/`}>
          <h2 class="text-lg font-medium text-slate-900">{post.data.title}</h2>
          <p class="mt-1 text-sm text-slate-600">{post.data.description}</p>
          <time class="mt-2 block text-xs text-slate-500" datetime={post.data.publishDate.toISOString()}>
            {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
