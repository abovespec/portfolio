---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="404 - page not found" noindex>
  <section class="py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">404</p>
    <h1 class="mt-2 text-4xl font-bold">Page not found</h1>
    <p class="mx-auto mt-4 max-w-md text-slate-600">
      The page you're looking for doesn't exist or has moved.
    </p>
    <a href="/" class="mt-6 inline-block rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">
      Go home
    </a>
  </section>
</BaseLayout>
