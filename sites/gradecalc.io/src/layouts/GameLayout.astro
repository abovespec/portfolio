---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import SchemaVideoGame from '~/components/SchemaVideoGame.astro';
import { siteUrl } from '~/config/site.config';

interface Props {
  title: string;
  description: string;
  slug: string;
  genre?: string;
  gamePlatform?: string[];
  applicationCategory?: string;
  ratingValue?: number;
  ratingCount?: number;
}
const {
  title, description, slug,
  genre, gamePlatform, applicationCategory, ratingValue, ratingCount,
} = Astro.props;
const url = new URL(Astro.url.pathname, siteUrl).toString();
---
<BaseLayout title={title} description={description}>
  <Breadcrumb items={[
    { name: 'Home', url: '/' },
    { name: 'Games', url: '/games/' },
    { name: title, url: `/games/${slug}/` },
  ]} />

  <section class="mt-6 rounded-xl border border-slate-200 bg-slate-50 p-8">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">{title}</h1>
    <p class="mt-3 text-lg text-slate-600">{description}</p>
    <div class="mt-6">
      <slot name="game" />
    </div>
  </section>

  <section class="prose prose-slate mt-10 max-w-none">
    <slot />
  </section>

  <SchemaVideoGame
    name={title}
    description={description}
    url={url}
    genre={genre}
    gamePlatform={gamePlatform}
    applicationCategory={applicationCategory}
    ratingValue={ratingValue}
    ratingCount={ratingCount}
  />
</BaseLayout>
