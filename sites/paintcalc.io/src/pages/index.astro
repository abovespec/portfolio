---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title={siteConfig.identity.name} description={siteConfig.identity.description}>
  <section class="relative -mx-4 overflow-hidden px-4 py-14 sm:py-20">
    <div class="absolute inset-0 bg-gradient-to-br from-rose-50 via-orange-50 to-amber-50" aria-hidden="true" />
    <div class="absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-rose-300/20 blur-3xl" aria-hidden="true" />
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-orange-300/15 blur-3xl" aria-hidden="true" />
    <div class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">PaintCalc</h1>
        <p class="mt-3 text-lg text-slate-600">Paint calculator, flooring estimator, roofing square footage, HVAC BTU sizing, and solar savings tools.</p>
      </div>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {['Paint, flooring & roofing calculators', 'HVAC BTU sizing tool', 'Waste factor included', 'No data stored or shared'].map((badge) => (
          <li class="flex items-center gap-1.5">
            <svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
            </svg>
            {badge}
          </li>
        ))}
      </ul>
    </div>
  </section>
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-wrap gap-2 justify-center mb-8">
      <button id="tab-paint" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-rose-600 text-white">Paint</button>
      <button id="tab-floor" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Flooring</button>
      <button id="tab-roof" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Roofing</button>
      <button id="tab-hvac" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">HVAC BTU</button>
    </div>

    <div id="panel-paint" class="calc-panel">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Paint Calculator</h2>

        <!-- Shared inputs (coats, labor) -->
        <div class="grid gap-4 sm:grid-cols-3 mb-4">
          <label class="block"><span class="text-sm font-medium text-slate-700">Coats</span><input id="p-coat" type="number" value="2" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Labor rate ($/hour) <span class="text-slate-400 font-normal">(optional)</span></span><input id="p-labor-rate" type="number" placeholder="0.00" min="0" step="0.01" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Est. hours <span class="text-slate-400 font-normal">(auto if blank)</span></span><input id="p-labor-hours" type="number" placeholder="auto" min="0" step="0.5" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>

        <!-- Rooms container -->
        <div id="paint-rooms" class="space-y-4"></div>
        <button id="p-add-room" class="mt-3 text-sm text-rose-600 hover:text-rose-800 font-medium">+ Add another room</button>

        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Total wall area (sq ft)</p><p id="p-out-area" class="text-xl font-bold text-slate-800">356</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Gallons needed</p><p id="p-out-gal" class="text-xl font-bold text-slate-800">2</p></div>
          <div class="rounded-lg bg-rose-50 p-4 text-center border border-rose-100"><p class="text-xs uppercase text-rose-600">Est. paint cost</p><p id="p-out-cost" class="text-xl font-bold text-rose-700">$80</p></div>
        </div>
        <div id="p-labor-section" class="mt-4 hidden grid gap-4 sm:grid-cols-2">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Est. labor hours</p><p id="p-out-labor-hours" class="text-xl font-bold text-slate-800">4</p></div>
          <div class="rounded-lg bg-rose-50 p-4 text-center border border-rose-100"><p class="text-xs uppercase text-rose-600">Total project cost</p><p id="p-out-total" class="text-xl font-bold text-rose-700">$240</p></div>
        </div>
        <p class="mt-3 text-xs text-slate-400">Assumes 350 sq ft per gallon. Adjust for textured walls or dark colors.</p>
      </div>
    </div>

    <div id="panel-floor" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Flooring Estimator</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Room length (ft)</span><input id="f-len" type="number" value="12" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Room width (ft)</span><input id="f-wid" type="number" value="10" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Waste factor (%)</span><input id="f-waste" type="number" value="10" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Price per sq ft ($)</span><input id="f-price" type="number" value="4.50" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Total area</p><p id="f-out-area" class="text-xl font-bold text-slate-800">132 sq ft</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Material needed</p><p id="f-out-need" class="text-xl font-bold text-slate-800">145 sq ft</p></div>
          <div class="rounded-lg bg-rose-50 p-4 text-center border border-rose-100"><p class="text-xs uppercase text-rose-600">Est. material cost</p><p id="f-out-cost" class="text-xl font-bold text-rose-700">$653</p></div>
        </div>
      </div>
    </div>

    <div id="panel-roof" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Roofing Square Footage</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">House length (ft)</span><input id="r-len" type="number" value="40" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">House width (ft)</span><input id="r-wid" type="number" value="30" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Roof pitch (rise/run)</span>
            <select id="r-pitch" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
              <option value="1.00">Flat / low slope</option>
              <option value="1.054">4:12 pitch</option>
              <option value="1.118" selected>6:12 pitch</option>
              <option value="1.202">8:12 pitch</option>
              <option value="1.302">10:12 pitch</option>
              <option value="1.414">12:12 pitch</option>
            </select>
          </label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Overhang (ft)</span><input id="r-over" type="number" value="1" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Roof area (sq ft)</p><p id="r-out-area" class="text-xl font-bold text-slate-800">1,562</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Roofing squares</p><p id="r-out-sq" class="text-xl font-bold text-slate-800">15.6</p></div>
          <div class="rounded-lg bg-rose-50 p-4 text-center border border-rose-100"><p class="text-xs uppercase text-rose-600">Est. shingle bundles</p><p id="r-out-bundle" class="text-xl font-bold text-rose-700">47</p></div>
        </div>
      </div>
    </div>

    <div id="panel-hvac" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">HVAC BTU Sizing Calculator</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Room length (ft)</span><input id="h-len" type="number" value="20" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Room width (ft)</span><input id="h-wid" type="number" value="15" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Ceiling height (ft)</span><input id="h-ht" type="number" value="9" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Climate</span>
            <select id="h-climate" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
              <option value="20">Hot / tropical</option>
              <option value="25">Moderate</option>
              <option value="30" selected>Cold / northern</option>
            </select>
          </label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Sun exposure</span>
            <select id="h-sun" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
              <option value="1.0">Shaded</option>
              <option value="1.1" selected>Average</option>
              <option value="1.2">Heavy sun</option>
            </select>
          </label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Occupants</span><input id="h-occ" type="number" value="2" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 rounded-lg bg-rose-50 p-4 text-center border border-rose-100">
          <p class="text-xs uppercase text-rose-600">Recommended BTU</p>
          <p id="h-out" class="text-3xl font-bold text-rose-700">9,450</p>
        </div>
        <p class="mt-3 text-xs text-slate-400">Rough estimate. Consult an HVAC professional for load calculations.</p>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Home Improvement Guides</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/blog/how-much-paint-do-i-need-for-a-12x12-room-exact-calculation/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-rose-400"><h3 class="font-semibold text-slate-900">How Much Paint Do I Need?</h3><p class="mt-1 text-sm text-slate-600">Factors that change coverage: texture, color change, primer, and application method.</p></a>
        <a href="/blog/flooring-cost-calculator-by-square-foot-material-and-installation/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-rose-400"><h3 class="font-semibold text-slate-900">Flooring Cost Guide by Material</h3><p class="mt-1 text-sm text-slate-600">Hardwood, LVP, tile, carpet: installed price per square foot in 2025.</p></a>
        <a href="/blog/hvac-btu-calculator-by-room-size-sizing-guide-for-ac-and-heat/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-rose-400"><h3 class="font-semibold text-slate-900">HVAC Sizing Basics for Homeowners</h3><p class="mt-1 text-sm text-slate-600">Why bigger is not better. Manual J load calculations explained simply.</p></a>
        <a href="/blog/roof-replacement-cost-estimator-2025-pricing-by-material-and-size/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-rose-400"><h3 class="font-semibold text-slate-900">How to Read a Roofing Estimate</h3><p class="mt-1 text-sm text-slate-600">Squares, bundles, underlayment, and flashing: what should be included.</p></a>
      </div>
    </section>
  </div>
  <script is:inline>
    function $(id){ return document.getElementById(id); }
    function val(id){ return parseFloat($(id).value) || 0; }
    const tabs=['paint','floor','roof','hvac'];
    tabs.forEach(t=>{
      $('tab-'+t).addEventListener('click',()=>{
        tabs.forEach(x=>{ $('panel-'+x).classList.add('hidden'); $('tab-'+x).classList.remove('bg-rose-600','text-white'); $('tab-'+x).classList.add('bg-slate-200','text-slate-700'); });
        $('panel-'+t).classList.remove('hidden'); $('tab-'+t).classList.remove('bg-slate-200','text-slate-700'); $('tab-'+t).classList.add('bg-rose-600','text-white');
      });
    });

    // ── Multi-room paint calculator ──
    let rooms = [];
    let roomIdCounter = 0;

    function createRoomEl(id) {
      const div = document.createElement('div');
      div.id = 'room-'+id;
      div.className = 'rounded-lg border border-slate-100 bg-slate-50 p-4';
      div.innerHTML = `
        <div class="flex items-center justify-between mb-3">
          <span class="text-sm font-semibold text-slate-700">Room ${rooms.length + 1}</span>
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-1.5 text-xs font-medium text-slate-600">
              Shape:
              <select class="room-shape rounded border border-slate-300 px-2 py-1 text-xs bg-white">
                <option value="rect">Rectangular</option>
                <option value="lshaped">L-shaped</option>
              </select>
            </label>
            ${rooms.length > 0 ? '<button class="remove-room text-red-400 hover:text-red-600 text-xs font-medium">&times; Remove</button>' : ''}
          </div>
        </div>
        <div class="room-rect-inputs grid gap-3 sm:grid-cols-4">
          <label class="block"><span class="text-xs text-slate-600">Length (ft)</span><input type="number" class="room-len mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="12"></label>
          <label class="block"><span class="text-xs text-slate-600">Width (ft)</span><input type="number" class="room-wid mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="10"></label>
          <label class="block"><span class="text-xs text-slate-600">Ceiling ht (ft)</span><input type="number" class="room-ht mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="8"></label>
          <label class="block"><span class="text-xs text-slate-600">Doors</span><input type="number" class="room-door mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="1"></label>
          <label class="block"><span class="text-xs text-slate-600">Windows</span><input type="number" class="room-win mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="2"></label>
        </div>
        <div class="room-lshaped-inputs hidden mt-3">
          <p class="text-xs text-slate-500 mb-2">L-shaped room: enter two rectangles</p>
          <div class="grid gap-3 sm:grid-cols-4">
            <label class="block"><span class="text-xs text-slate-600">Rect A: Length</span><input type="number" class="ls-a-len mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="12"></label>
            <label class="block"><span class="text-xs text-slate-600">Rect A: Width</span><input type="number" class="ls-a-wid mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="10"></label>
            <label class="block"><span class="text-xs text-slate-600">Rect B: Length</span><input type="number" class="ls-b-len mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="8"></label>
            <label class="block"><span class="text-xs text-slate-600">Rect B: Width</span><input type="number" class="ls-b-wid mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="6"></label>
            <label class="block"><span class="text-xs text-slate-600">Ceiling ht (ft)</span><input type="number" class="ls-ht mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="8"></label>
            <label class="block"><span class="text-xs text-slate-600">Doors</span><input type="number" class="ls-door mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="1"></label>
            <label class="block"><span class="text-xs text-slate-600">Windows</span><input type="number" class="ls-win mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="2"></label>
          </div>
        </div>
      `;
      return div;
    }

    function addRoom() {
      if (rooms.length >= 8) return;
      const id = ++roomIdCounter;
      rooms.push(id);
      const el = createRoomEl(id);
      $('paint-rooms').appendChild(el);
      // Update room number labels
      document.querySelectorAll('#paint-rooms > div').forEach((row, i) => {
        row.querySelector('span.text-sm.font-semibold').textContent = 'Room ' + (i+1);
      });
      // Wire shape selector
      el.querySelector('.room-shape').addEventListener('change', function() {
        const rect = el.querySelector('.room-rect-inputs');
        const lsh = el.querySelector('.room-lshaped-inputs');
        if (this.value === 'lshaped') { rect.classList.add('hidden'); lsh.classList.remove('hidden'); }
        else { rect.classList.remove('hidden'); lsh.classList.add('hidden'); }
        calcTotal();
      });
      // Wire remove button
      const removeBtn = el.querySelector('.remove-room');
      if (removeBtn) {
        removeBtn.addEventListener('click', function() {
          rooms = rooms.filter(r => r !== id);
          el.remove();
          document.querySelectorAll('#paint-rooms > div').forEach((row, i) => {
            row.querySelector('span.text-sm.font-semibold').textContent = 'Room ' + (i+1);
          });
          calcTotal();
        });
      }
      el.querySelectorAll('input').forEach(i => i.addEventListener('input', calcTotal));
      calcTotal();
    }

    function getRoomArea(el) {
      const shape = el.querySelector('.room-shape').value;
      if (shape === 'lshaped') {
        const aLen = parseFloat(el.querySelector('.ls-a-len').value)||0;
        const aWid = parseFloat(el.querySelector('.ls-a-wid').value)||0;
        const bLen = parseFloat(el.querySelector('.ls-b-len').value)||0;
        const bWid = parseFloat(el.querySelector('.ls-b-wid').value)||0;
        const ht = parseFloat(el.querySelector('.ls-ht').value)||0;
        const door = parseFloat(el.querySelector('.ls-door').value)||0;
        const win = parseFloat(el.querySelector('.ls-win').value)||0;
        const perimA = (aLen + aWid) * 2;
        const perimB = (bLen + bWid) * 2;
        // Approximate: sum wall perimeters minus shared wall, times height
        const sharedWall = Math.min(aWid, bWid);
        const wallArea = (perimA + perimB - 2*sharedWall) * ht - door*21 - win*15;
        return Math.max(0, wallArea);
      } else {
        const len = parseFloat(el.querySelector('.room-len').value)||0;
        const wid = parseFloat(el.querySelector('.room-wid').value)||0;
        const ht = parseFloat(el.querySelector('.room-ht').value)||0;
        const door = parseFloat(el.querySelector('.room-door').value)||0;
        const win = parseFloat(el.querySelector('.room-win').value)||0;
        return Math.max(0, (len+wid)*2*ht - door*21 - win*15);
      }
    }

    function calcTotal() {
      let totalArea = 0;
      document.querySelectorAll('#paint-rooms > div').forEach(row => {
        totalArea += getRoomArea(row);
      });
      const coat = val('p-coat') || 2;
      const gal = Math.ceil(totalArea * coat / 350);
      const paintCost = gal * 40;
      $('p-out-area').textContent = totalArea.toFixed(0);
      $('p-out-gal').textContent = gal;
      $('p-out-cost').textContent = '$' + paintCost.toFixed(0);

      // Labor
      const laborRate = parseFloat($('p-labor-rate').value) || 0;
      const laborHoursInput = parseFloat($('p-labor-hours').value) || 0;
      const estimatedHours = laborHoursInput > 0 ? laborHoursInput : Math.ceil(totalArea / 100);
      const laborCost = laborRate * estimatedHours;
      const laborSection = $('p-labor-section');
      if (laborRate > 0) {
        $('p-out-labor-hours').textContent = estimatedHours;
        $('p-out-total').textContent = '$' + (paintCost + laborCost).toFixed(0);
        laborSection.classList.remove('hidden');
        laborSection.classList.add('grid');
      } else {
        laborSection.classList.add('hidden');
        laborSection.classList.remove('grid');
      }
    }

    // Add first room on load
    addRoom();
    $('p-coat').addEventListener('input', calcTotal);
    $('p-labor-rate').addEventListener('input', calcTotal);
    $('p-labor-hours').addEventListener('input', calcTotal);
    $('p-add-room').addEventListener('click', addRoom);

    function calcFloor(){ const len=val('f-len'), wid=val('f-wid'), waste=val('f-waste'), price=val('f-price'); const area=len*wid; const need=area*(1+waste/100); $('f-out-area').textContent=area.toFixed(0)+' sq ft'; $('f-out-need').textContent=need.toFixed(0)+' sq ft'; $('f-out-cost').textContent='$'+(need*price).toFixed(0); }
    function calcRoof(){ const len=val('r-len'), wid=val('r-wid'), pitch=val('r-pitch'), over=val('r-over'); const area=(len+over*2)*(wid+over*2)*pitch; const sq=area/100; const bundles=Math.ceil(sq*3); $('r-out-area').textContent=area.toFixed(0); $('r-out-sq').textContent=sq.toFixed(1); $('r-out-bundle').textContent=bundles; }
    function calcHvac(){ const len=val('h-len'), wid=val('h-wid'), ht=val('h-ht'), climate=val('h-climate'), sun=val('h-sun'), occ=val('h-occ'); const vol=len*wid*ht; const base=vol*climate; const occAdd=(occ-1)*600; const total=(base+occAdd)*sun; $('h-out').textContent=total.toFixed(0).toLocaleString(); }
    ['f-len','f-wid','f-waste','f-price'].forEach(id=>$(id)?.addEventListener('input',calcFloor));
    ['r-len','r-wid','r-pitch','r-over'].forEach(id=>$(id)?.addEventListener('input',calcRoof));
    ['h-len','h-wid','h-ht','h-climate','h-sun','h-occ'].forEach(id=>$(id)?.addEventListener('input',calcHvac));
    calcFloor(); calcRoof(); calcHvac();
  </script>
</BaseLayout>
