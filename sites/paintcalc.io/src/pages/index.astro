---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title={siteConfig.identity.name} description={siteConfig.identity.description}>
  <section class="relative -mx-4 overflow-hidden px-4 py-14 sm:py-20">
    <div class="absolute inset-0 bg-gradient-to-br from-rose-50 via-orange-50 to-amber-50" aria-hidden="true" />
    <div class="absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-rose-300/20 blur-3xl" aria-hidden="true" />
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-orange-300/15 blur-3xl" aria-hidden="true" />
    <div class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">PaintCalc</h1>
        <p class="mt-3 text-lg text-slate-600">Paint calculator, flooring estimator, roofing square footage, HVAC BTU sizing, and solar savings tools.</p>
      </div>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {['Paint, flooring & roofing calculators', 'HVAC BTU sizing tool', 'Waste factor included', 'No data stored or shared'].map((badge) => (
          <li class="flex items-center gap-1.5">
            <svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
            </svg>
            {badge}
          </li>
        ))}
      </ul>
    </div>
  </section>
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-wrap gap-2 justify-center mb-8">
      <button id="tab-paint" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-rose-600 text-white">Paint</button>
      <button id="tab-floor" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Flooring</button>
      <button id="tab-roof" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Roofing</button>
      <button id="tab-hvac" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">HVAC BTU</button>
    </div>

    <div id="panel-paint" class="calc-panel">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Paint Calculator</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Room length (ft)</span><input id="p-len" type="number" value="12" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Room width (ft)</span><input id="p-wid" type="number" value="10" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Ceiling height (ft)</span><input id="p-ht" type="number" value="8" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Number of doors</span><input id="p-door" type="number" value="1" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Number of windows</span><input id="p-win" type="number" value="2" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Coats</span><input id="p-coat" type="number" value="2" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Wall area (sq ft)</p><p id="p-out-area" class="text-xl font-bold text-slate-800">356</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Gallons needed</p><p id="p-out-gal" class="text-xl font-bold text-slate-800">2</p></div>
          <div class="rounded-lg bg-rose-50 p-4 text-center border border-rose-100"><p class="text-xs uppercase text-rose-600">Est. paint cost</p><p id="p-out-cost" class="text-xl font-bold text-rose-700">$80</p></div>
        </div>
        <p class="mt-3 text-xs text-slate-400">Assumes 350 sq ft per gallon. Adjust for textured walls or dark colors.</p>
      </div>
    </div>

    <div id="panel-floor" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Flooring Estimator</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Room length (ft)</span><input id="f-len" type="number" value="12" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Room width (ft)</span><input id="f-wid" type="number" value="10" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Waste factor (%)</span><input id="f-waste" type="number" value="10" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Price per sq ft ($)</span><input id="f-price" type="number" value="4.50" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Total area</p><p id="f-out-area" class="text-xl font-bold text-slate-800">132 sq ft</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Material needed</p><p id="f-out-need" class="text-xl font-bold text-slate-800">145 sq ft</p></div>
          <div class="rounded-lg bg-rose-50 p-4 text-center border border-rose-100"><p class="text-xs uppercase text-rose-600">Est. material cost</p><p id="f-out-cost" class="text-xl font-bold text-rose-700">$653</p></div>
        </div>
      </div>
    </div>

    <div id="panel-roof" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Roofing Square Footage</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">House length (ft)</span><input id="r-len" type="number" value="40" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">House width (ft)</span><input id="r-wid" type="number" value="30" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Roof pitch (rise/run)</span>
            <select id="r-pitch" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
              <option value="1.00">Flat / low slope</option>
              <option value="1.054">4:12 pitch</option>
              <option value="1.118" selected>6:12 pitch</option>
              <option value="1.202">8:12 pitch</option>
              <option value="1.302">10:12 pitch</option>
              <option value="1.414">12:12 pitch</option>
            </select>
          </label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Overhang (ft)</span><input id="r-over" type="number" value="1" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Roof area (sq ft)</p><p id="r-out-area" class="text-xl font-bold text-slate-800">1,562</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Roofing squares</p><p id="r-out-sq" class="text-xl font-bold text-slate-800">15.6</p></div>
          <div class="rounded-lg bg-rose-50 p-4 text-center border border-rose-100"><p class="text-xs uppercase text-rose-600">Est. shingle bundles</p><p id="r-out-bundle" class="text-xl font-bold text-rose-700">47</p></div>
        </div>
      </div>
    </div>

    <div id="panel-hvac" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">HVAC BTU Sizing Calculator</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Room length (ft)</span><input id="h-len" type="number" value="20" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Room width (ft)</span><input id="h-wid" type="number" value="15" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Ceiling height (ft)</span><input id="h-ht" type="number" value="9" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Climate</span>
            <select id="h-climate" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
              <option value="20">Hot / tropical</option>
              <option value="25">Moderate</option>
              <option value="30" selected>Cold / northern</option>
            </select>
          </label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Sun exposure</span>
            <select id="h-sun" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
              <option value="1.0">Shaded</option>
              <option value="1.1" selected>Average</option>
              <option value="1.2">Heavy sun</option>
            </select>
          </label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Occupants</span><input id="h-occ" type="number" value="2" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 rounded-lg bg-rose-50 p-4 text-center border border-rose-100">
          <p class="text-xs uppercase text-rose-600">Recommended BTU</p>
          <p id="h-out" class="text-3xl font-bold text-rose-700">9,450</p>
        </div>
        <p class="mt-3 text-xs text-slate-400">Rough estimate. Consult an HVAC professional for load calculations.</p>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Home Improvement Guides</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/blog/how-much-paint-do-i-need/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-rose-400"><h3 class="font-semibold text-slate-900">How Much Paint Do I Need?</h3><p class="mt-1 text-sm text-slate-600">Factors that change coverage: texture, color change, primer, and application method.</p></a>
        <a href="/blog/flooring-cost-guide/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-rose-400"><h3 class="font-semibold text-slate-900">Flooring Cost Guide by Material</h3><p class="mt-1 text-sm text-slate-600">Hardwood, LVP, tile, carpet: installed price per square foot in 2025.</p></a>
        <a href="/blog/hvac-sizing-basics/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-rose-400"><h3 class="font-semibold text-slate-900">HVAC Sizing Basics for Homeowners</h3><p class="mt-1 text-sm text-slate-600">Why bigger is not better. Manual J load calculations explained simply.</p></a>
        <a href="/blog/roofing-estimates/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-rose-400"><h3 class="font-semibold text-slate-900">How to Read a Roofing Estimate</h3><p class="mt-1 text-sm text-slate-600">Squares, bundles, underlayment, and flashing: what should be included.</p></a>
      </div>
    </section>
  </div>
  <script is:inline>
    function $(id){ return document.getElementById(id); }
    function val(id){ return parseFloat($(id).value) || 0; }
    const tabs=['paint','floor','roof','hvac'];
    tabs.forEach(t=>{
      $('tab-'+t).addEventListener('click',()=>{
        tabs.forEach(x=>{ $('panel-'+x).classList.add('hidden'); $('tab-'+x).classList.remove('bg-rose-600','text-white'); $('tab-'+x).classList.add('bg-slate-200','text-slate-700'); });
        $('panel-'+t).classList.remove('hidden'); $('tab-'+t).classList.remove('bg-slate-200','text-slate-700'); $('tab-'+t).classList.add('bg-rose-600','text-white');
      });
    });
    function calcPaint(){ const len=val('p-len'), wid=val('p-wid'), ht=val('p-ht'), door=val('p-door'), win=val('p-win'), coat=val('p-coat'); const area=((len+wid)*2*ht - door*21 - win*15); const gal=Math.ceil(area*coat/350); $('p-out-area').textContent=Math.max(0,area).toFixed(0); $('p-out-gal').textContent=gal; $('p-out-cost').textContent='$'+(gal*40).toFixed(0); }
    function calcFloor(){ const len=val('f-len'), wid=val('f-wid'), waste=val('f-waste'), price=val('f-price'); const area=len*wid; const need=area*(1+waste/100); $('f-out-area').textContent=area.toFixed(0)+' sq ft'; $('f-out-need').textContent=need.toFixed(0)+' sq ft'; $('f-out-cost').textContent='$'+(need*price).toFixed(0); }
    function calcRoof(){ const len=val('r-len'), wid=val('r-wid'), pitch=val('r-pitch'), over=val('r-over'); const area=(len+over*2)*(wid+over*2)*pitch; const sq=area/100; const bundles=Math.ceil(sq*3); $('r-out-area').textContent=area.toFixed(0); $('r-out-sq').textContent=sq.toFixed(1); $('r-out-bundle').textContent=bundles; }
    function calcHvac(){ const len=val('h-len'), wid=val('h-wid'), ht=val('h-ht'), climate=val('h-climate'), sun=val('h-sun'), occ=val('h-occ'); const vol=len*wid*ht; const base=vol*climate; const occAdd=(occ-1)*600; const total=(base+occAdd)*sun; $('h-out').textContent=total.toFixed(0).toLocaleString(); }
    ['p-len','p-wid','p-ht','p-door','p-win','p-coat'].forEach(id=>$(id)?.addEventListener('input',calcPaint));
    ['f-len','f-wid','f-waste','f-price'].forEach(id=>$(id)?.addEventListener('input',calcFloor));
    ['r-len','r-wid','r-pitch','r-over'].forEach(id=>$(id)?.addEventListener('input',calcRoof));
    ['h-len','h-wid','h-ht','h-climate','h-sun','h-occ'].forEach(id=>$(id)?.addEventListener('input',calcHvac));
    calcPaint(); calcFloor(); calcRoof(); calcHvac();
  </script>
</BaseLayout>
