---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title={siteConfig.identity.name} description={siteConfig.identity.description}>
  <section class="relative -mx-4 overflow-hidden px-4 py-14 sm:py-20">
    <div class="absolute inset-0 bg-gradient-to-br from-amber-50 via-orange-50 to-yellow-50" aria-hidden="true" />
    <div class="absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-amber-300/20 blur-3xl" aria-hidden="true" />
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-orange-300/15 blur-3xl" aria-hidden="true" />
    <div class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">RecipeScale</h1>
        <p class="mt-3 text-lg text-slate-600">Recipe scaler with unit conversion, nutrition calculator by ingredient, and meal plan generator.</p>
      </div>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {['Recipe scaling in seconds', 'Per-row unit conversion', 'Meal plan by calorie target', 'No data stored or shared'].map((badge) => (
          <li class="flex items-center gap-1.5">
            <svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
            </svg>
            {badge}
          </li>
        ))}
      </ul>
    </div>
  </section>
  <div class="mx-auto max-w-5xl">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Recipe Scaler</h2>
      <div class="flex flex-wrap gap-3 mb-4">
        <label class="block"><span class="text-sm font-medium text-slate-700">Original servings</span><input id="rs-orig" type="number" value="4" class="mt-1 w-24 rounded-lg border border-slate-300 px-3 py-2"></label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Desired servings</span><input id="rs-new" type="number" value="6" class="mt-1 w-24 rounded-lg border border-slate-300 px-3 py-2"></label>
      </div>
      <div id="rs-lines" class="space-y-2"></div>
      <button id="rs-add" class="mt-2 text-sm text-orange-600 hover:text-orange-800 font-medium">+ Add ingredient</button>
      <div class="mt-4 rounded-lg bg-yellow-50 p-3 text-center border border-yellow-100"><p class="text-sm text-orange-700 font-medium">Scale factor: <span id="rs-factor">1.5</span>x</p></div>
      <p class="mt-2 text-xs text-slate-400">Use the unit dropdown on each row to convert the scaled quantity to a different unit.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <button id="rs-download" onclick="downloadScaledRecipe()" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Download as .txt</button>
        <button id="rs-copy-recipe" onclick="copyScaledRecipe()" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Copy Recipe</button>
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Meal Plan by Calorie Target</h2>
      <div class="grid gap-4 sm:grid-cols-3 mb-4">
        <label class="block"><span class="text-sm font-medium text-slate-700">Daily calories</span><input id="mp-cals" type="number" value="2000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Protein target (%)</span><input id="mp-prot" type="number" value="30" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Meals per day</span><input id="mp-meals" type="number" value="3" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Protein / day</p><p id="mp-out-prot" class="text-xl font-bold text-slate-800">150g</p></div>
        <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Carbs / day</p><p id="mp-out-carb" class="text-xl font-bold text-slate-800">200g</p></div>
        <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Fat / day</p><p id="mp-out-fat" class="text-xl font-bold text-slate-800">67g</p></div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Cooking & Meal Prep Guides</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/blog/how-to-double-a-recipe-calculator-tips-and-common-mistakes/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-orange-400"><h3 class="font-semibold text-slate-900">How to Scale Recipes Accurately</h3><p class="mt-1 text-sm text-slate-600">Baking ratios, pan sizes, and when volume scaling breaks down.</p></a>
        <a href="/blog/macro-meal-planner-free-tool-for-balanced-nutrition/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-orange-400"><h3 class="font-semibold text-slate-900">Macro-Based Meal Prep for Beginners</h3><p class="mt-1 text-sm text-slate-600">Hit protein, carbs, and fat targets with simple batch-cooking strategies.</p></a>
        <a href="/blog/food-substitution-chart-for-baking-swaps-that-actually-work/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-orange-400"><h3 class="font-semibold text-slate-900">Baking Substitution Chart</h3><p class="mt-1 text-sm text-slate-600">What to swap when you're out of an ingredient: eggs, butter, flour, sugar, and more.</p></a>
        <a href="/blog/nutrition-calculator-by-ingredient-build-recipes-with-confidence/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-orange-400"><h3 class="font-semibold text-slate-900">Nutrition Calculator by Ingredient</h3><p class="mt-1 text-sm text-slate-600">Build and analyze recipes with per-ingredient nutrition data for protein, carbs, and fat.</p></a>
      </div>
    </section>
  </div>
  <script is:inline>
    function $(id){ return document.getElementById(id); }
    function val(id){ return parseFloat($(id).value)||0; }

    // Unit conversion table (from -> to -> factor)
    const CONV = {
      cup:   { ml: 236.6, tbsp: 16, tsp: 48, 'fl oz': 8, cup: 1 },
      ml:    { cup: 1/236.6, tbsp: 1/14.79, tsp: 1/4.93, 'fl oz': 1/29.57, ml: 1 },
      tbsp:  { cup: 1/16, ml: 14.79, tsp: 3, 'fl oz': 0.5, tbsp: 1 },
      tsp:   { cup: 1/48, ml: 4.93, tbsp: 1/3, 'fl oz': 1/6, tsp: 1 },
      'fl oz': { cup: 1/8, ml: 29.57, tbsp: 2, tsp: 6, 'fl oz': 1 },
      g:     { oz: 1/28.35, lbs: 1/453.6, g: 1 },
      oz:    { g: 28.35, lbs: 1/16, oz: 1 },
      lbs:   { g: 453.6, oz: 16, lbs: 1 },
    };

    // Unit groups for the selector
    const UNIT_GROUPS = {
      volume: ['cup','ml','tbsp','tsp','fl oz'],
      weight: ['g','oz','lbs'],
      other: [],
    };
    const ALL_UNITS = [...UNIT_GROUPS.volume, ...UNIT_GROUPS.weight];

    function getUnitGroup(unit) {
      if (UNIT_GROUPS.volume.includes(unit)) return 'volume';
      if (UNIT_GROUPS.weight.includes(unit)) return 'weight';
      return 'other';
    }

    function convertQty(qty, fromUnit, toUnit) {
      if (fromUnit === toUnit) return qty;
      const conv = CONV[fromUnit];
      if (!conv || conv[toUnit] === undefined) return qty; // incompatible
      return qty * conv[toUnit];
    }

    function buildUnitOptions(currentUnit) {
      const group = getUnitGroup(currentUnit);
      const units = group === 'other' ? [] : (group === 'volume' ? UNIT_GROUPS.volume : UNIT_GROUPS.weight);
      if (units.length === 0) return '<option value="">' + (currentUnit || 'unit') + '</option>';
      return units.map(u => '<option value="' + u + '"' + (u === currentUnit ? ' selected' : '') + '>' + u + '</option>').join('');
    }

    const INGREDIENT_GRAMS = {
      'flour': { cup: 125, tbsp: 7.8, tsp: 2.6 },
      'all-purpose flour': { cup: 125, tbsp: 7.8, tsp: 2.6 },
      'sugar': { cup: 200, tbsp: 12.5, tsp: 4.2 },
      'brown sugar': { cup: 220, tbsp: 13.75, tsp: 4.6 },
      'powdered sugar': { cup: 120, tbsp: 7.5, tsp: 2.5 },
      'butter': { cup: 227, tbsp: 14.2, tsp: 4.7 },
      'oil': { cup: 218, tbsp: 13.6, tsp: 4.5 },
      'milk': { cup: 244, tbsp: 15.3, tsp: 5.1 },
      'water': { cup: 237, tbsp: 14.8, tsp: 4.9 },
      'honey': { cup: 340, tbsp: 21.3, tsp: 7.1 },
      'cocoa': { cup: 86, tbsp: 5.4, tsp: 1.8 },
      'cocoa powder': { cup: 86, tbsp: 5.4, tsp: 1.8 },
      'salt': { cup: 273, tbsp: 17.1, tsp: 5.7 },
      'baking powder': { cup: 230, tbsp: 14.4, tsp: 4.8 },
      'baking soda': { cup: 220, tbsp: 13.75, tsp: 4.6 },
      'oats': { cup: 90, tbsp: 5.6, tsp: 1.9 },
      'rice': { cup: 185, tbsp: 11.6, tsp: 3.9 },
      'breadcrumbs': { cup: 108, tbsp: 6.75, tsp: 2.25 },
    };

    function getGrams(ingredientName, unit, amount) {
      const name = ingredientName.toLowerCase().trim();
      const match = Object.keys(INGREDIENT_GRAMS).find(k => name.includes(k));
      if (!match) return null;
      const convs = INGREDIENT_GRAMS[match];
      const unitLower = unit.toLowerCase();
      const factor = convs[unitLower] || convs['cup'];
      if (!factor) return null;
      return (parseFloat(amount) * factor).toFixed(0);
    }

    let rsCount = 0;
    function addRS(name, qty, unit) {
      rsCount++;
      const div = document.createElement('div');
      div.className = 'flex gap-2 items-center flex-wrap';
      const unitVal = unit || '';
      div.innerHTML =
        '<input type="text" placeholder="Ingredient" class="flex-1 min-w-0 rounded-lg border border-slate-300 px-3 py-2 text-sm" value="' + (name||'') + '">' +
        '<input type="number" placeholder="Qty" class="w-20 rounded-lg border border-slate-300 px-2 py-2 text-sm rs-qty" value="' + (qty||'') + '">' +
        '<select class="rs-unit w-28 rounded-lg border border-slate-300 px-2 py-2 text-sm">' + buildUnitOptions(unitVal) + '</select>' +
        '<span class="rs-out text-sm font-medium text-orange-700 w-28 text-right"></span>' +
        '<span class="rs-gram text-xs text-slate-400"></span>';
      $('rs-lines').appendChild(div);

      const qtyInput = div.querySelector('.rs-qty');
      const unitSelect = div.querySelector('.rs-unit');

      qtyInput.addEventListener('input', calcRS);

      unitSelect.addEventListener('change', () => {
        // Convert the displayed output to the new unit without re-entering original qty
        const newUnit = unitSelect.value;
        const outEl = div.querySelector('.rs-out');
        // Get the current scaled qty from the output text
        const currentScaled = parseFloat(outEl.textContent) || 0;
        // Find old unit from what was shown before
        const oldUnit = unitSelect.dataset.prevUnit || unitVal;
        // Re-derive from original qty instead (more reliable)
        calcRS();
        unitSelect.dataset.prevUnit = newUnit;
      });

      unitSelect.dataset.prevUnit = unitVal;
      div.querySelectorAll('input').forEach(i => i.addEventListener('input', calcRS));
    }

    addRS('Flour', 2, 'cup');
    addRS('Sugar', 0.5, 'cup');
    addRS('Butter', 4, 'tbsp');

    function calcRS() {
      const factor = val('rs-new') / Math.max(1, val('rs-orig'));
      $('rs-factor').textContent = factor.toFixed(2);
      document.querySelectorAll('#rs-lines > div').forEach(row => {
        const qtyInput = row.querySelector('.rs-qty');
        const unitSelect = row.querySelector('.rs-unit');
        const outEl = row.querySelector('.rs-out');
        const gramEl = row.querySelector('.rs-gram');
        const nameInput = row.querySelector('input[type="text"]');
        const origQty = parseFloat(qtyInput.value) || 0;
        const scaledQty = origQty * factor;
        const fromUnit = unitSelect ? (unitSelect.dataset.prevUnit || unitSelect.value || '') : '';
        const toUnit = unitSelect ? unitSelect.value : '';
        if (fromUnit && toUnit && fromUnit !== toUnit) {
          outEl.textContent = scaledQty.toFixed(3);
        } else {
          outEl.textContent = scaledQty.toFixed(3);
        }
        if (unitSelect) outEl.textContent = scaledQty.toFixed(3) + (toUnit ? ' ' + toUnit : '');
        else outEl.textContent = scaledQty.toFixed(3);
        // Gram badge
        if (gramEl && nameInput && toUnit && scaledQty > 0) {
          const grams = getGrams(nameInput.value, toUnit, scaledQty);
          gramEl.textContent = grams ? '≈ ' + grams + 'g' : '';
        } else if (gramEl) {
          gramEl.textContent = '';
        }
      });
    }

    // Better unit conversion: when user changes unit select, convert current displayed value
    // Attach on each new row's select with proper conversion
    function attachUnitConvert(row) {
      const qtyInput = row.querySelector('.rs-qty');
      const unitSelect = row.querySelector('.rs-unit');
      const outEl = row.querySelector('.rs-out');
      if (!unitSelect) return;

      unitSelect.addEventListener('change', function() {
        const fromUnit = this.dataset.prevUnit;
        const toUnit = this.value;
        if (fromUnit && toUnit && fromUnit !== toUnit) {
          const curQty = parseFloat(qtyInput.value) || 0;
          const converted = convertQty(curQty, fromUnit, toUnit);
          if (converted !== curQty) {
            qtyInput.value = parseFloat(converted.toFixed(4));
          }
        }
        this.dataset.prevUnit = toUnit;
        calcRS();
      });
    }

    // Re-attach on all initial rows
    document.querySelectorAll('#rs-lines > div').forEach(row => attachUnitConvert(row));

    // Override addRS to also attach conversion
    const _addRS = addRS;
    $('rs-add').addEventListener('click', () => {
      _addRS('', 1, 'g');
      const rows = document.querySelectorAll('#rs-lines > div');
      attachUnitConvert(rows[rows.length - 1]);
    });

    ['rs-orig', 'rs-new'].forEach(id => $(id)?.addEventListener('input', calcRS));
    calcRS();

    function calcMP() {
      const cals = val('mp-cals'), protPct = val('mp-prot'), meals = val('mp-meals');
      const fatPct = Math.max(15, 35 - protPct / 2);
      const carbPct = 100 - protPct - fatPct;
      const protG = (cals * (protPct / 100)) / 4;
      const carbG = (cals * (carbPct / 100)) / 4;
      const fatG = (cals * (fatPct / 100)) / 9;
      $('mp-out-prot').textContent = protG.toFixed(0) + 'g';
      $('mp-out-carb').textContent = carbG.toFixed(0) + 'g';
      $('mp-out-fat').textContent = fatG.toFixed(0) + 'g';
    }
    ['mp-cals', 'mp-prot', 'mp-meals'].forEach(id => $(id)?.addEventListener('input', calcMP));
    calcMP();

    function getScaledRecipeText() {
      const factor = (val('rs-new') / Math.max(1, val('rs-orig'))).toFixed(2);
      const lines = [];
      lines.push('Scaled Recipe (factor: ' + factor + 'x)');
      lines.push('='.repeat(30));
      document.querySelectorAll('#rs-lines > div').forEach(row => {
        const nameInput = row.querySelector('input[type="text"]');
        const outEl = row.querySelector('.rs-out');
        const gramEl = row.querySelector('.rs-gram');
        const name = nameInput ? nameInput.value.trim() : '';
        const qty = outEl ? outEl.textContent.trim() : '';
        const grams = gramEl ? gramEl.textContent.trim() : '';
        if (name || qty) lines.push((name || '?') + ': ' + qty + (grams ? ' ' + grams : ''));
      });
      return lines.join('\n');
    }

    function downloadScaledRecipe() {
      const text = getScaledRecipeText();
      const blob = new Blob([text], { type: 'text/plain' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'scaled-recipe.txt';
      a.click();
      URL.revokeObjectURL(a.href);
    }

    function copyScaledRecipe() {
      const text = getScaledRecipeText();
      navigator.clipboard.writeText(text).then(function() {
        const btn = $('rs-copy-recipe');
        if (btn) { btn.textContent = 'Copied!'; setTimeout(function() { btn.textContent = 'Copy Recipe'; }, 2000); }
      });
    }

    window.downloadScaledRecipe = downloadScaledRecipe;
    window.copyScaledRecipe = copyScaledRecipe;
  </script>
</BaseLayout>
