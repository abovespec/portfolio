---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout title="Profit Margin, Markup & Break-Even Calculators" description="Free online profit margin calculator, markup calculator, and break-even analysis for entrepreneurs and small businesses.">
  <section class="py-8 text-center">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">Business Calculators</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Calculate profit margins, markups, and break-even points. Plan pricing and profitability with confidence.</p>
  </section>

  <section class="my-6 grid gap-6 md:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-900">Profit Margin</h2>
      <div class="mt-4 space-y-3">
        <div><label class="block text-sm font-medium">Cost ($)</label><input type="number" id="pm-cost" class="w-full rounded border px-3 py-2" value="50"></div>
        <div><label class="block text-sm font-medium">Selling Price ($)</label><input type="number" id="pm-price" class="w-full rounded border px-3 py-2" value="100"></div>
        <button id="btn-pm" class="w-full rounded-lg bg-blue-600 px-4 py-2 text-white font-medium hover:bg-blue-700">Calculate</button>
      </div>
      <div id="pm-result" class="mt-4 hidden rounded-lg bg-slate-50 p-4 text-sm space-y-1"></div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-900">Markup Calculator</h2>
      <div class="mt-4 space-y-3">
        <div><label class="block text-sm font-medium">Cost ($)</label><input type="number" id="mu-cost" class="w-full rounded border px-3 py-2" value="50"></div>
        <div><label class="block text-sm font-medium">Markup (%)</label><input type="number" id="mu-pct" class="w-full rounded border px-3 py-2" value="50"></div>
        <button id="btn-mu" class="w-full rounded-lg bg-emerald-600 px-4 py-2 text-white font-medium hover:bg-emerald-700">Calculate</button>
      </div>
      <div id="mu-result" class="mt-4 hidden rounded-lg bg-slate-50 p-4 text-sm space-y-1"></div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-900">Break-Even Analysis</h2>
      <div class="mt-4 space-y-3">
        <div><label class="block text-sm font-medium">Fixed Costs ($)</label><input type="number" id="be-fixed" class="w-full rounded border px-3 py-2" value="5000"></div>
        <div><label class="block text-sm font-medium">Variable Cost/Unit ($)</label><input type="number" id="be-var" class="w-full rounded border px-3 py-2" value="20"></div>
        <div><label class="block text-sm font-medium">Selling Price/Unit ($)</label><input type="number" id="be-price" class="w-full rounded border px-3 py-2" value="50"></div>
        <button id="btn-be" class="w-full rounded-lg bg-indigo-600 px-4 py-2 text-white font-medium hover:bg-indigo-700">Calculate</button>
      </div>
      <div id="be-result" class="mt-4 hidden rounded-lg bg-slate-50 p-4 text-sm space-y-1"></div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6">
      <h2 class="text-xl font-bold text-slate-900">Reverse Margin</h2>
      <div class="mt-4 space-y-3">
        <div><label class="block text-sm font-medium">Desired Margin (%)</label><input type="number" id="rm-margin" class="w-full rounded border px-3 py-2" value="30"></div>
        <div><label class="block text-sm font-medium">Cost ($)</label><input type="number" id="rm-cost" class="w-full rounded border px-3 py-2" value="70"></div>
        <button id="btn-rm" class="w-full rounded-lg bg-violet-600 px-4 py-2 text-white font-medium hover:bg-violet-700">Calculate Price</button>
      </div>
      <div id="rm-result" class="mt-4 hidden rounded-lg bg-slate-50 p-4 text-sm space-y-1"></div>
    </div>
  </section>

  <script is:inline>
    function fmt(n) { return '$' + (+n).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

    document.getElementById('btn-pm').addEventListener('click', () => {
      const cost = +document.getElementById('pm-cost').value;
      const price = +document.getElementById('pm-price').value;
      const profit = price - cost;
      const margin = (profit / price) * 100;
      const markup = (profit / cost) * 100;
      const el = document.getElementById('pm-result');
      el.innerHTML = `<strong>Profit:</strong> ${fmt(profit)}<br><strong>Margin:</strong> ${margin.toFixed(2)}%<br><strong>Markup:</strong> ${markup.toFixed(2)}%`;
      el.classList.remove('hidden');
    });

    document.getElementById('btn-mu').addEventListener('click', () => {
      const cost = +document.getElementById('mu-cost').value;
      const pct = +document.getElementById('mu-pct').value;
      const price = cost * (1 + pct / 100);
      const profit = price - cost;
      const margin = (profit / price) * 100;
      const el = document.getElementById('mu-result');
      el.innerHTML = `<strong>Selling Price:</strong> ${fmt(price)}<br><strong>Profit:</strong> ${fmt(profit)}<br><strong>Margin:</strong> ${margin.toFixed(2)}%`;
      el.classList.remove('hidden');
    });

    document.getElementById('btn-be').addEventListener('click', () => {
      const fixed = +document.getElementById('be-fixed').value;
      const variable = +document.getElementById('be-var').value;
      const price = +document.getElementById('be-price').value;
      const units = fixed / (price - variable);
      const revenue = units * price;
      const el = document.getElementById('be-result');
      el.innerHTML = `<strong>Break-Even Units:</strong> ${Math.ceil(units)}<br><strong>Break-Even Revenue:</strong> ${fmt(revenue)}`;
      el.classList.remove('hidden');
    });

    document.getElementById('btn-rm').addEventListener('click', () => {
      const margin = +document.getElementById('rm-margin').value;
      const cost = +document.getElementById('rm-cost').value;
      const price = cost / (1 - margin / 100);
      const el = document.getElementById('rm-result');
      el.innerHTML = `<strong>Required Price:</strong> ${fmt(price)}<br><strong>Profit:</strong> ${fmt(price - cost)}`;
      el.classList.remove('hidden');
    });
  </script>
</BaseLayout>
