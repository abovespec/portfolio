---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title={siteConfig.identity.name} description={siteConfig.identity.description}>
  <section class="relative -mx-4 overflow-hidden px-4 py-14 sm:py-20">
    <div class="absolute inset-0 bg-gradient-to-br from-sky-50 via-blue-50 to-cyan-50" aria-hidden="true" />
    <div class="absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-sky-300/20 blur-3xl" aria-hidden="true" />
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-blue-300/15 blur-3xl" aria-hidden="true" />
    <div class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">CarLeaseCalc</h1>
        <p class="mt-3 text-lg text-slate-600">Lease vs buy calculator, total cost of ownership, fuel cost estimator, and depreciation tracker.</p>
      </div>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {['Instant results as you type', 'Compare lease vs buy instantly', 'Total cost of ownership', 'No data stored or shared'].map((badge) => (
          <li class="flex items-center gap-1.5">
            <svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
            </svg>
            {badge}
          </li>
        ))}
      </ul>
    </div>
  </section>
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-wrap gap-2 justify-center mb-8">
      <button id="tab-lease" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-sky-600 text-white">Lease vs Buy</button>
      <button id="tab-compare" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Compare Vehicles</button>
      <button id="tab-tco" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Total Cost</button>
      <button id="tab-fuel" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Fuel Cost</button>
      <button id="tab-dep" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Depreciation</button>
    </div>

    <div id="panel-lease" class="calc-panel space-y-6">
      <!-- Monthly payment card -->
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Lease vs Buy Calculator</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Vehicle MSRP ($)</span><input id="l-msrp" type="number" value="45000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Lease term (months)</span><input id="l-term" type="number" value="36" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block">
            <span class="text-sm font-medium text-slate-700">Money factor</span>
            <input id="l-mf" type="number" value="0.0025" step="0.0001" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
            <span id="l-mf-apr" class="mt-0.5 text-xs text-slate-400"></span>
          </label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Residual value (%)</span><input id="l-res" type="number" value="58" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Down payment / cap reduction ($)</span><input id="l-down" type="number" value="3000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Buy interest rate (% APR)</span><input id="l-apr" type="number" value="5.9" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Loan term (months) if buying</span><input id="l-loan" type="number" value="60" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="rounded-lg bg-sky-50 p-4 text-center border border-sky-100"><p class="text-xs uppercase text-sky-600">Est. monthly lease</p><p id="l-out-lease" class="text-2xl font-bold text-sky-700">$552</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Monthly loan payment</p><p id="l-out-loan" class="text-2xl font-bold text-slate-800">$805</p></div>
        </div>
      </div>

      <!-- ── Lease vs Buy Analysis card ── -->
      <div class="rounded-xl border border-sky-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-1 text-slate-800">Lease vs Buy Analysis</h2>
        <p class="text-sm text-slate-500 mb-5">Total money out-of-pocket over the lease/loan period, including estimated equity retained when buying.</p>

        <!-- Extra buy inputs -->
        <div class="grid gap-4 sm:grid-cols-2 mb-6 pb-6 border-b border-slate-100">
          <label class="block">
            <span class="text-sm font-medium text-slate-700">Acquisition fee ($)</span>
            <input id="lva-acq" type="number" value="895" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
            <span class="text-xs text-slate-400">Typical dealer/lender fee at lease start</span>
          </label>
          <label class="block">
            <span class="text-sm font-medium text-slate-700">Disposition fee ($)</span>
            <input id="lva-disp" type="number" value="395" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
            <span class="text-xs text-slate-400">Fee at lease end if you don't buy the car</span>
          </label>
          <label class="block">
            <span class="text-sm font-medium text-slate-700">Buy down payment ($)</span>
            <input id="lva-buydown" type="number" value="3000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
          </label>
          <label class="block">
            <span class="text-sm font-medium text-slate-700">Annual depreciation rate (%)</span>
            <input id="lva-dep" type="number" value="15" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
            <span class="text-xs text-slate-400">Used to estimate car value at lease end</span>
          </label>
        </div>

        <!-- Side-by-side results -->
        <div class="grid gap-4 sm:grid-cols-2 mb-6">
          <div class="rounded-xl border border-sky-200 bg-sky-50 p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-sky-600 mb-3">Lease path</p>
            <div class="space-y-2 text-sm text-slate-700">
              <div class="flex justify-between"><span>Monthly payments total</span><span id="lva-lease-payments" class="font-medium">—</span></div>
              <div class="flex justify-between"><span>Down / cap reduction</span><span id="lva-lease-down" class="font-medium">—</span></div>
              <div class="flex justify-between"><span>Acquisition fee</span><span id="lva-lease-acq" class="font-medium">—</span></div>
              <div class="flex justify-between"><span>Disposition fee</span><span id="lva-lease-disp" class="font-medium">—</span></div>
              <div class="flex justify-between border-t border-sky-200 pt-2 text-base font-bold text-sky-700"><span>Total lease cost</span><span id="lva-lease-total">—</span></div>
            </div>
          </div>
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-3">Buy path</p>
            <div class="space-y-2 text-sm text-slate-700">
              <div class="flex justify-between"><span>Monthly loan payments</span><span id="lva-buy-payments" class="font-medium">—</span></div>
              <div class="flex justify-between"><span>Down payment</span><span id="lva-buy-down" class="font-medium">—</span></div>
              <div class="flex justify-between border-t border-slate-200 pt-2 font-semibold"><span>Total out-of-pocket</span><span id="lva-buy-gross">—</span></div>
              <div class="flex justify-between text-emerald-700"><span>Est. car value at lease end</span><span id="lva-buy-equity" class="font-medium">—</span></div>
              <div class="flex justify-between border-t border-slate-200 pt-2 text-base font-bold text-slate-800"><span>Net buy cost</span><span id="lva-buy-total">—</span></div>
            </div>
          </div>
        </div>

        <!-- Verdict banner -->
        <div id="lva-verdict" class="rounded-xl p-4 text-center text-sm font-semibold"></div>
      </div>
    </div>

    <!-- Vehicle Comparison Card -->
    <div id="panel-compare" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Compare Two Vehicles</h2>
        <div class="grid gap-6 sm:grid-cols-2">
          <!-- Vehicle A -->
          <div class="rounded-lg border border-sky-200 bg-sky-50/30 p-4">
            <p class="text-xs font-semibold uppercase text-sky-600 mb-3">Vehicle A</p>
            <div class="space-y-3">
              <label class="block"><span class="text-xs font-medium text-slate-700">MSRP ($)</span><input type="number" id="cmp-a-msrp" value="45000" class="mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm"></label>
              <label class="block"><span class="text-xs font-medium text-slate-700">Residual (%)</span><input type="number" id="cmp-a-res" value="58" class="mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm"></label>
              <label class="block"><span class="text-xs font-medium text-slate-700">Money factor</span><input type="number" id="cmp-a-mf" value="0.0025" step="0.0001" class="mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm"></label>
              <label class="block"><span class="text-xs font-medium text-slate-700">Term (months)</span><input type="number" id="cmp-a-term" value="36" class="mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm"></label>
              <label class="block"><span class="text-xs font-medium text-slate-700">Down payment ($)</span><input type="number" id="cmp-a-down" value="3000" class="mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm"></label>
            </div>
          </div>
          <!-- Vehicle B -->
          <div class="rounded-lg border border-emerald-200 bg-emerald-50/30 p-4">
            <p class="text-xs font-semibold uppercase text-emerald-600 mb-3">Vehicle B</p>
            <div class="space-y-3">
              <label class="block"><span class="text-xs font-medium text-slate-700">MSRP ($)</span><input type="number" id="cmp-b-msrp" value="38000" class="mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm"></label>
              <label class="block"><span class="text-xs font-medium text-slate-700">Residual (%)</span><input type="number" id="cmp-b-res" value="55" class="mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm"></label>
              <label class="block"><span class="text-xs font-medium text-slate-700">Money factor</span><input type="number" id="cmp-b-mf" value="0.0020" step="0.0001" class="mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm"></label>
              <label class="block"><span class="text-xs font-medium text-slate-700">Term (months)</span><input type="number" id="cmp-b-term" value="36" class="mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm"></label>
              <label class="block"><span class="text-xs font-medium text-slate-700">Down payment ($)</span><input type="number" id="cmp-b-down" value="2000" class="mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm"></label>
            </div>
          </div>
        </div>
        <!-- Comparison table -->
        <div class="mt-6 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200">
                <th class="text-left py-2 px-3 font-semibold text-slate-600">Metric</th>
                <th class="text-right py-2 px-3 font-semibold text-sky-600">Vehicle A</th>
                <th class="text-right py-2 px-3 font-semibold text-emerald-600">Vehicle B</th>
              </tr>
            </thead>
            <tbody id="cmp-table" class="divide-y divide-slate-100">
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div id="panel-tco" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Total Cost of Ownership (5 Years)</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Purchase price ($)</span><input id="t-price" type="number" value="45000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Annual insurance ($)</span><input id="t-ins" type="number" value="1800" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Annual fuel cost ($)</span><input id="t-fuel" type="number" value="2400" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Annual maintenance ($)</span><input id="t-maint" type="number" value="800" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Annual registration ($)</span><input id="t-reg" type="number" value="200" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Resale value after 5 yrs ($)</span><input id="t-resale" type="number" value="22000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Total spent</p><p id="t-out-spent" class="text-xl font-bold text-slate-800">$65,000</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Less resale</p><p id="t-out-resale" class="text-xl font-bold text-slate-800">$22,000</p></div>
          <div class="rounded-lg bg-sky-50 p-4 text-center border border-sky-100"><p class="text-xs uppercase text-sky-600">Net 5-year cost</p><p id="t-out-net" class="text-xl font-bold text-sky-700">$43,000</p></div>
        </div>
      </div>
    </div>

    <div id="panel-fuel" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Annual Fuel Cost Estimator</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Miles driven / year</span><input id="fuel-miles" type="number" value="12000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">MPG (combined)</span><input id="fuel-mpg" type="number" value="28" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Price per gallon ($)</span><input id="fuel-price" type="number" value="3.60" step="0.01" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 rounded-lg bg-sky-50 p-4 text-center border border-sky-100">
          <p class="text-xs uppercase text-sky-600">Annual fuel cost</p>
          <p id="fuel-out" class="text-3xl font-bold text-sky-700">$1,543</p>
        </div>
      </div>
    </div>

    <div id="panel-dep" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Vehicle Depreciation Tracker</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Purchase price ($)</span><input id="d-price" type="number" value="45000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Depreciation method</span>
            <select id="d-method" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
              <option value="avg">Average car (15%/yr)</option>
              <option value="steep">Steep (20%/yr)</option>
              <option value="gentle">Gentle (10%/yr)</option>
            </select>
          </label>
        </div>
        <div class="mt-6">
          <table class="w-full text-sm">
            <thead><tr class="border-b border-slate-200"><th class="text-left py-2">Year</th><th class="text-right py-2">Value</th><th class="text-right py-2">Lost</th></tr></thead>
            <tbody id="d-table"></tbody>
          </table>
        </div>
      </div>
    </div>

    <aside
      role="note"
      class="mx-auto my-6 max-w-5xl rounded-lg border border-amber-200 bg-amber-50/80 p-3 text-sm text-amber-900"
    >
      <strong class="font-semibold">Important:</strong> All calculators provide estimates for
      informational purposes only. Results do not constitute financial, legal, or tax advice.
      Consult a licensed financial advisor before making decisions.
    </aside>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Car Buying Guides</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/blog/lease-vs-buy-car-calculator-2025-total-cost-comparison/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-sky-400"><h3 class="font-semibold text-slate-900">Lease vs Buy: Complete Guide</h3><p class="mt-1 text-sm text-slate-600">When leasing makes sense and when buying wins. Math, myths, and negotiation tips.</p></a>
        <a href="/blog/total-cost-of-car-ownership-calculator-the-real-monthly-number/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-sky-400"><h3 class="font-semibold text-slate-900">True Cost of Car Ownership</h3><p class="mt-1 text-sm text-slate-600">Insurance, fuel, maintenance, and depreciation add up. Compare by vehicle class.</p></a>
        <a href="/blog/car-depreciation-calculator-by-model-which-cars-hold-value-best/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-sky-400"><h3 class="font-semibold text-slate-900">Car Depreciation by Brand</h3><p class="mt-1 text-sm text-slate-600">Which brands hold value best? 5-year resale data for sedans, SUVs, and trucks.</p></a>
        <a href="/blog/is-it-better-to-lease-or-buy-a-car-decision-framework/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-sky-400"><h3 class="font-semibold text-slate-900">Is It Better to Lease or Buy?</h3><p class="mt-1 text-sm text-slate-600">The complete decision framework: math, myths, and the scenarios where leasing wins.</p></a>
      </div>
    </section>
  </div>
  <script is:inline>
    function $(id){ return document.getElementById(id); }
    function val(id){ return parseFloat($(id).value) || 0; }
    var fmt = function(n){ return '$' + Math.round(n).toLocaleString(); };

    const tabs=['lease','compare','tco','fuel','dep'];
    tabs.forEach(t=>{
      $('tab-'+t).addEventListener('click',()=>{
        tabs.forEach(x=>{ $('panel-'+x).classList.add('hidden'); $('tab-'+x).classList.remove('bg-sky-600','text-white'); $('tab-'+x).classList.add('bg-slate-200','text-slate-700'); });
        $('panel-'+t).classList.remove('hidden'); $('tab-'+t).classList.remove('bg-slate-200','text-slate-700'); $('tab-'+t).classList.add('bg-sky-600','text-white');
      });
    });

    function calcLease(){
      const msrp=val('l-msrp'), term=val('l-term'), mf=val('l-mf'), res=val('l-res'), down=val('l-down'), apr=val('l-apr'), loanM=val('l-loan');
      const dep=(msrp*(1-res/100)-down)/term;
      const rent=(msrp+msrp*(res/100)-down)*mf;
      const leaseMo=dep+rent;
      const r=apr/1200;
      const loanMo=(msrp-down)*r/(1-Math.pow(1+r,-loanM));
      $('l-out-lease').textContent='$'+leaseMo.toFixed(0);
      $('l-out-loan').textContent='$'+loanMo.toFixed(0);
      calcLeaseVsBuy(leaseMo, loanMo);
    }

    function calcLeaseVsBuy(leaseMo, loanMo) {
      const msrp     = val('l-msrp');
      const term     = val('l-term');
      const loanM    = val('l-loan');
      const down     = val('l-down');
      const res      = val('l-res');
      const acq      = val('lva-acq');
      const disp     = val('lva-disp');
      const buyDown  = val('lva-buydown');
      const depRate  = val('lva-dep') / 100;

      // Lease total
      const leasePayments = leaseMo * term;
      const leaseTotalCost = leasePayments + down + acq + disp;

      // Buy total — use the *loan* term for monthly payments
      // But we compare over the *lease* term months: remaining loan balance scenario
      // For simplicity: total loan payments over full loan term + down
      const buyPayments = loanMo * loanM;
      const buyGross = buyPayments + buyDown;

      // Estimated car value at lease-end (term months, compounded monthly)
      const monthlyDepRate = Math.pow(1 - depRate, 1/12);
      var carValue = msrp;
      for (var m = 0; m < term; m++) { carValue *= monthlyDepRate; }
      const buyNet = buyGross - carValue;

      // Populate
      $('lva-lease-payments').textContent = fmt(leasePayments);
      $('lva-lease-down').textContent     = fmt(down);
      $('lva-lease-acq').textContent      = fmt(acq);
      $('lva-lease-disp').textContent     = fmt(disp);
      $('lva-lease-total').textContent    = fmt(leaseTotalCost);

      $('lva-buy-payments').textContent   = fmt(buyPayments);
      $('lva-buy-down').textContent       = fmt(buyDown);
      $('lva-buy-gross').textContent      = fmt(buyGross);
      $('lva-buy-equity').textContent     = fmt(carValue);
      $('lva-buy-total').textContent      = fmt(buyNet);

      // Verdict
      var verdict = $('lva-verdict');
      var diff = Math.abs(leaseTotalCost - buyNet);
      if (leaseTotalCost < buyNet) {
        verdict.className = 'rounded-xl p-4 text-center text-sm font-semibold bg-sky-50 border border-sky-200 text-sky-800';
        verdict.textContent = 'Leasing saves an estimated ' + fmt(diff) + ' over ' + term + ' months compared to buying (net of equity).';
      } else if (buyNet < leaseTotalCost) {
        verdict.className = 'rounded-xl p-4 text-center text-sm font-semibold bg-emerald-50 border border-emerald-200 text-emerald-800';
        verdict.textContent = 'Buying saves an estimated ' + fmt(diff) + ' over ' + term + ' months compared to leasing (net of equity).';
      } else {
        verdict.className = 'rounded-xl p-4 text-center text-sm font-semibold bg-slate-50 border border-slate-200 text-slate-700';
        verdict.textContent = 'Lease and buy costs are roughly equal over ' + term + ' months.';
      }
    }

    function calcTco(){ const price=val('t-price'), ins=val('t-ins'), fuel=val('t-fuel'), maint=val('t-maint'), reg=val('t-reg'), resale=val('t-resale'); const spent=price+(ins+fuel+maint+reg)*5; const net=spent-resale; $('t-out-spent').textContent='$'+spent.toLocaleString(); $('t-out-resale').textContent='$'+resale.toLocaleString(); $('t-out-net').textContent='$'+net.toLocaleString(); }
    function calcFuel(){ const miles=val('fuel-miles'), mpg=val('fuel-mpg'), price=val('fuel-price'); $('fuel-out').textContent='$'+((miles/mpg)*price).toFixed(0); }
    function calcDep(){ const price=val('d-price'); const rates={avg:0.15,steep:0.20,gentle:0.10}; const rate=rates[$('d-method').value]; let tbody=''; let v=price; for(let y=1;y<=5;y++){ const lost=v*rate; v-=lost; tbody+='<tr class="border-b border-slate-100"><td class="py-2">Year '+y+'</td><td class="py-2 text-right font-medium">$'+v.toFixed(0)+'</td><td class="py-2 text-right text-red-600">-$'+lost.toFixed(0)+'</td></tr>'; } $('d-table').innerHTML=tbody; }

    // Money factor APR converter
    function updateMFApr() {
      const mf = parseFloat($('l-mf').value) || 0;
      const apr = (mf * 2400).toFixed(2);
      $('l-mf-apr').textContent = mf > 0 ? '≈ ' + apr + '% APR' : '';
    }
    $('l-mf').addEventListener('input', updateMFApr);
    updateMFApr();

    // Vehicle comparison
    function calcLeaseSimple(msrp, residualPct, mf, months, downPayment) {
      const residual = msrp * residualPct / 100;
      const netCapCost = msrp - downPayment;
      const depFee = (netCapCost - residual) / months;
      const finFee = (netCapCost + residual) * mf;
      const monthly = depFee + finFee;
      return { monthly, residual, totalCost: monthly * months + downPayment };
    }

    function calcCompare() {
      const a = calcLeaseSimple(
        parseFloat($('cmp-a-msrp').value)||0,
        parseFloat($('cmp-a-res').value)||0,
        parseFloat($('cmp-a-mf').value)||0,
        parseFloat($('cmp-a-term').value)||1,
        parseFloat($('cmp-a-down').value)||0
      );
      const b = calcLeaseSimple(
        parseFloat($('cmp-b-msrp').value)||0,
        parseFloat($('cmp-b-res').value)||0,
        parseFloat($('cmp-b-mf').value)||0,
        parseFloat($('cmp-b-term').value)||1,
        parseFloat($('cmp-b-down').value)||0
      );
      const rows = [
        ['Monthly payment', fmt(a.monthly), fmt(b.monthly)],
        ['Total cost (payments + down)', fmt(a.totalCost), fmt(b.totalCost)],
        ['Residual value', fmt(a.residual), fmt(b.residual)],
      ];
      $('cmp-table').innerHTML = rows.map(([label, aVal, bVal]) =>
        '<tr class="hover:bg-slate-50">' +
          '<td class="py-2 px-3 text-slate-700">' + label + '</td>' +
          '<td class="py-2 px-3 text-right font-semibold text-sky-700">' + aVal + '</td>' +
          '<td class="py-2 px-3 text-right font-semibold text-emerald-700">' + bVal + '</td>' +
        '</tr>'
      ).join('');
    }

    ['cmp-a-msrp','cmp-a-res','cmp-a-mf','cmp-a-term','cmp-a-down','cmp-b-msrp','cmp-b-res','cmp-b-mf','cmp-b-term','cmp-b-down'].forEach(id=>$(id)?.addEventListener('input',calcCompare));
    calcCompare();

    ['l-msrp','l-term','l-mf','l-res','l-down','l-apr','l-loan'].forEach(id=>$(id)?.addEventListener('input',calcLease));
    ['lva-acq','lva-disp','lva-buydown','lva-dep'].forEach(id=>$(id)?.addEventListener('input',calcLease));
    ['t-price','t-ins','t-fuel','t-maint','t-reg','t-resale'].forEach(id=>$(id)?.addEventListener('input',calcTco));
    ['fuel-miles','fuel-mpg','fuel-price'].forEach(id=>$(id)?.addEventListener('input',calcFuel));
    ['d-price','d-method'].forEach(id=>$(id)?.addEventListener('input',calcDep));
    calcLease(); calcTco(); calcFuel(); calcDep();
  </script>
</BaseLayout>
