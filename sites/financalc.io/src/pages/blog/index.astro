---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '~/config/site.config';
import { existsSync } from 'node:fs';
import path from 'node:path';

if (!siteConfig.features.hasBlog) return Astro.redirect('/');

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const imgDir = path.join(process.cwd(), 'public', 'images', 'blog');
const postsWithImages = posts.map((post) => ({
  ...post,
  heroSrc: existsSync(path.join(imgDir, `${post.slug}-hero.png`))
    ? `/images/blog/${post.slug}-hero.png`
    : null,
}));
---
<BaseLayout title="Financial Guides" description={`Finance articles and guides from ${siteConfig.identity.name}`}>
  <header class="pb-8 pt-2">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">Financial Guides</h1>
    <p class="mt-2 text-lg text-slate-600">Plain-English guides to loans, investing, and personal finance.</p>
  </header>
  <ul class="grid gap-5 sm:grid-cols-2">
    {postsWithImages.map((post) => (
      <li>
        <a
          href={`/blog/${post.slug}/`}
          class="group block rounded-xl border border-slate-200 bg-white transition hover:border-blue-300 hover:shadow-sm"
        >
          {post.heroSrc && (
            <div class="aspect-video overflow-hidden rounded-t-xl">
              <img
                src={post.heroSrc}
                alt=""
                width="600"
                height="315"
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="p-5">
            <time
              datetime={post.data.publishDate.toISOString()}
              class="text-xs font-medium uppercase tracking-wide text-slate-400"
            >
              {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h2 class="mt-1 text-lg font-semibold text-slate-900 group-hover:text-blue-700">{post.data.title}</h2>
            <p class="mt-1 text-sm text-slate-600 line-clamp-2">{post.data.description}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
