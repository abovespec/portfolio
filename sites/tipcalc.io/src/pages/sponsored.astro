---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FAQ from '~/components/FAQ.astro';
import { siteConfig } from '~/config/site.config';

// Static until the sponsored-post engine provides DR/traffic figures at build
// time. A future iteration should read packages/sponsored-data at build.
const metrics = {
  domainRating: 'DR __',
  monthlyTraffic: '__ / mo',
  niche: 'See about page',
};

const tiers = [
  { name: 'Standard', price: '$—', features: ['1 do-follow link', 'Permanent placement', '48-72h turnaround'] },
  { name: 'Premium', price: '$—', features: ['2 do-follow links', 'Homepage feature 7 days', 'Social share'] },
  { name: 'Package', price: '$—', features: ['3 posts / month', 'Bulk discount', 'Dedicated editor'] },
];

const faq = [
  { question: 'Do you accept sponsored posts?', answer: 'Yes. We accept a limited number of high-quality sponsored posts each month from vetted partners.' },
  { question: 'What niches do you accept?', answer: 'Content must be topically relevant to the site. We reject gambling, adult, and illicit-substance content.' },
  { question: 'Do links pass authority?', answer: 'All links are do-follow unless the content is clearly promotional, in which case we label with rel="sponsored" per Google guidelines.' },
  { question: 'What is the turnaround?', answer: '48–72 hours from payment and approved copy. Revisions included once.' },
  { question: 'Can I supply the copy?', answer: 'Yes, subject to editorial review. We reserve the right to decline or request revisions.' },
];

if (!siteConfig.features.hasSponsoredIntake) return Astro.redirect('/');
---
<BaseLayout title="Sponsored posts & partnerships" description={`Sponsored post opportunities on ${siteConfig.identity.name}.`}>
  <header class="py-8">
    <h1 class="text-4xl font-bold">Sponsored posts on {siteConfig.identity.name}</h1>
    <p class="mt-3 max-w-2xl text-lg text-slate-600">
      Partner with us to reach a highly targeted audience. All placements are
      editorially reviewed.
    </p>
  </header>

  <section class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Domain Rating</p>
      <p class="mt-2 text-2xl font-semibold">{metrics.domainRating}</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Monthly Traffic</p>
      <p class="mt-2 text-2xl font-semibold">{metrics.monthlyTraffic}</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Niche</p>
      <p class="mt-2 text-2xl font-semibold">{metrics.niche}</p>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-semibold">Pricing tiers</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      {tiers.map((t) => (
        <div class="rounded-lg border border-slate-200 bg-white p-6">
          <h3 class="text-lg font-semibold">{t.name}</h3>
          <p class="mt-2 text-3xl font-bold">{t.price}</p>
          <ul class="mt-4 space-y-1 text-sm text-slate-700">
            {t.features.map((f) => <li>• {f}</li>)}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-2 text-xs text-slate-500">Pricing will be auto-populated by the sponsored-post engine per site.</p>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-semibold">Request a placement</h2>
    <form class="mt-4 grid max-w-xl gap-4" method="post" action={`mailto:${siteConfig.org.contactEmail}`} enctype="text/plain">
      <label class="grid gap-1 text-sm">
        <span class="font-medium">Your name</span>
        <input required name="name" type="text" class="rounded border border-slate-300 px-3 py-2" />
      </label>
      <label class="grid gap-1 text-sm">
        <span class="font-medium">Email</span>
        <input required name="email" type="email" class="rounded border border-slate-300 px-3 py-2" />
      </label>
      <label class="grid gap-1 text-sm">
        <span class="font-medium">Company / site</span>
        <input name="company" type="text" class="rounded border border-slate-300 px-3 py-2" />
      </label>
      <label class="grid gap-1 text-sm">
        <span class="font-medium">Preferred tier</span>
        <select name="tier" class="rounded border border-slate-300 px-3 py-2">
          {tiers.map((t) => <option>{t.name}</option>)}
        </select>
      </label>
      <label class="grid gap-1 text-sm">
        <span class="font-medium">Topic & link target</span>
        <textarea required name="brief" rows="5" class="rounded border border-slate-300 px-3 py-2"></textarea>
      </label>
      <button type="submit" class="justify-self-start rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">
        Submit inquiry
      </button>
    </form>
  </section>

  <FAQ items={faq} />
</BaseLayout>
