---
import { siteConfig } from '~/config/site.config';
const { primary } = siteConfig.nav;
const { logoText } = siteConfig.branding;
const { hasBlog, hasTool, hasGame, hasSponsoredIntake } = siteConfig.features;

// Hide feature-flagged nav items when their collections are disabled.
const featureGate: Record<string, boolean> = {
  '/blog/': hasBlog,
  '/tools/': hasTool,
  '/games/': hasGame,
  '/sponsored/': hasSponsoredIntake,
};
const items = primary.filter((l) => !(l.href in featureGate) || featureGate[l.href]);
---
<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <a href="/" class="text-xl font-bold tracking-tight text-slate-900">{logoText}</a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-6 text-sm font-medium text-slate-700">
        {items.map((l) => (
          <li><a href={l.href} class="hover:text-slate-900">{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
