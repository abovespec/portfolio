---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
import StatusChecker from '~/components/StatusChecker';
---
<BaseLayout title="Is Dropbox Down Right Now? Status & Outage Report | IsItDown" description="Check if Dropbox is down today. Current status, outage history, common problems, and troubleshooting steps for dropbox.com.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Is Dropbox Down Right Now?</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Current status, outage history, and troubleshooting for Dropbox (dropbox.com).</p>
  </section>

  <div class="mx-auto max-w-4xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-xl font-semibold text-slate-800">Dropbox Status</h2>
          <p class="text-sm text-slate-500">dropbox.com • Cloud Storage</p>
        </div>
        <StatusChecker domain="dropbox.com" client:load />
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 mb-8">
      <div class="rounded-xl border border-slate-200 bg-white p-5">
        <h3 class="font-semibold text-slate-800 mb-2">About Dropbox</h3>
        <p class="text-sm text-slate-600">Dropbox is a cloud storage and file synchronization service with over 700 million registered users, offering collaboration tools and document editing.</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-5">
        <h3 class="font-semibold text-slate-800 mb-2">Official Status Page</h3>
        <p class="text-sm text-slate-600 mb-3">Check the official status page for confirmed incidents and maintenance windows.</p>
        <a href="https://status.dropbox.com/" target="_blank" rel="noopener" class="inline-block rounded-lg bg-gray-600 px-4 py-2 text-sm text-white font-medium hover:bg-gray-700">Visit Official Status Page</a>
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Common Dropbox Issues</h2>
      <ul class="list-disc list-inside space-y-2 text-slate-600">
            <li>Files not syncing across devices</li>
            <li>Uploads stuck at 100%</li>
            <li>Shared links not working</li>
            <li>Desktop app high CPU usage</li>
            <li>Paper documents not loading</li>
      </ul>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">How to Check If Dropbox Is Down</h2>
      <div class="space-y-3 text-sm text-slate-600">
        <p><strong>1. Check multiple devices:</strong> Try accessing dropbox.com from your phone, another browser, or an incognito window to rule out local cache issues.</p>
        <p><strong>2. Use our checker:</strong> Enter the URL in our status checker above to see if the server responds.</p>
        <p><strong>3. Check social media:</strong> Search Twitter/X for "Dropbox down" to see if others are reporting issues.</p>
        <p><strong>4. Visit the official status page:</strong> Dropbox's official status page lists confirmed outages and maintenance windows.</p>
        <p><strong>5. Try a different DNS:</strong> Switch to Google DNS (8.8.8.8) or Cloudflare DNS (1.1.1.1) to rule out DNS resolution problems.</p>
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Alternatives to Dropbox</h2>
      <p class="text-sm text-slate-600 mb-3">If Dropbox is experiencing prolonged downtime, consider these alternatives:</p>
      <p class="text-sm font-medium text-slate-800">Google Drive, OneDrive, pCloud</p>
    </div>

    <div class="my-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Related Searches</h2>
      <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">is dropbox down</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">dropbox not syncing</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">dropbox outage</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">dropbox status today</span>
            <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">dropbox not working</span>
      </div>
    </div>
  </div>
</BaseLayout>
