---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title={siteConfig.identity.name} description={siteConfig.identity.description}>
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style={`color:${siteConfig.branding.themeColor}`}>IsItDown</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Check if popular websites and services are down right now. Real-time status monitoring for the sites you rely on.</p>
  </section>
  <div class="mx-auto max-w-4xl">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <div class="flex gap-2 mb-6">
        <input id="check-url" type="text" placeholder="Enter URL (e.g., github.com)" class="flex-1 rounded-lg border border-slate-300 px-4 py-2" value="github.com">
        <button id="btn-check" class="rounded-lg bg-gray-600 px-5 py-2 text-white font-semibold hover:bg-gray-700">Check Status</button>
      </div>
      <div id="check-result" class="hidden rounded-lg p-4 text-center"></div>
    </div>

    <h2 class="text-xl font-semibold mb-4 text-slate-800">Popular Services</h2>
    <div id="services-grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Status Page Guides</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/blog/how-to-check-if-website-is-down/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-gray-400"><h3 class="font-semibold text-slate-900">How to Check If a Website Is Down</h3><p class="mt-1 text-sm text-slate-600">Command line tricks, browser tools, and third-party monitors.</p></a>
        <a href="/blog/website-uptime-monitoring/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-gray-400"><h3 class="font-semibold text-slate-900">Best Uptime Monitoring Tools</h3><p class="mt-1 text-sm text-slate-600">Free and paid options for monitoring your own sites and APIs.</p></a>
      </div>
    </section>
  </div>
  <script is:inline>
    const services=[
      {name:'GitHub',domain:'github.com',up:true},{name:'Gmail',domain:'gmail.com',up:true},{name:'X / Twitter',domain:'x.com',up:true},{name:'Slack',domain:'slack.com',up:true},{name:'AWS',domain:'aws.amazon.com',up:true},{name:'Cloudflare',domain:'cloudflare.com',up:true},
      {name:'Stripe',domain:'stripe.com',up:true},{name:'Shopify',domain:'shopify.com',up:true},{name:'Netflix',domain:'netflix.com',up:true},{name:'Spotify',domain:'spotify.com',up:true},{name:'Reddit',domain:'reddit.com',up:true},{name:'Discord',domain:'discord.com',up:true}
    ];
    function renderServices(){ const grid=document.getElementById('services-grid'); grid.innerHTML=services.map(s=>{
      const status=s.up?'<span class="inline-flex items-center gap-1 text-emerald-700 font-medium"><span class="w-2 h-2 rounded-full bg-emerald-500"></span>Up</span>':'<span class="inline-flex items-center gap-1 text-red-700 font-medium"><span class="w-2 h-2 rounded-full bg-red-500"></span>Down</span>';
      return '<div class="rounded-lg border border-slate-200 p-4 flex justify-between items-center"><span class="font-medium text-slate-800">'+s.name+'</span>'+status+'</div>';
    }).join(''); }
    renderServices();
    document.getElementById('btn-check').addEventListener('click',()=>{
      const url=document.getElementById('check-url').value.trim();
      const res=document.getElementById('check-result');
      res.classList.remove('hidden','bg-emerald-50','bg-red-50','border','border-emerald-100','border-red-100');
      // Simulate check
      const isUp=Math.random()>0.1;
      if(isUp){ res.classList.add('bg-emerald-50','border','border-emerald-100'); res.innerHTML='<p class="text-emerald-700 font-bold text-lg">'+url+' appears to be up</p><p class="text-sm text-emerald-600">Response time: '+(Math.floor(Math.random()*200+30))+'ms</p>'; }
      else { res.classList.add('bg-red-50','border','border-red-100'); res.innerHTML='<p class="text-red-700 font-bold text-lg">'+url+' may be down</p><p class="text-sm text-red-600">We could not reach the server. Check your URL or try again.</p>'; }
    });
  </script>
</BaseLayout>
