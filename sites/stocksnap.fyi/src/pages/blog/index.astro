---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '~/config/site.config';
import { existsSync } from 'node:fs';
import path from 'node:path';

if (!siteConfig.features.hasBlog) return Astro.redirect('/');

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const imgDir = path.join(process.cwd(), 'public', 'images', 'blog');
const postsWithImages = posts.map((post) => ({
  ...post,
  heroSrc: existsSync(path.join(imgDir, `${post.slug}-hero.png`))
    ? `/images/blog/${post.slug}-hero.png`
    : null,
}));
---
<BaseLayout title="Blog" description={`Articles from ${siteConfig.identity.name}`}>
  <h1 class="text-4xl font-bold">Blog</h1>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {postsWithImages.map((post) => (
      <li class="rounded-lg border border-slate-700 bg-slate-800 hover:border-amber-400">
        <a href={`/blog/${post.slug}/`} class="block">
          {post.heroSrc && (
            <div class="aspect-video overflow-hidden rounded-t-lg">
              <img
                src={post.heroSrc}
                alt=""
                width="600"
                height="315"
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="p-4">
            <h2 class="text-lg font-medium text-white">{post.data.title}</h2>
            <p class="mt-1 text-sm text-slate-300">{post.data.description}</p>
            <time class="mt-2 block text-xs text-slate-400" datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
