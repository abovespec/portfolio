---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NicheCard from '~/components/NicheCard.astro';
import ImageCard from '~/components/ImageCard.astro';
import { NICHE_LIST } from '~/data/niches';
import images from '~/data/images.json';

const nicheCards = NICHE_LIST.map(niche => {
  const sample = images.find(img => img.niche === niche.key);
  return {
    ...niche,
    sampleImagePath: sample?.imagePath ?? '',
    count: images.filter(img => img.niche === niche.key).length,
  };
});

// One featured image from each niche for variety
const featured = NICHE_LIST.map(niche =>
  images.find(img => img.niche === niche.key && img.style === 'warm')
).filter(Boolean).slice(0, 8);
---
<BaseLayout
  title="Free AI Stock Photos - Download Free High-Quality Images | StockSnap"
  description="980 free AI-generated stock photos. Abstract backgrounds, bokeh, food flatlay, workspace, interiors, nature macro, and sci-tech. Free to download, no signup."
>
  <!-- Hero -->
  <section class="text-center py-12 px-4">
    <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
      Free AI Stock Photos
    </h1>
    <p class="text-slate-400 text-lg max-w-2xl mx-auto mb-8">
      980 high-quality WebP images across 7 niches. Free to download, no signup required.
    </p>
    <a href="/browse/" class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-500 hover:bg-indigo-400 text-white font-semibold rounded-lg transition-colors text-lg">
      Browse All Photos
    </a>
  </section>

  <!-- Niche Grid -->
  <section class="mb-14">
    <h2 class="text-2xl font-bold text-white mb-6">Browse by Category</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {nicheCards.map(niche => (
        <NicheCard
          display={niche.display}
          slug={niche.slug}
          description={niche.description}
          sampleImagePath={niche.sampleImagePath}
          count={niche.count}
        />
      ))}
    </div>
  </section>

  <!-- Featured Images -->
  <section class="mb-14">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-white">Featured Photos</h2>
      <a href="/browse/" class="text-indigo-400 hover:text-indigo-300 text-sm font-medium transition-colors">View all →</a>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
      {featured.map(img => img && (
        <ImageCard
          title={img.title}
          imagePath={img.imagePath}
          altText={img.altText}
          href={`/${img.nicheSlug}/${img.clusterSlug}/${img.slug}/`}
          style={img.styleLabel}
          cluster={img.clusterDisplay}
        />
      ))}
    </div>
  </section>

  <!-- Value proposition -->
  <section class="rounded-xl border border-slate-700 bg-slate-800 p-8 mb-8 text-center">
    <h2 class="text-xl font-bold text-white mb-3">100% Free to Use</h2>
    <p class="text-slate-400 max-w-xl mx-auto">
      All images are AI-generated and free to use for personal and commercial projects. No attribution required, no signup needed. Download in high-quality WebP format.
    </p>
  </section>
</BaseLayout>
