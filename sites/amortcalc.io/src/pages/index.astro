---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout title="Amortization Calculator" description="Generate loan amortization schedules and see total interest paid.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-center mb-2">Amortization Calculator</h1>
    <p class="text-center text-gray-500 mb-8">Generate loan amortization schedules and see total interest paid.</p>

    <div class="bg-gray-50 border border-gray-300 rounded-xl p-6 mb-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1">Loan Amount ($)</label>
          <input id="principal" type="number" value="300000" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Interest Rate (%)</label>
          <input id="rate" type="number" step="0.01" value="6.5" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2">
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Term (years)</label>
          <input id="years" type="number" value="30" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2">
        </div>
      </div>
      <button onclick="calculate()" class="w-full mt-4 px-6 py-3 bg-neutral-700 hover:bg-neutral-600 text-white rounded-lg font-medium transition">Calculate Schedule</button>
    </div>

    <div id="summary" class="hidden grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
      <div class="bg-gray-50 border border-gray-300 rounded-xl p-4 text-center">
        <div class="text-sm text-gray-400">Monthly Payment</div>
        <div id="monthly" class="text-2xl font-bold text-neutral-600">--</div>
      </div>
      <div class="bg-gray-50 border border-gray-300 rounded-xl p-4 text-center">
        <div class="text-sm text-gray-400">Total Interest</div>
        <div id="total-interest" class="text-2xl font-bold text-red-600">--</div>
      </div>
      <div class="bg-gray-50 border border-gray-300 rounded-xl p-4 text-center">
        <div class="text-sm text-gray-400">Total Cost</div>
        <div id="total-cost" class="text-2xl font-bold">--</div>
      </div>
    </div>

    <div id="schedule-wrapper" class="hidden bg-gray-50 border border-gray-300 rounded-xl p-4 overflow-auto" style="max-height:400px">
      <table class="w-full text-sm">
        <thead class="sticky top-0 bg-gray-100">
          <tr>
            <th class="px-3 py-2 text-left">Month</th>
            <th class="px-3 py-2 text-right">Payment</th>
            <th class="px-3 py-2 text-right">Principal</th>
            <th class="px-3 py-2 text-right">Interest</th>
            <th class="px-3 py-2 text-right">Balance</th>
          </tr>
        </thead>
        <tbody id="schedule-body"></tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    function calculate() {
      const P = parseFloat(document.getElementById('principal').value) || 0;
      const r = (parseFloat(document.getElementById('rate').value) || 0) / 100 / 12;
      const n = (parseFloat(document.getElementById('years').value) || 0) * 12;
      if (!P || !r || !n) return;
      const monthly = P * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
      let balance = P;
      let totalInterest = 0;
      const tbody = document.getElementById('schedule-body');
      tbody.innerHTML = '';
      for (let i = 1; i <= n; i++) {
        const interest = balance * r;
        const principal = monthly - interest;
        balance -= principal;
        totalInterest += interest;
        if (i <= 120 || i % 12 === 0 || i === n) {
          const row = document.createElement('tr');
          row.className = 'border-b border-gray-200';
          row.innerHTML = '<td class="px-3 py-1">' + i + '</td><td class="px-3 py-1 text-right">$' + monthly.toFixed(2) + '</td><td class="px-3 py-1 text-right">$' + principal.toFixed(2) + '</td><td class="px-3 py-1 text-right">$' + interest.toFixed(2) + '</td><td class="px-3 py-1 text-right">$' + Math.max(0, balance).toFixed(2) + '</td>';
          tbody.appendChild(row);
        }
      }
      document.getElementById('monthly').textContent = '$' + monthly.toFixed(2);
      document.getElementById('total-interest').textContent = '$' + totalInterest.toFixed(2);
      document.getElementById('total-cost').textContent = '$' + (P + totalInterest).toFixed(2);
      document.getElementById('summary').classList.remove('hidden');
      document.getElementById('schedule-wrapper').classList.remove('hidden');
    }
  </script>
</BaseLayout>
