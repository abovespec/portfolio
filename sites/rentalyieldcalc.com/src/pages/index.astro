---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title={siteConfig.identity.name} description={siteConfig.identity.description}>
  <section class="relative -mx-4 overflow-hidden px-4 py-14 sm:py-20">
    <div class="absolute inset-0 bg-gradient-to-br from-emerald-50 via-green-50 to-teal-50" aria-hidden="true" />
    <div class="absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-emerald-300/20 blur-3xl" aria-hidden="true" />
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-green-300/15 blur-3xl" aria-hidden="true" />
    <div class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">RentalYieldCalc</h1>
        <p class="mt-3 text-lg text-slate-600">Rental yield, cap rate, cash-on-cash return, and fix-and-flip profit calculators for property investors.</p>
      </div>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {['Rental yield & cap rate calculator', 'Cash-on-cash return analysis', 'Fix-and-flip profit estimator', 'No data stored or shared'].map((badge) => (
          <li class="flex items-center gap-1.5">
            <svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
            </svg>
            {badge}
          </li>
        ))}
      </ul>
    </div>
  </section>
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-wrap gap-2 justify-center mb-8">
      <button id="tab-ry" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-amber-600 text-white">Rental Yield</button>
      <button id="tab-cr" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Cap Rate</button>
      <button id="tab-coc" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Cash-on-Cash</button>
      <button id="tab-flip" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Fix & Flip</button>
    </div>

    <div id="panel-ry" class="calc-panel">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Rental Yield Calculator</h2>

        <!-- Properties container -->
        <div id="ry-properties" class="space-y-4"></div>
        <button id="ry-add-prop" class="mt-3 text-sm text-amber-600 hover:text-amber-800 font-medium">+ Add property</button>

        <!-- CapEx reserve -->
        <div class="mt-5 pt-4 border-t border-slate-100">
          <label class="flex items-center gap-3">
            <div class="flex-1">
              <span class="text-sm font-medium text-slate-700">CapEx reserve (% of value/year)</span>
              <p class="text-xs text-slate-400">e.g. 1.5% = major repair fund</p>
            </div>
            <input id="ry-capex" type="number" value="1.5" step="0.1" min="0" class="w-24 rounded-lg border border-slate-300 px-3 py-2 text-sm">
          </label>
        </div>

        <!-- Multi-property comparison table -->
        <div id="ry-comparison" class="mt-6 hidden overflow-x-auto">
          <p class="text-sm font-semibold text-slate-700 mb-2">Property Comparison</p>
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200">
                <th class="text-left py-2 px-3 font-semibold text-slate-600">Property</th>
                <th class="text-right py-2 px-3 font-semibold text-slate-600">Cap Rate</th>
                <th class="text-right py-2 px-3 font-semibold text-slate-600">Gross Yield</th>
                <th class="text-right py-2 px-3 font-semibold text-slate-600">Net Cash Flow/mo</th>
              </tr>
            </thead>
            <tbody id="ry-compare-body" class="divide-y divide-slate-100"></tbody>
          </table>
        </div>

        <!-- Single-property summary (shown when only 1 property) -->
        <div id="ry-single-summary" class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Gross yield</p><p id="ry-gross" class="text-xl font-bold text-slate-800">6.67%</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Net yield</p><p id="ry-net" class="text-xl font-bold text-slate-800">5.07%</p></div>
          <div class="rounded-lg bg-amber-50 p-4 text-center border border-amber-100"><p class="text-xs uppercase text-amber-600">Monthly cash flow</p><p id="ry-cf" class="text-xl font-bold text-amber-700">$1,775</p></div>
        </div>
      </div>
    </div>

    <div id="panel-cr" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Cap Rate Calculator</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Net operating income ($/yr)</span><input id="cr-noi" type="number" value="22800" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Property value ($)</span><input id="cr-value" type="number" value="450000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 rounded-lg bg-amber-50 p-4 text-center border border-amber-100">
          <p class="text-xs uppercase text-amber-600">Cap rate</p>
          <p id="cr-out" class="text-3xl font-bold text-amber-700">5.07%</p>
        </div>
      </div>
    </div>

    <div id="panel-coc" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Cash-on-Cash Return</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Annual pre-tax cash flow ($)</span><input id="coc-cf" type="number" value="8400" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Total cash invested ($)</span><input id="coc-invest" type="number" value="100000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 rounded-lg bg-amber-50 p-4 text-center border border-amber-100">
          <p class="text-xs uppercase text-amber-600">Cash-on-cash return</p>
          <p id="coc-out" class="text-3xl font-bold text-amber-700">8.40%</p>
        </div>
      </div>
    </div>

    <div id="panel-flip" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Fix-and-Flip Profit Calculator</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">After-repair value (ARV) ($)</span><input id="f-arv" type="number" value="550000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Purchase price ($)</span><input id="f-buy" type="number" value="380000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Repair costs ($)</span><input id="f-repair" type="number" value="45000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Holding costs ($)</span><input id="f-hold" type="number" value="8000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Selling costs (%)</span><input id="f-sell" type="number" value="6" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Selling costs</p><p id="f-out-sell" class="text-xl font-bold text-slate-800">$33,000</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Total investment</p><p id="f-out-invest" class="text-xl font-bold text-slate-800">$433,000</p></div>
          <div class="rounded-lg bg-amber-50 p-4 text-center border border-amber-100"><p class="text-xs uppercase text-amber-600">Net profit</p><p id="f-out-profit" class="text-xl font-bold text-amber-700">$84,000</p></div>
        </div>
      </div>
    </div>

    <aside
      role="note"
      class="mx-auto my-6 max-w-5xl rounded-lg border border-amber-200 bg-amber-50/80 p-3 text-sm text-amber-900"
    >
      <strong class="font-semibold">Important:</strong> All calculators provide estimates for
      informational purposes only. Results do not constitute financial, legal, or tax advice.
      Consult a licensed financial advisor before making decisions.
    </aside>
    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Real Estate Investing Guides</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/blog/what-is-a-good-rental-yield-in-2025-benchmarks-by-market/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-amber-400"><h3 class="font-semibold text-slate-900">What Is a Good Rental Yield?</h3><p class="mt-1 text-sm text-slate-600">Benchmarks by city and property type. When gross yield is misleading.</p></a>
        <a href="/blog/cap-rate-calculator-by-zip-code-measure-property-performance/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-amber-400"><h3 class="font-semibold text-slate-900">Cap Rate vs Cash-on-Cash Return</h3><p class="mt-1 text-sm text-slate-600">Which metric matters for your strategy and how to use them together.</p></a>
        <a href="/blog/fix-and-flip-profit-calculator-estimate-your-next-deal-accurately/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-amber-400"><h3 class="font-semibold text-slate-900">Fix-and-Flip Profit: The 70% Rule</h3><p class="mt-1 text-sm text-slate-600">How to estimate ARV, repair budgets, and holding costs before you buy.</p></a>
        <a href="/blog/rental-property-roi-calculator-total-return-on-investment/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-amber-400"><h3 class="font-semibold text-slate-900">Rental Property Analysis Spreadsheet</h3><p class="mt-1 text-sm text-slate-600">Free downloadable template and walkthrough of every line item.</p></a>
      </div>
    </section>
  </div>
  <script is:inline>
    function $(id){ return document.getElementById(id); }
    function val(id){ return parseFloat($(id).value) || 0; }
    const tabs = ['ry','cr','coc','flip'];
    tabs.forEach(t => {
      $('tab-'+t).addEventListener('click', () => {
        tabs.forEach(x => { $('panel-'+x).classList.add('hidden'); $('tab-'+x).classList.remove('bg-amber-600','text-white'); $('tab-'+x).classList.add('bg-slate-200','text-slate-700'); });
        $('panel-'+t).classList.remove('hidden'); $('tab-'+t).classList.remove('bg-slate-200','text-slate-700'); $('tab-'+t).classList.add('bg-amber-600','text-white');
      });
    });
    // Multi-property tracker
    let ryProps = [];
    let ryPropCounter = 0;

    function calcPropData(el) {
      const rent = parseFloat(el.querySelector('.ry-p-rent').value)||0;
      const value = parseFloat(el.querySelector('.ry-p-value').value)||0;
      const exp = parseFloat(el.querySelector('.ry-p-exp').value)||0;
      const vac = parseFloat(el.querySelector('.ry-p-vac').value)||0;
      const capexRate = parseFloat($('ry-capex').value)||0;
      const annualCapex = value * capexRate / 100;
      const grossCF = rent*(1-vac/100) - exp;
      const netCashFlow = grossCF - annualCapex/12;
      const gross = value > 0 ? (rent*12/value)*100 : 0;
      const net = value > 0 ? ((rent*12*(1-vac/100)-exp*12)/value)*100 : 0;
      const capRate = value > 0 ? ((rent*12*(1-vac/100)-exp*12)/value)*100 : 0;
      return { gross, net, capRate, netCashFlow, annualCapex };
    }

    function renderRY() {
      const propEls = document.querySelectorAll('#ry-properties > div');
      if (propEls.length === 1) {
        // Single property summary
        $('ry-single-summary').classList.remove('hidden');
        $('ry-comparison').classList.add('hidden');
        const data = calcPropData(propEls[0]);
        $('ry-gross').textContent = data.gross.toFixed(2) + '%';
        $('ry-net').textContent = data.net.toFixed(2) + '%';
        $('ry-cf').textContent = '$' + data.netCashFlow.toFixed(0);
      } else {
        $('ry-single-summary').classList.add('hidden');
        $('ry-comparison').classList.remove('hidden');
        const rows = [];
        propEls.forEach((el, i) => {
          const data = calcPropData(el);
          const name = el.querySelector('.ry-p-name').value || ('Property ' + (i+1));
          const cfColor = data.netCashFlow >= 0 ? 'text-emerald-700' : 'text-red-600';
          rows.push(
            '<tr class="hover:bg-slate-50">' +
              '<td class="py-2 px-3 font-medium text-slate-700">' + name + '</td>' +
              '<td class="py-2 px-3 text-right">' + data.capRate.toFixed(2) + '%</td>' +
              '<td class="py-2 px-3 text-right">' + data.gross.toFixed(2) + '%</td>' +
              '<td class="py-2 px-3 text-right font-semibold ' + cfColor + '">$' + data.netCashFlow.toFixed(0) + '</td>' +
            '</tr>'
          );
        });
        $('ry-compare-body').innerHTML = rows.join('');
      }
    }

    function addRYProperty() {
      if (ryProps.length >= 3) return;
      const id = ++ryPropCounter;
      ryProps.push(id);
      const div = document.createElement('div');
      div.id = 'ry-prop-' + id;
      div.className = 'rounded-lg border border-slate-100 bg-slate-50 p-4';
      const canRemove = ryProps.length > 1;
      div.innerHTML =
        '<div class="flex items-center justify-between mb-3">' +
          '<input type="text" class="ry-p-name text-sm font-semibold text-slate-700 bg-transparent border-none outline-none w-48" placeholder="Property ' + ryProps.length + '">' +
          (canRemove ? '<button class="ry-remove-prop text-xs text-red-400 hover:text-red-600 font-medium">&times; Remove</button>' : '') +
        '</div>' +
        '<div class="grid gap-3 sm:grid-cols-2">' +
          '<label class="block"><span class="text-xs text-slate-600">Monthly rent ($)</span><input type="number" class="ry-p-rent mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="2500"></label>' +
          '<label class="block"><span class="text-xs text-slate-600">Property value ($)</span><input type="number" class="ry-p-value mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="450000"></label>' +
          '<label class="block"><span class="text-xs text-slate-600">Monthly expenses ($)</span><input type="number" class="ry-p-exp mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="600"></label>' +
          '<label class="block"><span class="text-xs text-slate-600">Vacancy rate (%)</span><input type="number" class="ry-p-vac mt-0.5 w-full rounded border border-slate-300 px-2 py-1.5 text-sm" value="5"></label>' +
        '</div>';
      $('ry-properties').appendChild(div);
      div.querySelectorAll('input').forEach(inp => inp.addEventListener('input', renderRY));
      const rmBtn = div.querySelector('.ry-remove-prop');
      if (rmBtn) {
        rmBtn.addEventListener('click', () => {
          ryProps = ryProps.filter(r => r !== id);
          div.remove();
          renderRY();
        });
      }
      renderRY();
    }

    $('ry-add-prop').addEventListener('click', addRYProperty);
    $('ry-capex').addEventListener('input', renderRY);
    addRYProperty(); // add first property

    function calcCR(){ const noi=val('cr-noi'), value=val('cr-value'); $('cr-out').textContent=((noi/value)*100).toFixed(2)+'%'; }
    function calcCOC(){ const cf=val('coc-cf'), invest=val('coc-invest'); $('coc-out').textContent=((cf/invest)*100).toFixed(2)+'%'; }
    function calcFlip(){ const arv=val('f-arv'), buy=val('f-buy'), repair=val('f-repair'), hold=val('f-hold'), sell=val('f-sell'); const sellCost=arv*(sell/100); const invest=buy+repair+hold; const profit=arv-sellCost-invest; $('f-out-sell').textContent='$'+sellCost.toFixed(0); $('f-out-invest').textContent='$'+invest.toFixed(0); $('f-out-profit').textContent='$'+profit.toFixed(0); }
    ['cr-noi','cr-value'].forEach(id => $('cr-'+id.split('-')[1])?.addEventListener('input',calcCR));
    ['coc-cf','coc-invest'].forEach(id => $('coc-'+id.split('-')[1])?.addEventListener('input',calcCOC));
    ['f-arv','f-buy','f-repair','f-hold','f-sell'].forEach(id => $('f-'+id.split('-')[1])?.addEventListener('input',calcFlip));
    calcCR(); calcCOC(); calcFlip();
  </script>
</BaseLayout>
