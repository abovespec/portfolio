---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import SchemaSoftwareApplication from '~/components/SchemaSoftwareApplication.astro';
import { siteUrl } from '~/config/site.config';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  slug: string;
  applicationCategory?: string;
  operatingSystem?: string;
  price?: string;
  priceCurrency?: string;
  ratingValue?: number;
  ratingCount?: number;
}

const {
  title, description, slug,
  applicationCategory, operatingSystem, price, priceCurrency, ratingValue, ratingCount,
} = Astro.props;

const url = new URL(Astro.url.pathname, siteUrl).toString();

const allTools = await getCollection('tools', ({ data }) => !data.draft);
const otherTools = allTools
  .filter((t) => t.data.urlSlug !== slug)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const TOOL_ICONS: Record<string, string> = {
  'percent-of':         '🔢',
  'percent-change':     '📊',
  'percent-off':        '🏷️',
  'percent-increase':   '📈',
  'percent-difference': '↔️',
};
---
<BaseLayout title={title} description={description}>

  <Breadcrumb items={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: title, url: `/tools/${slug}/` },
  ]} />

  <!-- Hero: centered calculator card with amber/orange gradient -->
  <section class="relative -mx-4 overflow-hidden px-4 py-12 sm:py-16">
    <div class="absolute inset-0 bg-gradient-to-br from-amber-50 via-yellow-50 to-orange-50" aria-hidden="true" />
    <div class="absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-amber-300/20 blur-3xl" aria-hidden="true" />
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-orange-300/15 blur-3xl" aria-hidden="true" />

    <div class="relative mx-auto max-w-2xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">{title}</h1>
      <p class="mt-3 text-lg text-slate-600">{description}</p>
    </div>

    <!-- Calculator card: centered, max 640px -->
    <div class="relative mx-auto mt-8 max-w-xl">
      <div class="rounded-2xl border border-white/80 bg-white p-6 shadow-lg sm:p-8">
        <slot name="tool" />
      </div>
    </div>
  </section>

  <!-- SEO prose content from Calliope -->
  <div class="prose prose-slate mt-12 max-w-none">
    <slot />
  </div>

  <slot name="faq" />

  <!-- Related tools strip -->
  {otherTools.length > 0 && (
    <section class="mt-12" aria-labelledby="related-heading">
      <h2 id="related-heading" class="text-xl font-bold text-slate-900">Other Percent Calculators</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {otherTools.map((tool) => (
          <li>
            <a
              href={`/tools/${tool.data.urlSlug}/`}
              class="group flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-brand/40 hover:shadow-sm"
            >
              <span class="text-2xl" aria-hidden="true">
                {TOOL_ICONS[tool.data.urlSlug] ?? '🧮'}
              </span>
              <span class="font-medium text-slate-800 group-hover:text-brand">{tool.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Footer: accuracy stamp -->
  <footer class="mt-16 border-t border-slate-200 pt-8 text-sm text-slate-500">
    <div class="flex items-center gap-2">
      <svg class="h-4 w-4 shrink-0 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M16.403 12.652a3 3 0 000-5.304 3 3 0 00-3.75-3.751 3 3 0 00-5.305 0 3 3 0 00-3.751 3.75 3 3 0 000 5.305 3 3 0 003.75 3.751 3 3 0 005.305 0 3 3 0 003.751-3.75zm-2.546-4.46a.75.75 0 00-1.214-.883l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
      </svg>
      <span>Formula reviewed for accuracy. Last reviewed: <time datetime="2026-04-25">April 25, 2026</time>.</span>
    </div>
  </footer>

  <SchemaSoftwareApplication
    name={title}
    description={description}
    url={url}
    applicationCategory={applicationCategory}
    operatingSystem={operatingSystem}
    price={price}
    priceCurrency={priceCurrency}
    ratingValue={ratingValue}
    ratingCount={ratingCount}
  />
</BaseLayout>
