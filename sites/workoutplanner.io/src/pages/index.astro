    // Parse exercises from a day string — extract the exercise name (before the colon or comma)
    function getExerciseName(token) {
      // Strip set/rep info — take text before ':'
      return token.split(':')[0].trim();
    }

    function findSubstitutions(name) {
      // Exact match first
      if (SUBSTITUTIONS[name]) return SUBSTITUTIONS[name];
      // Partial match
      for (const key of Object.keys(SUBSTITUTIONS)) {
        if (name.toLowerCase().includes(key.toLowerCase()) || key.toLowerCase().includes(name.toLowerCase())) {
          return SUBSTITUTIONS[key];
        }
      }
      return null;
    }

    function renderPlan(plan, goal) {
      swapState = {};
      let html = '<div class="grid gap-3">';
      plan.forEach((day, dayIdx) => {
        // Split exercises by pipe or comma (for day strings with multiple exercises)
        const tokens = day.split(/\s*\|\s*/);
        html += '<div class="rounded-lg border border-slate-200 p-4">';
        html += '<p class="text-xs font-bold uppercase text-red-600 mb-2">Day ' + (dayIdx + 1) + '</p>';
        html += '<div class="space-y-1.5">';
        tokens.forEach((token, exIdx) => {
          const key = dayIdx + '-' + exIdx;
          const exName = getExerciseName(token);
          const subs = findSubstitutions(exName);
          const hasSubs = subs && subs.length > 0;
          html += '<div class="flex items-center gap-2 flex-wrap" id="ex-row-' + key + '">';
          html += '<span class="text-slate-800 text-sm leading-relaxed" id="ex-text-' + key + '">' + token.trim() + '</span>';
          if (hasSubs) {
            html += '<button class="swap-btn text-xs bg-slate-100 hover:bg-rose-100 hover:text-rose-700 text-slate-500 px-2 py-0.5 rounded font-medium transition-colors" data-key="' + key + '" data-name="' + exName.replace(/"/g, '&quot;') + '">swap</button>';
          }
          html += '</div>';
          html += '<div id="swap-panel-' + key + '" class="hidden ml-2 mt-1 mb-2 rounded-lg border border-rose-100 bg-rose-50 p-3">';
          if (hasSubs) {
            html += '<p class="text-xs font-semibold text-rose-700 mb-2">Swap "' + exName + '" with:</p>';
            html += '<div class="flex flex-wrap gap-2">';
            subs.forEach(sub => {
              html += '<button class="sub-choice text-xs bg-white border border-rose-200 hover:bg-rose-600 hover:text-white text-rose-700 px-2.5 py-1 rounded font-medium transition-colors" data-key="' + key + '" data-sub="' + sub.replace(/"/g, '&quot;') + '" data-orig="' + token.trim().replace(/"/g, '&quot;') + '">' + sub + '</button>';
            });
            html += '</div>';
          }
          html += '</div>';
        });
        html += '</div></div>';
      });
      html += '</div>';
      document.getElementById('wp-result').innerHTML = html;

      // Attach swap button listeners
      document.querySelectorAll('.swap-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.key;
          const panel = document.getElementById('swap-panel-' + key);
          const isOpen = !panel.classList.contains('hidden');
          // Close all panels first
          document.querySelectorAll('[id^="swap-panel-"]').forEach(p => p.classList.add('hidden'));
          if (!isOpen) panel.classList.remove('hidden');
        });
      });

      // Attach substitution choice listeners
      document.querySelectorAll('.sub-choice').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.key;
          const sub = btn.dataset.sub;
          const orig = btn.dataset.orig;
          const textEl = document.getElementById('ex-text-' + key);
          const panel = document.getElementById('swap-panel-' + key);

          if (!swapState[key]) {
            swapState[key] = { original: orig };
          }

          // Get current set/rep info from original token (keep everything after first colon)
          const colonIdx = orig.indexOf(':');
          const setsReps = colonIdx >= 0 ? orig.substring(colonIdx) : '';
          const newText = sub + setsReps;

          textEl.innerHTML = '<span class="line-through text-slate-400 mr-1">' + (swapState[key].original.split(':')[0]) + '</span><span class="text-rose-700 font-medium">' + newText + '</span>';
          swapState[key].current = newText;

          // Update undo button
          panel.innerHTML = '<p class="text-xs text-rose-700">Swapped to <strong>' + sub + '</strong>. <button class="undo-btn underline font-medium" data-key="' + key + '">Undo</button></p>';
          panel.classList.remove('hidden');

          // Undo
          panel.querySelector('.undo-btn').addEventListener('click', () => {
            textEl.textContent = swapState[key].original;
            delete swapState[key];
            panel.classList.add('hidden');
          });
        });
      });
    }

    function getRestPeriod(goal) {
      const goalLower = (goal || '').toLowerCase();
      if (goalLower.includes('strength') || goalLower.includes('power')) return '3–5 min rest between sets';
      if (goalLower.includes('hypertrophy') || goalLower.includes('muscle') || goalLower.includes('size')) return '60–90 sec rest between sets';
      if (goalLower.includes('endurance') || goalLower.includes('cardio')) return '30–45 sec rest between sets';
      if (goalLower.includes('weight loss')) return '45–60 sec rest between sets';
      return '60–120 sec rest between sets';
    }

    function printWorkout() {
      window.print();
    }

    function generateDeload() {
      const planEl = document.getElementById('wp-result');
      if (!planEl) return;
      const deloadNote = document.createElement('div');
      deloadNote.className = 'rounded-lg bg-amber-50 border border-amber-200 p-3 mb-4 text-sm text-amber-800';
      deloadNote.innerHTML = '<strong>Deload Week:</strong> Reduce all weights by 40–50% and cut volume to 50–60% of normal. Focus on form and active recovery. This follows your 4–6 week training block.';
      planEl.prepend(deloadNote);
      document.getElementById('deload-btn')?.classList.add('hidden');
    }
    window.generateDeload = generateDeload;
    window.printWorkout = printWorkout;

    document.getElementById('wp-gen').addEventListener('click', () => {
      const d = document.getElementById('wp-days').value;
      const g = document.getElementById('wp-goal').value;
      const e = document.getElementById('wp-equip').value;
      let key = d + '-' + g + '-' + e;
      let plan = splits[key];
      if (!plan) {
        const fallbackGoals = ['Hypertrophy', 'Strength', 'Weight loss', 'Endurance'];
        for (const fg of fallbackGoals) { key = d + '-' + fg + '-' + e; plan = splits[key]; if (plan) break; }
        if (!plan) { key = '3-Hypertrophy-Gym'; plan = splits[key]; }
      }
      renderPlan(plan, g);
      // Show rest period note and action buttons
      const restNote = document.getElementById('wp-rest-note');
      if (restNote) { restNote.textContent = 'Rest period: ' + getRestPeriod(g); restNote.classList.remove('hidden'); }
      document.getElementById('wp-actions')?.classList.remove('hidden');
      // Reset deload btn
      document.getElementById('deload-btn')?.classList.remove('hidden');
    });

    function calcPO() {
      const w = parseFloat(document.getElementById('po-weight').value) || 0;
      const r = parseFloat(document.getElementById('po-reps').value) || 1;
      const t = parseFloat(document.getElementById('po-target').value) || 1;
      const estMax = w * (1 + r / 30);
      const next = estMax / (1 + t / 30);
      document.getElementById('po-out').textContent = Math.round(next) + ' lbs';
    }
    ['po-weight', 'po-reps', 'po-target'].forEach(id => document.getElementById(id)?.addEventListener('input', calcPO));
    calcPO();
  </script>
</BaseLayout>
