---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title={siteConfig.identity.name} description={siteConfig.identity.description}>
  <section class="relative -mx-4 overflow-hidden px-4 py-14 sm:py-20 no-print">
    <div class="absolute inset-0 bg-gradient-to-br from-red-50 via-rose-50 to-pink-50" aria-hidden="true" />
    <div class="absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-red-300/20 blur-3xl" aria-hidden="true" />
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-rose-300/15 blur-3xl" aria-hidden="true" />
    <div class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">WorkoutPlanner</h1>
        <p class="mt-3 text-lg text-slate-600">Custom workout split generator, progressive overload planner, and bodyweight routine builder.</p>
      </div>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {['Custom workout split generator', 'Exercise substitution', 'Bodyweight & gym routines', 'No data stored or shared'].map((badge) => (
          <li class="flex items-center gap-1.5">
            <svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
            </svg>
            {badge}
          </li>
        ))}
      </ul>
    </div>
  </section>
  <div class="mx-auto max-w-5xl">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Workout Split Generator</h2>
      <div class="grid gap-4 sm:grid-cols-3 mb-4">
        <label class="block"><span class="text-sm font-medium text-slate-700">Days per week</span>
          <select id="wp-days" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"><option>3</option><option>4</option><option selected>5</option><option>6</option></select>
        </label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Goal</span>
          <select id="wp-goal" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"><option>Strength</option><option selected>Hypertrophy</option><option>Endurance</option><option>Weight loss</option></select>
        </label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Equipment</span>
          <select id="wp-equip" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"><option selected>Gym</option><option>Dumbbells only</option><option>Bodyweight</option></select>
        </label>
      </div>
      <button id="wp-gen" class="no-print rounded-lg bg-red-600 px-5 py-2 text-white font-semibold hover:bg-red-700">Generate Workout Plan</button>
      <p id="wp-rest-note" class="hidden mt-4 text-xs font-medium text-slate-600 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2"></p>
      <div id="wp-result" class="mt-3 space-y-4 workout-plan"></div>
      <div id="wp-actions" class="hidden mt-4 flex flex-wrap gap-2 no-print">
        <button id="deload-btn" onclick="generateDeload()" class="rounded-lg bg-amber-100 border border-amber-300 px-4 py-2 text-sm font-medium text-amber-800 hover:bg-amber-200">Generate Deload Version</button>
        <button onclick="printWorkout()" class="rounded-lg bg-slate-100 border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200">Print Workout</button>
      </div>
      <p class="mt-3 text-xs text-slate-400 no-print">Click the swap button next to any exercise to see alternative exercises that work the same muscle groups.</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8 no-print">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Progressive Overload Calculator</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        <label class="block"><span class="text-sm font-medium text-slate-700">Current weight (lbs)</span><input id="po-weight" type="number" value="185" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Current reps</span><input id="po-reps" type="number" value="8" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Target reps</span><input id="po-target" type="number" value="10" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
      </div>
      <div class="mt-4 rounded-lg bg-lime-50 p-4 text-center border border-lime-100">
        <p class="text-xs uppercase text-lime-600">Suggested next weight</p>
        <p id="po-out" class="text-2xl font-bold text-lime-700">195 lbs</p>
        <p id="po-sub" class="text-sm text-lime-600 mt-1">to hit 10 reps at similar intensity</p>
      </div>
    </div>

    <section class="my-12 no-print">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Fitness Guides</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/blog/3-day-workout-split-for-beginners-full-body-strength-plan/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-red-400"><h3 class="font-semibold text-slate-900">3 Day Workout Split for Beginners</h3><p class="mt-1 text-sm text-slate-600">Full body strength plan with exact exercises, sets, and reps for new lifters.</p></a>
        <a href="/blog/progressive-overload-calculator-track-weight-increases-over-time/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-red-400"><h3 class="font-semibold text-slate-900">Progressive Overload Calculator</h3><p class="mt-1 text-sm text-slate-600">How to track weight increases over time for strength and muscle growth.</p></a>
        <a href="/blog/bodyweight-workout-plan-no-equipment-build-muscle-at-home/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-red-400"><h3 class="font-semibold text-slate-900">Bodyweight Workout Plan (No Equipment)</h3><p class="mt-1 text-sm text-slate-600">Build muscle at home with push-ups, rows, squats, and core progressions.</p></a>
        <a href="/blog/how-to-progressive-overload-at-home-no-gym-required/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-red-400"><h3 class="font-semibold text-slate-900">How to Progressive Overload at Home</h3><p class="mt-1 text-sm text-slate-600">Five methods to get stronger without a gym using bands, tempo, and bodyweight.</p></a>
        <a href="/blog/workout-split-for-busy-professionals-minimal-time-maximum-results/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-red-400"><h3 class="font-semibold text-slate-900">Workout Split for Busy Professionals</h3><p class="mt-1 text-sm text-slate-600">Minimal time, maximum results with 30-45 minute sessions 3-4 times per week.</p></a>
        <a href="/blog/full-body-workout-3-times-a-week-the-science-and-the-routine/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-red-400"><h3 class="font-semibold text-slate-900">Full Body Workout 3 Times a Week</h3><p class="mt-1 text-sm text-slate-600">The science behind full body training and a complete routine for all levels.</p></a>
      </div>
    </section>
  </div>
  <style>
    @media print {
      .no-print { display: none !important; }
      body { font-size: 12pt; }
      .workout-plan { break-inside: avoid; }
    }
  </style>

