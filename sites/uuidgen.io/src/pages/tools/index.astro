---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '~/config/site.config';

if (!siteConfig.features.hasTool) return Astro.redirect('/');
const tools = (await getCollection('tools', ({ data }) => !data.draft));
---
<BaseLayout title="Tools" description={`Free tools from ${siteConfig.identity.name}`}>
  <h1 class="text-4xl font-bold">Tools</h1>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {tools.map((t) => (
      <li class="rounded-lg border border-slate-200 bg-white p-4 hover:border-slate-400">
        <a href={`/tools/${t.data.urlSlug}/`}>
          <h2 class="text-lg font-medium text-slate-900">{t.data.title}</h2>
          <p class="mt-1 text-sm text-slate-600">{t.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
