---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout
  title="HTML Formatter &amp; Minifier — Beautify &amp; Minify HTML Online Free"
  description="Free online HTML formatter and minifier. Beautify messy HTML with proper indentation, or minify HTML to reduce file size. Runs entirely in your browser."
>

  <!-- Compact header -->
  <header class="pb-4 pt-2">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">
      HTML Formatter &amp; Minifier
    </h1>
    <p class="mt-1.5 text-sm text-slate-500">
      Beautify HTML with proper indentation, or minify it to reduce size — runs entirely in your browser.
    </p>
  </header>

  <!-- Toolbar -->
  <div class="flex flex-wrap gap-2 mb-3">
    <button id="btn-format"  class="rounded-md bg-slate-700 px-3.5 py-1.5 text-sm font-medium text-white hover:bg-slate-800 transition-colors">Format</button>
    <button id="btn-minify"  class="rounded-md bg-slate-600 px-3.5 py-1.5 text-sm font-medium text-white hover:bg-slate-700 transition-colors">Minify</button>
    <button id="btn-sample"  class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Sample</button>
    <div class="flex-1"></div>
    <button id="btn-clear"   class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Clear</button>
    <button id="btn-copy"    class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Copy output</button>
  </div>

  <!-- File drop zone -->
  <div
    id="drop-zone"
    class="mb-3 flex cursor-pointer flex-col items-center justify-center rounded-lg border-2 border-dashed border-slate-300 bg-slate-50 px-4 py-5 text-center transition-colors hover:border-slate-500 hover:bg-slate-100"
    role="button"
    tabindex="0"
    aria-label="Drop an HTML file here or click to upload"
  >
    <svg class="mb-2 h-7 w-7 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
    </svg>
    <p class="text-sm font-medium text-slate-600">Drop an <code class="rounded bg-slate-200 px-1 text-xs">.html</code> file here, or <span class="text-slate-700 underline underline-offset-2">click to upload</span></p>
    <input id="file-input" type="file" accept=".html,.htm" class="hidden" aria-label="Upload HTML file" />
  </div>

  <!-- Dual-pane editor -->
  <div class="grid gap-3 md:grid-cols-2 min-h-96">
    <div class="flex flex-col gap-1 min-h-0">
      <label for="html-input" class="text-xs font-semibold uppercase tracking-wide text-slate-500">Input HTML</label>
      <textarea
        id="html-input"
        class="flex-1 w-full rounded-lg border border-slate-300 bg-slate-950 text-slate-100 p-4 font-mono text-sm resize-none focus:border-slate-500 focus:ring-1 focus:ring-slate-500 placeholder:text-slate-600"
        placeholder="Paste your HTML here"
        spellcheck="false"
        autocomplete="off"
        rows="16"
      ></textarea>
    </div>
    <div class="flex flex-col gap-1 min-h-0">
      <label for="html-output" class="text-xs font-semibold uppercase tracking-wide text-slate-500">Output</label>
      <textarea
        id="html-output"
        class="flex-1 w-full rounded-lg border border-slate-200 bg-slate-950 text-slate-100 p-4 font-mono text-sm resize-none"
        readonly
        placeholder="Result appears here"
        spellcheck="false"
        rows="16"
      ></textarea>
    </div>
  </div>

  <!-- Status bar -->
  <div id="status" class="mt-2 rounded-md px-3 py-1.5 text-sm font-medium hidden"></div>

  <!-- Format diff summary -->
  <div id="format-diff" class="mt-1 text-xs text-slate-400 hidden"></div>

  <!-- Validation output -->
  <div id="validation-output" class="mt-3 hidden">
    <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">Validation</div>
    <div id="validation-list" class="rounded-lg border border-slate-200 bg-white p-3 text-sm space-y-1"></div>
  </div>

  <!-- Keyboard hint -->
  <p class="mt-2 text-xs text-slate-400">
    <kbd class="rounded border border-slate-300 bg-slate-100 px-1 py-0.5 font-mono text-slate-600">Ctrl</kbd>
    +
    <kbd class="rounded border border-slate-300 bg-slate-100 px-1 py-0.5 font-mono text-slate-600">Enter</kbd>
    to format
  </p>

  <!-- ── Below-fold: SEO content ── -->
  <div class="mt-16 max-w-3xl space-y-10">

    <section aria-labelledby="format-vs-minify-heading">
      <h2 id="format-vs-minify-heading" class="text-2xl font-bold text-slate-900">Format vs. minify — when to use each</h2>
      <div class="prose mt-4 max-w-none">
        <p>
          <strong>Format (beautify)</strong> — adds consistent indentation and line breaks to make HTML
          human-readable. Use this when inspecting third-party markup, debugging rendered HTML from
          DevTools, or reviewing server-rendered templates. The output is functionally identical to
          the input; only whitespace changes.
        </p>
        <p>
          <strong>Minify</strong> — removes unnecessary whitespace, comments, and optional closing
          tags to reduce file size. Use this in production where every kilobyte affects page load time.
          Minified HTML is not meant for humans to read directly — keep the unminified source in version
          control and minify as part of your build step.
        </p>
      </div>
    </section>

    <section aria-labelledby="html-indentation-heading">
      <h2 id="html-indentation-heading" class="text-2xl font-bold text-slate-900">HTML formatting conventions</h2>
      <div class="prose mt-4 max-w-none">
        <p>This formatter uses 2-space indentation, matching the most common convention in web projects:</p>
        <ul>
          <li>Block-level elements (<code>div</code>, <code>section</code>, <code>article</code>, <code>main</code>, etc.) get their own line and indent their children.</li>
          <li>Inline elements (<code>span</code>, <code>strong</code>, <code>em</code>, <code>a</code>) may remain inline within their parent's line when short.</li>
          <li>Void elements (<code>br</code>, <code>hr</code>, <code>img</code>, <code>input</code>, <code>meta</code>, <code>link</code>) are self-closing by convention.</li>
          <li>Attributes are preserved as-is; attribute sorting is not applied.</li>
        </ul>
      </div>
    </section>

  </div>

  <script is:inline>
    var input  = document.getElementById('html-input');
    var output = document.getElementById('html-output');
    var statusEl = document.getElementById('status');

    var SAMPLE = '<html><head><meta charset="UTF-8"><title>My Page</title><link rel="stylesheet" href="style.css"></head><body><div class="container"><header><h1>Hello World</h1><nav><ul><li><a href="/">Home</a></li><li><a href="/about">About</a></li></ul></nav></header><main><p>Welcome to my <strong>page</strong>.</p></main></div></body></html>';

    var VOID = { area:1,base:1,br:1,col:1,embed:1,hr:1,img:1,input:1,link:1,meta:1,param:1,source:1,track:1,wbr:1 };
    var INLINE_TAGS = { a:1,abbr:1,acronym:1,b:1,bdo:1,big:1,br:1,cite:1,code:1,dfn:1,em:1,i:1,img:1,input:1,kbd:1,label:1,map:1,object:1,q:1,samp:1,select:1,small:1,span:1,strong:1,sub:1,sup:1,textarea:1,tt:1,u:1,var:1 };

    function showStatus(msg, type) {
      var clsMap = { error: 'bg-red-50 text-red-700 border border-red-200', success: 'bg-emerald-50 text-emerald-700 border border-emerald-200', info: 'bg-blue-50 text-blue-700 border border-blue-200' };
      statusEl.className = 'mt-2 rounded-md px-3 py-1.5 text-sm font-medium ' + (clsMap[type] || 'bg-slate-100 text-slate-700');
      statusEl.textContent = msg;
      statusEl.classList.remove('hidden');
    }

    function formatHTML(src) {
      var indent = 0;
      var result = '';
      var tokens = src.replace(/>\s*</g, '>\n<').split('\n');
      tokens.forEach(function(tok) {
        tok = tok.trim();
        if (!tok) return;
        var closeMatch = tok.match(/^<\/([a-zA-Z0-9]+)/);
        var openMatch  = tok.match(/^<([a-zA-Z0-9]+)/);
        var tag = openMatch ? openMatch[1].toLowerCase() : '';
        var isClose = !!closeMatch;
        var isVoid = VOID[tag];
        var isSelfClose = tok.endsWith('/>');

        if (isClose) indent = Math.max(0, indent - 1);
        result += '  '.repeat(indent) + tok + '\n';
        if (!isClose && !isVoid && !isSelfClose && openMatch) indent++;
      });
      return result.trim();
    }

    function minifyHTML(src) {
      return src
        .replace(/<!--[\s\S]*?-->/g, '')
        .replace(/\s+/g, ' ')
        .replace(/>\s</g, '><')
        .replace(/\s+>/g, '>')
        .replace(/<\s+/g, '<')
        .trim();
    }

    function validateHTML(html) {
      var warnings = [];
      var imgs = html.match(/<img[^>]*>/gi) || [];
      imgs.forEach(function(img) { if (!/alt=/i.test(img)) warnings.push('Image missing alt attribute'); });
      ['<center','<font','<marquee','<blink'].forEach(function(tag) {
        if (html.toLowerCase().includes(tag)) warnings.push('Deprecated tag found: ' + tag.slice(1));
      });
      var selfClosing = new Set(['br','hr','img','input','link','meta','area','base','col','embed','param','source','track','wbr']);
      var openStack = [];
      var tagMatches = html.match(/<\/?([a-z][a-z0-9]*)[^>]*>/gi) || [];
      tagMatches.forEach(function(t) {
        var isClose = t.startsWith('</');
        var nameMatch = t.match(/[a-z][a-z0-9]*/i);
        var name = nameMatch ? nameMatch[0].toLowerCase() : '';
        if (!selfClosing.has(name)) {
          if (!isClose) openStack.push(name);
          else { var idx = openStack.lastIndexOf(name); if(idx >= 0) openStack.splice(idx,1); else warnings.push('Unexpected closing tag: </' + name + '>'); }
        }
      });
      openStack.slice(0,5).forEach(function(t) { warnings.push('Possibly unclosed tag: <' + t + '>'); });
      return warnings;
    }

    function showValidation(html) {
      var warnings = validateHTML(html);
      var valOut = document.getElementById('validation-output');
      var valList = document.getElementById('validation-list');
      if (warnings.length === 0) {
        valList.innerHTML = '<span class="text-emerald-600">No validation issues found &#10003;</span>';
      } else {
        valList.innerHTML = warnings.map(function(w) {
          return '<div class="flex items-start gap-2 text-amber-700"><span class="text-amber-500 mt-0.5">&#9888;</span><span>' + w + '</span></div>';
        }).join('');
      }
      valOut.classList.remove('hidden');
    }

    function runFormat() {
      if (!input.value.trim()) { showStatus('Paste some HTML first', 'info'); return; }
      var origLines = input.value.split('\n').length;
      var origLen   = input.value.length;
      var formatted = formatHTML(input.value);
      output.value = formatted;
      var fmtLines  = formatted.split('\n').length;
      var fmtLen    = formatted.length;
      showStatus('Formatted successfully', 'success');

      // Diff summary
      var diffEl = document.getElementById('format-diff');
      diffEl.textContent = 'Original: ' + origLines + ' lines, ' + origLen + ' chars → Formatted: ' + fmtLines + ' lines, ' + fmtLen + ' chars';
      diffEl.classList.remove('hidden');

      // Validation
      showValidation(input.value);
    }

    document.getElementById('btn-format').addEventListener('click', runFormat);

    document.getElementById('btn-minify').addEventListener('click', function() {
      if (!input.value.trim()) { showStatus('Paste some HTML first', 'info'); return; }
      var orig = input.value.length;
      var result = minifyHTML(input.value);
      output.value = result;
      var saved = orig - result.length;
      showStatus('Minified — saved ' + saved + ' bytes (' + ((saved / orig) * 100).toFixed(1) + '%)', 'success');
    });

    document.getElementById('btn-sample').addEventListener('click', function() {
      input.value = SAMPLE;
      output.value = '';
      statusEl.classList.add('hidden');
      input.focus();
    });

    document.getElementById('btn-clear').addEventListener('click', function() {
      input.value = ''; output.value = '';
      statusEl.classList.add('hidden');
      input.focus();
    });

    document.getElementById('btn-copy').addEventListener('click', function() {
      if (!output.value) { showStatus('Nothing to copy yet', 'info'); return; }
      navigator.clipboard.writeText(output.value).then(function() {
        showStatus('Copied to clipboard', 'success');
      }, function() {
        output.select(); document.execCommand('copy');
        showStatus('Copied', 'success');
      });
    });

    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); runFormat(); }
    });

    // File upload / drag-and-drop
    var dropZone = document.getElementById('drop-zone');
    var fileInput = document.getElementById('file-input');

    function loadFile(file) {
      if (!file) return;
      var name = file.name.toLowerCase();
      if (!name.endsWith('.html') && !name.endsWith('.htm') && file.type !== 'text/html') {
        showStatus('Please upload a .html file', 'error'); return;
      }
      var reader = new FileReader();
      reader.onload = function(e) {
        input.value = e.target.result;
        output.value = '';
        statusEl.classList.add('hidden');
        showStatus('Loaded: ' + file.name + ' (' + file.size + ' bytes)', 'info');
      };
      reader.readAsText(file);
    }

    dropZone.addEventListener('click', function() { fileInput.click(); });
    dropZone.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') fileInput.click(); });
    fileInput.addEventListener('change', function() { loadFile(fileInput.files[0]); fileInput.value = ''; });

    dropZone.addEventListener('dragover', function(e) {
      e.preventDefault();
      dropZone.classList.add('border-slate-600', 'bg-slate-200');
    });
    dropZone.addEventListener('dragleave', function() {
      dropZone.classList.remove('border-slate-600', 'bg-slate-200');
    });
    dropZone.addEventListener('drop', function(e) {
      e.preventDefault();
      dropZone.classList.remove('border-slate-600', 'bg-slate-200');
      var file = e.dataTransfer.files[0];
      loadFile(file);
    });
  </script>

</BaseLayout>
