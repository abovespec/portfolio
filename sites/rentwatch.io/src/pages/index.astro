---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title={siteConfig.identity.name} description={siteConfig.identity.description}>
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style={`color:${siteConfig.branding.themeColor}`}>RentWatch</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Visualize rent prices by city, salary data by job title, and cost-of-living comparisons across regions.</p>
  </section>
  <div class="mx-auto max-w-5xl">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Average Rent by City (1BR Apartment)</h2>
      <div class="space-y-3">
        <div><div class="flex justify-between text-sm mb-1"><span class="text-slate-700">San Francisco, CA</span><span class="font-medium text-slate-900">$3,200</span></div><div class="w-full bg-slate-100 rounded-full h-3"><div class="bg-emerald-500 h-3 rounded-full" style="width:100%"></div></div></div>
        <div><div class="flex justify-between text-sm mb-1"><span class="text-slate-700">New York, NY</span><span class="font-medium text-slate-900">$3,100</span></div><div class="w-full bg-slate-100 rounded-full h-3"><div class="bg-emerald-500 h-3 rounded-full" style="width:97%"></div></div></div>
        <div><div class="flex justify-between text-sm mb-1"><span class="text-slate-700">Boston, MA</span><span class="font-medium text-slate-900">$2,800</span></div><div class="w-full bg-slate-100 rounded-full h-3"><div class="bg-emerald-500 h-3 rounded-full" style="width:88%"></div></div></div>
        <div><div class="flex justify-between text-sm mb-1"><span class="text-slate-700">Seattle, WA</span><span class="font-medium text-slate-900">$2,400</span></div><div class="w-full bg-slate-100 rounded-full h-3"><div class="bg-emerald-500 h-3 rounded-full" style="width:75%"></div></div></div>
        <div><div class="flex justify-between text-sm mb-1"><span class="text-slate-700">Austin, TX</span><span class="font-medium text-slate-900">$1,800</span></div><div class="w-full bg-slate-100 rounded-full h-3"><div class="bg-emerald-500 h-3 rounded-full" style="width:56%"></div></div></div>
        <div><div class="flex justify-between text-sm mb-1"><span class="text-slate-700">Denver, CO</span><span class="font-medium text-slate-900">$1,700</span></div><div class="w-full bg-slate-100 rounded-full h-3"><div class="bg-emerald-500 h-3 rounded-full" style="width:53%"></div></div></div>
        <div><div class="flex justify-between text-sm mb-1"><span class="text-slate-700">Atlanta, GA</span><span class="font-medium text-slate-900">$1,500</span></div><div class="w-full bg-slate-100 rounded-full h-3"><div class="bg-emerald-500 h-3 rounded-full" style="width:47%"></div></div></div>
        <div><div class="flex justify-between text-sm mb-1"><span class="text-slate-700">Phoenix, AZ</span><span class="font-medium text-slate-900">$1,350</span></div><div class="w-full bg-slate-100 rounded-full h-3"><div class="bg-emerald-500 h-3 rounded-full" style="width:42%"></div></div></div>
      </div>
      <p class="mt-3 text-xs text-slate-400">Data based on market averages for 2025. Actual rents vary by neighborhood and building quality.</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Rent Affordability Calculator</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block"><span class="text-sm font-medium text-slate-700">Monthly gross income ($)</span><input id="rw-income" type="number" value="6000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Monthly debt payments ($)</span><input id="rw-debt" type="number" value="400" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">30% rule max</p><p id="rw-out-30" class="text-xl font-bold text-slate-800">$1,800</p></div>
        <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">50% rule max</p><p id="rw-out-50" class="text-xl font-bold text-slate-800">$2,600</p></div>
        <div class="rounded-lg bg-emerald-50 p-4 text-center border border-emerald-100"><p class="text-xs uppercase text-emerald-600">Comfortable target</p><p id="rw-out-rec" class="text-xl font-bold text-emerald-700">$1,500</p></div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Housing & Cost of Living Guides</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/blog/rent-affordability-rules/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-emerald-400"><h3 class="font-semibold text-slate-900">Rent Affordability Rules Explained</h3><p class="mt-1 text-sm text-slate-600">30% rule, 50/30/20 budget, and why debt-to-income matters more than rent alone.</p></a>
        <a href="/blog/cheapest-cities-to-live/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-emerald-400"><h3 class="font-semibold text-slate-900">Cheapest Cities to Live in 2025</h3><p class="mt-1 text-sm text-slate-600">Cost-of-living index, rent prices, and salary data for affordable U.S. cities.</p></a>
        <a href="/blog/remote-work-salary-negotiation/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-emerald-400"><h3 class="font-semibold text-slate-900">Remote Work Salary Negotiation</h3><p class="mt-1 text-sm text-slate-600">How location-based pay works and how to negotiate for market-rate compensation.</p></a>
        <a href="/blog/rent-vs-buy-calculator/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-emerald-400"><h3 class="font-semibold text-slate-900">Rent vs Buy Calculator</h3><p class="mt-1 text-sm text-slate-600">Break-even analysis, opportunity cost, and when buying actually builds wealth.</p></a>
      </div>
    </section>
  </div>
  <script is:inline>
    function $(id){ return document.getElementById(id); }
    function val(id){ return parseFloat($(id).value)||0; }
    function calcRW(){ const inc=val('rw-income'), debt=val('rw-debt'); $('rw-out-30').textContent='$'+(inc*0.3).toFixed(0); $('rw-out-50').textContent='$'+((inc-debt)*0.5).toFixed(0); $('rw-out-rec').textContent='$'+((inc-debt)*0.3).toFixed(0); }
    ['rw-income','rw-debt'].forEach(id=>$(id)?.addEventListener('input',calcRW));
    calcRW();
  </script>
</BaseLayout>
