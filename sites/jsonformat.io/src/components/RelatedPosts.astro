---
interface RelatedPost {
  url: string;
  title: string;
  description?: string;
  publishDate?: Date | string;
}
interface Props {
  posts: RelatedPost[];
  heading?: string;
}
const { posts, heading = 'Related reading' } = Astro.props;
if (!posts.length) return null;
---
<section class="my-12 not-prose" aria-labelledby="related-heading">
  <h2 id="related-heading" class="text-2xl font-semibold mb-4 text-slate-900">{heading}</h2>
  <ul class="grid gap-4 sm:grid-cols-2">
    {posts.map((p) => (
      <li class="rounded-xl border border-slate-200 bg-white p-5 transition hover:border-blue-300 hover:shadow-sm">
        <a href={p.url} class="block">
          <h3 class="text-base font-semibold text-slate-900 hover:text-blue-700">{p.title}</h3>
          {p.description && <p class="mt-1 text-sm text-slate-600">{p.description}</p>}
        </a>
      </li>
    ))}
  </ul>
</section>
