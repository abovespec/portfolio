---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
const email = siteConfig.org.contactEmail;
---
<BaseLayout title="Contact" description={`Get in touch with ${siteConfig.identity.name}. One email address, no form.`}>
  <h1 class="text-4xl font-bold">Contact</h1>
  <div class="prose prose-slate mt-6 max-w-none">
    <p class="lead">
      One email address, no form. Write to
      <a href={`mailto:${email}`}>{email}</a> and a human will reply.
    </p>

    <h2>Happy to answer</h2>
    <ul>
      <li>Bug reports — what you tried, what happened, which browser.</li>
      <li>Feature requests and preset suggestions (new passport sizes, new platforms).</li>
      <li>Privacy or legal questions.</li>
      <li>Press and partnership inquiries.</li>
      <li>Sponsored post inquiries (see our <a href="/sponsored/">sponsored page</a> first).</li>
      <li>A plain "this was useful, thanks" message — those are always nice to get.</li>
    </ul>

    <h2>Please don't email us about</h2>
    <ul>
      <li>Recovering an image — your images never come to us, so we can't retrieve them.</li>
      <li>SEO outreach, guest-post-for-backlink pitches, or AI-written link requests. They go to trash unread.</li>
    </ul>

    <p>
      For privacy or data-rights requests specifically, please include
      "privacy" in the subject line so we can route it correctly.
    </p>
  </div>
</BaseLayout>
