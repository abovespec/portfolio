---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title={siteConfig.identity.name} description={siteConfig.identity.description}>
  <section class="relative -mx-4 overflow-hidden px-4 py-14 sm:py-20">
    <div class="absolute inset-0 bg-gradient-to-br from-sky-50 via-cyan-50 to-teal-50" aria-hidden="true" />
    <div class="absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-sky-300/20 blur-3xl" aria-hidden="true" />
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-cyan-300/15 blur-3xl" aria-hidden="true" />
    <div class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">TripCostCalc</h1>
        <p class="mt-3 text-lg text-slate-600">Trip cost estimator by destination, packing list generator, visa requirement checker, and jet lag calculator.</p>
      </div>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {['Trip costs by destination', 'Side-by-side destination compare', 'Local currency display', 'No data stored or shared'].map((badge) => (
          <li class="flex items-center gap-1.5">
            <svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
            </svg>
            {badge}
          </li>
        ))}
      </ul>
    </div>
  </section>
  <div class="mx-auto max-w-5xl">

    <!-- Destination comparison header -->
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-semibold text-slate-800">Trip Cost Estimator</h2>
      <button id="btn-compare" class="rounded-lg border border-sky-300 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700 hover:bg-sky-100">+ Compare Destination</button>
    </div>

    <!-- Winner banner -->
    <div id="winner-banner" class="hidden mb-4 rounded-lg bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm font-semibold text-emerald-800"></div>

    <div id="destinations-grid" class="grid gap-6 sm:grid-cols-1 mb-8">

      <!-- Destination 1 -->
      <div id="dest1-card" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-semibold text-slate-700">Destination 1</h3>
          <span id="dest1-currency-badge" class="text-xs font-medium bg-sky-100 text-sky-700 rounded-full px-2.5 py-0.5"></span>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Destination</span>
            <select id="tc-dest" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
              <option value="Tokyo">Tokyo, Japan</option>
              <option value="Paris">Paris, France</option>
              <option value="New York">New York, USA</option>
              <option value="Bangkok">Bangkok, Thailand</option>
              <option value="London">London, UK</option>
              <option value="Bali">Bali, Indonesia</option>
              <option value="Barcelona">Barcelona, Spain</option>
              <option value="Dubai">Dubai, UAE</option>
              <option value="Sydney">Sydney, Australia</option>
              <option value="Amsterdam">Amsterdam, Netherlands</option>
              <option value="Rome">Rome, Italy</option>
              <option value="Singapore">Singapore</option>
              <option value="Lisbon">Lisbon, Portugal</option>
              <option value="Prague">Prague, Czech Republic</option>
              <option value="Cape Town">Cape Town, South Africa</option>
              <option value="Buenos Aires">Buenos Aires, Argentina</option>
              <option value="Istanbul">Istanbul, Turkey</option>
              <option value="Mexico City">Mexico City, Mexico</option>
              <option value="Ho Chi Minh City">Ho Chi Minh City, Vietnam</option>
              <option value="Medellin">Medellin, Colombia</option>
              <option value="custom" selected>Custom</option>
            </select>
          </label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Number of travelers</span><input id="tc-ppl" type="number" value="2" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Nights</span><input id="tc-nights" type="number" value="5" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Hotel per night ($)</span><input id="tc-hotel" type="number" value="150" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Food per day ($)</span><input id="tc-food" type="number" value="80" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Activities per day ($)</span><input id="tc-act" type="number" value="50" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Local transport per day ($)</span><input id="tc-trans" type="number" value="20" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Flight cost total ($)</span><input id="tc-flight" type="number" value="800" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Hotel total</p><p id="tc-out-hotel" class="text-xl font-bold text-slate-800">$1,500</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Daily spend total</p><p id="tc-out-daily" class="text-xl font-bold text-slate-800">$750</p></div>
          <div class="rounded-lg bg-sky-50 p-4 text-center border border-sky-100"><p class="text-xs uppercase text-sky-600">Trip total (USD)</p><p id="tc-out-total" class="text-xl font-bold text-sky-700">$3,050</p></div>
        </div>
        <div id="dest1-local" class="mt-3 hidden rounded-lg bg-slate-50 p-3 text-center">
          <p class="text-xs uppercase text-slate-500">Trip total (local currency)</p>
          <p id="dest1-local-total" class="text-lg font-bold text-slate-700"></p>
        </div>
        <div id="dest1-chart" class="mt-4 hidden">
          <p class="text-xs font-semibold uppercase text-slate-500 mb-2">Cost Per Day Breakdown</p>
          <div id="dest1-chart-bars" class="space-y-1"></div>
        </div>
      </div>

      <!-- Destination 2 (hidden by default) -->
      <div id="dest2-card" class="hidden rounded-xl border border-sky-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-semibold text-slate-700">Destination 2</h3>
          <div class="flex items-center gap-2">
            <span id="dest2-currency-badge" class="text-xs font-medium bg-sky-100 text-sky-700 rounded-full px-2.5 py-0.5"></span>
            <button id="btn-remove-dest2" class="text-xs text-slate-400 hover:text-red-500">&#215; Remove</button>
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Destination</span>
            <select id="tc2-dest" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
              <option value="Tokyo">Tokyo, Japan</option>
              <option value="Paris" selected>Paris, France</option>
              <option value="New York">New York, USA</option>
              <option value="Bangkok">Bangkok, Thailand</option>
              <option value="London">London, UK</option>
              <option value="Bali">Bali, Indonesia</option>
              <option value="Barcelona">Barcelona, Spain</option>
              <option value="Dubai">Dubai, UAE</option>
              <option value="Sydney">Sydney, Australia</option>
              <option value="Amsterdam">Amsterdam, Netherlands</option>
              <option value="Rome">Rome, Italy</option>
              <option value="Singapore">Singapore</option>
              <option value="Lisbon">Lisbon, Portugal</option>
              <option value="Prague">Prague, Czech Republic</option>
              <option value="Cape Town">Cape Town, South Africa</option>
              <option value="Buenos Aires">Buenos Aires, Argentina</option>
              <option value="Istanbul">Istanbul, Turkey</option>
              <option value="Mexico City">Mexico City, Mexico</option>
              <option value="Ho Chi Minh City">Ho Chi Minh City, Vietnam</option>
              <option value="Medellin">Medellin, Colombia</option>
              <option value="custom">Custom</option>
            </select>
          </label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Number of travelers</span><input id="tc2-ppl" type="number" value="2" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Nights</span><input id="tc2-nights" type="number" value="5" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Hotel per night ($)</span><input id="tc2-hotel" type="number" value="200" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Food per day ($)</span><input id="tc2-food" type="number" value="100" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Activities per day ($)</span><input id="tc2-act" type="number" value="50" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Local transport per day ($)</span><input id="tc2-trans" type="number" value="10" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Flight cost total ($)</span><input id="tc2-flight" type="number" value="900" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Hotel total</p><p id="tc2-out-hotel" class="text-xl font-bold text-slate-800">$1,000</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Daily spend total</p><p id="tc2-out-daily" class="text-xl font-bold text-slate-800">$800</p></div>
          <div class="rounded-lg bg-sky-50 p-4 text-center border border-sky-100"><p class="text-xs uppercase text-sky-600">Trip total (USD)</p><p id="tc2-out-total" class="text-xl font-bold text-sky-700">$2,700</p></div>
        </div>
        <div id="dest2-local" class="mt-3 hidden rounded-lg bg-slate-50 p-3 text-center">
          <p class="text-xs uppercase text-slate-500">Trip total (local currency)</p>
          <p id="dest2-local-total" class="text-lg font-bold text-slate-700"></p>
        </div>
      </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Packing List Generator</h2>
      <div class="flex flex-wrap gap-3 mb-4">
        <label class="block"><span class="text-sm font-medium text-slate-700">Climate</span>
          <select id="pk-climate" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"><option>Tropical</option><option selected>Temperate</option><option>Cold</option><option>Desert</option></select>
        </label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Activities</span>
          <select id="pk-act" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"><option selected>City / sightseeing</option><option>Beach</option><option>Hiking</option><option>Business</option></select>
        </label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Nights</span><input id="pk-nights" type="number" value="5" class="mt-1 w-24 rounded-lg border border-slate-300 px-3 py-2"></label>
      </div>
      <button id="pk-gen" class="rounded-lg bg-sky-600 px-5 py-2 text-white font-semibold hover:bg-sky-700">Generate List</button>
      <ul id="pk-result" class="mt-4 grid gap-2 sm:grid-cols-2"></ul>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Travel Guides</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/blog/japan-trip-budget-calculator-2025-plan-your-perfect-visit/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-sky-400"><h3 class="font-semibold text-slate-900">Tokyo Trip Budget Breakdown</h3><p class="mt-1 text-sm text-slate-600">5-day itinerary with real costs for hotels, food, transit, and attractions.</p></a>
        <a href="/blog/travel-budget-calculator-by-destination-estimate-any-trip/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-sky-400"><h3 class="font-semibold text-slate-900">Travel Budget by Destination</h3><p class="mt-1 text-sm text-slate-600">Estimate any trip cost with our destination budget calculator. Hotels, food, activities, and transport.</p></a>
        <a href="/blog/backpacking-budget-by-country-2025-daily-costs-ranked/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-sky-400"><h3 class="font-semibold text-slate-900">Backpacking Budget by Country</h3><p class="mt-1 text-sm text-slate-600">Daily costs for 50+ countries in 2025: budget, mid-range, and comfortable travel tiers.</p></a>
        <a href="/blog/road-trip-cost-calculator-gas-hotels-food-and-fun/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-sky-400"><h3 class="font-semibold text-slate-900">Road Trip Cost Estimator</h3><p class="mt-1 text-sm text-slate-600">Calculate gas, hotels, food, and activities for any U.S. road trip. Works for solo or group travel.</p></a>
      </div>
    </section>
  </div>
  <script is:inline>
    function $(id){ return document.getElementById(id); }
    function val(id){ return parseFloat($(id).value)||0; }

    const TRIP_PRESETS = {
      'Tokyo':             { hotel:120, food:60,  act:40, trans:20 },
      'Paris':             { hotel:180, food:70,  act:50, trans:25 },
      'New York':          { hotel:200, food:80,  act:60, trans:35 },
      'Bangkok':           { hotel:50,  food:20,  act:25, trans:8  },
      'London':            { hotel:190, food:65,  act:55, trans:30 },
      'Bali':              { hotel:60,  food:25,  act:30, trans:10 },
      'Barcelona':         { hotel:130, food:55,  act:40, trans:15 },
      'Dubai':             { hotel:150, food:70,  act:65, trans:20 },
      'Sydney':            { hotel:160, food:70,  act:50, trans:30 },
      'Amsterdam':         { hotel:170, food:60,  act:45, trans:20 },
      'Rome':              { hotel:140, food:55,  act:45, trans:15 },
      'Singapore':         { hotel:140, food:40,  act:50, trans:20 },
      'Lisbon':            { hotel:100, food:45,  act:30, trans:12 },
      'Prague':            { hotel:80,  food:35,  act:25, trans:10 },
      'Cape Town':         { hotel:90,  food:40,  act:40, trans:15 },
      'Buenos Aires':      { hotel:70,  food:30,  act:25, trans:8  },
      'Istanbul':          { hotel:80,  food:30,  act:30, trans:8  },
      'Mexico City':       { hotel:75,  food:30,  act:25, trans:10 },
      'Ho Chi Minh City':  { hotel:45,  food:15,  act:20, trans:5  },
      'Medellin':          { hotel:60,  food:25,  act:20, trans:7  },
    };

    const presets = TRIP_PRESETS; // alias for backward compat

    const EXCHANGE_RATES = {
      'Tokyo':            { currency: 'JPY', rate: 150,  symbol: '¥' },
      'Paris':            { currency: 'EUR', rate: 0.92, symbol: '€' },
      'New York':         { currency: 'USD', rate: 1,    symbol: '$' },
      'Bangkok':          { currency: 'THB', rate: 35,   symbol: '฿' },
      'London':           { currency: 'GBP', rate: 0.79, symbol: '£' },
      'Bali':             { currency: 'IDR', rate: 15800, symbol: 'Rp' },
      'Barcelona':        { currency: 'EUR', rate: 0.92, symbol: '€' },
      'Dubai':            { currency: 'AED', rate: 3.67, symbol: 'AED' },
      'Sydney':           { currency: 'AUD', rate: 1.55, symbol: 'A$' },
      'Amsterdam':        { currency: 'EUR', rate: 0.92, symbol: '€' },
      'Rome':             { currency: 'EUR', rate: 0.92, symbol: '€' },
      'Singapore':        { currency: 'SGD', rate: 1.35, symbol: 'S$' },
      'Lisbon':           { currency: 'EUR', rate: 0.92, symbol: '€' },
      'Prague':           { currency: 'CZK', rate: 23,   symbol: 'Kč' },
      'Cape Town':        { currency: 'ZAR', rate: 18.5, symbol: 'R' },
      'Buenos Aires':     { currency: 'ARS', rate: 900,  symbol: '$' },
      'Istanbul':         { currency: 'TRY', rate: 32,   symbol: '₺' },
      'Mexico City':      { currency: 'MXN', rate: 17.5, symbol: 'MX$' },
      'Ho Chi Minh City': { currency: 'VND', rate: 25000, symbol: '₫' },
      'Medellin':         { currency: 'COP', rate: 4000, symbol: 'COL$' },
      'custom':  null,
    };

    function formatLocal(usd, destKey) {
      const info = EXCHANGE_RATES[destKey];
      if (!info) return null;
      const amount = usd * info.rate;
      if (info.rate >= 10) {
        return info.symbol + Math.round(amount).toLocaleString() + ' ' + info.currency;
      }
      return info.symbol + amount.toFixed(0) + ' ' + info.currency;
    }

    function renderTripChart(costs, chartBarsId, chartId) {
      const cats = [
        { label: 'Accommodation', key: 'hotel', color: '#6366f1' },
        { label: 'Food',          key: 'food',  color: '#f59e0b' },
        { label: 'Activities',    key: 'activities', color: '#10b981' },
        { label: 'Transport',     key: 'transport',  color: '#3b82f6' },
      ];
      const totalPerDay = cats.reduce((s,c) => s + (costs[c.key]||0), 0);
      const chartDiv = $(chartId);
      const chartBars = $(chartBarsId);
      if (!totalPerDay) { chartDiv && chartDiv.classList.add('hidden'); return; }
      const html = cats.map(c =>
        '<div class="flex items-center gap-2 text-xs py-0.5">' +
          '<span class="w-24 text-slate-600 truncate">' + c.label + '</span>' +
          '<div class="flex-1 h-2.5 bg-slate-100 rounded-full overflow-hidden">' +
            '<div class="h-full rounded-full" style="width:' + ((costs[c.key]||0)/totalPerDay*100).toFixed(0) + '%;background:' + c.color + '"></div>' +
          '</div>' +
          '<span class="text-slate-500">$' + (costs[c.key]||0) + '/day</span>' +
        '</div>'
      ).join('');
      if (chartBars) chartBars.innerHTML = html;
      if (chartDiv) chartDiv.classList.remove('hidden');
    }

    function calcTrip1() {
      const nights = val('tc-nights');
      const hotel = val('tc-hotel');
      const food = val('tc-food');
      const act = val('tc-act');
      const trans = val('tc-trans');
      const flight = val('tc-flight');
      const hotelTot = hotel * nights;
      const daily = (food + act + trans) * nights;
      const total = hotelTot + daily + flight;
      $('tc-out-hotel').textContent = '$' + hotelTot.toFixed(0);
      $('tc-out-daily').textContent = '$' + daily.toFixed(0);
      $('tc-out-total').textContent = '$' + total.toFixed(0);

      const destKey = $('tc-dest').value;
      const localStr = formatLocal(total, destKey);
      const badge = $('dest1-currency-badge');
      const localDiv = $('dest1-local');
      if (localStr && destKey !== 'custom' && destKey !== 'New York') {
        $('dest1-local-total').textContent = localStr;
        localDiv.classList.remove('hidden');
        badge.textContent = EXCHANGE_RATES[destKey].currency;
      } else {
        localDiv.classList.add('hidden');
        badge.textContent = '';
      }

      // Render per-day chart
      renderTripChart({ hotel: hotel, food: food, activities: act, transport: trans }, 'dest1-chart-bars', 'dest1-chart');

      compareDestinations();
      return total;
    }

    function calcTrip2() {
      const nights = val('tc2-nights');
      const hotel = val('tc2-hotel');
      const food = val('tc2-food');
      const act = val('tc2-act');
      const trans = val('tc2-trans');
      const flight = val('tc2-flight');
      const hotelTot = hotel * nights;
      const daily = (food + act + trans) * nights;
      const total = hotelTot + daily + flight;
      $('tc2-out-hotel').textContent = '$' + hotelTot.toFixed(0);
      $('tc2-out-daily').textContent = '$' + daily.toFixed(0);
      $('tc2-out-total').textContent = '$' + total.toFixed(0);

      const destKey = $('tc2-dest').value;
      const localStr = formatLocal(total, destKey);
      const badge = $('dest2-currency-badge');
      const localDiv = $('dest2-local');
      if (localStr && destKey !== 'custom' && destKey !== 'New York') {
        $('dest2-local-total').textContent = localStr;
        localDiv.classList.remove('hidden');
        badge.textContent = EXCHANGE_RATES[destKey].currency;
      } else {
        localDiv.classList.add('hidden');
        badge.textContent = '';
      }

      compareDestinations();
      return total;
    }

    function compareDestinations() {
      const banner = $('winner-banner');
      if ($('dest2-card').classList.contains('hidden')) {
        banner.classList.add('hidden');
        return;
      }
      const t1 = parseFloat($('tc-out-total').textContent.replace('$','').replace(',','')) || 0;
      const t2 = parseFloat($('tc2-out-total').textContent.replace('$','').replace(',','')) || 0;
      if (t1 === 0 && t2 === 0) { banner.classList.add('hidden'); return; }
      banner.classList.remove('hidden');
      if (t1 < t2) {
        banner.textContent = 'Destination 1 is $' + (t2 - t1).toFixed(0) + ' cheaper than Destination 2';
      } else if (t2 < t1) {
        banner.textContent = 'Destination 2 is $' + (t1 - t2).toFixed(0) + ' cheaper than Destination 1';
      } else {
        banner.textContent = 'Both destinations cost the same!';
      }
    }

    $('tc-dest').addEventListener('change', () => {
      const p = TRIP_PRESETS[$('tc-dest').value];
      if (p) { $('tc-hotel').value = p.hotel; $('tc-food').value = p.food; $('tc-act').value = p.act; $('tc-trans').value = p.trans; }
      calcTrip1();
    });
    $('tc2-dest').addEventListener('change', () => {
      const p = TRIP_PRESETS[$('tc2-dest').value];
      if (p) { $('tc2-hotel').value = p.hotel; $('tc2-food').value = p.food; $('tc2-act').value = p.act; $('tc2-trans').value = p.trans; }
      calcTrip2();
    });

    ['tc-ppl','tc-nights','tc-hotel','tc-food','tc-act','tc-trans','tc-flight'].forEach(id => $(id)?.addEventListener('input', calcTrip1));
    ['tc2-ppl','tc2-nights','tc2-hotel','tc2-food','tc2-act','tc2-trans','tc2-flight'].forEach(id => $(id)?.addEventListener('input', calcTrip2));

    $('btn-compare').addEventListener('click', () => {
      $('dest2-card').classList.remove('hidden');
      $('destinations-grid').classList.add('sm:grid-cols-2');
      $('btn-compare').classList.add('hidden');
      // Trigger preset load for destination 2
      const p = TRIP_PRESETS[$('tc2-dest').value];
      if (p) { $('tc2-hotel').value = p.hotel; $('tc2-food').value = p.food; $('tc2-act').value = p.act; $('tc2-trans').value = p.trans; }
      calcTrip2();
    });

    $('btn-remove-dest2').addEventListener('click', () => {
      $('dest2-card').classList.add('hidden');
      $('destinations-grid').classList.remove('sm:grid-cols-2');
      $('btn-compare').classList.remove('hidden');
      $('winner-banner').classList.add('hidden');
    });

    calcTrip1();

    const packLists = {
      'Tropical-City / sightseeing':['Lightweight shirts x nights','Shorts x 2','Comfortable walking shoes','Sunglasses','Sunscreen','Portable charger','Umbrella (compact)','Daypack'],
      'Temperate-City / sightseeing':['T-shirts x nights','Light jacket','Jeans x 2','Comfortable walking shoes','Umbrella','Portable charger','Daypack','Layers'],
      'Cold-City / sightseeing':['Thermal base layer','Wool sweater','Insulated jacket','Warm boots','Hat / gloves / scarf','Jeans x 2','Portable charger'],
      'Temperate-Hiking':['Moisture-wicking shirts','Hiking pants','Boots','Rain jacket','First aid kit','Headlamp','Water bottle','Snacks']
    };
    $('pk-gen').addEventListener('click', () => {
      const c = $('pk-climate').value, a = $('pk-act').value;
      let key = c + '-' + a;
      let items = packLists[key] || packLists['Temperate-City / sightseeing'];
      $('pk-result').innerHTML = items.map(i => '<li class="flex items-center gap-2"><span class="w-4 h-4 rounded border border-slate-300 inline-block"></span><span class="text-slate-700">' + i + '</span></li>').join('');
    });
  </script>
</BaseLayout>
