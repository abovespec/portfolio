---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title={siteConfig.identity.name} description={siteConfig.identity.description}>

  <style is:inline>
    @media print {
      body * { visibility: hidden !important; }
      #invoice-preview, #invoice-preview * { visibility: visible !important; }
      #invoice-preview {
        position: fixed !important;
        top: 0 !important; left: 0 !important;
        width: 100% !important;
        border: none !important;
        box-shadow: none !important;
        padding: 2cm !important;
        margin: 0 !important;
      }
    }
    @page { size: A4; margin: 1cm; }
  </style>

  <section class="relative -mx-4 overflow-hidden px-4 py-14 sm:py-20">
    <div class="absolute inset-0 bg-gradient-to-br from-emerald-50 via-teal-50 to-green-50" aria-hidden="true" />
    <div class="absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-emerald-300/20 blur-3xl" aria-hidden="true" />
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-teal-300/15 blur-3xl" aria-hidden="true" />
    <div class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">FreeInvoiceMake</h1>
        <p class="mt-3 text-lg text-slate-600">Create professional invoices in seconds. Free, no signup, instant download-ready print view.</p>
      </div>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {['Professional invoices in seconds', 'Free, no account needed', 'Print-ready PDF output', 'No data stored or shared'].map((badge) => (
          <li class="flex items-center gap-1.5">
            <svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
            </svg>
            {badge}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="mx-auto max-w-5xl grid gap-8 lg:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold mb-4 text-slate-800">Invoice Details</h2>

      <!-- Logo upload -->
      <div class="mb-4">
        <span class="block text-sm font-medium text-slate-700 mb-2">Company Logo</span>
        <div id="logo-drop-zone"
          class="relative flex flex-col items-center justify-center gap-1 rounded-lg border-2 border-dashed border-slate-300 bg-slate-50 px-4 py-4 cursor-pointer hover:border-blue-400 hover:bg-blue-50/30 transition"
          onclick="document.getElementById('logo-file-input').click()"
        >
          <div id="logo-placeholder" class="text-center">
            <svg class="mx-auto h-8 w-8 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="mt-1 text-xs text-slate-500">Click or drag &amp; drop to upload logo</p>
            <p class="text-xs text-slate-400">PNG, JPG, SVG</p>
          </div>
          <img id="logo-preview-thumb" class="hidden max-h-16 max-w-full object-contain rounded" alt="Logo preview" />
        </div>
        <input id="logo-file-input" type="file" accept="image/png,image/jpeg,image/svg+xml" class="hidden" />
        <button id="btn-remove-logo" class="hidden mt-1 text-xs text-red-500 hover:text-red-700 font-medium">Remove logo</button>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <label class="block"><span class="text-sm font-medium text-slate-700">Your business name</span><input id="inv-from-name" type="text" value="Acme Design Co." class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Your email</span><input id="inv-from-email" type="text" value="hello@acme.design" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Client name</span><input id="inv-to-name" type="text" value="Client Corp" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Client email</span><input id="inv-to-email" type="text" value="billing@client.com" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Invoice #</span><input id="inv-num" type="text" value="INV-001" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Invoice date</span><input id="inv-date" type="date" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Due date</span><input id="inv-due" type="date" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></label>
        <label class="block"><span class="text-sm font-medium text-slate-700">Tax rate (%)</span><input id="inv-tax" type="number" value="0" step="0.01" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></label>
      </div>

      <h3 class="text-sm font-semibold mt-5 mb-2 text-slate-800">Line Items</h3>
      <div id="line-items" class="space-y-2"></div>
      <button id="add-line" class="mt-2 text-sm text-blue-600 hover:text-blue-800 font-medium">+ Add line item</button>

      <div class="mt-5 flex gap-2">
        <button id="btn-print" class="flex-1 rounded-lg bg-blue-600 px-4 py-2 text-white font-semibold hover:bg-blue-700 flex items-center justify-center gap-2">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Download PDF (Print)
        </button>
        <button id="btn-reset" class="rounded-lg bg-slate-100 px-4 py-2 text-slate-700 font-medium hover:bg-slate-200">Reset</button>
      </div>
      <p class="mt-1.5 text-xs text-slate-400">Your browser will open the print dialog — choose "Save as PDF" to download.</p>
    </div>

    <div id="invoice-preview" class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm min-h-[600px]">
      <div class="flex justify-between items-start mb-6">
        <div>
          <!-- Logo in preview (hidden when no logo) -->
          <img id="prev-logo" class="hidden mb-2 max-h-16 max-w-[180px] object-contain" alt="Company logo" />
          <h2 id="prev-from-name" class="text-xl font-bold text-slate-900">Acme Design Co.</h2>
          <p id="prev-from-email" class="text-sm text-slate-500">hello@acme.design</p>
        </div>
        <div class="text-right">
          <p class="text-xs uppercase text-slate-400">Invoice</p>
          <p id="prev-num" class="text-lg font-bold text-slate-800">INV-001</p>
        </div>
      </div>
      <div class="flex justify-between mb-6 text-sm">
        <div><p class="text-slate-400 text-xs uppercase">Bill to</p><p id="prev-to-name" class="font-medium text-slate-800">Client Corp</p><p id="prev-to-email" class="text-slate-500">billing@client.com</p></div>
        <div class="text-right">
          <p class="text-slate-400 text-xs uppercase">Date</p><p id="prev-date" class="text-slate-700">--</p>
          <p class="text-slate-400 text-xs uppercase mt-1">Due</p><p id="prev-due" class="text-slate-700">--</p>
        </div>
      </div>
      <table class="w-full text-sm mb-6">
        <thead><tr class="border-b border-slate-200"><th class="text-left py-2 font-medium text-slate-500">Description</th><th class="text-right py-2 font-medium text-slate-500">Qty</th><th class="text-right py-2 font-medium text-slate-500">Rate</th><th class="text-right py-2 font-medium text-slate-500">Amount</th></tr></thead>
        <tbody id="prev-lines"></tbody>
      </table>
      <div class="border-t border-slate-200 pt-4 flex justify-end">
        <div class="w-48 text-sm">
          <div class="flex justify-between py-1"><span class="text-slate-500">Subtotal</span><span id="prev-subtotal" class="font-medium text-slate-800">$0.00</span></div>
          <div class="flex justify-between py-1"><span class="text-slate-500">Tax</span><span id="prev-tax" class="font-medium text-slate-800">$0.00</span></div>
          <div class="flex justify-between py-1 text-base font-bold"><span class="text-slate-800">Total</span><span id="prev-total" class="text-blue-700">$0.00</span></div>
        </div>
      </div>
      <p class="mt-8 text-xs text-slate-400 text-center">Generated by FreeInvoiceMake.com</p>
    </div>
  </div>

  <aside
    role="note"
    class="mx-auto my-6 max-w-5xl rounded-lg border border-amber-200 bg-amber-50/80 p-3 text-sm text-amber-900"
  >
    <strong class="font-semibold">Important:</strong> All calculators provide estimates for
    informational purposes only. Results do not constitute financial, legal, or tax advice.
    Consult a licensed financial advisor before making decisions.
  </aside>

  <section class="my-12 mx-auto max-w-5xl">
    <h2 class="text-2xl font-semibold mb-4 text-slate-800">Freelancer &amp; Small Business Guides</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <a href="/blog/how-to-write-an-invoice-for-freelance-work-a-step-by-step-guide/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-blue-400">
        <h3 class="font-semibold text-slate-900">How to Write a Professional Invoice</h3>
        <p class="mt-1 text-sm text-slate-600">Required elements, payment terms, and layout tips that get you paid faster.</p>
      </a>
      <a href="/blog/best-free-invoicing-software-2025-top-picks-for-freelancers-and-small-business/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-blue-400">
        <h3 class="font-semibold text-slate-900">Best Invoicing Software for Freelancers</h3>
        <p class="mt-1 text-sm text-slate-600">QuickBooks, FreshBooks, Wave, and Stripe Invoicing compared.</p>
      </a>
      <a href="/blog/invoice-payment-terms-examples-net-30-due-on-receipt-and-more/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-blue-400">
        <h3 class="font-semibold text-slate-900">Invoice Payment Terms Explained</h3>
        <p class="mt-1 text-sm text-slate-600">Net 30 vs Net 15 vs due on receipt. Which terms should you use?</p>
      </a>
      <a href="/blog/invoice-template-for-small-business-free-and-professional/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-blue-400">
        <h3 class="font-semibold text-slate-900">Free Invoice Template for Small Business</h3>
        <p class="mt-1 text-sm text-slate-600">A professional invoice template you can download and use immediately. No signup required.</p>
      </a>
    </div>
  </section>

  <script is:inline>
    let lineCount = 0;
    function $(id){ return document.getElementById(id); }
    function fmt(n){ return '$' + (n || 0).toFixed(2); }
    function todayStr(){ const d=new Date(); return d.toISOString().split('T')[0]; }

    $('inv-date').value = todayStr();
    const due = new Date(); due.setDate(due.getDate()+14);
    $('inv-due').value = due.toISOString().split('T')[0];

    function addLine(desc,qty,rate){
      lineCount++;
      const div = document.createElement('div');
      div.className = 'flex gap-2 items-center';
      div.innerHTML = '<input type="text" placeholder="Description" class="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm line-desc" value="'+(desc||'')+'">' +
        '<input type="number" placeholder="Qty" class="w-16 rounded-lg border border-slate-300 px-2 py-2 text-sm line-qty" value="'+(qty||1)+'">' +
        '<input type="number" placeholder="Rate" class="w-24 rounded-lg border border-slate-300 px-2 py-2 text-sm line-rate" value="'+(rate||0)+'">' +
        '<button class="text-red-500 text-sm remove-line" title="Remove">&times;</button>';
      $('line-items').appendChild(div);
      div.querySelector('.remove-line').addEventListener('click', () => { div.remove(); updatePreview(); });
      div.querySelectorAll('input').forEach(inp => inp.addEventListener('input', updatePreview));
    }
    addLine('Website Design', 1, 1500);
    addLine('Logo Design', 2, 350);

    $('add-line').addEventListener('click', () => addLine('',1,0));

    function updatePreview(){
      $('prev-from-name').textContent = $('inv-from-name').value || 'Your Business';
      $('prev-from-email').textContent = $('inv-from-email').value || '';
      $('prev-to-name').textContent = $('inv-to-name').value || 'Client';
      $('prev-to-email').textContent = $('inv-to-email').value || '';
      $('prev-num').textContent = $('inv-num').value || 'INV-001';
      $('prev-date').textContent = $('inv-date').value || '--';
      $('prev-due').textContent = $('inv-due').value || '--';

      const tbody = $('prev-lines');
      tbody.innerHTML = '';
      let subtotal = 0;
      document.querySelectorAll('#line-items > div').forEach(row => {
        const d = row.querySelector('.line-desc').value;
        const q = parseFloat(row.querySelector('.line-qty').value) || 0;
        const r = parseFloat(row.querySelector('.line-rate').value) || 0;
        const amt = q * r;
        subtotal += amt;
        const tr = document.createElement('tr');
        tr.className = 'border-b border-slate-100';
        tr.innerHTML = '<td class="py-2 text-slate-800">'+d+'</td><td class="py-2 text-right text-slate-600">'+q+'</td><td class="py-2 text-right text-slate-600">'+fmt(r)+'</td><td class="py-2 text-right font-medium text-slate-800">'+fmt(amt)+'</td>';
        tbody.appendChild(tr);
      });
      const taxRate = parseFloat($('inv-tax').value) || 0;
      const tax = subtotal * (taxRate/100);
      const total = subtotal + tax;
      $('prev-subtotal').textContent = fmt(subtotal);
      $('prev-tax').textContent = fmt(tax);
      $('prev-total').textContent = fmt(total);
    }

    ['inv-from-name','inv-from-email','inv-to-name','inv-to-email','inv-num','inv-date','inv-due','inv-tax'].forEach(id => {
      $(id).addEventListener('input', updatePreview);
    });

    // ── Logo upload ──
    const logoInput = $('logo-file-input');
    const dropZone  = $('logo-drop-zone');
    const logoThumb = $('logo-preview-thumb');
    const logoPrev  = $('prev-logo');
    const logoPlaceholder = $('logo-placeholder');
    const btnRemoveLogo   = $('btn-remove-logo');

    function applyLogo(dataUrl) {
      logoThumb.src = dataUrl;
      logoThumb.classList.remove('hidden');
      logoPlaceholder.classList.add('hidden');
      btnRemoveLogo.classList.remove('hidden');
      logoPrev.src = dataUrl;
      logoPrev.classList.remove('hidden');
    }

    function removeLogo() {
      logoThumb.src = '';
      logoThumb.classList.add('hidden');
      logoPlaceholder.classList.remove('hidden');
      btnRemoveLogo.classList.add('hidden');
      logoPrev.src = '';
      logoPrev.classList.add('hidden');
      logoInput.value = '';
    }

    logoInput.addEventListener('change', function() {
      const file = this.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) { applyLogo(e.target.result); };
      reader.readAsDataURL(file);
    });

    // Drag and drop
    dropZone.addEventListener('dragover', function(e) {
      e.preventDefault();
      this.classList.add('border-blue-400', 'bg-blue-50/30');
    });
    dropZone.addEventListener('dragleave', function() {
      this.classList.remove('border-blue-400', 'bg-blue-50/30');
    });
    dropZone.addEventListener('drop', function(e) {
      e.preventDefault();
      this.classList.remove('border-blue-400', 'bg-blue-50/30');
      const file = e.dataTransfer.files[0];
      if (!file || !file.type.startsWith('image/')) return;
      const reader = new FileReader();
      reader.onload = function(ev) { applyLogo(ev.target.result); };
      reader.readAsDataURL(file);
    });

    btnRemoveLogo.addEventListener('click', removeLogo);

    // ── Print / PDF ──
    $('btn-print').addEventListener('click', () => { window.print(); });

    $('btn-reset').addEventListener('click', () => {
      $('line-items').innerHTML = '';
      addLine('Website Design',1,1500); addLine('Logo Design',2,350);
      removeLogo();
      updatePreview();
    });

    updatePreview();
  </script>
</BaseLayout>
