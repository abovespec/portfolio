---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best Website Builders 2025 | PickTheStack" description="Compare drag-and-drop website builders for portfolios, stores, and business sites. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best Website Builders</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare drag-and-drop website builders for portfolios, stores, and business sites. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Website Builders Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Wix</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Squarespace</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Webflow</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">WordPress.com</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Weebly</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">Yes (branded)</td><td class="text-center">14-day trial</td><td class="text-center">Yes (staging)</td><td class="text-center">Yes (branded)</td><td class="text-center">Yes (branded)</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$11/mo</td><td class="text-center">$16/mo</td><td class="text-center">$14/mo</td><td class="text-center">$4/mo</td><td class="text-center">$10/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">Design flexibility</td><td class="text-center">Portfolios & creatives</td><td class="text-center">Designers & devs</td><td class="text-center">Bloggers</td><td class="text-center">Simple sites</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.2</td><td class="text-center">4.4</td><td class="text-center">4.4</td><td class="text-center">4.2</td><td class="text-center">4.2</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Templates</td><td class="text-center">900+</td><td class="text-center">150+</td><td class="text-center">1,500+</td><td class="text-center">10,000+</td><td class="text-center">50+</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">E-commerce</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Blog</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">CMS</td><td class="text-center">Native</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">SEO tools</td><td class="text-center">Good</td><td class="text-center">Good</td><td class="text-center">Excellent</td><td class="text-center">Plugin</td><td class="text-center">Basic</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Custom code</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Full</td><td class="text-center">Business+</td><td class="text-center">Limited</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Support</td><td class="text-center">24/7</td><td class="text-center">24/7</td><td class="text-center">Email/chat</td><td class="text-center">Email</td><td class="text-center">Email/chat</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
      <p class="mt-1 text-xs text-slate-400">Last updated: April 2026</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your Website Builders</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Need full design control + animations?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="webflow:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="wix:2,squarespace:2,wordpress:1,weebly:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Is e-commerce the primary goal?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="squarespace:2,wix:2,webflow:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="wordpress:2,weebly:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Are you a blogger first?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="wordpress:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="wix:1,squarespace:1,webflow:1,weebly:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Want the cheapest paid plan?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="wordpress:3,weebly:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="wix:1,squarespace:1,webflow:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Wix</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Design flexibility — Starting at $11/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (branded) | G2: 4.2</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Squarespace</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Portfolios & creatives — Starting at $16/mo</p>
          <p class="mt-2 text-xs text-slate-400">14-day trial | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Webflow</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Designers & devs — Starting at $14/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (staging) | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">WordPress.com</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Bloggers — Starting at $4/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (branded) | G2: 4.2</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Weebly</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Simple sites — Starting at $10/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (branded) | G2: 4.2</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best website builder</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">wix vs squarespace</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">webflow review</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best website builder for small business</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">free website builder</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { wix:0, squarespace:0, webflow:0, wordpresscom:0, weebly:0 };
    const names = { wix:"Wix", squarespace:"Squarespace", webflow:"Webflow", wordpresscom:"WordPress.com", weebly:"Weebly" };
    const reasons = { wix:"Design flexibility", squarespace:"Portfolios & creatives", webflow:"Designers & devs", wordpresscom:"Bloggers", weebly:"Simple sites" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
