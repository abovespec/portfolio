---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best Team Chat & Collaboration 2025 | PickTheStack" description="Compare team messaging apps for remote work, async communication, and integrations. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best Team Chat & Collaboration</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare team messaging apps for remote work, async communication, and integrations. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Team Chat & Collaboration Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Slack</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Microsoft Teams</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Discord</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Mattermost</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Rocket.Chat</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">Yes (90 days history)</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes (self-host)</td><td class="text-center">Yes (self-host)</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$7.25/mo</td><td class="text-center">$4/mo</td><td class="text-center">$2.99/mo</td><td class="text-center">$10/mo</td><td class="text-center">$7/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">Integrations</td><td class="text-center">M365 shops</td><td class="text-center">Communities</td><td class="text-center">Self-hosted teams</td><td class="text-center">Open source</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.5</td><td class="text-center">4.3</td><td class="text-center">4.5</td><td class="text-center">4.4</td><td class="text-center">4.3</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Channels</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Voice/video</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Screen share</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Threads</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Guest access</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Open source</td><td class="text-center">No</td><td class="text-center">No</td><td class="text-center">No</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
      <p class="mt-1 text-xs text-slate-400">Last updated: April 2026</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your Team Chat & Collaboration</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Need self-hosted / air-gapped deployment?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="mattermost:3,rocket.chat:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="slack:2,teams:2,discord:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Is this for a community, not a company?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="discord:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="slack:2,teams:2,mattermost:1,rocket.chat:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Deep Microsoft 365 integration needed?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="teams:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="slack:2,discord:1,mattermost:1,rocket.chat:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Want the most app integrations?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="slack:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="teams:2,discord:1,mattermost:1,rocket.chat:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Slack</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Integrations — Starting at $7.25/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (90 days history) | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Microsoft Teams</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: M365 shops — Starting at $4/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.3</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Discord</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Communities — Starting at $2.99/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Mattermost</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Self-hosted teams — Starting at $10/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (self-host) | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Rocket.Chat</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Open source — Starting at $7/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (self-host) | G2: 4.3</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best team chat app</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">slack vs teams</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">slack alternatives</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">team collaboration software</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">open source team chat</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { slack:0, microsoftteams:0, discord:0, mattermost:0, rocketchat:0 };
    const names = { slack:"Slack", microsoftteams:"Microsoft Teams", discord:"Discord", mattermost:"Mattermost", rocketchat:"Rocket.Chat" };
    const reasons = { slack:"Integrations", microsoftteams:"M365 shops", discord:"Communities", mattermost:"Self-hosted teams", rocketchat:"Open source" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
