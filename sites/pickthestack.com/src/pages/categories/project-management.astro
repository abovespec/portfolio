---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best Project Management 2025 | PickTheStack" description="Compare the best project management software for teams, agencies, and solo operators. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best Project Management</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare the best project management software for teams, agencies, and solo operators. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Project Management Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Asana</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Monday.com</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">ClickUp</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Notion</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Trello</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$10.99/mo</td><td class="text-center">$9/mo</td><td class="text-center">$7/mo</td><td class="text-center">$8/mo</td><td class="text-center">$5/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">Teams & workflows</td><td class="text-center">Visual planners</td><td class="text-center">All-in-one power users</td><td class="text-center">Docs + databases</td><td class="text-center">Kanban purists</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.3</td><td class="text-center">4.7</td><td class="text-center">4.6</td><td class="text-center">4.7</td><td class="text-center">4.4</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Team size</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Integrations</td><td class="text-center">300+</td><td class="text-center">200+</td><td class="text-center">1000+</td><td class="text-center">100+</td><td class="text-center">200+</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Mobile app</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Time tracking</td><td class="text-center">Add-on</td><td class="text-center">Built-in</td><td class="text-center">Built-in</td><td class="text-center">No</td><td class="text-center">Power-Up</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Custom fields</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Guest access</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Automation</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Partial</td><td class="text-center">Yes</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your Project Management</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Do you need docs and wikis alongside tasks?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="notion:3,clickup:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="asana:2,monday:2,trello:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Is visual timeline/Gantt critical?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="monday:3,asana:2,clickup:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="trello:2,notion:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Do you need built-in time tracking?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="clickup:3,monday:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="asana:1,notion:1,trello:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Budget under $8/user/month?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="trello:3,clickup:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="asana:1,monday:1,notion:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Asana</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Teams & workflows — Starting at $10.99/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.3</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Monday.com</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Visual planners — Starting at $9/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.7</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">ClickUp</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: All-in-one power users — Starting at $7/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.6</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Notion</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Docs + databases — Starting at $8/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.7</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Trello</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Kanban purists — Starting at $5/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.4</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best project management software</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">asana vs monday.com</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">clickup vs notion</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">free project management tools</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">project management software for small teams</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { asana:0, mondaycom:0, clickup:0, notion:0, trello:0 };
    const names = { asana:"Asana", mondaycom:"Monday.com", clickup:"ClickUp", notion:"Notion", trello:"Trello" };
    const reasons = { asana:"Teams & workflows", mondaycom:"Visual planners", clickup:"All-in-one power users", notion:"Docs + databases", trello:"Kanban purists" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
