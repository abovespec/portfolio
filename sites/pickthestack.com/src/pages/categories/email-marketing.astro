---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best Email Marketing 2025 | PickTheStack" description="Find the best email marketing platform for newsletters, automation, and e-commerce. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best Email Marketing</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Find the best email marketing platform for newsletters, automation, and e-commerce. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Email Marketing Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Mailchimp</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">ConvertKit</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">ActiveCampaign</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Brevo</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">MailerLite</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">Yes (500 contacts)</td><td class="text-center">Yes (1,000 subs)</td><td class="text-center">14-day trial</td><td class="text-center">Yes (300 emails/day)</td><td class="text-center">Yes (1,000 subs)</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$13/mo</td><td class="text-center">$9/mo</td><td class="text-center">$15/mo</td><td class="text-center">$9/mo</td><td class="text-center">$9/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">Beginners</td><td class="text-center">Creators</td><td class="text-center">Automation power</td><td class="text-center">Budget senders</td><td class="text-center">Simple newsletters</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.3</td><td class="text-center">4.4</td><td class="text-center">4.5</td><td class="text-center">4.5</td><td class="text-center">4.7</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Automation</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Advanced</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Templates</td><td class="text-center">100+</td><td class="text-center">Minimal</td><td class="text-center">250+</td><td class="text-center">40+</td><td class="text-center">80+</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">A/B testing</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Landing pages</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">E-commerce</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Support</td><td class="text-center">Email/chat</td><td class="text-center">Chat/email</td><td class="text-center">Chat/email</td><td class="text-center">Email/chat</td><td class="text-center">Email/chat</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
      <p class="mt-1 text-xs text-slate-400">Last updated: April 2026</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your Email Marketing</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Are you a creator selling digital products?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="convertkit:3,mailerlite:1">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="mailchimp:2,activecampaign:2,brevo:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Need advanced automation workflows?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="activecampaign:3,convertkit:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="mailchimp:1,brevo:1,mailerlite:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Is a generous free plan essential?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="brevo:3,convertkit:2,mailerlite:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="activecampaign:1,mailchimp:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Do you need e-commerce deep integrations?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="activecampaign:3,mailchimp:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="convertkit:1,mailerlite:1,brevo:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Mailchimp</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Beginners — Starting at $13/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (500 contacts) | G2: 4.3</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">ConvertKit</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Creators — Starting at $9/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (1,000 subs) | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">ActiveCampaign</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Automation power — Starting at $15/mo</p>
          <p class="mt-2 text-xs text-slate-400">14-day trial | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Brevo</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Budget senders — Starting at $9/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (300 emails/day) | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">MailerLite</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Simple newsletters — Starting at $9/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (1,000 subs) | G2: 4.7</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best email marketing software</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">mailchimp vs convertkit</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">activecampaign review</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">free email marketing tools</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">email marketing for creators</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { mailchimp:0, convertkit:0, activecampaign:0, brevo:0, mailerlite:0 };
    const names = { mailchimp:"Mailchimp", convertkit:"ConvertKit", activecampaign:"ActiveCampaign", brevo:"Brevo", mailerlite:"MailerLite" };
    const reasons = { mailchimp:"Beginners", convertkit:"Creators", activecampaign:"Automation power", brevo:"Budget senders", mailerlite:"Simple newsletters" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
