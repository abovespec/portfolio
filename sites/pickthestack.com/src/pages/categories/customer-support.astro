---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best Customer Support Software 2025 | PickTheStack" description="Compare help desk and customer support tools for SaaS, e-commerce, and agencies. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best Customer Support Software</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare help desk and customer support tools for SaaS, e-commerce, and agencies. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Customer Support Software Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Zendesk</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Intercom</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Freshdesk</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Help Scout</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">LiveAgent</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">No</td><td class="text-center">No</td><td class="text-center">Yes</td><td class="text-center">No</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$19/mo</td><td class="text-center">$39/mo</td><td class="text-center">$15/mo</td><td class="text-center">$20/mo</td><td class="text-center">$9/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">Enterprise</td><td class="text-center">Product-led growth</td><td class="text-center">Budget teams</td><td class="text-center">SMB simplicity</td><td class="text-center">All-in-one budget</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.3</td><td class="text-center">4.4</td><td class="text-center">4.4</td><td class="text-center">4.4</td><td class="text-center">4.5</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Ticketing</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Live chat</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Add-on</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Knowledge base</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Automation</td><td class="text-center">Advanced</td><td class="text-center">Advanced</td><td class="text-center">Good</td><td class="text-center">Good</td><td class="text-center">Good</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Reporting</td><td class="text-center">Advanced</td><td class="text-center">Good</td><td class="text-center">Good</td><td class="text-center">Good</td><td class="text-center">Good</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Integrations</td><td class="text-center">1,000+</td><td class="text-center">300+</td><td class="text-center">500+</td><td class="text-center">100+</td><td class="text-center">200+</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your Customer Support Software</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Need enterprise scale + 1,000+ integrations?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="zendesk:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="intercom:2,freshdesk:2,help scout:1,liveagent:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Is in-app product messaging critical?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="intercom:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="zendesk:2,freshdesk:1,help scout:1,liveagent:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Tightest budget under $20/agent?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="liveagent:3,freshdesk:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="zendesk:1,intercom:1,help scout:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Want the simplest, cleanest UI?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="help scout:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="freshdesk:2,liveagent:1,zendesk:1,intercom:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Zendesk</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Enterprise — Starting at $19/mo</p>
          <p class="mt-2 text-xs text-slate-400">No | G2: 4.3</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Intercom</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Product-led growth — Starting at $39/mo</p>
          <p class="mt-2 text-xs text-slate-400">No | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Freshdesk</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Budget teams — Starting at $15/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Help Scout</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: SMB simplicity — Starting at $20/mo</p>
          <p class="mt-2 text-xs text-slate-400">No | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">LiveAgent</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: All-in-one budget — Starting at $9/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.5</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best customer support software</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">zendesk vs intercom</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">freshdesk review</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">help desk software comparison</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">live chat software</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { zendesk:0, intercom:0, freshdesk:0, helpscout:0, liveagent:0 };
    const names = { zendesk:"Zendesk", intercom:"Intercom", freshdesk:"Freshdesk", helpscout:"Help Scout", liveagent:"LiveAgent" };
    const reasons = { zendesk:"Enterprise", intercom:"Product-led growth", freshdesk:"Budget teams", helpscout:"SMB simplicity", liveagent:"All-in-one budget" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
