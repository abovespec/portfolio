---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best Graphic Design Tools 2025 | PickTheStack" description="Compare graphic design tools for social media, marketing materials, and brand assets. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best Graphic Design Tools</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare graphic design tools for social media, marketing materials, and brand assets. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Graphic Design Tools Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Canva</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Adobe Express</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Figma</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Sketch</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">VistaCreate</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">No</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$12.99/mo</td><td class="text-center">$9.99/mo</td><td class="text-center">$12/mo</td><td class="text-center">$9/mo</td><td class="text-center">$10/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">Non-designers</td><td class="text-center">Adobe ecosystem</td><td class="text-center">UI/UX design</td><td class="text-center">Mac UI design</td><td class="text-center">Social creatives</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.7</td><td class="text-center">4.5</td><td class="text-center">4.7</td><td class="text-center">4.5</td><td class="text-center">4.4</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Templates</td><td class="text-center">1M+</td><td class="text-center">50,000+</td><td class="text-center">Community</td><td class="text-center">Community</td><td class="text-center">100,000+</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Brand kit</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Styles</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">AI features</td><td class="text-center">Magic Studio</td><td class="text-center">Firefly</td><td class="text-center">AI plugins</td><td class="text-center">Limited</td><td class="text-center">Basic</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Collaboration</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Real-time</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Video</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">No</td><td class="text-center">No</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Print</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">No</td><td class="text-center">No</td><td class="text-center">Yes</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your Graphic Design Tools</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Are you designing app interfaces / UI?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="figma:3,sketch:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="canva:2,adobe express:2,vistacreate:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Need print-ready marketing materials?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="canva:3,adobe express:2,vistacreate:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="figma:1,sketch:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Already paying for Adobe Creative Cloud?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="adobe express:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="canva:2,figma:1,sketch:1,vistacreate:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Want the largest template library?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="canva:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="adobe express:2,figma:1,sketch:1,vistacreate:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Canva</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Non-designers — Starting at $12.99/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.7</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Adobe Express</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Adobe ecosystem — Starting at $9.99/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Figma</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: UI/UX design — Starting at $12/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.7</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Sketch</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Mac UI design — Starting at $9/mo</p>
          <p class="mt-2 text-xs text-slate-400">No | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">VistaCreate</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Social creatives — Starting at $10/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.4</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best graphic design software</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">canva vs adobe express</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">figma vs sketch</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best design tool for marketers</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">free graphic design tool</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { canva:0, adobeexpress:0, figma:0, sketch:0, vistacreate:0 };
    const names = { canva:"Canva", adobeexpress:"Adobe Express", figma:"Figma", sketch:"Sketch", vistacreate:"VistaCreate" };
    const reasons = { canva:"Non-designers", adobeexpress:"Adobe ecosystem", figma:"UI/UX design", sketch:"Mac UI design", vistacreate:"Social creatives" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
