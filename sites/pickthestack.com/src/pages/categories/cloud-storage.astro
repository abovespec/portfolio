---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best Cloud Storage 2025 | PickTheStack" description="Compare secure cloud storage providers for personal files, teams, and backups. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best Cloud Storage</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare secure cloud storage providers for personal files, teams, and backups. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Cloud Storage Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Dropbox</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Google Drive</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">pCloud</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Sync.com</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Icedrive</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">Yes (2GB)</td><td class="text-center">Yes (15GB)</td><td class="text-center">Yes (10GB)</td><td class="text-center">Yes (5GB)</td><td class="text-center">Yes (10GB)</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$9.99/mo</td><td class="text-center">$1.99/mo</td><td class="text-center">$49.99/yr</td><td class="text-center">$8/mo</td><td class="text-center">$1.67/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">Collaboration</td><td class="text-center">Google users</td><td class="text-center">Lifetime deals</td><td class="text-center">Privacy</td><td class="text-center">Budget</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.4</td><td class="text-center">4.6</td><td class="text-center">4.5</td><td class="text-center">4.6</td><td class="text-center">4.3</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Storage free</td><td class="text-center">2 GB</td><td class="text-center">15 GB</td><td class="text-center">10 GB</td><td class="text-center">5 GB</td><td class="text-center">10 GB</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Storage paid</td><td class="text-center">2 TB</td><td class="text-center">2 TB</td><td class="text-center">2 TB</td><td class="text-center">2 TB</td><td class="text-center">1 TB</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Sync speed</td><td class="text-center">Fast</td><td class="text-center">Fast</td><td class="text-center">Fast</td><td class="text-center">Good</td><td class="text-center">Good</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">File sharing</td><td class="text-center">Excellent</td><td class="text-center">Excellent</td><td class="text-center">Good</td><td class="text-center">Good</td><td class="text-center">Basic</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Versioning</td><td class="text-center">180 days</td><td class="text-center">100 days</td><td class="text-center">15 days</td><td class="text-center">180 days</td><td class="text-center">No</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Encryption</td><td class="text-center">AES-256</td><td class="text-center">AES-256</td><td class="text-center">Client-side</td><td class="text-center">End-to-end</td><td class="text-center">Client-side</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
      <p class="mt-1 text-xs text-slate-400">Last updated: April 2026</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your Cloud Storage</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Is end-to-end encryption a must?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="sync:3,pcloud:2,icedrive:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="dropbox:2,google drive:2">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Do you want a lifetime payment option?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="pcloud:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="dropbox:1,google drive:1,sync:1,icedrive:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Already deep in Google Workspace?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="google drive:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="dropbox:1,pcloud:1,sync:1,icedrive:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Cheapest option with decent features?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="icedrive:3,google drive:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="dropbox:1,pcloud:1,sync:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Dropbox</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Collaboration — Starting at $9.99/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (2GB) | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Google Drive</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Google users — Starting at $1.99/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (15GB) | G2: 4.6</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">pCloud</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Lifetime deals — Starting at $49.99/yr</p>
          <p class="mt-2 text-xs text-slate-400">Yes (10GB) | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Sync.com</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Privacy — Starting at $8/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (5GB) | G2: 4.6</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Icedrive</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Budget — Starting at $1.67/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (10GB) | G2: 4.3</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best cloud storage</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">dropbox vs google drive</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">secure cloud storage</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">pcloud review</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">cloud storage comparison</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { dropbox:0, googledrive:0, pcloud:0, synccom:0, icedrive:0 };
    const names = { dropbox:"Dropbox", googledrive:"Google Drive", pcloud:"pCloud", synccom:"Sync.com", icedrive:"Icedrive" };
    const reasons = { dropbox:"Collaboration", googledrive:"Google users", pcloud:"Lifetime deals", synccom:"Privacy", icedrive:"Budget" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
