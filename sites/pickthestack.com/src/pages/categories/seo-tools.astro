---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best SEO Tools 2025 | PickTheStack" description="Compare SEO tools for keyword research, rank tracking, site audits, and backlink analysis. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best SEO Tools</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare SEO tools for keyword research, rank tracking, site audits, and backlink analysis. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">SEO Tools Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Ahrefs</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">SEMrush</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Moz Pro</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Ubersuggest</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Serpstat</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">Limited tools</td><td class="text-center">Limited</td><td class="text-center">30-day trial</td><td class="text-center">Limited</td><td class="text-center">Limited</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$83/mo</td><td class="text-center">$108.33/mo</td><td class="text-center">$79/mo</td><td class="text-center">$29/mo</td><td class="text-center">$50/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">Backlinks</td><td class="text-center">All-in-one</td><td class="text-center">Beginners</td><td class="text-center">Budget</td><td class="text-center">Mid-market</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.5</td><td class="text-center">4.5</td><td class="text-center">4.4</td><td class="text-center">4.2</td><td class="text-center">4.6</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Keyword research</td><td class="text-center">Excellent</td><td class="text-center">Excellent</td><td class="text-center">Good</td><td class="text-center">Good</td><td class="text-center">Good</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Rank tracking</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Site audit</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Backlinks</td><td class="text-center">Best</td><td class="text-center">Good</td><td class="text-center">Good</td><td class="text-center">Basic</td><td class="text-center">Good</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Content explorer</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">No</td><td class="text-center">No</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">API</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">No</td><td class="text-center">Yes</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
      <p class="mt-1 text-xs text-slate-400">Last updated: April 2026</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your SEO Tools</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Is backlink analysis your #1 need?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="ahrefs:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="semrush:2,moz:2,ubersuggest:1,serpstat:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Need content marketing / topic research too?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="semrush:3,ahrefs:2,serpstat:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="moz:1,ubersuggest:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Budget under $50/mo?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="ubersuggest:3,serpstat:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="ahrefs:1,semrush:1,moz:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Want the simplest UI for beginners?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="moz:3,ubersuggest:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="ahrefs:1,semrush:1,serpstat:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Ahrefs</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Backlinks — Starting at $83/mo</p>
          <p class="mt-2 text-xs text-slate-400">Limited tools | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">SEMrush</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: All-in-one — Starting at $108.33/mo</p>
          <p class="mt-2 text-xs text-slate-400">Limited | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Moz Pro</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Beginners — Starting at $79/mo</p>
          <p class="mt-2 text-xs text-slate-400">30-day trial | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Ubersuggest</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Budget — Starting at $29/mo</p>
          <p class="mt-2 text-xs text-slate-400">Limited | G2: 4.2</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Serpstat</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Mid-market — Starting at $50/mo</p>
          <p class="mt-2 text-xs text-slate-400">Limited | G2: 4.6</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best seo tools</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">ahrefs vs semrush</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">seo software comparison</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best keyword research tool</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">free seo tools</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { ahrefs:0, semrush:0, mozpro:0, ubersuggest:0, serpstat:0 };
    const names = { ahrefs:"Ahrefs", semrush:"SEMrush", mozpro:"Moz Pro", ubersuggest:"Ubersuggest", serpstat:"Serpstat" };
    const reasons = { ahrefs:"Backlinks", semrush:"All-in-one", mozpro:"Beginners", ubersuggest:"Budget", serpstat:"Mid-market" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
