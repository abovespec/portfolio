---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best Note Taking & Knowledge Bases 2025 | PickTheStack" description="Compare note-taking apps for students, writers, researchers, and teams. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best Note Taking & Knowledge Bases</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare note-taking apps for students, writers, researchers, and teams. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Note Taking & Knowledge Bases Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Notion</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Obsidian</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Evernote</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">OneNote</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Bear</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes (limited)</td><td class="text-center">Yes</td><td class="text-center">No</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$8/mo</td><td class="text-center">$0 (free forever)</td><td class="text-center">$10.83/mo</td><td class="text-center">$0</td><td class="text-center">$2.99/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">All-in-one workspace</td><td class="text-center">Local markdown</td><td class="text-center">Web clipper</td><td class="text-center">Microsoft users</td><td class="text-center">Apple writers</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.7</td><td class="text-center">4.8</td><td class="text-center">4.4</td><td class="text-center">4.5</td><td class="text-center">4.5</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Markdown</td><td class="text-center">Partial</td><td class="text-center">Native</td><td class="text-center">No</td><td class="text-center">No</td><td class="text-center">Native</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Offline</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Attachments</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Web clipper</td><td class="text-center">Yes</td><td class="text-center">Plugin</td><td class="text-center">Excellent</td><td class="text-center">Good</td><td class="text-center">No</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Templates</td><td class="text-center">10,000+</td><td class="text-center">Community</td><td class="text-center">100+</td><td class="text-center">Built-in</td><td class="text-center">Themes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Collaboration</td><td class="text-center">Yes</td><td class="text-center">Publish add-on</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">No</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your Note Taking & Knowledge Bases</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Do you want files stored locally, not cloud?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="obsidian:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="notion:2,evernote:2,onenote:1,bear:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Is native Markdown support essential?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="obsidian:3,bear:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="notion:1,evernote:1,onenote:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Deep web clipping / research focus?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="evernote:3,notion:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="obsidian:1,onenote:1,bear:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Apple-only ecosystem?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="bear:3,obsidian:1">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="notion:2,evernote:2,onenote:2">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Notion</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: All-in-one workspace — Starting at $8/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.7</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Obsidian</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Local markdown — Starting at $0 (free forever)</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.8</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Evernote</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Web clipper — Starting at $10.83/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (limited) | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">OneNote</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Microsoft users — Starting at $0</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Bear</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Apple writers — Starting at $2.99/mo</p>
          <p class="mt-2 text-xs text-slate-400">No | G2: 4.5</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best note taking app</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">notion vs obsidian</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">evernote alternatives</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">note taking app for students</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">markdown note app</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { notion:0, obsidian:0, evernote:0, onenote:0, bear:0 };
    const names = { notion:"Notion", obsidian:"Obsidian", evernote:"Evernote", onenote:"OneNote", bear:"Bear" };
    const reasons = { notion:"All-in-one workspace", obsidian:"Local markdown", evernote:"Web clipper", onenote:"Microsoft users", bear:"Apple writers" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
