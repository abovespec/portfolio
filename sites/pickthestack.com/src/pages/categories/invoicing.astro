---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best Invoicing Software 2025 | PickTheStack" description="Compare invoicing tools for freelancers, agencies, and small businesses. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best Invoicing Software</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare invoicing tools for freelancers, agencies, and small businesses. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Invoicing Software Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">QuickBooks</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">FreshBooks</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Wave</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Zoho Invoice</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Invoice2go</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">30-day trial</td><td class="text-center">30-day trial</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">No</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$15/mo</td><td class="text-center">$8.50/mo</td><td class="text-center">$0</td><td class="text-center">$0</td><td class="text-center">$5.99/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">Full accounting</td><td class="text-center">Freelancers</td><td class="text-center">Free invoicing</td><td class="text-center">Zoho users</td><td class="text-center">Mobile-first</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.0</td><td class="text-center">4.5</td><td class="text-center">4.4</td><td class="text-center">4.5</td><td class="text-center">4.3</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Unlimited invoices</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Recurring</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Payments</td><td class="text-center">Built-in</td><td class="text-center">Built-in</td><td class="text-center">Paid</td><td class="text-center">Multiple</td><td class="text-center">Built-in</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Multi-currency</td><td class="text-center">Plus+</td><td class="text-center">Yes</td><td class="text-center">No</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Time tracking</td><td class="text-center">Yes</td><td class="text-center">Built-in</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Expenses</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your Invoicing Software</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Need full bookkeeping + tax reporting?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="quickbooks:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="freshbooks:2,wave:2,zoho:1,invoice2go:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Is completely free invoicing the goal?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="wave:3,zoho:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="quickbooks:1,freshbooks:1,invoice2go:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Do you bill by the hour and need time tracking?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="freshbooks:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="quickbooks:1,wave:1,zoho:1,invoice2go:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Heavy mobile invoicing on the go?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="invoice2go:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="quickbooks:1,freshbooks:1,wave:1,zoho:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">QuickBooks</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Full accounting — Starting at $15/mo</p>
          <p class="mt-2 text-xs text-slate-400">30-day trial | G2: 4.0</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">FreshBooks</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Freelancers — Starting at $8.50/mo</p>
          <p class="mt-2 text-xs text-slate-400">30-day trial | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Wave</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Free invoicing — Starting at $0</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Zoho Invoice</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Zoho users — Starting at $0</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Invoice2go</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Mobile-first — Starting at $5.99/mo</p>
          <p class="mt-2 text-xs text-slate-400">No | G2: 4.3</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best invoicing software</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">free invoicing tool</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">freshbooks vs quickbooks</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">invoicing for freelancers</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best invoice app</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { quickbooks:0, freshbooks:0, wave:0, zohoinvoice:0, invoice2go:0 };
    const names = { quickbooks:"QuickBooks", freshbooks:"FreshBooks", wave:"Wave", zohoinvoice:"Zoho Invoice", invoice2go:"Invoice2go" };
    const reasons = { quickbooks:"Full accounting", freshbooks:"Freelancers", wave:"Free invoicing", zohoinvoice:"Zoho users", invoice2go:"Mobile-first" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
