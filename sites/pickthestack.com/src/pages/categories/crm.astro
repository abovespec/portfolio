---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best CRM Software 2025 | PickTheStack" description="Compare customer relationship management tools for sales teams and small businesses. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best CRM Software</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare customer relationship management tools for sales teams and small businesses. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">CRM Software Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">HubSpot CRM</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Salesforce</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Pipedrive</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Zoho CRM</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Freshsales</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">Yes</td><td class="text-center">30-day trial</td><td class="text-center">14-day trial</td><td class="text-center">Yes (3 users)</td><td class="text-center">Yes (3 users)</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$15/mo</td><td class="text-center">$25/mo</td><td class="text-center">$14/mo</td><td class="text-center">$14/mo</td><td class="text-center">$9/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">All-in-one growth</td><td class="text-center">Enterprise sales</td><td class="text-center">Visual sales pipelines</td><td class="text-center">Budget SMBs</td><td class="text-center">Support + sales</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.4</td><td class="text-center">4.3</td><td class="text-center">4.2</td><td class="text-center">4.0</td><td class="text-center">4.5</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Contact limit</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Pipelines</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td><td class="text-center">Unlimited</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Email tracking</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Reporting</td><td class="text-center">Advanced</td><td class="text-center">Advanced</td><td class="text-center">Good</td><td class="text-center">Good</td><td class="text-center">Good</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Mobile app</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">AI features</td><td class="text-center">Yes</td><td class="text-center">Einstein</td><td class="text-center">Add-on</td><td class="text-center">Zia</td><td class="text-center">Freddy</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your CRM Software</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Do you need marketing + service hub too?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="hubspot:3,zoho:1">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="pipedrive:2,freshsales:2,salesforce:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Is visual pipeline your top priority?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="pipedrive:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="hubspot:2,salesforce:2,freshsales:1,zoho:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Need a completely free CRM for 1-3 users?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="hubspot:3,zoho:2,freshsales:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="salesforce:1,pipedrive:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Enterprise-level customization needed?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="salesforce:3,hubspot:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="pipedrive:1,freshsales:1,zoho:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">HubSpot CRM</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: All-in-one growth — Starting at $15/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Salesforce</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Enterprise sales — Starting at $25/mo</p>
          <p class="mt-2 text-xs text-slate-400">30-day trial | G2: 4.3</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Pipedrive</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Visual sales pipelines — Starting at $14/mo</p>
          <p class="mt-2 text-xs text-slate-400">14-day trial | G2: 4.2</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Zoho CRM</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Budget SMBs — Starting at $14/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (3 users) | G2: 4.0</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Freshsales</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Support + sales — Starting at $9/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (3 users) | G2: 4.5</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best crm software</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">hubspot vs salesforce</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">free crm for small business</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">pipedrive review</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">crm comparison 2025</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { hubspotcrm:0, salesforce:0, pipedrive:0, zohocrm:0, freshsales:0 };
    const names = { hubspotcrm:"HubSpot CRM", salesforce:"Salesforce", pipedrive:"Pipedrive", zohocrm:"Zoho CRM", freshsales:"Freshsales" };
    const reasons = { hubspotcrm:"All-in-one growth", salesforce:"Enterprise sales", pipedrive:"Visual sales pipelines", zohocrm:"Budget SMBs", freshsales:"Support + sales" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
