---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best Password Managers 2025 | PickTheStack" description="Compare the best password managers for security, cross-device sync, and family sharing. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best Password Managers</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare the best password managers for security, cross-device sync, and family sharing. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Password Managers Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">1Password</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Bitwarden</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">LastPass</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Dashlane</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">NordPass</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">14-day trial</td><td class="text-center">Yes</td><td class="text-center">Yes (1 device)</td><td class="text-center">Yes (1 device)</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$2.99/mo</td><td class="text-center">$0.83/mo</td><td class="text-center">$3/mo</td><td class="text-center">$3.99/mo</td><td class="text-center">$1.49/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">Best overall</td><td class="text-center">Open source</td><td class="text-center">Enterprise</td><td class="text-center">Built-in VPN</td><td class="text-center">Budget pick</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.7</td><td class="text-center">4.7</td><td class="text-center">4.1</td><td class="text-center">4.5</td><td class="text-center">4.4</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Cross-platform</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Family plan</td><td class="text-center">$4.99/mo</td><td class="text-center">$3.33/mo</td><td class="text-center">$4/mo</td><td class="text-center">$4.99/mo</td><td class="text-center">$2.99/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">2FA</td><td class="text-center">Built-in</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Travel mode</td><td class="text-center">Yes</td><td class="text-center">No</td><td class="text-center">No</td><td class="text-center">No</td><td class="text-center">No</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Dark web monitor</td><td class="text-center">Yes</td><td class="text-center">Premium</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Open source</td><td class="text-center">No</td><td class="text-center">Yes</td><td class="text-center">No</td><td class="text-center">No</td><td class="text-center">No</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your Password Managers</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Do you want open-source and self-host option?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="bitwarden:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="1password:2,dashlane:1,lastpass:1,nordpass:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Is a built-in VPN important?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="dashlane:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="1password:2,bitwarden:2,lastpass:1,nordpass:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Do you frequently cross borders (travel mode)?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="1password:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="bitwarden:1,dashlane:1,lastpass:1,nordpass:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Cheapest reliable option?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="bitwarden:3,nordpass:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="1password:1,dashlane:1,lastpass:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">1Password</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Best overall — Starting at $2.99/mo</p>
          <p class="mt-2 text-xs text-slate-400">14-day trial | G2: 4.7</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Bitwarden</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Open source — Starting at $0.83/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.7</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">LastPass</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Enterprise — Starting at $3/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (1 device) | G2: 4.1</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Dashlane</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Built-in VPN — Starting at $3.99/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (1 device) | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">NordPass</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Budget pick — Starting at $1.49/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.4</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best password manager</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">1password vs bitwarden</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">lastpass alternatives</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">password manager for families</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">secure password manager 2025</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { 1password:0, bitwarden:0, lastpass:0, dashlane:0, nordpass:0 };
    const names = { 1password:"1Password", bitwarden:"Bitwarden", lastpass:"LastPass", dashlane:"Dashlane", nordpass:"NordPass" };
    const reasons = { 1password:"Best overall", bitwarden:"Open source", lastpass:"Enterprise", dashlane:"Built-in VPN", nordpass:"Budget pick" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
