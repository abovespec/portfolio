---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best AI Writing Assistants 2025 | PickTheStack" description="Compare AI writing tools for marketing copy, blog posts, emails, and creative content. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best AI Writing Assistants</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare AI writing tools for marketing copy, blog posts, emails, and creative content. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">AI Writing Assistants Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Jasper</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Copy.ai</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Writesonic</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Rytr</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Anyword</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">7-day trial</td><td class="text-center">Yes (2,000 words)</td><td class="text-center">Yes (10,000 words)</td><td class="text-center">Yes (10K chars/mo)</td><td class="text-center">7-day trial</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$39/mo</td><td class="text-center">$36/mo</td><td class="text-center">$13/mo</td><td class="text-center">$9/mo</td><td class="text-center">$39/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">Marketing teams</td><td class="text-center">Short copy</td><td class="text-center">Budget long-form</td><td class="text-center">Cheapest</td><td class="text-center">Data-driven copy</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.7</td><td class="text-center">4.8</td><td class="text-center">4.8</td><td class="text-center">4.7</td><td class="text-center">4.8</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Templates</td><td class="text-center">50+</td><td class="text-center">90+</td><td class="text-center">80+</td><td class="text-center">40+</td><td class="text-center">30+</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Long-form</td><td class="text-center">Yes</td><td class="text-center">Workflows</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">SEO mode</td><td class="text-center">Surfer</td><td class="text-center">No</td><td class="text-center">Yes</td><td class="text-center">No</td><td class="text-center">No</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Plagiarism check</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Languages</td><td class="text-center">30+</td><td class="text-center">25+</td><td class="text-center">25+</td><td class="text-center">30+</td><td class="text-center">25+</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Brand voice</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your AI Writing Assistants</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Do you need full blog post generation?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="writesonic:3,jasper:2,anyword:1">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="copy.ai:2,rytr:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Is the cheapest possible tool the priority?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="rytr:3,writesonic:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="jasper:1,copy.ai:1,anyword:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Need predictive performance scoring?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="anyword:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="jasper:2,copy.ai:1,writesonic:1,rytr:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Want the most templates for short-form ads?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="copy.ai:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="jasper:2,writesonic:1,rytr:1,anyword:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Jasper</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Marketing teams — Starting at $39/mo</p>
          <p class="mt-2 text-xs text-slate-400">7-day trial | G2: 4.7</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Copy.ai</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Short copy — Starting at $36/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (2,000 words) | G2: 4.8</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Writesonic</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Budget long-form — Starting at $13/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (10,000 words) | G2: 4.8</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Rytr</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Cheapest — Starting at $9/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (10K chars/mo) | G2: 4.7</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Anyword</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Data-driven copy — Starting at $39/mo</p>
          <p class="mt-2 text-xs text-slate-400">7-day trial | G2: 4.8</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best ai writing tool</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">jasper ai review</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">copy ai vs jasper</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">ai copywriting software</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best ai content writer</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { jasper:0, copyai:0, writesonic:0, rytr:0, anyword:0 };
    const names = { jasper:"Jasper", copyai:"Copy.ai", writesonic:"Writesonic", rytr:"Rytr", anyword:"Anyword" };
    const reasons = { jasper:"Marketing teams", copyai:"Short copy", writesonic:"Budget long-form", rytr:"Cheapest", anyword:"Data-driven copy" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
