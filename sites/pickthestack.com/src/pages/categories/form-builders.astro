---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best Form Builders 2025 | PickTheStack" description="Compare form builders for surveys, lead capture, registrations, and quizzes. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best Form Builders</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare form builders for surveys, lead capture, registrations, and quizzes. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Form Builders Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Typeform</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Jotform</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Google Forms</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Wufoo</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Paperform</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">Yes (10 responses/mo)</td><td class="text-center">Yes (5 forms)</td><td class="text-center">Yes</td><td class="text-center">Yes (5 forms)</td><td class="text-center">14-day trial</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$25/mo</td><td class="text-center">$34/mo</td><td class="text-center">$0</td><td class="text-center">$14.08/mo</td><td class="text-center">$20/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">Beautiful forms</td><td class="text-center">Power users</td><td class="text-center">Free & simple</td><td class="text-center">Quick setup</td><td class="text-center">E-commerce forms</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.5</td><td class="text-center">4.7</td><td class="text-center">4.6</td><td class="text-center">4.2</td><td class="text-center">4.8</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Logic jumps</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Payments</td><td class="text-center">Stripe</td><td class="text-center">30+ gateways</td><td class="text-center">No</td><td class="text-center">Stripe/PayPal</td><td class="text-center">Stripe/PayPal</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Templates</td><td class="text-center">500+</td><td class="text-center">10,000+</td><td class="text-center">Basic</td><td class="text-center">400+</td><td class="text-center">500+</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Embed</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">API</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Sheets</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Calculations</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Partial</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your Form Builders</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Need payment collection in forms?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="paperform:3,jotform:2,typeform:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="google forms:2,wufoo:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Want the most templates available?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="jotform:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="typeform:2,paperform:1,google forms:1,wufoo:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Is completely free the only option?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="google forms:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="typeform:1,jotform:1,wufoo:1,paperform:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Need best-in-class conversational UX?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="typeform:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="jotform:2,paperform:1,google forms:1,wufoo:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Typeform</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Beautiful forms — Starting at $25/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (10 responses/mo) | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Jotform</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Power users — Starting at $34/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (5 forms) | G2: 4.7</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Google Forms</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Free & simple — Starting at $0</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.6</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Wufoo</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Quick setup — Starting at $14.08/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (5 forms) | G2: 4.2</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Paperform</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: E-commerce forms — Starting at $20/mo</p>
          <p class="mt-2 text-xs text-slate-400">14-day trial | G2: 4.8</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best form builder</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">typeform vs jotform</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">free form builder</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best survey tool</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">form builder with payments</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { typeform:0, jotform:0, googleforms:0, wufoo:0, paperform:0 };
    const names = { typeform:"Typeform", jotform:"Jotform", googleforms:"Google Forms", wufoo:"Wufoo", paperform:"Paperform" };
    const reasons = { typeform:"Beautiful forms", jotform:"Power users", googleforms:"Free & simple", wufoo:"Quick setup", paperform:"E-commerce forms" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
