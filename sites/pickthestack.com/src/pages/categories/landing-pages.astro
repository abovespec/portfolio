---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best Landing Page Builders 2025 | PickTheStack" description="Compare landing page builders for marketers, agencies, and SaaS companies. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best Landing Page Builders</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare landing page builders for marketers, agencies, and SaaS companies. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Landing Page Builders Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Unbounce</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Leadpages</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Instapage</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Swipe Pages</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Landingi</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">14-day trial</td><td class="text-center">14-day trial</td><td class="text-center">14-day trial</td><td class="text-center">No</td><td class="text-center">Yes (1 page)</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$74/mo</td><td class="text-center">$37/mo</td><td class="text-center">$299/mo</td><td class="text-center">$29/mo</td><td class="text-center">$29/mo</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">A/B testing</td><td class="text-center">Small business</td><td class="text-center">Enterprise</td><td class="text-center">AMP pages</td><td class="text-center">Agencies</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.4</td><td class="text-center">4.3</td><td class="text-center">4.4</td><td class="text-center">4.7</td><td class="text-center">4.4</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Templates</td><td class="text-center">100+</td><td class="text-center">200+</td><td class="text-center">500+</td><td class="text-center">40+</td><td class="text-center">400+</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Popups</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Sticky bars</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">AI copy</td><td class="text-center">Yes</td><td class="text-center">No</td><td class="text-center">Yes</td><td class="text-center">No</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Dynamic text</td><td class="text-center">Yes</td><td class="text-center">No</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Integrations</td><td class="text-center">30+</td><td class="text-center">40+</td><td class="text-center">50+</td><td class="text-center">20+</td><td class="text-center">50+</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your Landing Page Builders</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Need AMP / instant-loading mobile pages?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="swipe pages:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="unbounce:2,instapage:2,leadpages:1,landingi:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Is AI-generated copy a must-have?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="unbounce:3,instapage:2,landingi:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="leadpages:1,swipe pages:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Tightest budget under $40/mo?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="leadpages:3,landingi:2,swipe pages:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="unbounce:1,instapage:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Enterprise-level personalization needed?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="instapage:3,unbounce:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="leadpages:1,swipe pages:1,landingi:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Unbounce</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: A/B testing — Starting at $74/mo</p>
          <p class="mt-2 text-xs text-slate-400">14-day trial | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Leadpages</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Small business — Starting at $37/mo</p>
          <p class="mt-2 text-xs text-slate-400">14-day trial | G2: 4.3</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Instapage</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Enterprise — Starting at $299/mo</p>
          <p class="mt-2 text-xs text-slate-400">14-day trial | G2: 4.4</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Swipe Pages</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: AMP pages — Starting at $29/mo</p>
          <p class="mt-2 text-xs text-slate-400">No | G2: 4.7</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Landingi</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Agencies — Starting at $29/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (1 page) | G2: 4.4</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best landing page builder</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">unbounce vs leadpages</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">landing page builder for small business</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">instapage review</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best landing page software</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { unbounce:0, leadpages:0, instapage:0, swipepages:0, landingi:0 };
    const names = { unbounce:"Unbounce", leadpages:"Leadpages", instapage:"Instapage", swipepages:"Swipe Pages", landingi:"Landingi" };
    const reasons = { unbounce:"A/B testing", leadpages:"Small business", instapage:"Enterprise", swipepages:"AMP pages", landingi:"Agencies" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
