---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title="Best Video Conferencing 2025 | PickTheStack" description="Compare video conferencing tools for remote teams, webinars, and online meetings. Side-by-side comparisons, pricing, and an interactive quiz to find your perfect tool.">
  <section class="py-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight" style="color:{siteConfig.branding.themeColor}">Best Video Conferencing</h1>
    <p class="mx-auto mt-3 max-w-2xl text-lg text-slate-600">Compare video conferencing tools for remote teams, webinars, and online meetings. Compare features, pricing, and find your fit with our decision quiz.</p>
  </section>

  <div class="mx-auto max-w-6xl px-4">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Video Conferencing Comparison Table</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="text-left py-2 px-3 font-semibold text-slate-700">Feature</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Zoom</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Google Meet</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Microsoft Teams</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Webex</th>
              <th class="text-center py-2 px-3 font-semibold text-indigo-700">Jitsi Meet</th>
            </tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-b border-slate-100"><td class="py-2 px-3">Free plan</td><td class="text-center">Yes (40 min)</td><td class="text-center">Yes (1 hr)</td><td class="text-center">Yes</td><td class="text-center">Yes (40 min)</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Starting price</td><td class="text-center">$13.99/mo</td><td class="text-center">$6/mo</td><td class="text-center">$4/mo</td><td class="text-center">$14.50/mo</td><td class="text-center">$0</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Best for</td><td class="text-center">Meetings & webinars</td><td class="text-center">Google Workspace</td><td class="text-center">M365 ecosystem</td><td class="text-center">Enterprise security</td><td class="text-center">Open source</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">G2 score</td><td class="text-center">4.5</td><td class="text-center">4.6</td><td class="text-center">4.3</td><td class="text-center">4.2</td><td class="text-center">4.4</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Max participants</td><td class="text-center">1,000</td><td class="text-center">1,000</td><td class="text-center">1,000</td><td class="text-center">1,000</td><td class="text-center">75</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Recording</td><td class="text-center">Yes</td><td class="text-center">Paid</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Self-host</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Breakout rooms</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">No</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Screen share</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td><td class="text-center">Yes</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">Virtual background</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td></tr>
<tr class="border-b border-slate-100"><td class="py-2 px-3">E2E encryption</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td><td class="text-center">-</td></tr>

          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-slate-400">Prices and features updated 2025. Click tool names to visit their site (affiliate links where available).</p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-8">
      <h2 class="text-xl font-semibold mb-4 text-slate-800">Decision Quiz: Find Your Video Conferencing</h2>
      <div id="quiz-container">
        <div id="q1" class="quiz-step ">
          <p class="font-medium text-slate-800 mb-3">1. Already using Google Workspace?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="google meet:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q2" data-score="zoom:2,teams:2,webex:1,jitsi:1">No</button>
          </div>
        </div>
        <div id="q2" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">2. Need open-source / self-host option?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="jitsi:3">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q3" data-score="zoom:2,google meet:1,teams:1,webex:1">No</button>
          </div>
        </div>
        <div id="q3" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">3. Enterprise-grade security required?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="webex:3,teams:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="q4" data-score="zoom:1,google meet:1,jitsi:1">No</button>
          </div>
        </div>
        <div id="q4" class="quiz-step hidden">
          <p class="font-medium text-slate-800 mb-3">4. Cheapest reliable paid plan?</p>
          <div class="flex flex-wrap gap-2">
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="teams:3,google meet:2">Yes</button>
            <button class="quiz-btn px-4 py-2 rounded-lg bg-slate-100 hover:bg-indigo-100 text-slate-700" data-next="result" data-score="zoom:1,webex:1,jitsi:1">No</button>
          </div>
        </div>
        <div id="result" class="quiz-step hidden">
          <h3 class="text-lg font-semibold text-slate-800 mb-2">Recommended for you:</h3>
          <div id="result-card" class="rounded-lg bg-indigo-50 border border-indigo-100 p-4"></div>
          <button id="quiz-restart" class="mt-4 px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm">Start over</button>
        </div>
      </div>
    </div>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Top Picks by Use Case</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Zoom</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Meetings & webinars — Starting at $13.99/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (40 min) | G2: 4.5</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Google Meet</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Google Workspace — Starting at $6/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (1 hr) | G2: 4.6</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Microsoft Teams</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: M365 ecosystem — Starting at $4/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.3</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Webex</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Enterprise security — Starting at $14.50/mo</p>
          <p class="mt-2 text-xs text-slate-400">Yes (40 min) | G2: 4.2</p>
        </a>
        <a href="#" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-400 transition">
          <h3 class="font-semibold text-slate-900">Jitsi Meet</h3>
          <p class="mt-1 text-sm text-slate-600">Best for: Open source — Starting at $0</p>
          <p class="mt-2 text-xs text-slate-400">Yes | G2: 4.4</p>
        </a>
      </div>
    </section>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Related Keywords</h2>
      <div class="flex flex-wrap gap-2">
<span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best video conferencing software</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">zoom vs google meet</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">zoom alternatives</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">free video conferencing</span><span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm">best video call app for teams</span>      </div>
    </section>
  </div>

  <script is:inline>
    const scores = { zoom:0, googlemeet:0, microsoftteams:0, webex:0, jitsimeet:0 };
    const names = { zoom:"Zoom", googlemeet:"Google Meet", microsoftteams:"Microsoft Teams", webex:"Webex", jitsimeet:"Jitsi Meet" };
    const reasons = { zoom:"Meetings & webinars", googlemeet:"Google Workspace", microsoftteams:"M365 ecosystem", webex:"Enterprise security", jitsimeet:"Open source" };
    document.querySelectorAll('.quiz-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.next;
        const delta = btn.dataset.score;
        if (delta) {
          delta.split(',').forEach(part => {
            const [k,v] = part.split(':');
            scores[k] += parseInt(v);
          });
        }
        document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
        if (next === 'result') {
          const winner = Object.entries(scores).sort((a,b) => b[1]-a[1])[0];
          document.getElementById('result-card').innerHTML = '<p class="text-2xl font-bold text-indigo-700">' + names[winner[0]] + '</p><p class="mt-1 text-slate-700">Best for: ' + reasons[winner[0]] + '</p>';
        }
        document.getElementById(next).classList.remove('hidden');
      });
    });
    document.getElementById('quiz-restart')?.addEventListener('click', () => {
      Object.keys(scores).forEach(k => scores[k]=0);
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('q1').classList.remove('hidden');
    });
  </script>
</BaseLayout>
