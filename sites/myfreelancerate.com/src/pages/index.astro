---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
---
<BaseLayout title={siteConfig.identity.name} description={siteConfig.identity.description}>
  <section class="relative -mx-4 overflow-hidden px-4 py-14 sm:py-20">
    <div class="absolute inset-0 bg-gradient-to-br from-teal-50 via-cyan-50 to-sky-50" aria-hidden="true" />
    <div class="absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-teal-300/20 blur-3xl" aria-hidden="true" />
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-cyan-300/15 blur-3xl" aria-hidden="true" />
    <div class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">MyFreelanceRate</h1>
        <p class="mt-3 text-lg text-slate-600">Hourly rate calculator, project estimator, value-based pricing worksheets, and platform fee comparison for freelancers.</p>
      </div>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {['Set your rate with confidence', 'Covers taxes, benefits, and overhead', 'Platform fee comparison', 'No data stored or shared'].map((badge) => (
          <li class="flex items-center gap-1.5">
            <svg class="h-4 w-4 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
            </svg>
            {badge}
          </li>
        ))}
      </ul>
    </div>
  </section>
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-wrap gap-2 justify-center mb-8">
      <button id="tab-rate" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-cyan-600 text-white">Hourly Rate</button>
      <button id="tab-project" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Project Estimate</button>
      <button id="tab-value" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Value Pricing</button>
      <button id="tab-platform" class="tab-btn px-4 py-2 rounded-full font-semibold text-sm bg-slate-200 text-slate-700">Platform Fees</button>
    </div>

    <!-- Currency selector -->
    <div class="flex items-center gap-3 mb-6 p-3 rounded-lg bg-slate-50 border border-slate-200">
      <label for="fx-currency" class="text-sm font-medium text-slate-700">Display currency:</label>
      <select id="fx-currency" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm bg-white">
        <option value="USD">USD ($)</option>
        <option value="EUR">EUR (€)</option>
        <option value="GBP">GBP (£)</option>
        <option value="CAD">CAD (CA$)</option>
        <option value="AUD">AUD (A$)</option>
        <option value="INR">INR (₹)</option>
        <option value="BRL">BRL (R$)</option>
        <option value="PLN">PLN (zł)</option>
        <option value="PHP">PHP (₱)</option>
        <option value="MXN">MXN (MX$)</option>
      </select>
    </div>

    <div id="panel-rate" class="calc-panel">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Freelance Hourly Rate Calculator</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Annual income goal ($)</span><input id="r-goal" type="number" value="100000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Billable hours / week</span><input id="r-hours" type="number" value="25" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Weeks off / year</span><input id="r-weeks" type="number" value="4" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Monthly business expenses ($)</span><input id="r-exp" type="number" value="500" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Tax estimate (%)</span><input id="r-tax" type="number" value="25" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Billable hours / year</p><p id="r-out-hours" class="text-xl font-bold text-slate-800">1,200</p></div>
          <div class="rounded-lg bg-cyan-50 p-4 text-center border border-cyan-100"><p class="text-xs uppercase text-cyan-600">Minimum hourly rate</p><p id="r-out-rate" class="text-xl font-bold text-cyan-700">$116.67</p></div>
          <div class="rounded-lg bg-cyan-50 p-4 text-center border border-cyan-100"><p class="text-xs uppercase text-cyan-600">Rate with tax buffer</p><p id="r-out-buffer" class="text-xl font-bold text-cyan-700">$155.56</p></div>
        </div>
      </div>
    </div>

    <div id="panel-project" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Project Estimate Calculator</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Estimated hours</span><input id="p-hours" type="number" value="40" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Your hourly rate ($)</span><input id="p-rate" type="number" value="120" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Material / tool costs ($)</span><input id="p-mat" type="number" value="200" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Buffer / contingency (%)</span><input id="p-buffer" type="number" value="15" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Labor cost</p><p id="p-out-labor" class="text-xl font-bold text-slate-800">$4,800</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">With buffer</p><p id="p-out-buffer" class="text-xl font-bold text-slate-800">$5,750</p></div>
          <div class="rounded-lg bg-cyan-50 p-4 text-center border border-cyan-100"><p class="text-xs uppercase text-cyan-600">Project quote</p><p id="p-out-quote" class="text-xl font-bold text-cyan-700">$5,950</p></div>
        </div>
      </div>
    </div>

    <div id="panel-value" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-4 text-slate-800">Value-Based Pricing Worksheet</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block"><span class="text-sm font-medium text-slate-700">Client's annual revenue ($)</span><input id="v-rev" type="number" value="500000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Estimated revenue impact (%)</span><input id="v-impact" type="number" value="10" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Cost savings you deliver ($/yr)</span><input id="v-save" type="number" value="15000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="block"><span class="text-sm font-medium text-slate-700">Your fee as % of value</span><input id="v-pct" type="number" value="20" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Revenue impact</p><p id="v-out-rev" class="text-xl font-bold text-slate-800">$50,000</p></div>
          <div class="rounded-lg bg-slate-50 p-4 text-center"><p class="text-xs uppercase text-slate-500">Total value created</p><p id="v-out-total" class="text-xl font-bold text-slate-800">$65,000</p></div>
          <div class="rounded-lg bg-cyan-50 p-4 text-center border border-cyan-100"><p class="text-xs uppercase text-cyan-600">Suggested project fee</p><p id="v-out-fee" class="text-xl font-bold text-cyan-700">$13,000</p></div>
        </div>
      </div>
    </div>

    <!-- Platform Fee Calculator -->
    <div id="panel-platform" class="calc-panel hidden">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold mb-1 text-slate-800">Platform Fee Calculator</h2>
        <p class="text-sm text-slate-500 mb-5">Enter your desired take-home hourly rate and see what you need to charge on each platform.</p>
        <div class="grid gap-4 sm:grid-cols-2 mb-6">
          <label class="block">
            <span class="text-sm font-medium text-slate-700">Desired take-home rate ($/hr)</span>
            <input id="pf-rate" type="number" value="80" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
          </label>
          <label class="block">
            <span class="text-sm font-medium text-slate-700">Total billed to Upwork client ($)</span>
            <input id="pf-upwork-billed" type="number" value="1000" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
            <p class="mt-1 text-xs text-slate-400">Affects Upwork sliding scale (20% / 10% / 5%)</p>
          </label>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-50 text-left">
                <th class="px-4 py-3 font-semibold text-slate-700">Platform</th>
                <th class="px-4 py-3 font-semibold text-slate-700">Fee structure</th>
                <th class="px-4 py-3 font-semibold text-slate-700 text-right">You charge</th>
                <th class="px-4 py-3 font-semibold text-slate-700 text-right">You receive</th>
                <th class="px-4 py-3 font-semibold text-slate-700 text-right">Effective fee</th>
              </tr>
            </thead>
            <tbody id="pf-table-body" class="divide-y divide-slate-100">
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-slate-400">PeoplePerHour fees are in GBP tiers but shown here as approximate equivalent percentages. Rates are estimates — verify current rates on each platform before quoting.</p>
      </div>
    </div>

    <aside
      role="note"
      class="mx-auto my-6 max-w-5xl rounded-lg border border-amber-200 bg-amber-50/80 p-3 text-sm text-amber-900"
    >
      <strong class="font-semibold">Important:</strong> All calculators provide estimates for
      informational purposes only. Results do not constitute financial, legal, or tax advice.
      Consult a licensed financial advisor before making decisions.
    </aside>

    <section class="my-12">
      <h2 class="text-2xl font-semibold mb-4 text-slate-800">Freelancer Guides</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/blog/how-much-should-i-charge-as-a-freelancer-a-pricing-framework/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-cyan-400"><h3 class="font-semibold text-slate-900">How to Set Freelance Rates</h3><p class="mt-1 text-sm text-slate-600">From cost-plus to value-based pricing. Which model fits your niche?</p></a>
        <a href="/blog/project-based-pricing-formula-how-to-quote-fixed-price-work/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-cyan-400"><h3 class="font-semibold text-slate-900">Project Estimation Methods</h3><p class="mt-1 text-sm text-slate-600">Fixed price vs time-and-materials vs retainers. Pros, cons, and when to use each.</p></a>
        <a href="/blog/value-based-pricing-for-freelancers-charge-for-outcomes-not-hours/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-cyan-400"><h3 class="font-semibold text-slate-900">Value-Based Pricing for Freelancers</h3><p class="mt-1 text-sm text-slate-600">How to price based on client outcomes instead of hours worked.</p></a>
        <a href="/blog/how-to-negotiate-freelance-rates-without-losing-the-client/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-cyan-400"><h3 class="font-semibold text-slate-900">How to Negotiate Your Freelance Rates</h3><p class="mt-1 text-sm text-slate-600">Scripts and strategies for raising rates with existing clients and setting them right with new ones.</p></a>
      </div>
    </section>
  </div>
  <script is:inline>
    function $(id){ return document.getElementById(id); }
    function val(id){ return parseFloat($(id).value) || 0; }
    const tabs=['rate','project','value','platform'];
    tabs.forEach(t=>{
      $('tab-'+t).addEventListener('click',()=>{
        tabs.forEach(x=>{ $('panel-'+x).classList.add('hidden'); $('tab-'+x).classList.remove('bg-cyan-600','text-white'); $('tab-'+x).classList.add('bg-slate-200','text-slate-700'); });
        $('panel-'+t).classList.remove('hidden'); $('tab-'+t).classList.remove('bg-slate-200','text-slate-700'); $('tab-'+t).classList.add('bg-cyan-600','text-white');
      });
    });
    const FX = { USD:1, EUR:0.92, GBP:0.79, CAD:1.36, AUD:1.55, INR:83.5, BRL:5.0, PLN:3.95, PHP:56.0, MXN:17.5 };
    const SYMBOLS = { USD:'$', EUR:'€', GBP:'£', CAD:'CA$', AUD:'A$', INR:'₹', BRL:'R$', PLN:'zł', PHP:'₱', MXN:'MX$' };

    function getCurrency() { return $('fx-currency').value || 'USD'; }
    function fmtRate(usdAmount) {
      const cur = getCurrency();
      const converted = (usdAmount * FX[cur]).toFixed(2);
      return SYMBOLS[cur] + converted;
    }
    function fmtRateFixed0(usdAmount) {
      const cur = getCurrency();
      const converted = Math.round(usdAmount * FX[cur]);
      return SYMBOLS[cur] + converted.toLocaleString();
    }

    function calcRate(){ const goal=val('r-goal'), hours=val('r-hours'), weeks=val('r-weeks'), exp=val('r-exp'), tax=val('r-tax'); const annualHours=hours*(52-weeks); const preTax=(goal+exp*12)/annualHours; const buffer=preTax/(1-tax/100); $('r-out-hours').textContent=annualHours.toLocaleString(); $('r-out-rate').textContent=fmtRate(preTax); $('r-out-buffer').textContent=fmtRate(buffer); }
    function calcProject(){ const h=val('p-hours'), r=val('p-rate'), m=val('p-mat'), b=val('p-buffer'); const labor=h*r; const withBuffer=labor*(1+b/100)+m; $('p-out-labor').textContent=fmtRateFixed0(labor); $('p-out-buffer').textContent=fmtRateFixed0(withBuffer); $('p-out-quote').textContent=fmtRateFixed0(withBuffer); }
    function calcValue(){ const rev=val('v-rev'), impact=val('v-impact'), save=val('v-save'), pct=val('v-pct'); const revImpact=rev*(impact/100); const total=revImpact+save; const fee=total*(pct/100); $('v-out-rev').textContent=fmtRateFixed0(revImpact); $('v-out-total').textContent=fmtRateFixed0(total); $('v-out-fee').textContent=fmtRateFixed0(fee); }

    function calcPlatformFees() {
      const takeHome = val('pf-rate');
      const upworkBilled = val('pf-upwork-billed');
      if (takeHome <= 0) return;

      // Upwork sliding scale: 20% on first $500, 10% on $500-$10k, 5% above $10k
      function upworkFeeRate(totalBilled) {
        if (totalBilled <= 500) return 0.20;
        if (totalBilled <= 10000) return 0.10;
        return 0.05;
      }
      const uwRate = upworkFeeRate(upworkBilled);
      const uwCharge = takeHome / (1 - uwRate);

      // Fiverr: 20% flat + $2 on orders under $40
      const fiverrCharge = takeHome / 0.80;
      const fiverrActual = fiverrCharge < 40 ? fiverrCharge + 2 : fiverrCharge;
      const fiverrFee = fiverrActual - takeHome;
      const fiverrEffective = (fiverrFee / fiverrActual) * 100;

      // Toptal: ~13.5% margin kept by platform
      const toptalCharge = takeHome / (1 - 0.135);

      // Freelancer.com: 10% or $5 min
      const freelancerFee = Math.max(takeHome * 0.10, 5);
      const freelancerCharge = takeHome + freelancerFee;
      const freelancerEffective = (freelancerFee / freelancerCharge) * 100;

      // PeoplePerHour: 20% up to ~£500 equivalent
      const pphCharge = takeHome / (1 - 0.20);

      // Direct: 0%
      const directCharge = takeHome;

      const platforms = [
        { name: 'Direct / self', fee: '0%', charge: directCharge, receive: takeHome, effective: 0, highlight: true },
        { name: 'Upwork', fee: uwRate*100+'% (sliding, based on billed total)', charge: uwCharge, receive: takeHome, effective: uwRate*100 },
        { name: 'Fiverr', fee: '20% flat (+ $2 under $40)', charge: fiverrActual, receive: takeHome, effective: fiverrEffective },
        { name: 'Toptal', fee: '~13.5%', charge: toptalCharge, receive: takeHome, effective: 13.5 },
        { name: 'Freelancer.com', fee: '10% or $5 min', charge: freelancerCharge, receive: takeHome, effective: freelancerEffective },
        { name: 'PeoplePerHour', fee: '20% (up to £500 equiv.)', charge: pphCharge, receive: takeHome, effective: 20 },
      ];

      const tbody = $('pf-table-body');
      tbody.innerHTML = platforms.map(p => {
        const rowCls = p.highlight ? 'bg-emerald-50' : 'bg-white hover:bg-slate-50';
        const chargeCls = p.highlight ? 'font-bold text-emerald-700' : 'font-semibold text-slate-800';
        return '<tr class="' + rowCls + '">' +
          '<td class="px-4 py-3 font-medium text-slate-800">' + p.name + '</td>' +
          '<td class="px-4 py-3 text-slate-500 text-xs">' + p.fee + '</td>' +
          '<td class="px-4 py-3 text-right ' + chargeCls + '">$' + p.charge.toFixed(2) + '/hr</td>' +
          '<td class="px-4 py-3 text-right text-slate-700">$' + p.receive.toFixed(2) + '/hr</td>' +
          '<td class="px-4 py-3 text-right text-slate-500">' + p.effective.toFixed(1) + '%</td>' +
          '</tr>';
      }).join('');
    }

    function recalcAll() { calcRate(); calcProject(); calcValue(); calcPlatformFees(); }
    ['r-goal','r-hours','r-weeks','r-exp','r-tax'].forEach(id=>$(id)?.addEventListener('input',calcRate));
    ['p-hours','p-rate','p-mat','p-buffer'].forEach(id=>$(id)?.addEventListener('input',calcProject));
    ['v-rev','v-impact','v-save','v-pct'].forEach(id=>$(id)?.addEventListener('input',calcValue));
    ['pf-rate','pf-upwork-billed'].forEach(id=>$(id)?.addEventListener('input',calcPlatformFees));
    $('fx-currency').addEventListener('change', recalcAll);
    calcRate(); calcProject(); calcValue(); calcPlatformFees();
  </script>
</BaseLayout>
