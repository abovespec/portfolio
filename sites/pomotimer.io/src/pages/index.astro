---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout
  title="Pomodoro Timer — Free Online Focus Timer, No Signup"
  description="Stay focused with the Pomodoro Technique. 25-minute work sessions, short and long breaks, session tracking. Free, no signup, works offline."
>

  <!-- Hero: timer as focal point, warm peach/amber gradient -->
  <section class="relative -mx-4 overflow-hidden px-4 py-14 sm:py-20">
    <div class="absolute inset-0 bg-gradient-to-br from-orange-50 via-amber-50 to-rose-50" aria-hidden="true" />
    <div class="absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-orange-300/20 blur-3xl" aria-hidden="true" />
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-amber-300/15 blur-3xl" aria-hidden="true" />

    <div class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Pomodoro Timer
        </h1>
        <p class="mt-3 text-lg text-slate-600">
          Boost focus with 25-minute work sprints. Take a short break, then repeat.
          Your sessions are tracked — no account needed.
        </p>
      </div>

      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {[
          '25-min work sessions',
          'Short & long break modes',
          'Session counter',
          'Tab title updates live',
        ].map((badge) => (
          <li class="flex items-center gap-1.5">
            <svg class="h-4 w-4 shrink-0 text-orange-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
            </svg>
            {badge}
          </li>
        ))}
      </ul>

      <!-- Timer card -->
      <div class="mx-auto mt-8 w-full max-w-sm">
        <div class="rounded-2xl border border-orange-200/80 bg-white p-8 shadow-sm text-center">
          <!-- Mode buttons -->
          <div class="flex justify-center gap-2 mb-8">
            <button
              id="mode-work"
              onclick="setMode('work')"
              class="rounded-lg bg-orange-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-orange-700"
            >Work</button>
            <button
              id="mode-short"
              onclick="setMode('short')"
              class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-200"
            >Short Break</button>
            <button
              id="mode-long"
              onclick="setMode('long')"
              class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-200"
            >Long Break</button>
          </div>

          <!-- Timer display — the focal point -->
          <div
            id="display"
            class="font-mono text-7xl font-bold tracking-tight text-slate-900 sm:text-8xl"
            aria-live="polite"
            aria-label="Timer"
          >25:00</div>

          <!-- Progress arc indicator -->
          <div class="mx-auto mt-4 h-1.5 w-48 overflow-hidden rounded-full bg-orange-100">
            <div id="progress-bar" class="h-full rounded-full bg-orange-500 transition-all duration-1000" style="width:100%"></div>
          </div>

          <!-- Controls -->
          <div class="mt-8 flex justify-center gap-3">
            <button
              id="btn-toggle"
              onclick="toggleTimer()"
              class="rounded-xl bg-orange-600 px-8 py-3 text-lg font-semibold text-white shadow-sm transition hover:bg-orange-700 active:scale-95"
            >Start</button>
            <button
              onclick="resetTimer()"
              class="rounded-xl bg-slate-100 px-6 py-3 text-lg font-medium text-slate-700 transition hover:bg-slate-200 active:scale-95"
            >Reset</button>
          </div>

          <!-- Session counter -->
          <p class="mt-6 text-sm text-slate-500">
            Completed sessions today:
            <span id="sessions" class="ml-1 text-base font-bold text-orange-600">0</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational content -->
  <section class="mt-16" aria-labelledby="what-is-pomo-heading">
    <h2 id="what-is-pomo-heading" class="text-2xl font-bold text-slate-900">What is the Pomodoro Technique?</h2>
    <div class="prose prose-slate mt-3 max-w-none">
      <p>
        Developed by Francesco Cirillo in the late 1980s, the Pomodoro Technique is a time-management method that uses
        a timer to break work into intervals — traditionally 25 minutes — separated by short breaks.
        Each interval is called a <em>pomodoro</em>, the Italian word for tomato (after the tomato-shaped kitchen timer Cirillo used as a student).
      </p>
    </div>
  </section>

  <section class="mt-12" aria-labelledby="how-it-works-heading">
    <h2 id="how-it-works-heading" class="text-2xl font-bold text-slate-900">How it Works</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {([
        { step: '1', label: 'Choose a task', desc: 'Pick one thing to focus on. Write it down if that helps.' },
        { step: '2', label: 'Work for 25 min', desc: 'Start the timer. Work only on that task until it rings.' },
        { step: '3', label: 'Take a 5-min break', desc: 'Step away. Stretch, breathe, grab water. Fully disconnect.' },
        { step: '4', label: 'Every 4 sessions', desc: 'Take a longer 15–30 minute break to recharge deeply.' },
      ] as const).map((item) => (
        <div class="rounded-xl border border-slate-200 bg-white p-5">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-orange-100 text-sm font-bold text-orange-700">
            {item.step}
          </span>
          <h3 class="mt-3 font-semibold text-slate-900">{item.label}</h3>
          <p class="mt-1 text-sm text-slate-600">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-12" aria-labelledby="why-it-works-heading">
    <h2 id="why-it-works-heading" class="text-2xl font-bold text-slate-900">Why It Works</h2>
    <div class="prose prose-slate mt-3 max-w-none">
      <p>
        The Pomodoro Technique works because it makes the cost of distraction tangible — interrupting a pomodoro means
        you have to restart. It also uses the psychology of deadlines: a 25-minute countdown creates urgency that a
        vague "I'll work until I'm done" goal never does.
      </p>
      <p>
        Research on task-switching shows that even small interruptions (a quick check of email, a glance at your phone)
        can add 15–20 minutes of recovery time to get back into deep focus. The Pomodoro technique discourages this by
        giving each interval a clear boundary and a built-in reward (the break) for staying on task.
      </p>
    </div>
  </section>

  <section class="mt-12" aria-labelledby="tips-heading">
    <h2 id="tips-heading" class="text-2xl font-bold text-slate-900">Tips for Getting the Most Out of It</h2>
    <ul class="mt-4 space-y-3">
      {([
        { tip: 'Use headphones', detail: 'Even without music, wearing headphones signals "I\'m in focus mode" to those around you.' },
        { tip: 'Keep a distraction log', detail: 'When a random thought pops up mid-pomodoro, write it down and return to it during a break.' },
        { tip: 'Batch small tasks', detail: 'If a task takes less than one pomodoro, group it with similar micro-tasks.' },
        { tip: 'Honor the break', detail: 'Don\'t skip breaks to "keep the momentum." The break is what sustains the momentum.' },
        { tip: 'Adapt the length', detail: 'The 25/5 split works for most, but 50/10 or 90/20 may suit deep-focus work better.' },
      ] as const).map((item) => (
        <li class="flex gap-3 rounded-xl border border-slate-200 bg-white p-4">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-orange-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
          </svg>
          <div>
            <span class="font-semibold text-slate-900">{item.tip}:</span>
            <span class="ml-1 text-slate-600">{item.detail}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <footer class="mt-16 border-t border-slate-200 pt-8 text-sm text-slate-500">
    <span>Content last reviewed: <time datetime="2026-04-25">April 25, 2026</time>.</span>
  </footer>

</BaseLayout>

<script is:inline>
  const MODES = { work: 25 * 60, short: 5 * 60, long: 15 * 60 };
  const COLORS = { work: 'bg-orange-600 hover:bg-orange-700', short: 'bg-teal-600 hover:bg-teal-700', long: 'bg-indigo-600 hover:bg-indigo-700' };
  const BAR_COLORS = { work: 'bg-orange-500', short: 'bg-teal-500', long: 'bg-indigo-500' };

  let currentMode = 'work';
  let totalTime = MODES.work;
  let timeLeft = MODES.work;
  let running = false;
  let interval = null;
  let sessions = 0;

  function updateDisplay() {
    const m = Math.floor(timeLeft / 60).toString().padStart(2, '0');
    const s = (timeLeft % 60).toString().padStart(2, '0');
    document.getElementById('display').textContent = m + ':' + s;
    document.title = m + ':' + s + ' — PomoTimer';
    const pct = (timeLeft / totalTime) * 100;
    const bar = document.getElementById('progress-bar');
    bar.style.width = pct + '%';
  }

  function updateModeButtons() {
    const modes = ['work', 'short', 'long'];
    modes.forEach(m => {
      const btn = document.getElementById('mode-' + m);
      if (m === currentMode) {
        btn.className = 'rounded-lg px-4 py-2 text-sm font-medium text-white transition ' +
          (currentMode === 'work' ? 'bg-orange-600 hover:bg-orange-700' :
           currentMode === 'short' ? 'bg-teal-600 hover:bg-teal-700' : 'bg-indigo-600 hover:bg-indigo-700');
      } else {
        btn.className = 'rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-200';
      }
    });
    const bar = document.getElementById('progress-bar');
    bar.className = 'h-full rounded-full transition-all duration-1000 ' +
      (currentMode === 'work' ? 'bg-orange-500' : currentMode === 'short' ? 'bg-teal-500' : 'bg-indigo-500');
    const toggleBtn = document.getElementById('btn-toggle');
    toggleBtn.className = 'rounded-xl px-8 py-3 text-lg font-semibold text-white shadow-sm transition active:scale-95 ' +
      (currentMode === 'work' ? 'bg-orange-600 hover:bg-orange-700' :
       currentMode === 'short' ? 'bg-teal-600 hover:bg-teal-700' : 'bg-indigo-600 hover:bg-indigo-700');
  }

  function setMode(mode) {
    if (running) { clearInterval(interval); running = false; }
    currentMode = mode;
    totalTime = MODES[mode];
    timeLeft = MODES[mode];
    document.getElementById('btn-toggle').textContent = 'Start';
    updateDisplay();
    updateModeButtons();
  }

  function toggleTimer() {
    if (running) {
      clearInterval(interval);
      running = false;
      document.getElementById('btn-toggle').textContent = 'Resume';
    } else {
      running = true;
      document.getElementById('btn-toggle').textContent = 'Pause';
      interval = setInterval(() => {
        timeLeft--;
        updateDisplay();
        if (timeLeft <= 0) {
          clearInterval(interval);
          running = false;
          document.getElementById('btn-toggle').textContent = 'Start';
          if (currentMode === 'work') {
            sessions++;
            document.getElementById('sessions').textContent = sessions;
          }
          try {
            new Audio('data:audio/wav;base64,UklGRnoGAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQoGAACBhYqFbF1fdJivrJBhNjVgodDbq2EcBj+a2/LDciUFLIHO8tiJNwgZaLvt559NEAxQp+PwtmMcBjiR1/LMeSwFJHfH8N2QQAoUXrTp66hVFApGn+DyvmwhBSuBzvLZiTYIG2m98OScTgwOUarm7blmFgU7k9n1unEiBC13yO/eizEIHWq+8+OWT').play();
          } catch(e) {}
        }
      }, 1000);
    }
  }

  function resetTimer() {
    if (running) { clearInterval(interval); running = false; }
    timeLeft = MODES[currentMode];
    document.getElementById('btn-toggle').textContent = 'Start';
    updateDisplay();
  }

  updateDisplay();
  updateModeButtons();
</script>
