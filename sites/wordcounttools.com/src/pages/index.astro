---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
import { getCollection } from 'astro:content';

const recentPosts = siteConfig.features.hasBlog
  ? (await getCollection('blog', ({ data }) => !data.draft))
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
      .slice(0, 3)
  : [];
---
<BaseLayout
  title="Word Counter — Count Words, Characters & Readability Free"
  description="Free online word counter with character count, syllable counter, reading time, readability score, and keyword density. Runs entirely in your browser."
>

  <!-- Compact header -->
  <header class="pb-4 pt-2">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">
      Word Counter &amp; Readability
    </h1>
    <p class="mt-1.5 text-sm text-slate-500">
      Count words, characters, sentences, and syllables. Check reading time and readability — runs entirely in your browser.
    </p>
  </header>

  <!-- Toolbar -->
  <div class="flex flex-wrap gap-2 mb-3">
    <div class="flex-1"></div>
    <button id="btn-compare" class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Compare</button>
    <button id="btn-copy-stats" class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Copy Stats</button>
    <button id="btn-clear" class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Clear</button>
    <button id="btn-copy"  class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Copy text</button>
  </div>

  <!-- Dual-pane: textarea + stats -->
  <div class="grid gap-3 md:grid-cols-2 min-h-96">
    <!-- Input pane -->
    <div class="flex flex-col gap-1 min-h-0">
      <label for="wc-input" class="text-xs font-semibold uppercase tracking-wide text-slate-500">Your text</label>
      <textarea
        id="wc-input"
        class="flex-1 w-full rounded-lg border border-slate-300 bg-white p-4 text-base leading-relaxed resize-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 placeholder:text-slate-400"
        placeholder="Paste or type your text here…"
        spellcheck="true"
        rows="16"
      ></textarea>
    </div>

    <!-- Stats pane -->
    <div class="flex flex-col gap-3">
      <div class="text-xs font-semibold uppercase tracking-wide text-slate-500">Stats</div>

      <!-- Primary stats grid -->
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-2">
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div id="stat-words" class="text-3xl font-bold text-emerald-600">0</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500">Words</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div id="stat-chars" class="text-3xl font-bold text-emerald-600">0</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500">Characters</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div id="stat-chars-nospace" class="text-3xl font-bold text-emerald-600">0</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500">No-space chars</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div id="stat-sentences" class="text-3xl font-bold text-emerald-600">0</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500">Sentences</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div id="stat-paragraphs" class="text-3xl font-bold text-emerald-600">0</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500">Paragraphs</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div id="stat-syllables" class="text-3xl font-bold text-emerald-600">0</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500">Syllables</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div id="stat-readtime" class="text-3xl font-bold text-emerald-600">—</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500">Read time</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center">
          <div id="stat-speaktime" class="text-3xl font-bold text-emerald-600">—</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500">Speak time</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4 text-center col-span-2">
          <div id="stat-reading" class="text-2xl font-bold text-emerald-600 leading-tight">—</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500">Reading level</div>
        </div>
      </div>

      <!-- Keyword density -->
      <div class="rounded-lg border border-slate-200 bg-white p-4 flex-1">
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">Top keywords</div>
        <div id="keywords-list" class="flex flex-wrap gap-2">
          <span class="text-sm text-slate-400">Type to see keyword density…</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Sentence analysis -->
  <div id="sentence-section" class="hidden mt-3 rounded-lg border border-slate-200 bg-white p-4">
    <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">Sentence Analysis</div>
    <div id="sentence-content" class="text-sm text-slate-700 space-y-1"></div>
  </div>

  <!-- Compare panel -->
  <div id="compare-panel" class="hidden mt-3">
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">Compare Text</div>
      <textarea
        id="wc-compare-input"
        class="w-full rounded-lg border border-slate-300 bg-white p-4 text-base leading-relaxed resize-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 placeholder:text-slate-400"
        placeholder="Paste second text here to compare…"
        spellcheck="true"
        rows="6"
      ></textarea>
      <div id="compare-result" class="hidden mt-3 overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-slate-50">
              <th class="text-left px-3 py-2 border border-slate-200 font-semibold text-slate-600">Metric</th>
              <th class="text-left px-3 py-2 border border-slate-200 font-semibold text-slate-600">Text 1</th>
              <th class="text-left px-3 py-2 border border-slate-200 font-semibold text-slate-600">Text 2</th>
            </tr>
          </thead>
          <tbody id="compare-tbody" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Status bar -->
  <div id="status" class="mt-2 rounded-md px-3 py-1.5 text-sm font-medium hidden"></div>

  <!-- ── Below-fold: SEO content ── -->
  <div class="mt-16 max-w-3xl space-y-10">

    <section aria-labelledby="how-it-works-heading">
      <h2 id="how-it-works-heading" class="text-2xl font-bold text-slate-900">How the word counter works</h2>
      <div class="prose mt-4 max-w-none">
        <p>
          Paste or type your text into the left panel. The stats update live as you type — no buttons to click.
          Word count is calculated by splitting on whitespace runs, so adjacent punctuation attached to a word
          counts as part of that word (matching the convention used by most word processors).
        </p>
        <ul>
          <li><strong>Words</strong> — tokens separated by whitespace.</li>
          <li><strong>Characters</strong> — every character including spaces and punctuation.</li>
          <li><strong>No-space chars</strong> — characters after removing all whitespace.</li>
          <li><strong>Sentences</strong> — splits on <code>.</code>, <code>!</code>, and <code>?</code>.</li>
          <li><strong>Paragraphs</strong> — blocks separated by blank lines.</li>
          <li><strong>Syllables</strong> — heuristic English syllable count (vowel-cluster approach).</li>
          <li><strong>Read time</strong> — assumes 225 words per minute (average adult silent reading speed).</li>
          <li><strong>Speak time</strong> — assumes 130 words per minute (average conversational speaking pace). Useful for presentations, speeches, and video scripts.</li>
        </ul>
      </div>
    </section>

    <section aria-labelledby="readability-heading">
      <h2 id="readability-heading" class="text-2xl font-bold text-slate-900">What is the Flesch-Kincaid reading level?</h2>
      <div class="prose mt-4 max-w-none">
        <p>
          The reading level score uses the Flesch Reading Ease formula, which considers average sentence length
          and average number of syllables per word. Higher scores mean easier text; lower scores mean more academic
          or technical writing.
        </p>
        <ul>
          <li><strong>90–100 — Very Easy.</strong> 5th grade. Simple, conversational prose.</li>
          <li><strong>80–89 — Easy.</strong> 6th grade. Plain English.</li>
          <li><strong>70–79 — Fairly Easy.</strong> 7th grade. Most newsletters and blog posts.</li>
          <li><strong>60–69 — Standard.</strong> 8th–9th grade. General audience journalism.</li>
          <li><strong>50–59 — Fairly Difficult.</strong> 10th–12th grade. Academic writing.</li>
          <li><strong>30–49 — Difficult.</strong> College level.</li>
          <li><strong>0–29 — Very Difficult.</strong> Professional/technical, law, medicine.</li>
        </ul>
        <p>
          For most web content, aim for a score of 60–70. Marketing copy benefits from scores above 70.
          Technical documentation may legitimately score below 50.
        </p>
      </div>
    </section>

    <section aria-labelledby="keyword-density-heading">
      <h2 id="keyword-density-heading" class="text-2xl font-bold text-slate-900">Keyword density explained</h2>
      <div class="prose mt-4 max-w-none">
        <p>
          Keyword density is the percentage of times a word appears in a text relative to the total word count.
          It is calculated as: <code>(occurrences ÷ total words) × 100</code>. The Top keywords panel shows the
          10 most frequent words longer than 3 characters, which filters out common stop words like "the", "and",
          "for", "with".
        </p>
        <p>
          SEO practitioners historically targeted a keyword density of 1–3%. Modern search engines care far more
          about topical relevance and natural language than raw density, so use this panel as a sanity check
          rather than a target.
        </p>
      </div>
    </section>

  </div>

  {recentPosts.length > 0 && (
    <section class="mt-16" aria-labelledby="articles-heading">
      <h2 id="articles-heading" class="text-2xl font-bold text-slate-900">Writing &amp; Readability Guides</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">
        {recentPosts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}/`}
              class="group block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-emerald-400 hover:shadow-sm"
            >
              <time
                datetime={post.data.publishDate.toISOString()}
                class="text-xs font-medium uppercase tracking-wide text-slate-400"
              >
                {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <h3 class="mt-1 text-base font-semibold text-slate-900 group-hover:text-emerald-700">{post.data.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm text-slate-600">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-6">
        <a href="/blog/" class="text-sm font-medium text-emerald-700 underline underline-offset-2 hover:text-emerald-800">
          View all guides →
        </a>
      </div>
    </section>
  )}

  <script is:inline>
    var input = document.getElementById('wc-input');
    var statusEl = document.getElementById('status');

    function showStatus(msg, type) {
      var clsMap = { error: 'bg-red-50 text-red-700 border border-red-200', success: 'bg-emerald-50 text-emerald-700 border border-emerald-200', info: 'bg-blue-50 text-blue-700 border border-blue-200' };
      statusEl.className = 'mt-2 rounded-md px-3 py-1.5 text-sm font-medium ' + (clsMap[type] || 'bg-slate-100 text-slate-700');
      statusEl.textContent = msg;
      statusEl.classList.remove('hidden');
    }

    function countSyllables(word) {
      word = word.toLowerCase().replace(/[^a-z]/g, '');
      if (!word) return 0;
      var m = word.match(/[aeiouy]+/g);
      if (!m) return 1;
      var count = m.length;
      if (word.endsWith('e')) count--;
      if (word.endsWith('le') && word.length > 2 && !/[aeiouy]/.test(word[word.length - 3])) count++;
      return Math.max(1, count);
    }

    function fmtTime(secs) {
      if (secs < 60) return secs + 's';
      if (secs < 3600) return Math.ceil(secs / 60) + 'm';
      return (secs / 3600).toFixed(1) + 'h';
    }

    function analyzeSentences(text) {
      var sentences = text.match(/[^.!?…]+[.!?…]+/g) || [];
      if (!sentences.length) return null;
      var lengths = sentences.map(function(s) { return s.trim().split(/\s+/).filter(Boolean).length; });
      var avg = Math.round(lengths.reduce(function(a, b) { return a + b; }, 0) / lengths.length);
      var short = lengths.filter(function(l) { return l <= 10; }).length;
      var medium = lengths.filter(function(l) { return l > 10 && l <= 20; }).length;
      var long = lengths.filter(function(l) { return l > 20; }).length;
      return { avg: avg, short: short, medium: medium, long: long, total: sentences.length };
    }

    function computeStats(text) {
      var words = text.trim() === '' ? [] : text.trim().split(/\s+/);
      var sentences = text.split(/[.!?]+/).filter(function(s) { return s.trim().length > 0; });
      var syllables = words.reduce(function(sum, w) { return sum + countSyllables(w); }, 0);
      var chars = text.length;
      var charsNoSpace = text.replace(/\s/g, '').length;
      var readTime = words.length === 0 ? 0 : Math.ceil(words.length / 225 * 60);
      return { words: words, sentences: sentences, syllables: syllables, chars: chars,
               charsNoSpace: charsNoSpace, readTime: readTime };
    }

    function update() {
      var text = input.value;
      var words = text.trim() === '' ? [] : text.trim().split(/\s+/);
      var sentences = text.split(/[.!?]+/).filter(function(s) { return s.trim().length > 0; });
      var paragraphs = text.split(/\n\n+/).filter(function(p) { return p.trim().length > 0; });
      var syllables = words.reduce(function(sum, w) { return sum + countSyllables(w); }, 0);
      var chars = text.length;
      var charsNoSpace = text.replace(/\s/g, '').length;
      var readTime = words.length === 0 ? 0 : Math.ceil(words.length / 225 * 60);
      var speakTime = words.length === 0 ? 0 : Math.ceil(words.length / 130 * 60);

      var readingLevel = '—';
      if (words.length > 1 && sentences.length > 0) {
        var avgSentenceLen = words.length / sentences.length;
        var avgSyll = syllables / words.length;
        var fk = 206.835 - 1.015 * avgSentenceLen - 84.6 * avgSyll;
        if (fk >= 90) readingLevel = 'Very Easy';
        else if (fk >= 80) readingLevel = 'Easy';
        else if (fk >= 70) readingLevel = 'Fairly Easy';
        else if (fk >= 60) readingLevel = 'Standard';
        else if (fk >= 50) readingLevel = 'Fairly Difficult';
        else if (fk >= 30) readingLevel = 'Difficult';
        else readingLevel = 'Very Difficult';
        readingLevel += ' (' + Math.max(0, Math.round(fk)) + ')';
      }

      document.getElementById('stat-words').textContent = words.length;
      document.getElementById('stat-chars').textContent = chars;
      document.getElementById('stat-chars-nospace').textContent = charsNoSpace;
      document.getElementById('stat-sentences').textContent = sentences.length;
      document.getElementById('stat-paragraphs').textContent = paragraphs.length;
      document.getElementById('stat-syllables').textContent = syllables;
      document.getElementById('stat-readtime').textContent = words.length === 0 ? '—' : fmtTime(readTime);
      document.getElementById('stat-speaktime').textContent = words.length === 0 ? '—' : fmtTime(speakTime);
      document.getElementById('stat-reading').textContent = readingLevel;

      var freq = {};
      words.forEach(function(w) {
        var clean = w.toLowerCase().replace(/[^a-z0-9]/g, '');
        if (clean.length > 3) freq[clean] = (freq[clean] || 0) + 1;
      });
      var top = Object.keys(freq).map(function(k) { return [k, freq[k]]; }).sort(function(a, b) { return b[1] - a[1]; }).slice(0, 10);
      var list = document.getElementById('keywords-list');
      if (top.length === 0) {
        list.innerHTML = '<span class="text-sm text-slate-400">Type to see keyword density…</span>';
      } else {
        list.innerHTML = top.map(function(pair) {
          var pct = ((pair[1] / words.length) * 100).toFixed(1);
          return '<span class="rounded-full bg-emerald-50 px-3 py-1 text-sm text-emerald-700">' + pair[0] + ' <span class="font-semibold">' + pct + '%</span></span>';
        }).join('');
      }

      // Sentence analysis
      var sentData = analyzeSentences(text);
      var sentSection = document.getElementById('sentence-section');
      var sentContent = document.getElementById('sentence-content');
      if (sentData && sentData.total > 2) {
        var guide = sentData.avg < 15 ? 'Good readability' : sentData.avg < 20 ? 'Moderate complexity' : 'Complex — consider shorter sentences';
        sentContent.innerHTML =
          '<p>Average: <strong>' + sentData.avg + '</strong> words/sentence — ' + guide + '</p>' +
          '<p class="text-slate-500">Short (&le;10w): ' + sentData.short + ' &middot; Medium: ' + sentData.medium + ' &middot; Long (20w+): ' + sentData.long + '</p>';
        sentSection.classList.remove('hidden');
      } else {
        sentSection.classList.add('hidden');
      }

      // Update compare if active
      if (!document.getElementById('compare-panel').classList.contains('hidden')) {
        updateCompare();
      }
    }

    function updateCompare() {
      var text1 = input.value;
      var text2 = document.getElementById('wc-compare-input').value;
      if (!text1.trim() || !text2.trim()) {
        document.getElementById('compare-result').classList.add('hidden');
        return;
      }
      var s1 = computeStats(text1);
      var s2 = computeStats(text2);
      var rows = [
        ['Words', s1.words.length, s2.words.length],
        ['Characters', s1.chars, s2.chars],
        ['No-space chars', s1.charsNoSpace, s2.charsNoSpace],
        ['Sentences', s1.sentences.length, s2.sentences.length],
        ['Read time', fmtTime(s1.readTime), fmtTime(s2.readTime)],
      ];
      document.getElementById('compare-tbody').innerHTML = rows.map(function(r) {
        return '<tr class="even:bg-slate-50"><td class="px-3 py-2 border border-slate-200 font-medium text-slate-700">' + r[0] + '</td>' +
          '<td class="px-3 py-2 border border-slate-200 text-emerald-700 font-mono">' + r[1] + '</td>' +
          '<td class="px-3 py-2 border border-slate-200 text-blue-700 font-mono">' + r[2] + '</td></tr>';
      }).join('');
      document.getElementById('compare-result').classList.remove('hidden');
    }

    var compareVisible = false;
    document.getElementById('btn-compare').addEventListener('click', function() {
      compareVisible = !compareVisible;
      var panel = document.getElementById('compare-panel');
      if (compareVisible) {
        panel.classList.remove('hidden');
        this.className = 'rounded-md border border-emerald-400 bg-emerald-50 px-3.5 py-1.5 text-sm font-medium text-emerald-700 hover:bg-emerald-100 transition-colors';
        updateCompare();
      } else {
        panel.classList.add('hidden');
        this.className = 'rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors';
      }
    });

    document.getElementById('wc-compare-input').addEventListener('input', updateCompare);

    document.getElementById('btn-copy-stats').addEventListener('click', function() {
      var text = input.value;
      if (!text.trim()) { showStatus('No text to summarize', 'info'); return; }
      var words = text.trim() ? text.trim().split(/\s+/).length : 0;
      var chars = text.length;
      var charsNoSpace = text.replace(/\s/g, '').length;
      var sentences = text.split(/[.!?]+/).filter(function(s) { return s.trim().length > 0; }).length;
      var paragraphs = text.split(/\n\n+/).filter(function(p) { return p.trim().length > 0; }).length;
      var readTime = words === 0 ? '—' : fmtTime(Math.ceil(words / 225 * 60));
      var level = document.getElementById('stat-reading').textContent;
      var statsText = [
        'Words: ' + words,
        'Characters: ' + chars,
        'No-space chars: ' + charsNoSpace,
        'Sentences: ' + sentences,
        'Paragraphs: ' + paragraphs,
        'Read time: ' + readTime,
        'Reading level: ' + level,
      ].join('\n');
      navigator.clipboard.writeText(statsText).then(function() {
        showStatus('Stats copied to clipboard', 'success');
      }, function() { showStatus('Could not copy', 'error'); });
    });

    document.getElementById('btn-clear').addEventListener('click', function() {
      input.value = '';
      update();
      statusEl.classList.add('hidden');
      input.focus();
    });

    document.getElementById('btn-copy').addEventListener('click', function() {
      if (!input.value) { showStatus('Nothing to copy', 'info'); return; }
      navigator.clipboard.writeText(input.value).then(function() {
        showStatus('Copied to clipboard', 'success');
      }, function() {
        input.select();
        document.execCommand('copy');
        showStatus('Copied', 'success');
      });
    });

    input.addEventListener('input', update);
  </script>

</BaseLayout>
