---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '~/config/site.config';

const recentPosts = siteConfig.features.hasBlog
  ? (await getCollection('blog', ({ data }) => !data.draft))
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
      .slice(0, 6)
  : [];
---
<BaseLayout
  title="Favicon Generator — Create ICO, PNG & SVG Favicons Free"
  description="Generate favicon sets (16x16, 32x32, 180x180 Apple Touch, and SVG) from any image or text/emoji. Free, runs in your browser — nothing uploaded."
>

  <!-- Hero: upload area + live favicon preview as focal point -->
  <section class="relative -mx-4 overflow-hidden px-4 py-14 sm:py-20">
    <div class="absolute inset-0 bg-gradient-to-br from-fuchsia-50 via-violet-50 to-purple-50" aria-hidden="true" />
    <div class="absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-fuchsia-300/20 blur-3xl" aria-hidden="true" />
    <div class="absolute bottom-0 right-0 h-64 w-64 rounded-full bg-violet-300/15 blur-3xl" aria-hidden="true" />

    <div class="relative">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Favicon Generator
        </h1>
        <p class="mt-3 text-lg text-slate-600">
          Upload any image — or type initials/emoji — and get a complete favicon set.
          Generates in your browser. No uploads.
        </p>
      </div>

      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-600">
        {[
          '16×16, 32×32, 48×48 PNG',
          '180×180 Apple Touch',
          'Text &amp; Emoji mode',
          'Nothing uploaded',
        ].map((badge) => (
          <li class="flex items-center gap-1.5">
            <svg class="h-4 w-4 shrink-0 text-fuchsia-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span set:html={badge} />
          </li>
        ))}
      </ul>

      <!-- Generator card -->
      <div class="mx-auto mt-8 w-full max-w-2xl">
        <div class="rounded-2xl border border-fuchsia-200/80 bg-white p-6 shadow-sm">

          <!-- Padding control -->
          <div class="flex items-center gap-3 mb-4">
            <label class="text-sm font-medium text-slate-700 shrink-0">Padding</label>
            <input type="range" id="fav-padding" min="0" max="30" step="5" value="0" class="flex-1 accent-fuchsia-600" oninput="document.getElementById('fav-padding-label').textContent=this.value+'%'; refreshAllPreviews()" />
            <span class="text-sm font-mono text-slate-500 w-8 text-right" id="fav-padding-label">0%</span>
          </div>

          <!-- Mode tabs -->
          <div class="flex rounded-xl border border-slate-200 bg-slate-50 p-1 mb-6 gap-1">
            <button id="tab-upload" class="flex-1 rounded-lg py-2 text-sm font-semibold bg-white text-fuchsia-700 shadow-sm transition">Upload Image</button>
            <button id="tab-text"   class="flex-1 rounded-lg py-2 text-sm font-semibold text-slate-500 hover:text-slate-700 transition">Text / Emoji</button>
          </div>

          <!-- ── Upload mode ── -->
          <div id="mode-upload">
            <div
              id="drop-zone"
              class="flex flex-col items-center justify-center rounded-xl border-2 border-dashed border-fuchsia-300 bg-fuchsia-50/60 px-6 py-10 text-center transition hover:border-fuchsia-500 hover:bg-fuchsia-50 cursor-pointer"
              onclick="document.getElementById('file-input').click()"
              ondragover="event.preventDefault();this.classList.add('border-fuchsia-500','bg-fuchsia-50')"
              ondragleave="this.classList.remove('border-fuchsia-500','bg-fuchsia-50')"
              ondrop="handleDrop(event)"
            >
              <svg class="h-12 w-12 text-fuchsia-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3 21h18" />
              </svg>
              <p class="mt-3 text-sm font-medium text-slate-700">Drop an image here or <span class="text-fuchsia-600 underline underline-offset-2">browse</span></p>
              <p class="mt-1 text-xs text-slate-400">PNG, JPG, SVG, WebP — square image gives the best results</p>
              <input type="file" id="file-input" accept="image/*" class="hidden" onchange="handleFileInput(this)" />
            </div>

            <!-- Live preview section — shown after upload -->
            <div id="preview-section" class="hidden mt-6">
              <h2 class="text-sm font-semibold text-slate-700 mb-4">Preview &amp; Download</h2>
              <div class="flex flex-wrap items-end gap-6 justify-center mb-6">
                <div class="text-center">
                  <canvas id="prev-16" width="16" height="16" class="block mx-auto rounded border border-slate-200 fav-checkerboard" style="image-rendering:pixelated;width:64px;height:64px"></canvas>
                  <p class="mt-1.5 text-xs text-slate-500">16×16</p>
                </div>
                <div class="text-center">
                  <canvas id="prev-32" width="32" height="32" class="block mx-auto rounded border border-slate-200 fav-checkerboard" style="image-rendering:pixelated;width:64px;height:64px"></canvas>
                  <p class="mt-1.5 text-xs text-slate-500">32×32</p>
                </div>
                <div class="text-center">
                  <canvas id="prev-48" width="48" height="48" class="block mx-auto rounded border border-slate-200 fav-checkerboard" style="image-rendering:pixelated;width:64px;height:64px"></canvas>
                  <p class="mt-1.5 text-xs text-slate-500">48×48</p>
                </div>
                <div class="text-center">
                  <canvas id="prev-180" width="180" height="180" class="block mx-auto rounded border border-slate-200 fav-checkerboard" style="width:64px;height:64px"></canvas>
                  <p class="mt-1.5 text-xs text-slate-500">180×180</p>
                  <p class="text-xs text-slate-400">Apple Touch</p>
                </div>
              </div>
              <div class="flex flex-wrap gap-3 justify-center">
                <button onclick="downloadPng(16)" class="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-4 py-2 text-sm font-medium text-fuchsia-700 hover:bg-fuchsia-100 transition">16×16 PNG</button>
                <button onclick="downloadPng(32)" class="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-4 py-2 text-sm font-medium text-fuchsia-700 hover:bg-fuchsia-100 transition">32×32 PNG</button>
                <button onclick="downloadPng(48)" class="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-4 py-2 text-sm font-medium text-fuchsia-700 hover:bg-fuchsia-100 transition">48×48 PNG</button>
                <button onclick="downloadPng(180)" class="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-4 py-2 text-sm font-medium text-fuchsia-700 hover:bg-fuchsia-100 transition">Apple Touch PNG</button>
                <button onclick="downloadSvg()" class="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-4 py-2 text-sm font-medium text-fuchsia-700 hover:bg-fuchsia-100 transition">SVG</button>
                <button onclick="downloadFaviconICO()" class="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-4 py-2 text-sm font-medium text-fuchsia-700 hover:bg-fuchsia-100 transition">Download .ICO</button>
                <button onclick="generateManifest()" class="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-4 py-2 text-sm font-medium text-fuchsia-700 hover:bg-fuchsia-100 transition">Download Manifest</button>
              </div>
              <p class="text-xs text-slate-400 mt-2 text-center">.ICO downloads as a 32×32 PNG with .ico extension — compatible with all modern browsers and build tools. Edit <code class="font-mono">name</code> and <code class="font-mono">short_name</code> in the manifest after downloading.</p>
              <div class="mt-6">
                <p class="text-xs font-semibold text-slate-600 mb-2">HTML to paste in your <code class="font-mono text-fuchsia-700">&lt;head&gt;</code></p>
                <pre id="html-snippet" class="overflow-x-auto rounded-xl bg-slate-900 p-4 text-xs text-emerald-300 font-mono leading-relaxed"></pre>
                <button onclick="navigator.clipboard.writeText(document.getElementById('html-snippet').textContent)" class="mt-2 rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-200 transition">Copy HTML</button>
              </div>
            </div>
          </div>

          <!-- ── Text / Emoji mode ── -->
          <div id="mode-text" class="hidden">
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label class="block text-sm font-medium text-slate-700 mb-1">Text or Emoji <span class="text-slate-400 font-normal">(1–3 characters)</span></label>
                <input
                  id="txt-input"
                  type="text"
                  maxlength="3"
                  placeholder="AB or &#128640;"
                  class="w-full rounded-lg border border-slate-300 px-4 py-3 text-2xl text-center tracking-widest focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 outline-none"
                  oninput="updateTextPreview()"
                />
              </div>
              <label class="block">
                <span class="text-sm font-medium text-slate-700">Background color</span>
                <div class="mt-1 flex items-center gap-2">
                  <input type="color" id="txt-bg" value="#4F46E5" class="h-9 w-14 rounded-md border border-slate-300 cursor-pointer" oninput="updateTextPreview()" />
                  <span class="text-sm text-slate-500 font-mono" id="txt-bg-label">#4F46E5</span>
                </div>
              </label>
              <label class="block">
                <span class="text-sm font-medium text-slate-700">Text color</span>
                <div class="mt-1 flex items-center gap-2">
                  <input type="color" id="txt-fg" value="#FFFFFF" class="h-9 w-14 rounded-md border border-slate-300 cursor-pointer" oninput="updateTextPreview()" />
                  <span class="text-sm text-slate-500 font-mono" id="txt-fg-label">#FFFFFF</span>
                </div>
              </label>
              <div class="sm:col-span-2">
                <label class="block text-sm font-medium text-slate-700 mb-1">Font size adjustment</label>
                <div class="flex items-center gap-3">
                  <input type="range" id="txt-size-factor" min="50" max="100" value="75" class="flex-1 accent-fuchsia-600" oninput="updateTextPreview()" />
                  <span class="text-sm font-mono text-slate-500 w-10 text-right" id="txt-size-label">75%</span>
                </div>
                <p class="mt-1 text-xs text-slate-400">Auto-scales by character count; drag to fine-tune</p>
              </div>
            </div>

            <!-- Live preview -->
            <div class="mt-6">
              <p class="text-sm font-semibold text-slate-700 mb-3">Live Preview</p>
              <div class="flex flex-wrap items-end gap-6 justify-center mb-6">
                <div class="text-center">
                  <canvas id="txt-prev-16" width="16" height="16" class="block mx-auto rounded border border-slate-200" style="image-rendering:pixelated;width:64px;height:64px"></canvas>
                  <p class="mt-1.5 text-xs text-slate-500">16×16</p>
                </div>
                <div class="text-center">
                  <canvas id="txt-prev-32" width="32" height="32" class="block mx-auto rounded border border-slate-200" style="image-rendering:pixelated;width:64px;height:64px"></canvas>
                  <p class="mt-1.5 text-xs text-slate-500">32×32</p>
                </div>
                <div class="text-center">
                  <canvas id="txt-prev-64" width="64" height="64" class="block mx-auto rounded border border-slate-200" style="width:64px;height:64px"></canvas>
                  <p class="mt-1.5 text-xs text-slate-500">64×64</p>
                </div>
                <div class="text-center">
                  <canvas id="txt-prev-128" width="128" height="128" class="block mx-auto rounded border border-slate-200" style="width:64px;height:64px"></canvas>
                  <p class="mt-1.5 text-xs text-slate-500">128×128</p>
                </div>
              </div>
              <div class="flex flex-wrap gap-3 justify-center">
                <button onclick="downloadTextPng(16)"  class="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-4 py-2 text-sm font-medium text-fuchsia-700 hover:bg-fuchsia-100 transition">16×16 PNG</button>
                <button onclick="downloadTextPng(32)"  class="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-4 py-2 text-sm font-medium text-fuchsia-700 hover:bg-fuchsia-100 transition">32×32 PNG</button>
                <button onclick="downloadTextPng(64)"  class="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-4 py-2 text-sm font-medium text-fuchsia-700 hover:bg-fuchsia-100 transition">64×64 PNG</button>
                <button onclick="downloadTextPng(128)" class="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-4 py-2 text-sm font-medium text-fuchsia-700 hover:bg-fuchsia-100 transition">128×128 PNG</button>
                <button onclick="downloadTextFaviconICO()" class="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-4 py-2 text-sm font-medium text-fuchsia-700 hover:bg-fuchsia-100 transition">Download .ICO</button>
                <button onclick="generateManifest()" class="rounded-lg border border-fuchsia-200 bg-fuchsia-50 px-4 py-2 text-sm font-medium text-fuchsia-700 hover:bg-fuchsia-100 transition">Download Manifest</button>
              </div>
              <p class="text-xs text-slate-400 mt-2 text-center">.ICO downloads as a 32×32 PNG with .ico extension — compatible with all modern browsers and build tools. Edit <code class="font-mono">name</code> and <code class="font-mono">short_name</code> in the manifest after downloading.</p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Educational content -->
  <section class="mt-16" aria-labelledby="what-is-favicon-heading">
    <h2 id="what-is-favicon-heading" class="text-2xl font-bold text-slate-900">What is a Favicon?</h2>
    <div class="prose prose-slate mt-3 max-w-none">
      <p>
        A <strong>favicon</strong> (short for "favorites icon") is the small icon that appears in browser tabs,
        bookmark lists, history, and search results. Modern browsers support several formats and sizes, so a complete
        favicon set typically includes:
      </p>
    </div>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {([
        { size: '16×16 PNG', use: 'Browser tabs — the most common favicon size' },
        { size: '32×32 PNG', use: 'Taskbar pinned sites, Windows shortcut icons' },
        { size: '48×48 PNG', use: 'Windows site icons and some desktop environments' },
        { size: '180×180 PNG', use: 'Apple Touch icon — iOS and macOS home screen' },
        { size: 'SVG', use: 'Modern browsers; crisp at any size, supports dark mode' },
        { size: 'favicon.ico', use: 'Legacy fallback; embeds 16 and 32 sizes in one file' },
      ] as const).map((item) => (
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <p class="font-mono text-sm font-semibold text-fuchsia-700">{item.size}</p>
          <p class="mt-1 text-sm text-slate-600">{item.use}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-12" aria-labelledby="html-guide-heading">
    <h2 id="html-guide-heading" class="text-2xl font-bold text-slate-900">The Modern Favicon HTML</h2>
    <div class="prose prose-slate mt-3 max-w-none">
      <p>Place your favicon files in the site root and add this to your <code>&lt;head&gt;</code>:</p>
    </div>
    <pre class="mt-4 overflow-x-auto rounded-xl bg-slate-900 p-5 text-sm text-emerald-300 font-mono leading-relaxed">&lt;link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32"&gt;
&lt;link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16"&gt;
&lt;link rel="apple-touch-icon" href="/apple-touch-icon.png"&gt;
&lt;link rel="icon" type="image/svg+xml" href="/favicon.svg"&gt;</pre>
  </section>

  {recentPosts.length > 0 && (
    <section class="mt-16" aria-labelledby="articles-heading">
      <h2 id="articles-heading" class="text-2xl font-bold text-slate-900">Latest Articles</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {recentPosts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}/`}
              class="group block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-fuchsia-400/40 hover:shadow-sm"
            >
              <time
                datetime={post.data.publishDate.toISOString()}
                class="text-xs font-medium uppercase tracking-wide text-slate-400"
              >
                {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <h3 class="mt-1 text-base font-semibold text-slate-900 group-hover:text-fuchsia-700">{post.data.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm text-slate-600">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <footer class="mt-16 border-t border-slate-200 pt-8 text-sm text-slate-500">
    <span>Content last reviewed: <time datetime="2026-04-26">April 26, 2026</time>.</span>
  </footer>

</BaseLayout>

<style>
  .fav-checkerboard {
    background-image: linear-gradient(45deg, #d1d5db 25%, transparent 25%),
      linear-gradient(-45deg, #d1d5db 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #d1d5db 75%),
      linear-gradient(-45deg, transparent 75%, #d1d5db 75%);
    background-size: 8px 8px;
    background-position: 0 0, 0 4px, 4px -4px, -4px 0px;
  }
</style>

<script is:inline>
  // ── Image upload mode ──────────────────────────────────────────────────────
  var srcImg = null;

  function handleDrop(e) {
    e.preventDefault();
    document.getElementById('drop-zone').classList.remove('border-fuchsia-500','bg-fuchsia-50');
    var file = e.dataTransfer.files[0];
    if (file && file.type.startsWith('image/')) loadImageFile(file);
  }

  function handleFileInput(input) {
    var file = input.files[0];
    if (file) loadImageFile(file);
  }

  function loadImageFile(file) {
    var reader = new FileReader();
    reader.onload = function(ev) {
      var img = new Image();
      img.onload = function() {
        srcImg = img;
        renderPreviews();
        document.getElementById('preview-section').classList.remove('hidden');
        var dz = document.getElementById('drop-zone');
        dz.innerHTML =
          '<img src="' + ev.target.result + '" class="h-20 w-20 rounded-lg object-cover border border-fuchsia-200 mx-auto" alt="Source" />' +
          '<p class="mt-2 text-sm text-slate-600 font-medium">' + file.name + '</p>' +
          '<p class="text-xs text-slate-400 mt-1">Click or drop another image to replace</p>';
        dz.onclick = function() { document.getElementById('file-input').click(); };
      };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
  }

  function getPadding() {
    return parseInt(document.getElementById('fav-padding').value, 10) || 0;
  }

  function drawToCanvas(canvasId, size) {
    if (!srcImg) return null;
    var c = document.getElementById(canvasId);
    c.width = size; c.height = size;
    var ctx = c.getContext('2d');
    ctx.clearRect(0, 0, size, size);
    var sw = srcImg.naturalWidth, sh = srcImg.naturalHeight;
    var minDim = Math.min(sw, sh);
    var sx = (sw - minDim) / 2, sy = (sh - minDim) / 2;
    var pad = getPadding();
    var drawSize = Math.round(size * (100 - pad) / 100);
    var offset = Math.round((size - drawSize) / 2);
    ctx.drawImage(srcImg, sx, sy, minDim, minDim, offset, offset, drawSize, drawSize);
    return c;
  }

  function renderPreviews() {
    [16, 32, 48, 180].forEach(function(s) { drawToCanvas('prev-' + s, s); });
    document.getElementById('html-snippet').textContent = [
      '<link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32">',
      '<link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16">',
      '<link rel="apple-touch-icon" href="/apple-touch-icon.png">',
      '<link rel="icon" type="image/svg+xml" href="/favicon.svg">',
    ].join('\n');
  }

  function downloadPng(size) {
    var c = drawToCanvas('prev-' + size, size);
    if (!c) return;
    var a = document.createElement('a');
    a.download = (size === 180 ? 'apple-touch-icon' : 'favicon-' + size + 'x' + size) + '.png';
    a.href = c.toDataURL('image/png');
    a.click();
  }

  function downloadSvg() {
    if (!srcImg) return;
    var c = document.createElement('canvas');
    c.width = 32; c.height = 32;
    var ctx = c.getContext('2d');
    var sw = srcImg.naturalWidth, sh = srcImg.naturalHeight;
    var minDim = Math.min(sw, sh);
    ctx.drawImage(srcImg, (sw-minDim)/2, (sh-minDim)/2, minDim, minDim, 0, 0, 32, 32);
    var dataUrl = c.toDataURL('image/png');
    var svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><image href="' + dataUrl + '" width="32" height="32"/></svg>';
    var blob = new Blob([svg], {type: 'image/svg+xml'});
    var a = document.createElement('a');
    a.download = 'favicon.svg';
    a.href = URL.createObjectURL(blob);
    a.click();
    URL.revokeObjectURL(a.href);
  }

  // ── Text / Emoji mode ──────────────────────────────────────────────────────
  function textToCanvas(text, bgColor, fgColor, sizeFactor, size) {
    var canvas = document.createElement('canvas');
    canvas.width = size;
    canvas.height = size;
    var ctx = canvas.getContext('2d');
    ctx.fillStyle = bgColor;
    ctx.fillRect(0, 0, size, size);
    ctx.fillStyle = fgColor;
    var pad = getPadding();
    var drawSize = Math.round(size * (100 - pad) / 100);
    var autoScale = text.length === 1 ? 0.6 : text.length === 2 ? 0.45 : 0.35;
    var fontSize = Math.floor(drawSize * autoScale * (sizeFactor / 75));
    ctx.font = 'bold ' + fontSize + 'px system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(text, size / 2, size / 2);
    return canvas;
  }

  function updateTextPreview() {
    var text = document.getElementById('txt-input').value.trim() || 'A';
    var bg = document.getElementById('txt-bg').value;
    var fg = document.getElementById('txt-fg').value;
    var factor = parseInt(document.getElementById('txt-size-factor').value, 10);
    document.getElementById('txt-bg-label').textContent = bg.toUpperCase();
    document.getElementById('txt-fg-label').textContent = fg.toUpperCase();
    document.getElementById('txt-size-label').textContent = factor + '%';
    [16, 32, 64, 128].forEach(function(size) {
      var src = textToCanvas(text, bg, fg, factor, size);
      var dest = document.getElementById('txt-prev-' + size);
      dest.width = size;
      dest.height = size;
      dest.getContext('2d').drawImage(src, 0, 0);
    });
  }

  function downloadTextPng(size) {
    var text = document.getElementById('txt-input').value.trim() || 'A';
    var bg = document.getElementById('txt-bg').value;
    var fg = document.getElementById('txt-fg').value;
    var factor = parseInt(document.getElementById('txt-size-factor').value, 10);
    var canvas = textToCanvas(text, bg, fg, factor, size);
    var a = document.createElement('a');
    a.download = 'favicon-' + size + 'x' + size + '.png';
    a.href = canvas.toDataURL('image/png');
    a.click();
  }

  // ── ICO download ──────────────────────────────────────────────────────────
  function downloadFaviconICO() {
    var offscreen = document.createElement('canvas');
    offscreen.width = 32; offscreen.height = 32;
    var ctx = offscreen.getContext('2d');
    if (srcImg) {
      var sw = srcImg.naturalWidth, sh = srcImg.naturalHeight;
      var minDim = Math.min(sw, sh);
      var pad = getPadding();
      var drawSize = Math.round(32 * (100 - pad) / 100);
      var offset = Math.round((32 - drawSize) / 2);
      ctx.drawImage(srcImg, (sw-minDim)/2, (sh-minDim)/2, minDim, minDim, offset, offset, drawSize, drawSize);
    }
    offscreen.toBlob(function(blob) {
      if (!blob) return;
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'favicon.ico';
      a.click();
      URL.revokeObjectURL(a.href);
    }, 'image/png');
  }

  function downloadTextFaviconICO() {
    var text = document.getElementById('txt-input').value.trim() || 'A';
    var bg = document.getElementById('txt-bg').value;
    var fg = document.getElementById('txt-fg').value;
    var factor = parseInt(document.getElementById('txt-size-factor').value, 10);
    var canvas = textToCanvas(text, bg, fg, factor, 32);
    canvas.toBlob(function(blob) {
      if (!blob) return;
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'favicon.ico';
      a.click();
      URL.revokeObjectURL(a.href);
    }, 'image/png');
  }

  // ── Manifest download ──────────────────────────────────────────────────────
  function generateManifest() {
    var manifest = {
      name: '',
      short_name: '',
      icons: [
        { src: '/favicon-192.png', sizes: '192x192', type: 'image/png' },
        { src: '/favicon-512.png', sizes: '512x512', type: 'image/png' },
      ],
      theme_color: '#ffffff',
      background_color: '#ffffff',
      display: 'standalone',
    };
    var json = JSON.stringify(manifest, null, 2);
    var blob = new Blob([json], { type: 'application/json' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'site.webmanifest';
    a.click();
    URL.revokeObjectURL(a.href);
  }

  // ── Refresh all previews (called when padding changes) ─────────────────────
  function refreshAllPreviews() {
    if (srcImg) renderPreviews();
    var modeTextVisible = !document.getElementById('mode-text').classList.contains('hidden');
    if (modeTextVisible) updateTextPreview();
  }

  // ── Mode tab switching ─────────────────────────────────────────────────────
  document.getElementById('tab-upload').addEventListener('click', function() {
    document.getElementById('mode-upload').classList.remove('hidden');
    document.getElementById('mode-text').classList.add('hidden');
    this.classList.add('bg-white', 'text-fuchsia-700', 'shadow-sm');
    this.classList.remove('text-slate-500');
    var t = document.getElementById('tab-text');
    t.classList.remove('bg-white', 'text-fuchsia-700', 'shadow-sm');
    t.classList.add('text-slate-500');
  });

  document.getElementById('tab-text').addEventListener('click', function() {
    document.getElementById('mode-text').classList.remove('hidden');
    document.getElementById('mode-upload').classList.add('hidden');
    this.classList.add('bg-white', 'text-fuchsia-700', 'shadow-sm');
    this.classList.remove('text-slate-500');
    var u = document.getElementById('tab-upload');
    u.classList.remove('bg-white', 'text-fuchsia-700', 'shadow-sm');
    u.classList.add('text-slate-500');
    updateTextPreview();
  });

  // Initial text preview render
  updateTextPreview();
</script>
