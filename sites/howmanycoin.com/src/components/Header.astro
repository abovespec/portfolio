---
import { siteConfig } from '~/config/site.config';
const { primary } = siteConfig.nav;
const { logoText } = siteConfig.branding;
const { hasBlog, hasTool, hasGame, hasSponsoredIntake } = siteConfig.features;

// Hide feature-flagged nav items when their collections are disabled.
const featureGate: Record<string, boolean> = {
  '/blog/': hasBlog,
  '/tools/': hasTool,
  '/games/': hasGame,
  '/sponsored/': hasSponsoredIntake,
};
const items = primary.filter((l) => !(l.href in featureGate) || featureGate[l.href]);
---
<header class="border-b border-[var(--border)] bg-white/80 backdrop-blur-sm">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a href="/" class="text-lg font-bold tracking-tight text-[var(--ink)]">{logoText}</a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-5 text-sm font-medium text-[var(--muted)]">
        {items.map((l) => (
          <li><a href={l.href} class="hover:text-[var(--ink)] transition-colors">{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
