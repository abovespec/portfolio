---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { siteConfig } from '~/config/site.config';
import { getCollection } from 'astro:content';

const recentPosts = siteConfig.features.hasBlog
  ? (await getCollection('blog', ({ data }) => !data.draft))
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
      .slice(0, 6)
  : [];

const featuredTool = siteConfig.features.hasTool
  ? (await getCollection('tools', ({ data }) => !data.draft)).at(0)
  : undefined;
const featuredGame = siteConfig.features.hasGame
  ? (await getCollection('games', ({ data }) => !data.draft)).at(0)
  : undefined;

const featuredPairs = (await getCollection('pairs', ({ data }) => !data.draft && data.featured))
  .slice(0, 4);
---
<BaseLayout title={siteConfig.identity.name} description={siteConfig.identity.description}>
  <section class="py-12 text-center">
    <h1 class="text-5xl font-bold tracking-tight text-slate-900">{siteConfig.identity.name}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">{siteConfig.identity.description}</p>
  </section>

  <!-- Quick converters (featured pairs) -->
  {featuredPairs.length > 0 && (
    <section class="my-10">
      <h2 class="text-2xl font-semibold mb-4">Quick convert</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {featuredPairs.map((pair) => (
          <a href={`/convert/${pair.data.base}-${pair.data.quote}/`}
            class="rounded-lg border border-slate-200 bg-white p-5 hover:border-slate-400">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">
              {pair.data.base.toUpperCase()} → {pair.data.quote.toUpperCase()}
            </p>
            <h3 class="mt-1 text-lg font-medium">{pair.data.title}</h3>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Supply explainer links -->
  <section class="my-10">
    <h2 class="text-2xl font-semibold mb-4">Supply explainer</h2>
    <a href="/supply/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-slate-400">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Supply</p>
      <h3 class="mt-1 text-lg font-medium">How much of each token exists?</h3>
      <p class="mt-2 text-sm text-slate-600">Plain-English supply explainers for 10 major tokens.</p>
    </a>
  </section>

  <!-- Evergreen guides -->
  <section class="my-10">
    <h2 class="text-2xl font-semibold mb-4">Guides</h2>
    <a href="/guides/" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-slate-400">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Learn</p>
      <h3 class="mt-1 text-lg font-medium">Crypto supply & valuation basics</h3>
      <p class="mt-2 text-sm text-slate-600">Market cap, FDV, emissions schedules, supply shocks — plain English.</p>
    </a>
  </section>

  {(featuredTool || featuredGame) && (
    <section class="my-10">
      <h2 class="text-2xl font-semibold mb-4">Featured</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {featuredTool && (
          <a href={`/tools/${featuredTool.data.urlSlug}/`} class="rounded-lg border border-slate-200 bg-white p-6 hover:border-slate-400">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Tool</p>
            <h3 class="mt-2 text-xl font-medium">{featuredTool.data.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{featuredTool.data.description}</p>
          </a>
        )}
        {featuredGame && (
          <a href={`/games/${featuredGame.data.urlSlug}/`} class="rounded-lg border border-slate-200 bg-white p-6 hover:border-slate-400">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Game</p>
            <h3 class="mt-2 text-xl font-medium">{featuredGame.data.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{featuredGame.data.description}</p>
          </a>
        )}
      </div>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="my-10">
      <h2 class="text-2xl font-semibold mb-4">Recent posts</h2>
      <ul class="grid gap-4 sm:grid-cols-2">
        {recentPosts.map((post) => (
          <li class="rounded-lg border border-slate-200 bg-white p-4 hover:border-slate-400">
            <a href={`/blog/${post.slug}/`}>
              <h3 class="text-lg font-medium text-slate-900">{post.data.title}</h3>
              <p class="mt-1 text-sm text-slate-600">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
