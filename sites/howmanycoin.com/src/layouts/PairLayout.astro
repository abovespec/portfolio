---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import { siteUrl } from '~/config/site.config';
import PairConverter from '~/components/PairConverter.preact';

interface Props {
  title: string;
  description: string;
  base: string;
  quote: string;
}
const { title, description, base, quote } = Astro.props;
const url = new URL(Astro.url.pathname, siteUrl).toString();
const symbol = `${base.toUpperCase()}/${quote.toUpperCase()}`;
---
<BaseLayout title={title} description={description}>
  <Breadcrumb items={[
    { name: 'Home', url: '/' },
    { name: 'Converters', url: '/convert/' },
    { name: symbol, url: `/convert/${base}-${quote}/` },
  ]} />

  <section class="mt-6">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900">{title}</h1>
    <p class="mt-3 text-lg text-slate-600">{description}</p>

    <!-- Live rate card — Preact island fetches real-time rates -->
    <PairConverter client:load base={base} quote={quote} />
  </section>

  <slot />
</BaseLayout>
