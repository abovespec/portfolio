---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout
  title="CSS Gradient Generator — Linear, Radial &amp; Conic Gradients Free"
  description="Free online CSS gradient generator. Build linear, radial, and conic gradients with live preview, multi-stop support, and one-click CSS copy. Runs in your browser."
>

  <!-- Compact header -->
  <header class="pb-4 pt-2">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">
      CSS Gradient Generator
    </h1>
    <p class="mt-1.5 text-sm text-slate-500">
      Build linear, radial, and conic CSS gradients with a live preview and copy-ready code.
    </p>
  </header>

  <!-- Toolbar -->
  <div class="flex flex-wrap gap-2 mb-3">
    <select id="g-type" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-700 focus:border-purple-500 focus:ring-1 focus:ring-purple-500">
      <option value="linear">Linear gradient</option>
      <option value="radial">Radial gradient</option>
      <option value="conic">Conic gradient</option>
    </select>
    <div class="flex items-center gap-2">
      <input type="range" id="g-angle" min="0" max="360" value="135" class="w-28 accent-purple-600" />
      <span id="g-angle-label" class="text-sm text-slate-600 font-mono w-14">135deg</span>
    </div>
    <button id="btn-add-stop"    class="rounded-md bg-purple-600 px-3.5 py-1.5 text-sm font-medium text-white hover:bg-purple-700 transition-colors">+ Add Stop</button>
    <button id="btn-random-grad" class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Random</button>
    <div class="flex-1"></div>
    <button id="btn-copy-grad"   class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Copy CSS</button>
  </div>

  <!-- Tool: stops + preview + code -->
  <div class="grid gap-3 md:grid-cols-2 min-h-96">

    <!-- Stops pane -->
    <div class="flex flex-col gap-3 rounded-lg border border-slate-200 bg-white p-5">
      <div class="text-xs font-semibold uppercase tracking-wide text-slate-500">Color Stops</div>
      <div id="stops-container" class="space-y-3"></div>
    </div>

    <!-- Preview + output pane -->
    <div class="flex flex-col gap-3">
      <div class="text-xs font-semibold uppercase tracking-wide text-slate-500">Preview</div>
      <div id="grad-preview" class="flex-1 rounded-lg border border-slate-200 min-h-40" style="background:linear-gradient(135deg,#3b82f6,#a855f7)"></div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">CSS Output</div>
        <code id="grad-css" class="block rounded-lg bg-slate-900 px-4 py-3 text-sm text-emerald-300 font-mono overflow-x-auto whitespace-pre-wrap break-all">background: linear-gradient(135deg, #3b82f6, #a855f7);</code>
      </div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Tailwind Output</div>
        <code id="grad-tailwind" class="block rounded-lg bg-slate-900 px-4 py-3 text-sm text-purple-300 font-mono overflow-x-auto whitespace-pre-wrap break-all"></code>
      </div>
      <div class="flex flex-wrap gap-2">
        <button id="btn-copy-svg" class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Copy as SVG fill</button>
        <button id="btn-animate-toggle" class="rounded-md border border-slate-300 px-3.5 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">Animate</button>
      </div>
    </div>
  </div>

  <!-- Status bar -->
  <div id="status" class="mt-2 rounded-md px-3 py-1.5 text-sm font-medium hidden"></div>

  <!-- ── Preset Gallery ── -->
  <div class="mt-8">
    <button
      id="presets-toggle"
      class="flex w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-5 py-3.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors"
      aria-expanded="false"
    >
      <span>Preset Gradients <span class="ml-1.5 rounded-full bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-700">24</span></span>
      <svg id="presets-chevron" class="h-4 w-4 text-slate-400 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
      </svg>
    </button>
    <div id="presets-panel" class="hidden mt-3">
      <div class="grid grid-cols-4 gap-3 sm:grid-cols-6 lg:grid-cols-8" id="presets-grid"></div>
    </div>
  </div>

  <!-- ── Below-fold: SEO content ── -->
  <div class="mt-16 max-w-3xl space-y-10">

    <section aria-labelledby="gradient-types-heading">
      <h2 id="gradient-types-heading" class="text-2xl font-bold text-slate-900">CSS gradient types</h2>
      <div class="prose mt-4 max-w-none">
        <ul>
          <li>
            <strong>linear-gradient()</strong> — color transitions along a straight line defined by an angle
            (<code>0deg</code> = bottom-to-top, <code>90deg</code> = left-to-right, <code>135deg</code> = diagonal).
            The most widely used gradient type.
          </li>
          <li>
            <strong>radial-gradient()</strong> — transitions radiate outward from a center point in an ellipse
            or circle. Useful for spotlight effects, glows, and vignettes.
          </li>
          <li>
            <strong>conic-gradient()</strong> — transitions rotate around a center point, like the face of a
            clock. Used for pie charts, color wheels, and checkerboard patterns.
          </li>
        </ul>
      </div>
    </section>

    <section aria-labelledby="css-gradient-syntax-heading">
      <h2 id="css-gradient-syntax-heading" class="text-2xl font-bold text-slate-900">CSS gradient syntax reference</h2>
      <div class="prose mt-4 max-w-none">
        <p>The generated CSS uses the <code>background</code> shorthand property:</p>
        <ul>
          <li><code>background: linear-gradient(135deg, #3b82f6 0%, #a855f7 100%);</code></li>
          <li><code>background: radial-gradient(circle, #3b82f6 0%, #a855f7 100%);</code></li>
          <li><code>background: conic-gradient(from 0deg, #3b82f6 0%, #a855f7 100%);</code></li>
        </ul>
        <p>
          Color stops can use any valid CSS color (<code>#hex</code>, <code>rgb()</code>, <code>hsl()</code>,
          named colors) and any CSS length or percentage as position. Positions can be omitted to let the
          browser distribute stops evenly.
        </p>
      </div>
    </section>

    <section aria-labelledby="gradient-performance-heading">
      <h2 id="gradient-performance-heading" class="text-2xl font-bold text-slate-900">Gradients vs. images for backgrounds</h2>
      <div class="prose mt-4 max-w-none">
        <p>
          CSS gradients are rendered on the GPU and have zero network cost — they don't require an HTTP
          request the way a background image does. For decorative backgrounds, gradients are almost always
          the right choice:
        </p>
        <ul>
          <li>No image download = faster FCP (First Contentful Paint).</li>
          <li>Resolution-independent — crisp at any DPR/screen size.</li>
          <li>Can be animated with CSS transitions or <code>@keyframes</code> by interpolating CSS custom properties.</li>
        </ul>
      </div>
    </section>

  </div>

  <script is:inline>
    var stops = [{color:'#3b82f6',pos:0},{color:'#a855f7',pos:100}];
    var statusEl = document.getElementById('status');

    // ── Preset gallery ───────────────────────────────────────────────────────
    var PRESETS = [
      { name: 'Sunrise',   value: 'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)' },
      { name: 'Ocean',     value: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)' },
      { name: 'Candy',     value: 'linear-gradient(135deg, #f6d365 0%, #fda085 100%)' },
      { name: 'Forest',    value: 'linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)' },
      { name: 'Midnight',  value: 'linear-gradient(135deg, #0c0c0c 0%, #434343 100%)' },
      { name: 'Arctic',    value: 'linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%)' },
      { name: 'Lava',      value: 'linear-gradient(135deg, #ff0844 0%, #ffb199 100%)' },
      { name: 'Sage',      value: 'linear-gradient(135deg, #b8d8d8 0%, #7a9e7e 100%)' },
      { name: 'Dusk',      value: 'linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)' },
      { name: 'Citrus',    value: 'linear-gradient(135deg, #f9d423 0%, #ff4e50 100%)' },
      { name: 'Teal',      value: 'linear-gradient(135deg, #96fbc4 0%, #f9f586 100%)' },
      { name: 'Blueberry', value: 'linear-gradient(135deg, #4776e6 0%, #8e54e9 100%)' },
      { name: 'Peach',     value: 'linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%)' },
      { name: 'Mint',      value: 'linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%)' },
      { name: 'Ember',     value: 'linear-gradient(135deg, #f77062 0%, #fe5196 100%)' },
      { name: 'Steel',     value: 'linear-gradient(135deg, #616161 0%, #9bc5c3 100%)' },
      { name: 'Lavender',  value: 'linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%)' },
      { name: 'Sunset',    value: 'linear-gradient(135deg, #fa709a 0%, #fee140 100%)' },
      { name: 'Deep Sea',  value: 'linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)' },
      { name: 'Rose Gold', value: 'linear-gradient(135deg, #f093fb 0%, #f5576c 50%, #fda085 100%)' },
      { name: 'Northern',  value: 'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)' },
      { name: 'Crimson',   value: 'linear-gradient(135deg, #c94b4b 0%, #4b134f 100%)' },
      { name: 'Sky',       value: 'linear-gradient(135deg, #74b9ff 0%, #a29bfe 100%)' },
      { name: 'Autumn',    value: 'linear-gradient(135deg, #c44e00 0%, #ff8c00 50%, #ffd700 100%)' },
    ];

    // Parse a linear-gradient CSS string into stops array + angle
    function parseLinearGradient(css) {
      var match = css.match(/linear-gradient\((\d+)deg,\s*(.+)\)/);
      if (!match) return null;
      var angle = parseInt(match[1], 10);
      var stopsRaw = match[2].split(',').map(function(s) { return s.trim(); });
      var parsed = stopsRaw.map(function(s) {
        var parts = s.split(/\s+/);
        var color = parts[0];
        var pos = parts[1] ? parseInt(parts[1], 10) : null;
        return { color: color, pos: pos };
      });
      // Assign evenly-spaced positions if any are null
      parsed.forEach(function(s, i) {
        if (s.pos === null) s.pos = Math.round(i / (parsed.length - 1) * 100);
      });
      return { angle: angle, stops: parsed };
    }

    function applyPreset(preset) {
      var parsed = parseLinearGradient(preset.value);
      if (parsed) {
        document.getElementById('g-type').value = 'linear';
        document.getElementById('g-angle').value = parsed.angle;
        stops = parsed.stops;
        renderStops();
        update();
        showStatus('Applied preset: ' + preset.name, 'success');
      } else {
        // Radial/conic or unparseable — just set the preview and CSS directly
        document.getElementById('grad-preview').style.background = preset.value;
        document.getElementById('grad-css').textContent = 'background: ' + preset.value + ';';
        showStatus('Applied preset: ' + preset.name, 'success');
      }
    }

    function renderPresets() {
      var grid = document.getElementById('presets-grid');
      grid.innerHTML = PRESETS.map(function(p, i) {
        return '<button class="preset-swatch group flex flex-col items-center gap-1.5" data-i="' + i + '" title="' + p.name + '">' +
          '<div class="h-12 w-full rounded-lg border border-slate-200 shadow-sm transition group-hover:scale-105 group-hover:shadow-md" style="background:' + p.value + '"></div>' +
          '<span class="text-xs text-slate-500 group-hover:text-slate-800 truncate w-full text-center leading-tight">' + p.name + '</span>' +
          '</button>';
      }).join('');
      grid.querySelectorAll('.preset-swatch').forEach(function(btn) {
        btn.addEventListener('click', function() { applyPreset(PRESETS[+btn.dataset.i]); });
      });
    }

    document.getElementById('presets-toggle').addEventListener('click', function() {
      var panel = document.getElementById('presets-panel');
      var chevron = document.getElementById('presets-chevron');
      var open = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden', open);
      chevron.style.transform = open ? '' : 'rotate(180deg)';
      this.setAttribute('aria-expanded', String(!open));
      if (!open) renderPresets();
    });

    // ── Gradient builder ─────────────────────────────────────────────────────
    function showStatus(msg, type) {
      var clsMap = { error: 'bg-red-50 text-red-700 border border-red-200', success: 'bg-emerald-50 text-emerald-700 border border-emerald-200', info: 'bg-blue-50 text-blue-700 border border-blue-200' };
      statusEl.className = 'mt-2 rounded-md px-3 py-1.5 text-sm font-medium ' + (clsMap[type] || 'bg-slate-100 text-slate-700');
      statusEl.textContent = msg;
      statusEl.classList.remove('hidden');
    }

    function renderStops() {
      var c = document.getElementById('stops-container');
      c.innerHTML = stops.map(function(s, i) {
        return '<div class="flex items-center gap-2">' +
          '<input type="color" data-i="' + i + '" class="stop-color h-9 w-12 rounded-md border border-slate-300 cursor-pointer" value="' + s.color + '">' +
          '<div class="flex-1">' +
            '<input type="range" data-i="' + i + '" class="stop-pos w-full accent-purple-600" min="0" max="100" value="' + s.pos + '">' +
          '</div>' +
          '<span class="w-10 text-xs text-slate-500 text-right font-mono">' + s.pos + '%</span>' +
          '<button data-i="' + i + '" class="btn-del-stop rounded-md border border-red-200 bg-red-50 px-2 py-1 text-xs text-red-700 hover:bg-red-100' + (stops.length <= 2 ? ' opacity-40 cursor-not-allowed' : '') + '">&#10005;</button>' +
          '</div>';
      }).join('');
      c.querySelectorAll('.stop-color').forEach(function(el) {
        el.addEventListener('input', function() { stops[+el.dataset.i].color = el.value; update(); });
      });
      c.querySelectorAll('.stop-pos').forEach(function(el) {
        el.addEventListener('input', function() {
          stops[+el.dataset.i].pos = +el.value;
          el.parentNode.nextElementSibling.textContent = el.value + '%';
          update();
        });
      });
      c.querySelectorAll('.btn-del-stop').forEach(function(el) {
        el.addEventListener('click', function() {
          if (stops.length > 2) { stops.splice(+el.dataset.i, 1); renderStops(); update(); }
        });
      });
    }

    function randomHex() { return '#' + Math.floor(Math.random() * 16777215).toString(16).padStart(6, '0'); }

    function update() {
      stops.sort(function(a, b) { return a.pos - b.pos; });
      var type = document.getElementById('g-type').value;
      var angle = document.getElementById('g-angle').value;
      document.getElementById('g-angle-label').textContent = angle + 'deg';
      var stopsStr = stops.map(function(s) { return s.color + ' ' + s.pos + '%'; }).join(', ');
      var css;
      if (type === 'linear') css = 'linear-gradient(' + angle + 'deg, ' + stopsStr + ')';
      else if (type === 'radial') css = 'radial-gradient(circle, ' + stopsStr + ')';
      else css = 'conic-gradient(from ' + angle + 'deg, ' + stopsStr + ')';
      document.getElementById('grad-preview').style.background = css;
      document.getElementById('grad-css').textContent = 'background: ' + css + ';';
    }

    document.getElementById('g-type').addEventListener('change', update);
    document.getElementById('g-angle').addEventListener('input', update);

    document.getElementById('btn-add-stop').addEventListener('click', function() {
      stops.push({ color: randomHex(), pos: 50 });
      renderStops(); update();
    });

    document.getElementById('btn-random-grad').addEventListener('click', function() {
      var count = 2 + Math.floor(Math.random() * 2);
      stops = Array.from({ length: count }, function(_, i) {
        return { color: randomHex(), pos: Math.round(i / (count - 1) * 100) };
      });
      renderStops(); update();
      showStatus('Random gradient generated', 'success');
    });

    document.getElementById('btn-copy-grad').addEventListener('click', function() {
      var css = document.getElementById('grad-css').textContent;
      navigator.clipboard.writeText(css).then(function() {
        showStatus('CSS copied to clipboard', 'success');
      }, function() {
        showStatus('Copy failed — please copy manually from the code block above', 'error');
      });
    });

    // ── Tailwind output ──────────────────────────────────────────────────────
    function toTailwindGradient(angleDeg, stopsList) {
      // Map common angles to Tailwind direction classes
      var angle = ((parseInt(angleDeg, 10) % 360) + 360) % 360;
      var dirClass;
      if (angle === 0)   dirClass = 'bg-gradient-to-t';
      else if (angle === 45)  dirClass = 'bg-gradient-to-tr';
      else if (angle === 90)  dirClass = 'bg-gradient-to-r';
      else if (angle === 135) dirClass = 'bg-gradient-to-br';
      else if (angle === 180) dirClass = 'bg-gradient-to-b';
      else if (angle === 225) dirClass = 'bg-gradient-to-bl';
      else if (angle === 270) dirClass = 'bg-gradient-to-l';
      else if (angle === 315) dirClass = 'bg-gradient-to-tl';
      else dirClass = 'bg-gradient-to-br'; // fallback
      var colorStops = stopsList.map(function(s) { return s.color; });
      var from = colorStops[0] || '#000';
      var to = colorStops[colorStops.length - 1] || '#fff';
      var via = colorStops.length > 2 ? ' via-[' + colorStops[Math.floor(colorStops.length / 2)] + ']' : '';
      return '<div class="' + dirClass + ' from-[' + from + ']' + via + ' to-[' + to + ']">';
    }

    function toSVGGradient(id, stopsList, angleDeg) {
      var angle = ((parseInt(angleDeg, 10) % 360) + 360) % 360;
      var rad = angle * Math.PI / 180;
      var x2 = parseFloat(Math.abs(Math.sin(rad)).toFixed(2));
      var y2 = parseFloat(Math.abs(Math.cos(rad)).toFixed(2));
      // Normalize so max coord is 1
      var maxCoord = Math.max(x2, y2) || 1;
      x2 = parseFloat((x2 / maxCoord).toFixed(2));
      y2 = parseFloat((y2 / maxCoord).toFixed(2));
      var stopEls = stopsList.map(function(s, i) {
        return '<stop offset="' + s.pos + '%" stop-color="' + s.color + '"/>';
      }).join('\n    ');
      return '<svg xmlns="http://www.w3.org/2000/svg" width="0" height="0">\n  <defs>\n    <linearGradient id="' + id + '" x1="0" y1="0" x2="' + x2 + '" y2="' + y2 + '">\n    ' + stopEls + '\n    </linearGradient>\n  </defs>\n</svg>';
    }

    // ── Animated gradient ────────────────────────────────────────────────────
    var animStyleAdded = false;
    var animOn = false;

    function ensureAnimStyle() {
      if (animStyleAdded) return;
      var style = document.createElement('style');
      style.textContent = '@keyframes gradient-anim {\n  0% { background-position: 0% 50%; }\n  50% { background-position: 100% 50%; }\n  100% { background-position: 0% 50%; }\n}\n.gradient-animated {\n  background-size: 200% 200% !important;\n  animation: gradient-anim 3s ease infinite;\n}';
      document.head.appendChild(style);
      animStyleAdded = true;
    }

    document.getElementById('btn-animate-toggle').addEventListener('click', function() {
      ensureAnimStyle();
      animOn = !animOn;
      var preview = document.getElementById('grad-preview');
      preview.classList.toggle('gradient-animated', animOn);
      this.textContent = animOn ? 'Stop Animation' : 'Animate';
      this.classList.toggle('bg-purple-100', animOn);
      this.classList.toggle('text-purple-700', animOn);
    });

    document.getElementById('btn-copy-svg').addEventListener('click', function() {
      var angle = document.getElementById('g-angle').value;
      var svg = toSVGGradient('grad0', stops, angle);
      navigator.clipboard.writeText(svg).then(function() {
        showStatus('SVG gradient copied to clipboard', 'success');
      }, function() {
        showStatus('Copy failed — please copy manually', 'error');
      });
    });

    // Patch update() to also update Tailwind output
    var _origUpdate = update;
    update = function() {
      _origUpdate();
      var type = document.getElementById('g-type').value;
      var angle = document.getElementById('g-angle').value;
      var twEl = document.getElementById('grad-tailwind');
      if (twEl) {
        if (type === 'linear') {
          twEl.textContent = toTailwindGradient(angle, stops);
        } else {
          twEl.textContent = '/* Tailwind only supports linear gradients — use CSS output above */';
        }
      }
    };

    renderStops(); update();
  </script>

</BaseLayout>
