---
import SchemaBreadcrumbList, { type Crumb } from './SchemaBreadcrumbList.astro';
import { siteUrl } from '~/config/site.config';

interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
// Absolute URLs required by BreadcrumbList schema.
const absolute = items.map((c) => ({
  name: c.name,
  url: c.url.startsWith('http') ? c.url : siteUrl + c.url,
}));
---
<nav aria-label="Breadcrumb" class="text-sm text-slate-600">
  <ol class="flex flex-wrap items-center gap-1">
    {items.map((c, i) => (
      <li class="flex items-center gap-1">
        {i < items.length - 1 ? (
          <a href={c.url} class="hover:underline">{c.name}</a>
        ) : (
          <span aria-current="page" class="text-slate-900 font-medium">{c.name}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true" class="text-slate-400">/</span>}
      </li>
    ))}
  </ol>
</nav>
<SchemaBreadcrumbList items={absolute} />
