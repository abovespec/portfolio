---
interface Props {
  /** 'financial' | 'health' | 'legal' | 'general' */
  type?: 'financial' | 'health' | 'legal' | 'general';
  /** ISO date string for last reviewed date, e.g. '2026-04-25' */
  lastReviewed?: string;
  /** Reviewer name — leave empty until Calliope sources a real credential */
  reviewedBy?: string;
}

const { type = 'general', lastReviewed, reviewedBy } = Astro.props;

const disclaimers: Record<string, string> = {
  financial:
    'This calculator is for informational and educational purposes only. It does not constitute financial advice. Consult a qualified financial professional before making financial decisions.',
  health:
    'This tool provides general health information only and is not a substitute for professional medical advice, diagnosis, or treatment. Always consult a qualified healthcare provider.',
  legal:
    'This tool is for informational purposes only and does not constitute legal advice. Consult a licensed attorney for guidance specific to your situation.',
  general:
    'Results are for informational purposes only. Verify important calculations with a qualified professional.',
};

const text = disclaimers[type];

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<aside
  role="note"
  aria-label="Important disclaimer"
  class="mt-6 rounded-lg border border-amber-200 bg-amber-50/70 px-4 py-3 text-sm text-amber-900"
>
  <div class="flex flex-wrap items-start gap-x-2 gap-y-1">
    <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
    </svg>
    <span><strong class="font-semibold">Disclaimer:</strong> {text}</span>
  </div>

  {(lastReviewed || reviewedBy) && (
    <p class="mt-2 text-xs text-amber-800">
      {reviewedBy && <span>Reviewed by <strong>{reviewedBy}</strong>. </span>}
      {lastReviewed && (
        <span>
          Last reviewed: <time datetime={lastReviewed}>{fmt(lastReviewed)}</time>.
        </span>
      )}
    </p>
  )}
</aside>
