---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import SchemaSoftwareApplication from '~/components/SchemaSoftwareApplication.astro';
import { siteConfig, siteUrl } from '~/config/site.config';

interface Props {
  title: string;
  description: string;
  slug: string;
  /** ISO date string, e.g. '2026-04-25' */
  lastUpdated?: string;
  applicationCategory?: string;
  operatingSystem?: string;
  price?: string;
  priceCurrency?: string;
  ratingValue?: number;
  ratingCount?: number;
}
const {
  title, description, slug, lastUpdated,
  applicationCategory, operatingSystem, price, priceCurrency, ratingValue, ratingCount,
} = Astro.props;
const url = new URL(Astro.url.pathname, siteUrl).toString();

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={title} description={description}>
  <Breadcrumb items={[
    { name: 'Home', url: '/' },
    { name: 'Tools', url: '/tools/' },
    { name: title, url: `/tools/${slug}/` },
  ]} />

  <!-- Tool hero section -->
  <section class="relative -mx-4 mt-2 overflow-hidden px-4 pb-8 pt-10">
    <!-- Subtle gradient background keyed to the site accent -->
    <div class="absolute inset-0 bg-gradient-to-br from-slate-50 via-white to-slate-100" aria-hidden="true" />
    <div class="absolute -top-24 right-0 h-64 w-64 rounded-full bg-[color:var(--site-accent-color)]/10 blur-3xl" aria-hidden="true" />

    <div class="relative">
      <div class="mx-auto max-w-2xl">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">{title}</h1>
        <p class="mt-3 text-lg leading-relaxed text-slate-600">{description}</p>
        {lastUpdated && (
          <p class="mt-2 text-xs text-slate-400">
            Last updated: <time datetime={lastUpdated}>{fmt(lastUpdated)}</time>
          </p>
        )}
      </div>

      <!-- Tool widget -->
      <div class="mx-auto mt-8 max-w-2xl">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <slot name="tool" />
        </div>
      </div>
    </div>
  </section>

  <!-- SEO content below the fold -->
  <section class="prose prose-slate mt-10 max-w-none">
    <slot />
  </section>

  <slot name="faq" />

  <SchemaSoftwareApplication
    name={title}
    description={description}
    url={url}
    applicationCategory={applicationCategory}
    operatingSystem={operatingSystem}
    price={price}
    priceCurrency={priceCurrency}
    ratingValue={ratingValue}
    ratingCount={ratingCount}
  />
</BaseLayout>
