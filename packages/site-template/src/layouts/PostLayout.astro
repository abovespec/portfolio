---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '~/components/Breadcrumb.astro';
import SchemaArticle from '~/components/SchemaArticle.astro';
import { siteUrl } from '~/config/site.config';
import { existsSync } from 'node:fs';
import path from 'node:path';

interface Props {
  title: string;
  description: string;
  publishDate: Date | string;
  updatedDate?: Date | string;
  author?: string;
  /** Reviewer name for YMYL legitimacy — leave empty until sourced */
  reviewedBy?: string;
  image?: string;
  tags?: string[];
}
const { title, description, publishDate, updatedDate, author, reviewedBy, image, tags = [] } = Astro.props;
const url = new URL(Astro.url.pathname, siteUrl).toString();

const slug = Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, '');
const imgDir = path.join(process.cwd(), 'public', 'images', 'blog');
const heroSrc = `/images/blog/${slug}-hero.png`;
const img1Src = `/images/blog/${slug}-1.png`;
const img2Src = `/images/blog/${slug}-2.png`;
const hasHero = existsSync(path.join(imgDir, `${slug}-hero.png`));
const hasImg1 = existsSync(path.join(imgDir, `${slug}-1.png`));
const hasImg2 = existsSync(path.join(imgDir, `${slug}-2.png`));
const ogImage = image ?? (hasHero ? heroSrc : undefined);

const fmt = (d: Date | string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={title} description={description} image={ogImage} ogType="article">
  <article class="prose prose-slate max-w-none">
    <Breadcrumb items={[
      { name: 'Home', url: '/' },
      { name: 'Blog', url: '/blog/' },
      { name: title, url: Astro.url.pathname },
    ]} />

    <header class="not-prose mt-4 mb-8 border-b border-slate-100 pb-6">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl leading-tight">{title}</h1>
      <p class="mt-3 text-lg text-slate-500 leading-relaxed">{description}</p>

      <!-- Author + date row -->
      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        {author && (
          <div class="flex items-center gap-2">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-slate-200 text-xs font-semibold text-slate-600">
              {author.charAt(0).toUpperCase()}
            </span>
            <span class="font-medium text-slate-800">{author}</span>
          </div>
        )}
        {author && <span class="text-slate-300" aria-hidden="true">|</span>}
        <time class="text-slate-500" datetime={new Date(publishDate).toISOString()}>
          {fmt(publishDate)}
        </time>
        {updatedDate && (
          <span class="text-slate-400">
            · Updated <time datetime={new Date(updatedDate).toISOString()}>{fmt(updatedDate)}</time>
          </span>
        )}
        {reviewedBy && (
          <>
            <span class="text-slate-300" aria-hidden="true">|</span>
            <span class="flex items-center gap-1 text-slate-500">
              <svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.061 1.06l2.5 2.5a.75.75 0 001.137-.088l4-5.5z" clip-rule="evenodd" />
              </svg>
              Reviewed by <strong class="ml-0.5 text-slate-700">{reviewedBy}</strong>
            </span>
          </>
        )}
      </div>

      {tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2">
          {tags.map((t) => (
            <li class="rounded-full bg-slate-100 px-3 py-0.5 text-xs font-medium text-slate-600">
              {t}
            </li>
          ))}
        </ul>
      )}
    </header>

    {hasHero && (
      <figure class="not-prose my-6 overflow-hidden rounded-xl">
        <img
          src={heroSrc}
          alt={title}
          width="1200"
          height="630"
          class="w-full object-cover"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )}

    <div class="prose prose-slate max-w-none flow-root">
      {hasImg1 && (
        <figure class="not-prose mb-6 overflow-hidden rounded-lg sm:float-right sm:mb-4 sm:ml-6 sm:w-5/12">
          <img
            src={img1Src}
            alt=""
            width="600"
            height="400"
            class="w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )}
      <slot />
    </div>

    {hasImg2 && (
      <figure class="not-prose my-8 overflow-hidden rounded-xl">
        <img
          src={img2Src}
          alt=""
          width="1200"
          height="630"
          class="w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </figure>
    )}

    <slot name="related" />
  </article>

  <SchemaArticle
    headline={title}
    description={description}
    url={url}
    image={ogImage}
    datePublished={publishDate}
    dateModified={updatedDate}
    author={author}
  />
</BaseLayout>
